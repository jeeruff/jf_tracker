// jf_fx_airwindows.jsfx-inc — общая библиотека эффектов экосистемы jf.
//
// Порт Airwindows (c) Chris Johnson, MIT. Исходники:
//   https://github.com/airwindows/airwindows
// Один файл на всю экосистему: jf_slixer, jf_grgrain, jf_reasimpler.
// Фильтры Y/Z живут отдельно в jf_fx_filters.jsfx-inc (тот же порт, раньше).
//
// ── СОГЛАШЕНИЕ ─────────────────────────────────────────────────────────────
// Каждый эффект = две функции:
//   fx_<имя>_prep(c, p1, p2, p3, mix)  — раз на блок, пишет в блок коэф. c[]
//   fx_<имя>(c, s, x, t)               — на сэмпл одного канала
// c — коэффициенты, ОБЩИЕ для L/R (FXC_SZ слов).
// s — состояние, СВОЁ на каждый канал (FXS_SZ слов).
// t — доля блока: 1 в начале (старые значения), 0 в конце (новые).
//     Так Крис морфит параметры внутри блока; у нас это же делает fxi().
// Параметры p1..p3, mix — все 0..1, как слайдеры VST у Криса.
//
// Дизер fpd из оригиналов выброшен: он борется с денормалами и добавляет
// 32-битный дизер при записи во float-буфер. В EEL2 всё double, для звука
// он не нужен. Где шум — часть эффекта (TapeDust), там стоит rand().
//
// ── ПАМЯТЬ ─────────────────────────────────────────────────────────────────
// FXC_SZ = 24 слова коэффициентов на слот (хватает самому жадному).
// FXS_SZ = 32 слова состояния на канал — КРОМЕ эффектов с линией задержки,
// им нужен ещё хвост: fx_need_delay(id) говорит, сколько слов сверх FXS_SZ.
// Вызывающий обязан выделить s[] размером FXS_SZ + fx_need_delay(id).

@init
// Секция обязательна: без неё REAPER не подхватит функции из include.

FXC_SZ = 24;
FXS_SZ = 32;

// ── идентификаторы эффектов ────────────────────────────────────────────────
// 0 = слот выключен (сигнал проходит насквозь).
FX_NONE       = 0;
FX_HYPERSOFT  = 1;   // мягкий клиппер   Depth  Bright
FX_SQROOT     = 2;   // сатурация        In     Soar
FX_FRACTURE2  = 3;   // вейвфолдер       Fract  Drive
FX_FACET      = 4;   // хард-клип        Facet  —
FX_KALMAN     = 5;   // «неправильный» фильтр   Kalman
FX_BIQUADNL   = 6;   // банк фильтров    Freq   Q     Type
FX_CAPACITOR2 = 7;   // свип LP/HP       Lowpas Highp NonLin
FX_RINGMOD    = 8;   // кольцевая        Freq   Soar
FX_VIBRATO    = 9;   // хорус/флэнж/ЧМ   Depth  Speed FM
FX_TREMOSQ    = 10;  // гейт-тремоло     Freq   —
FX_PRESSURE6  = 11;  // компрессор       Compr  Ratio
FX_POINT      = 12;  // транзиенты       Point  React
FX_PHASENUDGE = 13;  // фазовращатель    Nudge  —
FX_DEREZ3     = 14;  // биткрашер        Rez    Rate
FX_TAPEDUST   = 15;  // ленточный шум    Dust   —
FX_STEREOFX   = 16;  // ширина           Wide   MonoBs
FX_CHORUS     = 17;  // хорус            Speed  Range
FX_FLUTTER2   = 18;  // вау-флаттер      Flut   Speed
FX_BITE       = 19;  // «зуб»/резкость   Bite   Out
FX_CREATURE   = 20;  // слю-каскад       Drive  Depth
FX_EXCITER    = 21;  // аурал-эксайтер   Freq   Excite
FX_HULL       = 22;  // Hull-сглаживание Freq   Bright
FX_SWEETWIDE  = 23;  // ширина по Soar   Soar   Un/Wide
FX_SOFTGATE   = 24;  // мягкий гейт      Thresh Darken
FX_EROSION    = 25;  // шумовая КМ       Freq   Width  Color
FX_COUNT      = 26;

// интерполяция параметра по блоку: a — старое, b — новое
function fxi(a, b, t) ( a*t + b*(1-t) );

// сколько слов ДОПОЛНИТЕЛЬНОЙ памяти нужно эффекту сверх FXS_SZ (на канал)
function fx_need_delay(id) (
  id == FX_PHASENUDGE ? 1504 :
  id == FX_VIBRATO    ? 16386 :
  id == FX_CHORUS     ? 16386 :   // двойной буфер 2*loopLimit + хвост интерполяции
  id == FX_FLUTTER2   ? 1002 :    // кольцо 1000 + 2 на чтение соседей
  id == FX_HULL       ? 4110 :    // 4005 длинное кольцо + 105 короткое
  id == FX_CREATURE   ? 104 : 0;  // slew[] по одному слову на каскад
);

// ═══════════════════════════════════════════════════════════════════════════
// 1. HYPERSOFT — «more extreme form of soft-clipper»
//    Ряд синусоидальных гармоник; Bright гасит верхние на быстрых фронтах,
//    где они всё равно превратились бы в алиасинг.
//    c: 0,1 inGain 2,3 outGain 4,5 bright 6 stages 7 wet | s: 0 last
// ═══════════════════════════════════════════════════════════════════════════
function fx_hypersoft_prep(c, p1, p2, p3, mix) local(g) (
  c[0] = c[1]; c[2] = c[3]; c[4] = c[5];
  g = p1*2; c[1] = g > 1 ? g*g : 1 - (1-g)^2;      // кривая фейдера ConsoleX
  c[3] = 0.68;                                     // выход фиксируем
  c[5] = (1 - p2) * 0.15;
  c[6] = floor(p3*12) + 2;                         // целое — без морфа
  c[7] = mix;
);
function fx_hypersoft(c, s, x, t) local(dry, br, n, k, o) (
  dry = x;
  x *= fxi(c[0], c[1], t);
  br = fxi(c[4], c[5], t);
  x = sin(x); x += sin(x*2)*0.5;
  k = 2; n = c[6];
  while (k < n) (
    o = 1 - abs((x - s[0]) * br * k * k);
    o < 0 ? o = 0;
    x += sin(x*k) / (k*k*k) * o;
    k += 1;
  );
  s[0] = x;
  x *= fxi(c[2], c[3], t);
  c[7] < 1 ? x = x*c[7] + dry*(1-c[7]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 2. SQUAREROOT — Soar управляет плотностью, от гейта до густоты.
//    c: 0,1 in 2,3 soar 4,5 out 6 wet | без состояния
// ═══════════════════════════════════════════════════════════════════════════
function fx_sqroot_prep(c, p1, p2, p3, mix) local(g) (
  c[0] = c[1]; c[2] = c[3]; c[4] = c[5];
  g = p1*2; c[1] = g*g;
  c[3] = 0.3 - p2*0.3;
  g = p3*2; c[5] = g*g;
  c[6] = mix;
);
function fx_sqroot(c, s, x, t) local(dry, soar, tmp, o) (
  dry = x;
  x *= fxi(c[0], c[1], t);
  soar = fxi(c[2], c[3], t);
  tmp = abs(x) + soar*soar;
  x > 0 ? ( o = sqrt(1/tmp)*tmp - soar; x = o > 0 ? o : 0; )
  : x < 0 ? ( o = -sqrt(1/tmp)*tmp + soar; x = o < 0 ? o : 0; );
  x *= fxi(c[4], c[5], t);
  c[6] < 1 ? x = x*c[6] + dry*(1-c[6]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 3. FRACTURE2 — вейвфолдер: раскачка, потом sin() заворачивает волну.
//    Threshold решает, насколько заворот доходит до края.
//    c: 0,1 density 2,3 thresh 4,5 out 6 stages 7 wet | без состояния
// ═══════════════════════════════════════════════════════════════════════════
function fx_fracture2_prep(c, p1, p2, p3, mix) (
  c[0] = c[1]; c[2] = c[3]; c[4] = c[5];
  c[1] = p1*10;
  c[3] = p2;
  c[5] = 1;
  c[6] = floor(p3*8);
  c[7] = mix;
);
function fx_fracture2(c, s, x, t) local(dry, th, k) (
  dry = x;
  x *= fxi(c[0], c[1], t);
  th = fxi(c[2], c[3], t);
  k = 0; while (k < c[6]) ( x *= abs(x) + 1; k += 1; );
  x = x > $pi*0.5 ? sin(x)*th + (1-th)
    : x < -$pi*0.5 ? sin(x)*th - (1-th) : sin(x);
  x *= fxi(c[4], c[5], t);
  c[7] < 1 ? x = x*c[7] + dry*(1-c[7]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 4. FACET — «hard clip that adds two sharp corners into the wave».
//    Не срез, а излом передаточной функции: за порогом наклон падает.
//    c: 0,1 pos 2 wet | без состояния
// ═══════════════════════════════════════════════════════════════════════════
function fx_facet_prep(c, p1, p2, p3, mix) (
  c[0] = c[1]; c[1] = p1; c[2] = mix;
);
function fx_facet(c, s, x, t) local(dry, pos) (
  dry = x; pos = fxi(c[0], c[1], t);
  x > pos ? x = (x - pos)*pos + pos;
  x < -pos ? x = (x + pos)*pos - pos;
  c[2] < 1 ? x = x*c[2] + dry*(1-c[2]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 10. TREMOSQUARE — прямоугольное тремоло, переключается ТОЛЬКО на переходе
//     через ноль. Поэтому нет щелчков даже на резком гейте.
//     c: 0 increment 1 wet | s: 0 osc 1 polarity 2 mute
// ═══════════════════════════════════════════════════════════════════════════
function fx_tremosq_prep(c, p1, p2, p3, mix) (
  c[0] = (p1^4) / (50 * (srate/44100));
  c[1] = mix;
);
function fx_tremosq(c, s, x, t) local(dry) (
  dry = x;
  s[0] += c[0]; s[0] > 1 ? s[0] = 0;
  x < 0 ? ( s[1] ? ( s[2] = s[0] < 0.5; ); s[1] = 0; )
        : ( s[1] ? 0 : ( s[2] = s[0] < 0.5; ); s[1] = 1; );
  s[2] ? x = 0;
  c[1] < 1 ? x = x*c[1] + dry*(1-c[1]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 14. DEREZ3 — децимация + биткраш. Ступеньки сглаживаются кривой Безье
//     по трём последним удержанным точкам, отсюда «ретро-цифра», а не грязь.
//     Микс особый: 50% = полный сухой И полный мокрый (Крис так задумал).
//     c: 0,1 rez 2,3 bit 4,5 wet | s: 0 cycle 1 samp 2 A 3 B 4 C
// ═══════════════════════════════════════════════════════════════════════════
function fx_derez3_prep(c, p1, p2, p3, mix) (
  c[0] = c[1]; c[2] = c[3]; c[4] = c[5];
  c[1] = (p1^3) / (srate/44100);
  c[3] = p2*15 + 1;
  c[5] = mix*2;
);
function fx_derez3(c, s, x, t) local(dry, rez, bit, wet, dryg, bf, cb, ba) (
  dry = x;
  rez = fxi(c[0], c[1], t); rez < 0.0005 ? rez = 0.0005;
  bit = fxi(c[2], c[3], t);
  wet = fxi(c[4], c[5], t);
  bf = 2^bit;
  dryg = 2 - wet;
  wet > 1 ? wet = 1; wet < 0 ? wet = 0;
  dryg > 1 ? dryg = 1; dryg < 0 ? dryg = 0;
  x = floor(x*bf + 0.5/bf) / bf;
  s[0] += rez;
  s[1] += x * rez;
  s[0] > 1 ? (
    s[0] -= 1;
    s[4] = s[3]; s[3] = s[2]; s[2] = x; s[1] = 0;
  );
  cb = s[4]*(1-s[0]) + s[3]*s[0];
  ba = s[3]*(1-s[0]) + s[2]*s[0];
  x = (s[3] + cb*(1-s[0]) + ba*s[0]) * 0.5;
  wet*x + dryg*dry;
);

// ═══════════════════════════════════════════════════════════════════════════
// 15. TAPEDUST — «special treble-erode noise, a slew noise plugin».
//     Шум не подмешивается, а РАЗМЫВАЕТ верх: чем резче фронт, тем сильнее.
//     Скользящее среднее по 9 отсчётам со случайной длиной окна.
//     Примечание: в оригинале цикл сдвига буфера мёртв (count=9; count<0),
//     реально используются только два последних отсчёта. Делаем честно.
//     c: 0 rRange 1 xfuzz 2 rOffset 3 wet | s: 0 flip 1..10 буфер
// ═══════════════════════════════════════════════════════════════════════════
function fx_tapedust_prep(c, p1, p2, p3, mix) (
  c[0] = (p1^2) * 5;
  c[1] = c[0] * 0.002;
  c[2] = c[0]*0.4 + 1;
  c[3] = mix;
);
function fx_tapedust(c, s, x, t) local(dry, r, gain, k, f, acc, cnt, b) (
  dry = x;
  b = s + 1;
  k = 9; while (k > 0) ( b[k] = b[k-1]; k -= 1; );
  b[0] = x;
  r = rand(1);
  gain = r * c[0] + c[2];
  x = r * ((1 - abs(b[0]-b[1])) * c[1]);
  s[0] ? x = -x;
  s[0] = 1 - s[0];
  acc = 0; cnt = 0; k = 0;
  while (k < 9) (
    gain > 1 ? ( f = 1; gain -= 1; ) : ( f = gain; gain = 0; );
    f > 0 ? ( acc += b[k] * f; cnt += f; );
    k += 1;
  );
  cnt > 0 ? x += acc / cnt;
  c[3] < 1 ? x = x*c[3] + dry*(1-c[3]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 5. KALMAN — «Kalman is not a real filter!» (Крис)
//    Предсказывает следующий отсчёт по цепочке производных (слю, ускорение
//    слю, и дальше в бездну), потом смешивает предсказание с реальностью по
//    «калмановскому усилению». Резонанс не как у биквада — этим и ценен.
//    c: 0,1 kalman 2 wet 3 dry | s: 0..2 prevSamp 3..5 prevSlew
//       6..8 accSlew 9 kalOut 10 kalGain
// ═══════════════════════════════════════════════════════════════════════════
function fx_kalman_prep(c, p1, p2, p3, mix) (
  c[0] = c[1];
  c[1] = 1 - p1*p1;
  c[2] = mix*2 - 1;                    // инв-сухой-мокрый: даёт хайпасс
  c[3] = 2 - mix*2; c[3] > 1 ? c[3] = 1;
);
function fx_kalman(c, s, x, t) local(dry, kal, dk) (
  dry = x;
  kal = fxi(c[0], c[1], t);
  dk = x = x * (1-kal) * 0.777;
  x *= (1 - kal);
  s[5] += s[2] - s[1]; s[5] *= 0.5;
  s[4] += s[1] - s[0]; s[4] *= 0.5;
  s[3] += s[0] - x;    s[3] *= 0.5;
  s[7] += s[5] - s[4]; s[7] *= 0.5;
  s[6] += s[4] - s[3]; s[6] *= 0.5;
  s[8] += s[7] - s[6]; s[8] *= 0.5;
  s[9] += s[0] + s[4] + s[8]; s[9] *= 0.5;
  s[10] += abs(dk - s[9]) * kal * 8; s[10] *= 0.5;
  s[10] > kal*0.5 ? s[10] = kal*0.5;             // защита от разноса
  s[9] += dk * (1 - (0.68 + kal*0.157));
  s[2] = s[1]; s[1] = s[0];
  s[0] = s[10]*s[9] + (1-s[10])*dk;
  s[0] > 1 ? s[0] = 1; s[0] < -1 ? s[0] = -1;
  dry*c[3] + s[9]*c[2]*0.777;
);

// ═══════════════════════════════════════════════════════════════════════════
// 11. PRESSURE6 — вари-мю компрессор. СТЕРЕО-СВЯЗАН: детектор берёт максимум
//     L/R, иначе образ разъезжается. Скорость реакции сама подстраивается
//     под сигнал (muSpd), отсюда «дыхание», а не механическое качание.
//     c: 0,1 thresh 2,3 adjSpd 4 wet | s: 0 muComp 1 muSpd
// ═══════════════════════════════════════════════════════════════════════════
function fx_pressure6_prep(c, p1, p2, p3, mix) (
  c[0] = c[1]; c[2] = c[3];
  c[1] = 1 - (p1*0.9)^3;
  c[3] = (p1*92 + 92) * (srate/44100);
  c[4] = mix*0.9;
);
// стерео-версия: пишет обратно в l[0]/r[0]
function fx_pressure6_st(c, s, l, r, t) local(th, sp, det, dl, dr, w, mc, ms) (
  th = fxi(c[0], c[1], t); sp = fxi(c[2], c[3], t); w = c[4];
  s[1] <= 0 ? ( s[0] = 1; s[1] = sp; );          // ленивая инициализация
  dl = l[0]; dr = r[0];
  det = abs(dl); abs(dr) > det ? det = abs(dr);
  mc = s[0]; ms = s[1];
  det *= mc/th; l[0] *= mc/th; r[0] *= mc/th;
  abs(det) > th ? (
    mc *= ms;
    th/abs(det) < th ? mc += th*abs(det) : mc -= th/abs(det);
    mc /= ms;
  ) : (
    mc *= ms*ms;
    mc += (1.1 + th) - abs(det);
    mc /= ms*ms;
  );
  mc > 1 ? mc = 1; mc < th ? mc = th;
  det *= mc*mc; l[0] *= mc*mc; r[0] *= mc*mc;
  ms = ((ms*(ms-1)) + abs(det*sp)) / ms;
  ms > sp*2 ? ms = sp*2; ms < sp ? ms = sp;
  s[0] = mc; s[1] = ms;
  l[0] = dl*(1 - w*1.1) + sin(max(min(l[0]*w, $pi*0.5), -$pi*0.5))*w;
  r[0] = dr*(1 - w*1.1) + sin(max(min(r[0]*w, $pi*0.5), -$pi*0.5))*w;
);

// ═══════════════════════════════════════════════════════════════════════════
// 8. RINGMODULATOR — «repitches sounds mathematically, not harmonically».
//    НЕ умножение на синус: свёртка через sqrt(inM/snM)*snM. Крис: «свёртка
//    это умножение, а если возвести в квадрат и извлечь корень, вернёшься к
//    исходному». Soar восстанавливает плотность: 0 = тонкий гейт, 1 = густо.
//    Два независимых синуса L/R → стерео из моно, если развести частоты.
//    c: 0,1 incL 2,3 incR 4 soar 5 wet | s: 0 фаза
//    Два независимых синуса: p1 = Freq L, p2 = Freq R (равные = моно-кольцо).
// ═══════════════════════════════════════════════════════════════════════════
function fx_ringmod_prep(c, p1, p2, p3, mix) (
  c[0] = c[1]; c[2] = c[3];
  c[1] = (p1^5) / (srate/44100);
  c[3] = (p2^5) / (srate/44100);               // p2 — частота R, независимая (как Freq R у Криса)
  c[4] = 0.3 - p3*0.3;
  c[5] = mix*mix;
);
// ch: 0 = левый (инкремент c[0/1]), иначе правый (c[2/3])
function fx_ringmod(c, s, x, t, ch) local(dry, inc, sn, soar, snm, inm, o, q) (
  dry = x; soar = c[4];
  inc = ch ? fxi(c[2], c[3], t) : fxi(c[0], c[1], t);
  s[0] += inc; s[0] > 6.283185307179586 ? s[0] -= 6.283185307179586;
  sn = sin(s[0]);
  snm = abs(sn) + soar*soar;
  inm = abs(x);
  inm < snm ? ( inm = abs(sn); snm = abs(x) + soar*soar; );
  q = sqrt(inm/snm) * snm;
  // знак результата = знак произведения входа и синуса (как у кольцевой)
  o = 0;
  x != 0 ? (
    (x > 0) == (sn > 0) ? ( o = q - soar; o < 0 ? o = 0; )
                        : ( o = soar - q; o > 0 ? o = 0; );
  );
  c[5] < 1 ? o*c[5] + dry*(1-c[5]) : o;
);

// ═══════════════════════════════════════════════════════════════════════════
// 25. EROSION — узкополосный шум как НОСИТЕЛЬ кольцевой модуляции.
//     Своё, не порт: у Криса такого нет (TapeDust — slew-шум без высоты,
//     RingModulator — синус без шума). Образец поведения — Ableton Erosion.
//
//     Суть, из-за которой это музыкально: шум не СКЛАДЫВАЕТСЯ с сигналом,
//     а УМНОЖАЕТСЯ на него. Поэтому в паузах тихо (нечего умножать), песок
//     «прилипает» к звуку и получает высоту от полосы фильтра. Сложение
//     дало бы ровное шипение поверх — совсем другой, нерабочий эффект.
//
//     p1 Freq  — центр полосы, 100 Гц .. 12 кГц (экспонента: слух логарифмичен)
//     p2 Width — полоса: от узкой (звенящая, почти тон) до широкой (песок)
//     p3 Color — 0 белый · 0.5 розовый · 1 синус (чистая КМ, как Sine у Ableton)
//     mix      — глубина
//
//     Шум фильтруется полосовым SVF (Andrew Simper): один и тот же фильтр
//     держит и «почти тон» при высоком Q, и «песок» при низком — отдельные
//     ветки под узкую и широкую полосу не нужны.
//     Розовый — фильтр -3 дБ/окт по Полу Кельлету (три полюса, достаточно
//     точно в звуковом диапазоне и дёшево: три умножения).
//     c: 0/1 g  2/3 k  4 a1 5 a2  6 color  7 mix  8 sine_inc
//     s: 0 ic1  1 ic2  2..4 розовые полюса  5 фаза синуса  6 seed
// ═══════════════════════════════════════════════════════════════════════════
function fx_erosion_prep(c, p1, p2, p3, mix) local(fc, q, g) (
  c[0] = c[1]; c[2] = c[3];
  fc = 100 * exp(p1 * 4.79);                      // 100 Гц .. ~12 кГц
  fc = min(fc, srate * 0.45);
  // Q: узко (16) при Width=0 → широко (0.5) при Width=1. Полоса — это и
  // есть «насколько шум похож на тон».
  q = 16 * exp(-p2 * 3.47);
  g = tan($pi * fc / srate);
  c[1] = g;
  c[3] = 1 / max(0.05, q);                        // k = 1/Q
  c[4] = 1 / (1 + c[1] * (c[1] + c[3]));
  c[5] = c[1] * c[4];
  c[6] = p3;
  c[7] = mix;
  c[8] = 2 * $pi * fc / srate;                    // инкремент фазы для синуса
);
function fx_erosion(c, s, x, t) local(dry, g, k, a1, a2, v1, v2, v3, bp, nz, col, car, w) (
  dry = x;
  col = c[6];
  // НОСИТЕЛЬ. При Color=1 это чистый синус (кольцевая модуляция без шума),
  // иначе шум — белый или розовый, смесь по Color.
  col >= 0.999 ? (
    s[5] += c[8]; s[5] > 6.283185307179586 ? s[5] -= 6.283185307179586;
    car = sin(s[5]);
  ) : (
    // свой ГПСЧ: rand() в EEL2 есть, но свой повторяем при том же seed
    s[6] = (s[6] * 1103515245 + 12345) % 2147483648;
    s[6] < 0 ? s[6] += 2147483648;
    nz = s[6] * 0.000000000931322575 - 1;          // −1..1
    // розовый по Кельлету: три полюса, −3 дБ/окт
    s[2] = 0.99765 * s[2] + nz * 0.0990460;
    s[3] = 0.96300 * s[3] + nz * 0.2965164;
    s[4] = 0.57000 * s[4] + nz * 1.0526913;
    w = min(1, col * 2);                           // 0 белый .. 1 розовый
    nz = nz * (1 - w) + (s[2] + s[3] + s[4] + nz * 0.1848) * 0.25 * w;
    // полосовой SVF на шуме: полоса и есть «высота песка»
    g = fxi(c[0], c[1], t); k = fxi(c[2], c[3], t);
    a1 = c[4]; a2 = c[5];
    v3 = nz - s[1];
    v1 = a1 * s[0] + a2 * v3;
    v2 = s[1] + g * v1;
    s[0] = 2*v1 - s[0]; s[1] = 2*v2 - s[1];
    bp = v1;
    // компенсация: узкая полоса режет энергию шума, и на слух глубина
    // падала бы вместе с Width. Делим на корень из k — как в govl грануляра.
    car = bp * min(6, 1 / sqrt(max(0.05, k)));
    // при Color между 0.5 и 1 подмешиваем синус: непрерывный переход
    // «песок → тон», а не переключатель
    col > 0.5 ? (
      s[5] += c[8]; s[5] > 6.283185307179586 ? s[5] -= 6.283185307179586;
      car = car * (1 - (col-0.5)*2) + sin(s[5]) * (col-0.5)*2;
    );
  );
  x = x * car;
  c[7] < 1 ? x*c[7] + dry*(1-c[7]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 12. POINT — «explosive transient designer».
//     Считает две огибающие: быструю (nib) и медленную (nob). Их отношение и
//     есть коэффициент. Резкая атака → быстрая обгоняет медленную → усиление.
//     Ручка Point двигает медленную в обе стороны: подчёркивание ИЛИ сглаживание.
//     Два набора через такт (flip) — половинная частота без ресемплинга.
//     c: 0 gaintrim 1 nibDiv 2 nobDiv 3 wet | s: 0 flip 1..4 nibA nobA nibB nobB
// ═══════════════════════════════════════════════════════════════════════════
function fx_point_prep(c, p1, p2, p3, mix) local(nib, pt) (
  nib = 1 / ((p3 + 0.2)^7);
  nib /= (srate/44100);
  pt = p1*2 - 1;
  c[0] = 10^((p2*24 - 12)/20);
  c[1] = nib;
  c[2] = pt > 0 ? nib / (1.001 - pt) : nib * (1.001 - (pt*0.75)^2);
  c[3] = mix;
);
function fx_point(c, s, x, t) local(dry, ab, f, nb, nob) (
  dry = x;
  x *= c[0];
  ab = abs(x);
  f = 0;
  s[0] ? (
    s[1] = (s[1] + ab/c[1]) / (1 + 1/c[1]);
    s[2] = (s[2] + ab/c[2]) / (1 + 1/c[2]);
    s[2] > 0 ? f = s[1]/s[2];
  ) : (
    s[3] = (s[3] + ab/c[1]) / (1 + 1/c[1]);
    s[4] = (s[4] + ab/c[2]) / (1 + 1/c[2]);
    s[4] > 0 ? f = s[3]/s[4];
  );
  s[0] = 1 - s[0];
  x *= f;
  c[3] < 1 ? x = x*c[3] + dry*(1-c[3]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 16. STEREOFX — СТЕРЕО-СВЯЗАН. Расширяет не умножением, а насыщением боковой
//     части через синус: тихое проходит, громкое заворачивается. Ширина растёт,
//     а моно-совместимость держится, потому что пики Side ограничены.
//     MonoBass — хайпасс на Side, низ остаётся в центре.
//     c: 0 density 1 sustain 2 iirAmount 3 squish | s: 0 iirA 1 iirB 2 flip
// ═══════════════════════════════════════════════════════════════════════════
function fx_stereofx_prep(c, p1, p2, p3, mix) (
  c[0] = p1*2.4;
  c[1] = 1 - (1 / (1 + c[0]/7));
  c[2] = (p2^3) / (srate/44100);
  c[3] = p3;
  c[4] = mix;
);
function fx_stereofx_st(c, s, l, r, t) local(mid, sd, br, cnt, off, dl, dr, sq, w) (
  dl = l[0]; dr = r[0];
  mid = dl + dr; sd = dl - dr;
  cnt = c[0];
  while (cnt > 1) (                              // насыщение Side
    br = abs(sd)*1.57079633; br > 1.57079633 ? br = 1.57079633;
    br = sin(br); sd = sd > 0 ? br : -br;
    cnt -= 1;
  );
  br = abs(sd)*1.57079633; br > 1.57079633 ? br = 1.57079633;
  br = sin(br);
  sd = sd > 0 ? sd*(1-cnt) + br*cnt : sd*(1-cnt) - br*cnt;
  br = abs(sd)*1.57079633; br > 1.57079633 ? br = 1.57079633;
  br = (1 - cos(br)) * 3.141592653589793;
  sd = sd > 0 ? sd*(1-c[1]) + br*c[1] : sd*(1-c[1]) - br*c[1];
  // хайпасс на Side: моно-бас
  off = 0.666666666666666 + (1 - abs(sd)) * -0.33333333333333;
  off < 0 ? off = 0; off > 1 ? off = 1;
  s[2] ? (
    s[0] = s[0]*(1 - off*c[2]) + sd*(off*c[2]); sd -= s[0];
  ) : (
    s[1] = s[1]*(1 - off*c[2]) + sd*(off*c[2]); sd -= s[1];
  );
  s[2] = 1 - s[2];
  // сжатие центра
  sq = c[3];
  sq > 0 ? (
    br = abs(mid)*1.57079633; br > 1.57079633 ? br = 1.57079633;
    br = sin(br); br = mid > 0 ? br : -br;
    mid = mid*(1-sq) + br*sq;
  );
  w = c[4];
  l[0] = w < 1 ? ((mid+sd)/2)*w + dl*(1-w) : (mid+sd)/2;
  r[0] = w < 1 ? ((mid-sd)/2)*w + dr*(1-w) : (mid-sd)/2;
);

// ═══════════════════════════════════════════════════════════════════════════
// 6. BIQUADNONLIN — «Capacitor2, but for biquad filtering».
//    Коэффициент a0 плывёт от громкости сигнала (модель диода): на тихом
//    линеен, на громком форма фильтра меняется. Два ядра — lowpass и bandpass,
//    но микс ИНВЕРСНЫЙ: отрицательный wet вычитает отфильтрованное из сухого,
//    то есть LP становится HP, а BP — режекторным. Итого четыре режима.
//    c: 0..4 новые a0 a1 a2 b1 b2, 5..9 старые, 10 nonLin, 11 wet, 12 type
//    s: 0,1 состояние
// ═══════════════════════════════════════════════════════════════════════════
function fx_biquadnl_prep(c, p1, p2, p3, mix) local(fq, rq, kt, norm, i) (
  i = 0; loop(5, c[5+i] = c[i]; i += 1; );
  fq = ((p2*p2*p2*0.9999) + 0.0001) * 0.499; fq < 0.0001 ? fq = 0.0001;
  rq = (p3*p3*p3*29.99) + 0.01;              rq < 0.0001 ? rq = 0.0001;
  kt = tan($pi * fq);
  norm = 1 / (1 + kt/rq + kt*kt);
  c[12] = p1 > 0.5 ? 1 : 0;
  c[12] ? (                                   // bandpass
    c[0] = kt/rq*norm; c[1] = 0; c[2] = -c[0];
  ) : (                                       // lowpass
    c[0] = kt*kt*norm; c[1] = 2*c[0]; c[2] = c[0];
  );
  c[3] = 2*(kt*kt - 1)*norm;
  c[4] = (1 - kt/rq + kt*kt)*norm;
  c[10] = 0.25;                               // фиксированная нелинейность
  c[11] = mix*2 - 1;                          // инв-сухой-мокрый
  c[5] == 0 ? ( i = 0; loop(5, c[5+i] = c[i]; i += 1; ); );  // первый запуск
);
function fx_biquadnl(c, s, x, t) local(dry, a0, a1, a2, b1, b2, d0, d2, tmp, w) (
  dry = x;
  a0 = fxi(c[5], c[0], t); a1 = fxi(c[6], c[1], t); a2 = fxi(c[7], c[2], t);
  b1 = fxi(c[8], c[3], t); b2 = fxi(c[9], c[4], t);
  d0 = abs(a0 * (1 + x*c[10])); d0 > 1 ? d0 = 1;
  d2 = c[12] ? -d0 : d0;                      // полосовой требует смены знака
  tmp = x*d0 + s[0];
  s[0] = x*a1 - tmp*b1 + s[1];
  s[1] = x*d2 - tmp*b2;
  x = tmp;
  w = c[11];
  x *= w;
  w > 0 ? x + dry*(1-w) : x + dry;
);

// ═══════════════════════════════════════════════════════════════════════════
// 7. CAPACITOR2 — «Capacitor with extra analog modeling and mojo».
//    Модель титаната бария: у него ёмкость падает с ростом напряжения, значит
//    частота среза дышит вместе с сигналом (dielectricScale). Шесть наборов
//    через count дают пологий спад без шести полных каскадов на отсчёт.
//    c: 0 lowChase 1 highChase 2 nonLin 3 nonLinTrim 4 wetChase
//       5 lowSpeed 6 highSpeed 7 wetSpeed 8 lastLow 9 lastHigh 10 lastWet
//    s: 0 count 1 lowBase 2 highBase 3 wet 4..9 iirLow A..F 10..15 iirHigh A..F
// ═══════════════════════════════════════════════════════════════════════════
function fx_capacitor2_prep(c, p1, p2, p3, mix) (
  c[0] = p1*p1;
  c[1] = p2*p2;
  c[2] = 1 + (1-p3)*6;
  c[3] = 1.5 / (c[2]^(1/3));
  c[4] = mix;
  c[5] = 300 / (abs(c[8] - c[0]) + 1);
  c[6] = 300 / (abs(c[9] - c[1]) + 1);
  c[7] = 300 / (abs(c[10] - c[4]) + 1);
  c[8] = c[0]; c[9] = c[1]; c[10] = c[4];
);
function fx_capacitor2(c, s, x, t)
  local(dry, ds, la, ila, ha, iha, n, hp, lp) (
  dry = x;
  ds = abs(2 - ((x + c[2]) / c[2]));           // диэлектрик дышит от сигнала
  s[1] = ((s[1]*c[5]) + c[0]) / (c[5] + 1);
  s[2] = ((s[2]*c[6]) + c[1]) / (c[6] + 1);
  s[3] = ((s[3]*c[7]) + c[4]) / (c[7] + 1);
  la = s[1]*ds; ila = 1 - la;
  ha = s[2]*ds; iha = 1 - ha;
  s[0] += 1; s[0] > 5 ? s[0] = 0;
  // Каскады по таблице Криса (switch на 6 состояний), три ступени на отсчёт:
  //   0=A,B,D  1=A,C,E  2=A,B,F  3=A,C,D  4=A,B,E  5=A,C,F
  // A на каждом отсчёте, B/C через один, D/E/F через два. Отсюда дробное
  // число полюсов, которого обычным каскадом не получить.
  n = s[0];
  // 1) каскад A — всегда
  s[10] = s[10]*iha + x*ha; x -= s[10];
  s[4]  = s[4]*ila  + x*la; x  = s[4];
  // 2) B на чётных, C на нечётных
  hp = (n == 0 || n == 2 || n == 4) ? 11 : 12;
  lp = hp - 6;
  s[hp] = s[hp]*iha + x*ha; x -= s[hp];
  s[lp] = s[lp]*ila + x*la; x  = s[lp];
  // 3) D при 0 и 3, E при 1 и 4, F при 2 и 5
  hp = (n == 0 || n == 3) ? 13 : (n == 1 || n == 4) ? 14 : 15;
  lp = hp - 6;
  s[hp] = s[hp]*iha + x*ha; x -= s[hp];
  s[lp] = s[lp]*ila + x*la; x  = s[lp];
  x *= c[3];
  s[3] < 1 ? x*s[3] + dry*(1 - s[3]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 9. VIBRATO — «vibrato, chorus, flange, and odd FM noises» в одном.
//    Блок «air» перед задержкой компенсирует верх, который срезает
//    интерполяция дробной задержки. Второй генератор модулирует скорость
//    первого — сквозная ЧМ, фаза может уйти в минус и заворачивается.
//    Буфер 16386 слов на канал ЗА пределами FXS_SZ (см. fx_need_delay).
//    c: 0 speed 1 depth 2 speedB 3 depthB 4 wet
//    s: 0 gcount 1 sweep 2 sweepB 3 flip 4 airPrev 5 airEven 6 airOdd
//       FXS_SZ.. — кольцевой буфер
// ═══════════════════════════════════════════════════════════════════════════
function fx_vibrato_prep(c, p1, p2, p3, mix) local(sp, spb) (
  sp  = (0.1 + p2)^6;
  spb = (0.1 + p3)^6;
  c[0] = sp;
  c[1] = ((p1^3) / sqrt(sp)) * 4;
  c[2] = spb;
  c[3] = (p3^3) / sqrt(spb);
  c[4] = mix*2 - 1;                       // инв-сухой-мокрый
);
function fx_vibrato(c, s, x, t, buf)
  local(dry, af, cnt, off, fr, w, a, b, d) (
  dry = x;
  // air: вернуть верх, который срежет интерполяция
  af = s[4] - x;
  s[3] ? ( s[5] += af; s[6] -= af; af = s[5]; )
       : ( s[6] += af; s[5] -= af; af = s[6]; );
  s[6] = (s[6] - (s[6] - s[5])/256) / 1.0001;
  s[5] = (s[5] - (s[5] - s[6])/256) / 1.0001;
  s[4] = x;
  x += af;
  s[3] = 1 - s[3];
  s[0] < 1 || s[0] > 8192 ? s[0] = 8192;
  cnt = s[0];
  buf[cnt + 8192] = x; buf[cnt] = x;
  off = c[1] + c[1]*sin(s[1]);
  cnt += floor(off);
  fr = off - floor(off);
  a = buf[cnt]; b = buf[cnt+1]; d = buf[cnt+2];
  x = a*(1-fr) + b + d*fr;
  x -= ((a - b) - (b - d)) / 50;          // подчистка интерполяции
  x *= 0.5;
  s[1] += c[0] + c[2]*sin(s[2])*c[3];     // сквозная ЧМ
  s[2] += c[2];
  s[1] > 6.283185307179586 ? s[1] -= 6.283185307179586;
  s[1] < 0 ? s[1] += 6.283185307179586;
  s[2] > 6.283185307179586 ? s[2] -= 6.283185307179586;
  s[0] -= 1;
  w = c[4];
  w != 1 ? x*w + dry*(1 - abs(w)) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 13. PHASENUDGE — «phase rotator/allpass filter». Коэффициент — золотое
//     сечение (Крис так и пишет: «if you see 0.6180 it's not a wild stretch
//     to wonder whether you are working with a constant»).
//     Длина линии меняется ПЛАВНО, по сэмплу за такт с усреднением соседей,
//     поэтому автоматизация не щёлкает. Выход дважды загибается косинусом —
//     отсюда мягкость на пределе вместо клипа.
//     c: 0 maxdelayTarget 1 wet | s: 0 one 1 maxdelay | буфер 1504 слова
// ═══════════════════════════════════════════════════════════════════════════
function fx_phasenudge_prep(c, p1, p2, p3, mix) (
  c[0] = floor((p1^3) * 1501);
  c[1] = mix;
);
function fx_phasenudge(c, s, x, t, buf)
  local(dry, br, ap, one, md, gr) (
  gr = 0.618033988749894848204586;        // золотое сечение
  dry = x;
  x /= 4;
  br = sin(abs(x));
  x = x > 0 ? br : -br;
  md = s[1]; one = s[0];
  abs(md - c[0]) > 1500 ? md = c[0];
  md < c[0] ? ( md += 1; buf[md] = (buf[0] + buf[md-1]) * 0.5; );
  md > c[0] ? ( md -= 1; buf[md] = (buf[0] + buf[md]) * 0.5; );
  ap = one - 1;
  ap < 0 || ap > md ? ap = md;
  x -= buf[ap] * gr;
  buf[one] = x;
  x *= gr;
  one -= 1; one < 0 || one > md ? one = md;
  x += buf[one];
  s[0] = one; s[1] = md;
  br = 1 - cos(abs(x));
  x = x > 0 ? x - br : x + br;
  x *= 4;
  c[1] < 1 ? dry*(1-c[1]) + x*c[1] : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 17. CHORUS — классический хорус Криса. Родня Vibrato: тот же блок «air»
//     перед линией задержки (интерполяция дробной задержки ест верх, air его
//     возвращает) и та же трёхточечная интерполяция с поправкой /50.
//     Отличие от Vibrato: один генератор, без сквозной ЧМ, и глубина модуляции
//     ПРИВЯЗАНА К МИКСУ — modulation = range*wet. На малом wet ходит меньше.
//     Буфер двойной: пишем в count и count+loopLimit, читаем без wrap.
//     c: 0,1 speed 2,3 range 4 wet 5 loopLimit
//     s: 0 gcount 1 sweep 2 flip 3 airPrev 4 airEven 5 airOdd
//        FXS_SZ.. — буфер 16386
// ═══════════════════════════════════════════════════════════════════════════
function fx_chorus_prep(c, p1, p2, p3, mix) local(chl) (
  c[0] = c[1]; c[2] = c[3];
  c[1] = (p1^4) * 0.001 * (srate/44100);
  chl = floor(16386 * 0.499);                  // loopLimit = 8176
  c[3] = (p2^4) * chl * 0.499;
  c[4] = mix;
  c[5] = chl;
);
function fx_chorus(c, s, x, t, buf)
  local(dry, af, wet, rng, cnt, off, fr, a, b, d) (
  dry = x;
  wet = c[4];
  // air: компенсация верха, срезаемого интерполяцией (как в Vibrato)
  af = s[3] - x;
  s[2] ? ( s[4] += af; s[5] -= af; af = s[4]; )
       : ( s[5] += af; s[4] -= af; af = s[5]; );
  s[5] = (s[5] - (s[5] - s[4])/256) / 1.0001;
  s[4] = (s[4] - (s[4] - s[5])/256) / 1.0001;
  s[3] = x;
  x += af * wet;
  s[0] < 1 || s[0] > c[5] ? s[0] = c[5];
  cnt = s[0];
  buf[cnt + c[5]] = x; buf[cnt] = x;
  s[0] -= 1;
  rng = fxi(c[2], c[3], t);
  off = rng + (rng * wet) * sin(s[1]);          // modulation = range*wet
  cnt += floor(off);
  fr = off - floor(off);
  a = buf[cnt]; b = buf[cnt+1]; d = buf[cnt+2];
  x = a*(1-fr) + b + d*fr;
  x -= ((a - b) - (b - d)) / 50;
  x *= 0.5;
  s[1] += fxi(c[0], c[1], t);
  s[1] > 6.283185307179586 ? s[1] -= 6.283185307179586;
  s[2] = 1 - s[2];
  wet < 1 ? x*wet + dry*(1-wet) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 18. FLUTTER2 — вау-флаттер магнитофона. Скорость развёртки НЕ постоянная:
//     после каждого оборота она перевыбирается случайно (nextmax 0.24..0.98),
//     поэтому детонация не звучит как ровное вибрато — она «плавает».
//     Кольцо на 1000 отсчётов, чтение с wrap, линейная интерполяция.
//     L/R расходятся сами: nextmax свой на канал.
//     c: 0,1 flutDepth 2,3 flutFreq 4 wet | s: 0 gcount 1 sweep 2 nextmax
//        FXS_SZ.. — кольцо 1002
// ═══════════════════════════════════════════════════════════════════════════
function fx_flutter2_prep(c, p1, p2, p3, mix) local(os, fd) (
  c[0] = c[1]; c[2] = c[3];
  os = srate/44100;
  fd = (p1^4) * os * 90;
  fd > 498 ? fd = 498;
  c[1] = fd;
  c[3] = (0.02 * (p2^3)) / os;
  c[4] = mix;
);
function fx_flutter2(c, s, x, t, buf)
  local(dry, fd, cnt, off, fr, w, i0, i1) (
  dry = x; w = c[4];
  s[0] < 0 || s[0] > 999 ? s[0] = 999;
  s[2] <= 0 ? s[2] = 0.61;                      // ленивая инициализация nextmax
  buf[s[0]] = x;
  cnt = s[0];
  fd = fxi(c[0], c[1], t);
  off = fd + fd * sin(s[1]);
  s[1] += s[2] * fxi(c[2], c[3], t);
  s[1] > 6.283185307179586 ? (
    s[1] -= 6.283185307179586;
    s[2] = 0.24 + rand(1) * 0.74;               // у Криса из fpd — тот же диапазон
  );
  cnt += floor(off);
  fr = off - floor(off);
  i0 = cnt   > 999 ? cnt   - 1000 : cnt;
  i1 = cnt+1 > 999 ? cnt+1 - 1000 : cnt+1;
  x = buf[i0]*(1-fr) + buf[i1]*fr;
  s[0] -= 1;
  w < 1 ? x*w + dry*(1-w) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 19. BITE — «adds bite» через ОКНО В 9 ОТСЧЁТОВ. Считает четыре разности
//     от центра окна (E) и умножает каждую на локальную кривизну — насколько
//     середина отрезка отклонилась от прямой между концами. Сумма идёт в sin()
//     и прибавляется к центру с коэффициентом 8. Итог — подчёркивание изломов
//     формы волны, а не гармоник. Gain может быть ОТРИЦАТЕЛЬНЫМ (A < 0.5) —
//     тогда изломы наоборот сглаживаются. overallscale стартует с 1.3, не с 1.
//     ВНИМАНИЕ: выход задержан на 4 отсчёта (центр окна), это в оригинале.
//     c: 0,1 gain 2,3 outgain 4 wet | s: 0..8 окно A..I (0 = самый свежий)
// ═══════════════════════════════════════════════════════════════════════════
function fx_bite_prep(c, p1, p2, p3, mix) (
  c[0] = c[1]; c[2] = c[3];
  c[1] = ((p1*2) - 1) * (1.3/44100) * srate;
  c[3] = p2;
  c[4] = mix;
);
function fx_bite(c, s, x, t)
  local(dry, g, og, ma, mb, mc, md, tg, k) (
  dry = x;
  g = fxi(c[0], c[1], t); og = fxi(c[2], c[3], t);
  k = 8; while (k > 0) ( s[k] = s[k-1]; k -= 1; );   // сдвиг окна I<-H<-...<-A
  s[0] = x;
  // s: 0=A 1=B 2=C 3=D 4=E 5=F 6=G 7=H 8=I
  ma = s[0] - s[4];
  mb = s[8] - s[4];
  mc = s[2] - s[4];
  md = s[6] - s[4];
  ma *= (((s[1] + s[2] + s[3])/3) - ((s[0] + s[4])/2)) * g;
  mb *= (((s[5] + s[6] + s[7])/3) - ((s[4] + s[8])/2)) * g;
  mc *= (s[3] - ((s[2] + s[4])/2)) * g;
  md *= (s[5] - ((s[4] + s[6])/2)) * g;
  tg = sin(ma + mb + mc + md);
  x = s[4] + tg*8;
  og != 1 ? x *= og;
  c[4] < 1 ? x*c[4] + dry*(1-c[4]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 20. CREATURE — каскад слю-ячеек: каждая ступень тянется к предыдущему
//     значению через sin(), то есть это цепочка мягких нелинейных LP.
//     Depth = число ступеней (нечётное число ступеней ИНВЕРТИРУЕТ фазу —
//     так у Криса, и это часть звука). Микс инверсный: при mix > 0.5 сухое
//     вычитается, каскад работает как резонансный хайпасс.
//     c: 0 source 1 stages 2 wet 3 dry | s: FXS_SZ.. — slew[] по ступеням
// ═══════════════════════════════════════════════════════════════════════════
function fx_creature_prep(c, p1, p2, p3, mix) local(st) (
  c[0] = 1 - (1-p1)^5;
  st = floor((p2*p2) * 32 * sqrt(srate/44100)) + 1;
  st > 100 ? st = 100;                      // граница буфера (у Криса 102)
  c[1] = st;
  c[2] = mix*2 - 1;                         // инв-сухой-мокрый
  c[3] = 2 - mix*2; c[3] > 1 ? c[3] = 1;
);
function fx_creature(c, s, x, t, slw) local(dry, src, n, k) (
  dry = x;
  src = c[0]; n = c[1];
  k = 0;
  while (k < n) (
    x = (slw[k] + sin(slw[k] - x)*0.5) * src;
    slw[k] = x * 0.5;
    k += 1;
  );
  n % 2 > 0 ? x = -x;                       // нечётное число ступеней инвертирует
  x*c[2] + dry*c[3];
);

// ═══════════════════════════════════════════════════════════════════════════
// 21. EXCITER — аурал-эксайтер, как на 4049. Полосовой выделяет верхнюю
//     середину, дальше ДВА прохода клипа: первый вычитает sin() (значит
//     отклонения от синуса отрицательны), второй берёт sin() от результата,
//     подрезая пики. Итог ВЫЧИТАЕТСЯ из полного сигнала — так работает
//     настоящий эксайтер. Финальный хардклип ±1 обязателен: пики злые.
//     Добротность фильтра растёт вместе с частотой и с количеством возбуждения
//     (biquad[1] = A + B + 0.7071).
//     Примечание: в оригинале biquad[3] (a1) НЕ ИНИЦИАЛИЗИРУЕТСЯ и остаётся
//     нулём — полосовой у Криса именно такой. Повторяем: a1 = 0.
//     c: 0..4 a0 a1 a2 b1 b2 (новые) 5..9 старые 10,11 boost 12 wet
//     s: 0,1 состояние биквада
// ═══════════════════════════════════════════════════════════════════════════
function fx_exciter_prep(c, p1, p2, p3, mix) local(fq, rq, kt, norm, i) (
  i = 0; loop(5, c[5+i] = c[i]; i += 1; );
  c[10] = c[11];
  fq = ((p1*7000) + 8000) / srate;
  rq = p1 + p2 + 0.7071;
  kt = tan($pi * fq);
  norm = 1 / (1 + kt/rq + kt*kt);
  c[0] = kt / 0.7071 * norm;                // a0
  c[1] = 0;                                 // a1 — у Криса не задан, значит 0
  c[2] = -c[0];                             // a2
  c[3] = 2 * (kt*kt - 1) * norm;            // b1
  c[4] = (1 - kt/rq + kt*kt) * norm;        // b2
  c[11] = (p2*p2) * 16;
  c[12] = mix;
  c[5] == 0 && c[6] == 0 && c[7] == 0 ? ( i = 0; loop(5, c[5+i] = c[i]; i += 1; ); );
);
function fx_exciter(c, s, x, t)
  local(dry, a0, a1, a2, b1, b2, bst, o) (
  dry = x;
  a0 = fxi(c[5], c[0], t); a1 = fxi(c[6], c[1], t); a2 = fxi(c[7], c[2], t);
  b1 = fxi(c[8], c[3], t); b2 = fxi(c[9], c[4], t);
  bst = fxi(c[10], c[11], t);
  o = x*a0 + s[0];
  s[0] = x*a1 - o*b1 + s[1];
  s[1] = x*a2 - o*b2;
  o *= bst;
  o > $pi ? o = $pi; o < -$pi ? o = -$pi;
  o -= sin(o);                              // артефакты получаются отрицательными
  o *= bst;
  o > $pi ? o = $pi; o < -$pi ? o = -$pi;
  o = sin(o);                               // подрезаем пики артефактов
  x -= o;
  x > 1 ? x = 1; x < -1 ? x = -1;           // самый грубый хардклип — так задумано
  c[12] < 1 ? x*c[12] + dry*(1-c[12]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 22. HULL — фильтр по «скользящей средней Халла»: длинное среднее,
//     короткое среднее, потом short + (short - long) — это ОПЕРЕЖАЮЩЕЕ
//     сглаживание, у него почти нет задержки группы. Результат ещё раз
//     усредняется по sqrt-окну. Bright — инв-сухой-мокрый: 0.5 = чисто,
//     вниз = тёмный (пропускаем сглаженное), вверх = яркий (вычитаем его).
//     overallscale считается от 96 кГц и ЗАЖАТ единицей — на 192 кГц глубина
//     усреднения не растёт, а упирается в потолок (так у Криса).
//     c: 0 limitA 1 divA 2 limitB 3 divB 4 limitC 5 divC 6 wet
//     s: 0 bPointer 1 cPointer | буфер: [0..4004] длинный, [4005..4109] короткий
// ═══════════════════════════════════════════════════════════════════════════
function fx_hull_prep(c, p1, p2, p3, mix) local(os, hs, la, lb, lc) (
  os = srate/96000; os > 1 ? os = 1;
  hs = (p1^3) * os;
  la = floor(hs*2000) + 1;
  lb = floor(hs*1000) + 1;
  lc = floor(sqrt(hs*2000)) + 1;
  c[0] = la; c[1] = 1/la;
  c[2] = lb; c[3] = 1/lb;
  c[4] = lc; c[5] = 1/lc;
  c[6] = -((p2*2) - 1);                     // инв-сухой-мокрый, тёмный/яркий
  c[7] = mix;
);
function fx_hull(c, s, x, t, buf)
  local(dry, bp, cp, k, lim, lng, srt, sst, w, cb, o) (
  dry = x;
  cb = buf + 4005;                          // короткое кольцо со смещением
  s[0] -= 1; s[0] < 0 ? s[0] += 2000;
  bp = s[0];
  buf[bp] = x; buf[bp + 2000] = x;
  lng = 0; srt = 0;
  k = bp; lim = bp + c[2];
  while (k < lim) ( srt += buf[k]; lng += buf[k]; k += 1; );
  lim = bp + c[0];
  while (k < lim) ( lng += buf[k]; k += 1; );
  lng *= c[1]; srt *= c[3];
  s[1] -= 1; s[1] < 0 ? s[1] += 50;
  cp = s[1];
  o = srt + (srt - lng);                    // опережающее сглаживание Халла
  cb[cp] = o; cb[cp + 50] = o;
  sst = 0;
  k = cp; lim = cp + c[4];
  while (k < lim) ( sst += cb[k]; k += 1; );
  sst *= c[5];
  w = c[6];
  x = w > 0 ? sst*w + dry*(1-w)             // тёмный
            : (x - sst)*abs(w) + dry*(1+w); // яркий
  c[7] < 1 ? x*c[7] + dry*(1-c[7]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// 23. SWEETWIDE — СТЕРЕО-СВЯЗАН. Ширина через ту же свёртку sqrt(), что и
//     RingModulator, только вместо синуса второй канал: L «прокатывается»
//     через R и наоборот. Un/Wide 0.5 = чисто, вверх = шире (blend < 0,
//     свёрнутое вычитается), вниз = уже. Soar восстанавливает плотность.
//     Знак берётся от СВОЕГО канала, величина — от свёртки с чужим.
//     c: 0 soar 1 blend 2 wet | без состояния
// ═══════════════════════════════════════════════════════════════════════════
function fx_sweetwide_prep(c, p1, p2, p3, mix) (
  c[0] = 0.3 - p1*0.3;
  c[1] = -(p2 - 0.5);
  c[2] = mix;
);
function fx_sweetwide_st(c, s, l, r, t)
  local(dry, dl, dr, sr_, il, ir, ol, or_, bl, w) (
  dl = l[0]; dr = r[0];
  sr_ = c[0]; bl = c[1]; w = c[2];
  il = abs(dl) + sr_*sr_;
  ir = abs(dr) + sr_*sr_;
  ol = 0; or_ = 0;
  dl > 0 ? ( ol = sqrt(ir/il)*il - sr_;  ol < 0 ? ol = 0; );
  dl < 0 ? ( ol = -sqrt(ir/il)*il + sr_; ol > 0 ? ol = 0; );
  dr > 0 ? ( or_ = sqrt(il/ir)*ir - sr_;  or_ < 0 ? or_ = 0; );
  dr < 0 ? ( or_ = -sqrt(il/ir)*ir + sr_; or_ > 0 ? or_ = 0; );
  dry = ol*bl + dl*(1-bl);
  l[0] = w < 1 ? dry*w + dl*(1-w) : dry;
  dry = or_*bl + dr*(1-bl);
  r[0] = w < 1 ? dry*w + dr*(1-w) : dry;
);

// ═══════════════════════════════════════════════════════════════════════════
// 24. SOFTGATE — СТЕРЕО-СВЯЗАН: гейт ОДИН на пару, иначе образ разъезжается.
//     Триггерит не уровень, а СКОРОСТЬ изменения (diff): есть движение —
//     гейт открыт (1.1), нет — закрывается по recovery, и тогда выход
//     подменяется «замороженным» отсчётом с ослабленной разностью. Отсюда
//     не тишина, а потемнение: Darken. Silence (baseline) — пол, ниже
//     которого гейт не падает, то есть остаточный «воздух».
//     c: 0 threshold 1 recovery 2 baseline 3 invrec 4 wet
//     s: 0 gate 1 storedL0 2 storedL1 3 storedR0 4 storedR1
// ═══════════════════════════════════════════════════════════════════════════
function fx_softgate_prep(c, p1, p2, p3, mix) local(rc) (
  c[0] = p1^6;
  rc = ((p2*0.5)^6) / (srate/44100);
  c[1] = rc;
  c[2] = p3^6;
  c[3] = 1 - rc;
  c[4] = mix;
);
function fx_softgate_st(c, s, l, r, t)
  local(dl, dr, dfl, dfr, th, rc, bs, ir, g, w) (
  dl = l[0]; dr = r[0];
  th = c[0]; rc = c[1]; bs = c[2]; ir = c[3]; w = c[4];
  s[2] = s[1]; s[1] = dl; dfl = s[1] - s[2];
  s[4] = s[3]; s[3] = dr; dfr = s[3] - s[4];
  g = s[0];
  g > 0 ? g = ((g - bs) * ir) + bs;
  abs(dfr) > th || abs(dfl) > th ? g = 1.1 : (
    g = g * ir;
    th > 0 ? ( g += (abs(dl)/th) * rc; g += (abs(dr)/th) * rc; );
  );
  g < 0 ? g = 0;
  g < 1 ? ( s[1] = s[2] + dfl*g; s[3] = s[4] + dfr*g; );
  s[0] = g;
  g < 1 ? (
    l[0] = dl*g + s[1]*(1-g);
    r[0] = dr*g + s[3]*(1-g);
  );
  w < 1 ? (
    l[0] = l[0]*w + dl*(1-w);
    r[0] = r[0]*w + dr*(1-w);
  );
);

// ═══════════════════════════════════════════════════════════════════════════
// ── ДИСПЕТЧЕР ──────────────────────────────────────────────────────────────
// Вызывающий держит: c[] = FXC_SZ на слот, s[] = FXS_SZ+хвост на слот НА КАНАЛ.
// ═══════════════════════════════════════════════════════════════════════════

// стерео-связанные эффекты (детектор или M/S общий на пару)
function fx_is_stereo(id) (
  id == FX_PRESSURE6 || id == FX_STEREOFX ||
  id == FX_SWEETWIDE || id == FX_SOFTGATE
);

// раз на блок
function fx_prep(id, c, p1, p2, p3, mix) (
  id == FX_HYPERSOFT  ? fx_hypersoft_prep(c, p1, p2, p3, mix) :
  id == FX_SQROOT     ? fx_sqroot_prep(c, p1, p2, p3, mix) :
  id == FX_FRACTURE2  ? fx_fracture2_prep(c, p1, p2, p3, mix) :
  id == FX_FACET      ? fx_facet_prep(c, p1, p2, p3, mix) :
  id == FX_KALMAN     ? fx_kalman_prep(c, p1, p2, p3, mix) :
  id == FX_BIQUADNL   ? fx_biquadnl_prep(c, p1, p2, p3, mix) :
  id == FX_CAPACITOR2 ? fx_capacitor2_prep(c, p1, p2, p3, mix) :
  id == FX_EROSION    ? fx_erosion_prep(c, p1, p2, p3, mix) :
  id == FX_RINGMOD    ? fx_ringmod_prep(c, p1, p2, p3, mix) :
  id == FX_VIBRATO    ? fx_vibrato_prep(c, p1, p2, p3, mix) :
  id == FX_TREMOSQ    ? fx_tremosq_prep(c, p1, p2, p3, mix) :
  id == FX_PRESSURE6  ? fx_pressure6_prep(c, p1, p2, p3, mix) :
  id == FX_POINT      ? fx_point_prep(c, p1, p2, p3, mix) :
  id == FX_PHASENUDGE ? fx_phasenudge_prep(c, p1, p2, p3, mix) :
  id == FX_DEREZ3     ? fx_derez3_prep(c, p1, p2, p3, mix) :
  id == FX_TAPEDUST   ? fx_tapedust_prep(c, p1, p2, p3, mix) :
  id == FX_STEREOFX   ? fx_stereofx_prep(c, p1, p2, p3, mix) :
  id == FX_CHORUS     ? fx_chorus_prep(c, p1, p2, p3, mix) :
  id == FX_FLUTTER2   ? fx_flutter2_prep(c, p1, p2, p3, mix) :
  id == FX_BITE       ? fx_bite_prep(c, p1, p2, p3, mix) :
  id == FX_CREATURE   ? fx_creature_prep(c, p1, p2, p3, mix) :
  id == FX_EXCITER    ? fx_exciter_prep(c, p1, p2, p3, mix) :
  id == FX_HULL       ? fx_hull_prep(c, p1, p2, p3, mix) :
  id == FX_SWEETWIDE  ? fx_sweetwide_prep(c, p1, p2, p3, mix) :
  id == FX_SOFTGATE   ? fx_softgate_prep(c, p1, p2, p3, mix) : 0;
);

// один сэмпл одного канала. ch: 0 левый, 1 правый (нужно только RingModulator).
// Для стерео-связанных (fx_is_stereo) НЕ вызывать — звать fx_run_st.
function fx_run(id, c, s, x, t, ch) (
  id == FX_HYPERSOFT  ? fx_hypersoft(c, s, x, t) :
  id == FX_SQROOT     ? fx_sqroot(c, s, x, t) :
  id == FX_FRACTURE2  ? fx_fracture2(c, s, x, t) :
  id == FX_FACET      ? fx_facet(c, s, x, t) :
  id == FX_KALMAN     ? fx_kalman(c, s, x, t) :
  id == FX_BIQUADNL   ? fx_biquadnl(c, s, x, t) :
  id == FX_CAPACITOR2 ? fx_capacitor2(c, s, x, t) :
  id == FX_EROSION    ? fx_erosion(c, s, x, t) :
  id == FX_RINGMOD    ? fx_ringmod(c, s, x, t, ch) :
  id == FX_VIBRATO    ? fx_vibrato(c, s, x, t, s + FXS_SZ) :
  id == FX_TREMOSQ    ? fx_tremosq(c, s, x, t) :
  id == FX_POINT      ? fx_point(c, s, x, t) :
  id == FX_PHASENUDGE ? fx_phasenudge(c, s, x, t, s + FXS_SZ) :
  id == FX_DEREZ3     ? fx_derez3(c, s, x, t) :
  id == FX_TAPEDUST   ? fx_tapedust(c, s, x, t) :
  id == FX_CHORUS     ? fx_chorus(c, s, x, t, s + FXS_SZ) :
  id == FX_FLUTTER2   ? fx_flutter2(c, s, x, t, s + FXS_SZ) :
  id == FX_BITE       ? fx_bite(c, s, x, t) :
  id == FX_CREATURE   ? fx_creature(c, s, x, t, s + FXS_SZ) :
  id == FX_EXCITER    ? fx_exciter(c, s, x, t) :
  id == FX_HULL       ? fx_hull(c, s, x, t, s + FXS_SZ) : x;
);

// стерео-связанные: l и r — указатели, результат пишется на месте
function fx_run_st(id, c, s, l, r, t) (
  id == FX_PRESSURE6 ? fx_pressure6_st(c, s, l, r, t) :
  id == FX_STEREOFX  ? fx_stereofx_st(c, s, l, r, t) :
  id == FX_SWEETWIDE ? fx_sweetwide_st(c, s, l, r, t) :
  id == FX_SOFTGATE  ? fx_softgate_st(c, s, l, r, t) : 0;
);

// обнулить состояние слота при смене эффекта — ОБЯЗАТЕЛЬНО, иначе мусор
// от прошлого эффекта прочитается как звук (у Vibrato — как громкий щелчок).
function fx_clear(id, s) local(n) (
  n = FXS_SZ + fx_need_delay(id);
  memset(s, 0, n);
);

// ═══════════════════════════════════════════════════════════════════════════
// ── МАСТЕР-СЛОТЫ ───────────────────────────────────────────────────────────
// Общие на инструмент, не per-slice. Порядок в цепи имеет значение:
// ClipOnly2 ВСЕГДА последним — он работает по мгновенной амплитуде, и любое
// расширение стерео после него снова выбросит пики за 0 dBFS.
// ═══════════════════════════════════════════════════════════════════════════
FXM_NONE      = 0;
FXM_BUTTERCOMP = 1;   // клей          Compress
FXM_BAXANDALL2 = 2;   // тон           Treble  Bass
FXM_WIDER      = 3;   // ширина        Width   Center
FXM_CLIPONLY2  = 4;   // лимитер       (без параметров)
FXM_COUNT      = 5;

// ═══════════════════════════════════════════════════════════════════════════
// M1. BUTTERCOMP — «my softest, smoothest compressor».
//     Положительная и отрицательная полуволны сжимаются ОТДЕЛЬНО, четыре
//     независимые огибающие вместо одной. Асимметричный сигнал (вокал, малый)
//     обрабатывается естественнее — каждая полуволна со своим коэффициентом.
//     c: 0 inputgain 1 outputgain 2 divisor 3 remainder 4 wet
//     s: 0 ctlPos 1 ctlNeg 2 targetPos 3 targetNeg
// ═══════════════════════════════════════════════════════════════════════════
function fx_buttercomp_prep(c, p1, p2, p3, mix) local(ig, dv) (
  ig = 10^((p1*14)/20);
  c[0] = ig;
  c[1] = (ig - 1)/1.5 + 1;
  dv = 0.012 * (p1/135) / (srate/44100);
  // защита: при p1 = 0 делитель нулевой и 1/target уходит в бесконечность.
  // У Криса этого нет — там при нуле эффект и так обходится, у нас гарантии нет.
  dv < 0.0000001 ? dv = 0.0000001;
  c[3] = dv;
  c[2] = 1 - dv;
  c[4] = mix;
);
function fx_buttercomp(c, s, x, t)
  local(dry, ip, inn, op, on, cp, cn, m) (
  dry = x;
  s[2] <= 0 ? ( s[2] = 1; s[3] = 1; s[0] = 1; s[1] = 1; );
  x *= c[0];
  ip = x + 1; ip < 0 ? ip = 0;
  op = ip * 0.5; op > 1 ? op = 1;
  ip *= ip;
  s[2] = s[2]*c[2] + ip*c[3];
  cp = (1/s[2])^2;
  inn = -x + 1; inn < 0 ? inn = 0;
  on = inn * 0.5; on > 1 ? on = 1;
  inn *= inn;
  s[3] = s[3]*c[2] + inn*c[3];
  cn = (1/s[3])^2;
  x > 0 ? ( s[0] = s[0]*c[2] + cp*c[3]; )
        : ( s[1] = s[1]*c[2] + cn*c[3]; );
  m = s[0]*op + s[1]*on;
  x *= m;
  x /= c[1];
  c[4] < 1 ? x*c[4] + dry*(1-c[4]) : x;
);

// ═══════════════════════════════════════════════════════════════════════════
// M2. BAXANDALL2 — пассивный шельф. Хитрость: частота баса ОБРАТНА усилению
//     (bassFreq = 10^(-дБ/20)), поэтому подъём баса заодно опускает точку
//     перегиба — так ведёт себя настоящая схема Баксандалла.
//     c: 0 trebleGain 1 bassGain 2..6 коэф. ВЧ 7..11 коэф. НЧ 12 wet
//     s: 0 flip 1..4 состояние ВЧ (A,B) 5..8 состояние НЧ (A,B)
// ═══════════════════════════════════════════════════════════════════════════
function fx_baxandall2_prep(c, p1, p2, p3, mix) local(tf, bf, kt, norm) (
  // Частота ВЧ растёт вместе с усилением, частота НЧ — ОБРАТНА ему.
  // Поднимая бас, опускаешь точку перегиба; так ведёт себя настоящая
  // пассивная схема Баксандалла, отсюда её естественность.
  // Добротности разные: 0.4 у верха, 0.2 у низа. Свои множители НЕ добавлять.
  c[0] = 10^((p1*48 - 24)/20);                       // trebleGain
  tf = (4410 * c[0]) / srate;
  tf > 0.45 ? tf = 0.45;
  c[1] = 10^((p2*48 - 24)/20);                       // bassGain
  bf = (8820 * 10^(-(p2*48 - 24)/20)) / srate;
  bf > 0.45 ? bf = 0.45;
  kt = tan($pi * tf); norm = 1 / (1 + kt/0.4 + kt*kt);
  c[2] = kt*kt*norm; c[3] = 2*c[2]; c[4] = c[2];
  c[5] = 2*(kt*kt - 1)*norm; c[6] = (1 - kt/0.4 + kt*kt)*norm;
  kt = tan($pi * bf); norm = 1 / (1 + kt/0.2 + kt*kt);
  c[7] = kt*kt*norm; c[8] = 2*c[7]; c[9] = c[7];
  c[10] = 2*(kt*kt - 1)*norm; c[11] = (1 - kt/0.2 + kt*kt)*norm;
  c[12] = mix;
);
function fx_baxandall2(c, s, x, t) local(dry, tr, bs, o, i) (
  dry = x;
  i = s[0] ? 1 : 3;                        // два набора через такт
  tr = x*c[2] + s[i];
  s[i]   = x*c[3] - tr*c[5] + s[i+1];
  s[i+1] = x*c[4] - tr*c[6];
  tr = x - tr;                             // highpass через вычитание
  i = s[0] ? 5 : 7;
  bs = x*c[7] + s[i];
  s[i]   = x*c[8] - bs*c[10] + s[i+1];
  s[i+1] = x*c[9] - bs*c[11];
  s[0] = 1 - s[0];
  o = tr*c[0] + bs*c[1];
  c[12] < 1 ? o*c[12] + dry*(1-c[12]) : o;
);

// ═══════════════════════════════════════════════════════════════════════════
// M3. WIDER — СТЕРЕО-СВЯЗАН. Не растягивает, а по-разному насыщает Mid и Side
//     и сдвигает ОДИН из них относительно другого на доли отсчёта. Что именно
//     задерживается — зависит от знака смещения: если бока насыщены сильнее
//     середины, задерживается середина, иначе бока. Отсюда ощущение ширины,
//     а не просто разный уровень. Center отдельно от Width, поэтому низ можно
//     оставить в центре при широком верхе.
//     c: 0 densityside 1 densitymid 2 wet 3 offset 4 near 5 far
//        6 nearLevel 7 farLevel
//     s: 0 count, буфер 4098 слов с FXS_SZ
// ═══════════════════════════════════════════════════════════════════════════
function fx_wider_prep(c, p1, p2, p3, mix) local(off, nr) (
  c[0] = p1*2 - 1;                         // densityside
  c[1] = p2*2 - 1;                         // densitymid
  c[2] = mix * 0.5;                        // M/S удваивает — делим заранее
  off = (c[0] - c[1]) * 0.5;
  off = off > 0 ? sin(off) : off < 0 ? -sin(-off) : 0;
  off = -((off^4) * 20 * (srate/44100));
  c[3] = off;
  nr = floor(abs(off));
  c[4] = nr;                               // near
  c[5] = nr + 1;                           // far
  c[7] = abs(off) - nr;                    // farLevel
  c[6] = 1 - c[7];                         // nearLevel
);
function fx_wider_st(c, s, l, r, t)
  local(mid, sd, dl, dr, o, br, w, cnt, buf) (
  buf = s + 1;
  dl = l[0]; dr = r[0];
  mid = dl + dr; sd = dl - dr;
  // насыщение Side: положительная плотность через sin, отрицательная через 1-cos
  c[0] != 0 ? (
    o = abs(c[0]);
    br = abs(sd)*1.57079633; br > 1.57079633 ? br = 1.57079633;
    br = c[0] > 0 ? sin(br) : 1 - cos(br);
    sd = sd > 0 ? sd*(1-o) + br*o : sd*(1-o) - br*o;
  );
  c[1] != 0 ? (
    o = abs(c[1]);
    br = abs(mid)*1.57079633; br > 1.57079633 ? br = 1.57079633;
    br = c[1] > 0 ? sin(br) : 1 - cos(br);
    mid = mid > 0 ? mid*(1-o) + br*o : mid*(1-o) - br*o;
  );
  s[0] < 1 || s[0] > 2048 ? s[0] = 2048;
  cnt = s[0];
  // задерживаем ТО, ЧТО насыщено слабее: знак смещения решает, что именно
  c[3] > 0 ? (
    buf[cnt + 2048] = mid; buf[cnt] = mid;
    mid = buf[cnt + c[4]]*c[6] + buf[cnt + c[5]]*c[7];
  ) : c[3] < 0 ? (
    buf[cnt + 2048] = sd; buf[cnt] = sd;
    sd = buf[cnt + c[4]]*c[6] + buf[cnt + c[5]]*c[7];
  );
  s[0] -= 1;
  // ВНИМАНИЕ: wet уже поделён пополам в prep, а сухой множится на (1 - wet),
  // НЕ на (1 - wet*2). При полном миксе сухого остаётся половина — так у Криса.
  w = c[2];
  l[0] = dl*(1 - w) + (mid + sd)*w;
  r[0] = dr*(1 - w) + (mid - sd)*w;
);

// ═══════════════════════════════════════════════════════════════════════════
// M4. CLIPONLY2 — «suppresses the brightness of digital clipping without
//     affecting unclipped samples, at any sample rate». Без параметров.
//     Не срезает: при выходе за порог СЛЕДУЮЩИЙ отсчёт смешивается с
//     предыдущим по коэффициентам из уравнения x = cos(x) (корень 0.7390851).
//     Задержка — один отсчёт при 44.1 кГц. СТРОГО ПОСЛЕДНИМ в цепи.
//     c: 0 spacing | s: 0 last 1 wasPos 2 wasNeg 3..19 буфер
// ═══════════════════════════════════════════════════════════════════════════
function fx_cliponly2_prep(c, p1, p2, p3, mix) local(sp) (
  sp = floor(srate/44100); sp < 1 ? sp = 1; sp > 16 ? sp = 16;
  c[0] = sp;
);
function fx_cliponly2(c, s, x, t) local(sp, k, b) (
  sp = c[0]; b = s + 3;
  x > 4 ? x = 4; x < -4 ? x = -4;
  s[1] ? (
    x < s[0] ? s[0] = 0.7058208 + x*0.2609148
             : s[0] = 0.2491717 + s[0]*0.7390851;
  );
  s[1] = 0;
  x > 0.9549925859 ? ( s[1] = 1; x = 0.7058208 + s[0]*0.2609148; );
  s[2] ? (
    x > s[0] ? s[0] = -0.7058208 + x*0.2609148
             : s[0] = -0.2491717 + s[0]*0.7390851;
  );
  s[2] = 0;
  x < -0.9549925859 ? ( s[2] = 1; x = -0.7058208 + s[0]*0.2609148; );
  b[sp] = x;
  x = s[0];
  k = sp; while (k > 0) ( b[k-1] = b[k]; k -= 1; );
  s[0] = b[0];
  x;
);

// мастер-диспетчеры
function fxm_is_stereo(id) ( id == FXM_WIDER );
function fxm_need_delay(id) ( id == FXM_WIDER ? 4100 : 0 );  // 2048 + зеркало
function fxm_prep(id, c, p1, p2, p3, mix) (
  id == FXM_BUTTERCOMP ? fx_buttercomp_prep(c, p1, p2, p3, mix) :
  id == FXM_BAXANDALL2 ? fx_baxandall2_prep(c, p1, p2, p3, mix) :
  id == FXM_WIDER      ? fx_wider_prep(c, p1, p2, p3, mix) :
  id == FXM_CLIPONLY2  ? fx_cliponly2_prep(c, p1, p2, p3, mix) : 0;
);
function fxm_run(id, c, s, x, t) (
  id == FXM_BUTTERCOMP ? fx_buttercomp(c, s, x, t) :
  id == FXM_BAXANDALL2 ? fx_baxandall2(c, s, x, t) :
  id == FXM_CLIPONLY2  ? fx_cliponly2(c, s, x, t) : x;
);
function fxm_run_st(id, c, s, l, r, t) (
  id == FXM_WIDER ? fx_wider_st(c, s, l, r, t) : 0;
);
