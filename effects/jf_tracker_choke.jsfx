slider118:0<0,16,1>-note 117 group
slider119:0<0,16,1>-note 118 group
slider120:0<0,16,1>-note 119 group
slider121:0<0,16,1>-note 120 group
slider122:0<0,16,1>-note 121 group
slider123:0<0,16,1>-note 122 group
slider124:0<0,16,1>-note 123 group
slider125:0<0,16,1>-note 124 group
slider126:0<0,16,1>-note 125 group
slider127:0<0,16,1>-note 126 group
slider128:0<0,16,1>-note 127 group

in_pin:none
out_pin:none

@init
cur = 0; curch = 32;
i = 0; loop(17, cur[i] = -1; curch[i] = 0; i += 1);

@block
while (midirecv(ofs, m1, m2, m3)) (
  pass = 1;
  st = m1 & 0xF0; ch = m1 & 0x0F;
  (st == 0x90 || st == 0x80) ? (
    g = slider(m2 + 1) | 0;
    g > 0 ? (
      st == 0x90 && m3 > 0 ? (
        cur[g] >= 0 ? midisend(ofs, 0x80 | curch[g], cur[g], 0);
        cur[g] = m2; curch[g] = ch;
      ) : (
        pass = 0;
      );
    );
  );
  pass ? midisend(ofs, m1, m2, m3);
);
