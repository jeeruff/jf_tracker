slider248:0<0,16,1>-note 119 group
slider249:0<0,16,1>-note 120 group
slider250:0<0,16,1>-note 121 group
slider251:0<0,16,1>-note 122 group
slider252:0<0,16,1>-note 123 group
slider253:0<0,16,1>-note 124 group
slider254:0<0,16,1>-note 125 group
slider255:0<0,16,1>-note 126 group
slider256:0<0,16,1>-note 127 group

in_pin:none
out_pin:none

@init
cur = 0; curch = 32; held = 64;
i = 0; loop(17, cur[i] = -1; curch[i] = 0; i += 1);
i = 0; loop(128, held[i] = 0; i += 1);

function hit(ofs, ch, n, v) local(c) (
  c = slider(n + 1) | 0;
  c > 0 ? (
    cur[c] >= 0 ? midisend(ofs, 0x80 | curch[c], cur[c], 0);
    cur[c] = n; curch[c] = ch;
  );
  midisend(ofs, 0x90 | ch, n, v);
);
function release(ofs, ch, n) (
  (slider(n + 1) | 0) == 0 ? midisend(ofs, 0x80 | ch, n, 0);   // в choke-группе нота-офф глушится
);

@block
while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & 0xF0; ch = m1 & 0x0F;
  st == 0x90 && m3 > 0 ? (
    g = slider(m2 + 129) | 0;
    g > 0 ? (
      k = 0; loop(128, (slider(k + 129) | 0) == g ? hit(ofs, ch, k, m3); k += 1);
    ) : hit(ofs, ch, m2, m3);
  ) : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    g = slider(m2 + 129) | 0;
    g > 0 ? (
      k = 0; loop(128, (slider(k + 129) | 0) == g ? release(ofs, ch, k); k += 1);
    ) : release(ofs, ch, m2);
  ) : midisend(ofs, m1, m2, m3);
);
