        // даёт ту самую «глитчевость» — ступеньки вместо сглаживания.
        wl_y = floor(wmid - (pmx + pmn) * 0.5 * (WH/2 - 2));
        cx > 0 ? (
          gfx_set(1, 1, 1, 1);
          gfx_line(WX+cx-1, wl_prev, WX+cx, wl_y);
