desc:jf_slixer - transient slicer / pad sampler, A|B fx paths
//tags: sampler slicer drums
//author: jeeruff
//
// КАК УСТРОЕНО (коротко, 13 сен):
//   ОКНО   SAMPLE: rec/arm/load/item · SLICE: detect/mode/classify/gate/MIDI/names
//          волна + пэды · зона SLICE (pitch gain pan mode class choke, STR, bus/MIDI)
//          зона FX (all/sel, мастер M1 M2, FX MIX, FX D/W, фейдер A|B, 8 слотов:
//          A = filt sat crush comp, B = ring fold bite dust) · зона PLAY
//          (chrom/piano/class, tala, Q, tsync, sync, out, keys + поля голоса)
//          самый низ: 8 слотов быстрой загрузки с мини-волнами
//   КЛАВИШИ (CLASS): белая = свой класс, ЧЁРНАЯ = тот же срез РЕВЕРСОМ.
//          Октавой выше: белая = луп с этого удара, чёрная = скорость арпа.
//   GRID   ряды 1-4 = 64 среза (tsync выкл: играть; вкл: прыжок плейхеда по Q)
//          ряд 5 = 4 слота ×4 кнопки, держать = эффект на полную
//          ряд 6 = tsync · Q · LOOP · all/sel · … · arc-страница (ряды 7-8 пусты)
//   ARC    стр.1 start pitch speed filter · стр.2 length reso gain pan
//          стр.3 amount слотов A · стр.4 p2 слотов A; кнопка 1 = GRID/модуль
//   LOOP   срез крутится, пока пэд зажат (rev → назад, PP → туда-сюда);
//          TSYNC = луп идёт насквозь по таймлайну, пэд = прыжок
//   ЗВУК   срез → filt → sat → crush → comp → M1 → M2 → M3 → M4
//          перф-эффекты stretch/fm/stutter/glitch — банк B, вне слотов

// Filter and distortion algorithms adapted from Filther by Joep Vanlier (Saike),
// which is MIT licensed:
//
//   Copyright (C) 2019 Joep Vanlier
//
//   Permission is hereby granted, free of charge, to any person obtaining a copy
//   of this software and associated documentation files (the "Software"), to deal
//   in the Software without restriction, including without limitation the rights
//   to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
//   copies of the Software, and to permit persons to whom the Software is
//   furnished to do so, subject to the following conditions:
//
//   The above copyright notice and this permission notice shall be included in
//   all copies or substantial portions of the Software.
//
//   THE SOFTWARE IS PROVIDED "as is", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
//   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
//   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
//   AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
//   LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
//   OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
//   SOFTWARE.
//
// Taken from it: the Karlsen ladder filter (originally by Ove Hy Karlsen) used
// for the FILT slot, and the fasttanh / tanh / sine-fold saturation shapes used
// by the SAT and FOLD slots.
//
// The YN and ZN filter types and the spiral/density drive shapes are adapted
// from Airwindows plugins (YNotch, ZNotch, Spiral, Density) by Chris Johnson,
// MIT licensed -- Copyright (c) 2016-2024 Chris Johnson / Airwindows.
// Simplified for per-voice use: YN keeps the notch biquad with the pow-warp
// encode/decode around it, ZN keeps the clip -> trim -> notch -> x-x^5*0.1768
// chain with one biquad standing in for the four cascaded stages.

// ПАМЯТЬ СЧИТАЕТСЯ ОТ ДЛИНЫ ДЕКИ (25 окт), приём из jf_rec.jsfx: раньше тут
// стояло maxmem=33554432 — 256 МБ на КАЖДЫЙ экземпляр, из которых сам
// инструмент (64 среза x 163 поля, 16 голосов, таблицы) занимал меньше 4 МБ,
// а остальное была дека на 340 секунд. При «один slixer на трек» 16 треков
// просили бы 4 ГБ. Одной правки DECKW было бы НЕДОСТАТОЧНО: REAPER выделяет
// ровно по maxmem, независимо от того, сколько памяти код трогает.
// DECK_SECS секунд при 48 кГц; файл с другим рейтом ложится в деку в СВОЁМ
// рейте (dk_srate), поэтому 96 кГц влезет на 8 секунд, 44.1 — на 17.4.
// Слагаемые: 147106 всё до деки (таблицы, голоса, scratch, обзорные бины)
// + дека + 16 хвост мастер-цепи (FXSTW; блок слотов Airwindows на 131456
// слов ушёл 25 окт вместе со слотами) + 65536 запас. ПРИ ПРАВКЕ КАРТЫ
// ПАМЯТИ ПЕРЕСЧИТАТЬ ЗДЕСЬ ЖЕ — иначе константы разойдутся с выделенной
// памятью молча.
options:maxmem=<? printf("%d", 147106 + 16*48000*2 + 16 + 65536) ?>
options:gmem=jf_slixer

// Slider numbers are the project's storage keys, so retired ones (14, 16 -- the
// old deck B base note and MIDI channel) are left unused rather than reassigned.
slider1:sens=0.50<0.05,1,0.01>-Transient sensitivity
slider2:basenote_a=48<0,127,1>-Base note
slider3:monomode=1<0,1,1{Poly,Mono}>-Voice mode
slider4:legato=0<0,1,1{Off,On}>-Legato
slider5:glide_ms=0<0,500,1>-Glide (ms)
slider6:interp=2<0,2,1{None,Linear,Hermite}>-Interpolation
slider7:gatemode=1<0,1,1{One-shot,Gate}>-Trigger mode
slider8:mgain_db=0<-24,12,0.1>Master gain (dB)
// slider9 (caplen, Max capture) на пенсии с 25 окт — записи со входа нет.
// Номер не переиспользуется: номера слайдеров — ключи хранения в проектах.
slider10:saveaudio=1<0,1,1{No,Yes}>Save audio in project
slider11:thru=1<0,1,1{Off,On}>Input passthrough
// xfade оставлен МЁРТВЫМ: удаление слайдера сдвинуло бы номера всех
// последующих и сломало сохранённые настройки в старых проектах.
slider12:xfade=0<0,1,0.001>-(unused)
slider13:outmode=0<0,2,1{Mix on 1/2,Class buses 3-14,Slice per channel 1-64}>-Output routing
slider14:sloop=0<0,1,1{Off,On}>-LOOP: slice repeats while the pad is held
slider15:mcha=0<0,16,1>-MIDI channel (0=omni)
slider17:preroll_ms=5<0,100,1>-Slice pre-roll (ms)
slider18:gwet=100<0,100,0.1>-FX dry/wet (%)
slider19:playthru=0<0,1,1{Off,On}>-Playthrough (note plays on past its slice)
slider16:pbrange=12<1,24,1>-Pitch wheel range (semitones)
slider30:velfix=0<0,1,1{Off,On}>-VEL: ignore incoming velocity
slider31:velval=100<1,127,1>-VEL: fixed velocity
// КРИВАЯ АФТЕРТАЧА (решение пользователя 13 сен): клавиатуры отдают его
// по-разному — одна выходит на максимум от лёгкого нажима, другая требует
// продавить до упора. Кривая подгоняет реакцию под конкретную клавиатуру,
// не трогая сам движок стретча.
//   < 1 — мягче: эффект начинается раньше, от слабого нажима;
//   = 1 — как приходит;
//   > 1 — жёстче: до упора почти ничего, вся глубина в конце хода.
slider32:atcurve=1<0.25,4,0.01>-Aftertouch curve
// АРПЕДЖИАТОР. Держишь несколько пэдов — они играют по очереди в темп.
// Включается ПЕДАЛЬЮ (CC64): нога держит режим, руки играют. Это то же
// разделение, что у слоя раскладки и у THRU.
slider33:arp_on=0<0,1,1{Off,On}>-ARP: on
slider34:arp_rate=3<0,6,1{1/1,1/2,1/4,1/8,1/8T,1/16,1/32}>-ARP: rate
slider35:arp_mode=0<0,4,1{up,down,up-down,random,as played}>-ARP: order
slider36:arp_gate=0.5<0.05,1,0.01>-ARP: gate (note length)
slider37:arp_pedal=0<0,3,1{off,hold while pressed,latch,(removed)}>-Pedal role
slider20:qgrid=0<0,6,1{Off,1/32,1/16 T,1/16,1/8 T,1/8,1/4}>-Input quantize
slider21:tsync=1<0,1,1{Off,On}>-Lock loop to project timeline
slider22:theme=0<0,5,1{-}>-Theme (не используется: палитра одна на экосистему)
slider23:font_sc=1<0,3,1{0.8x,1x,1.25x,1.5x}>-UI font scale
slider24:tint=1<0,1,1{Off,On}>-Tint UI with track colour
slider25:slmode=0<0,2,1{Transients,Equal parts,Pitch changes}>-Slice mode
slider26:eqparts=16<2,64,1>-Equal parts: how many
slider27:pitchsens=0.5<0.05,1,0.01>-Pitch-change sensitivity
// РЕЖИМ 2 — ЛИНИЯ PURE DATA (просьба пользователя 14 сен): белая чёткая
// линия вместо заливки столбиками. Разница принципиальная: столбики дают
// МАССУ (глаз читает плотность), линия даёт ФОРМУ. Плюс «слегка глитчево,
// без смазывания» — рисуем ступенями по целым пикселям, без сглаживания
// между отсчётами: линия честная, а не причёсанная.
slider28:wavecol=0<0,4,1{Peaks (as the tracker slicer),Dark low - bright high,Line (PD),Array (PD),Spectral}>-Waveform colours
slider29:talas_on=0<0,1,1{Off,On}>-Tala browser and map
// SP-МОД УДАЛЁН 15 сен по просьбе пользователя: восемь фейдеров и три
// кнопки режима оказались лишним слоем поверх и без того плотного окна.
// Что из него осталось полезного — DeRez3 как алгоритм цепи, он доступен
// обычным выбором слота.
slider40:amen=0<0,1,1{Off,On}>-Amenhotep: waveform on the device
// ── MPE (14 сен) ─────────────────────────────────────────────────────────
// LinnStrument шлёт бенд и давление НА КАНАЛ ПАЛЬЦА (2-16), поэтому при
// выбранном MIDI-канале они отфильтровывались и прибор «не гнул».
// В режиме MPE бенд и давление принимаются с ЛЮБОГО канала и привязываются
// к ноте, звучащей на том же канале.
slider41:mpe=1<0,1,1{Off,On}>-MPE: per-note bend and pressure
// Диапазон бенда СТУПЕНЯМИ: 12 полутонов — стандарт MPE (у LinnStrument
// это заводская настройка), 5 и 3 — для мелкой подводки без «уезжания».
slider42:pbsel=0<0,3,1{slider,12,5,3}>-Bend range preset
// ── FULLLINN (просьба пользователя 14 сен) ───────────────────────────────
// LinnStrument становится ВОЛНОЙ СО СРЕЗАМИ на весь прибор: колонка = кусок
// сэмпла, цвет = класс среза, границы срезов видны стыком цветов.
// Нажал колонку — ЭТОТ СРЕЗ ВЫБРАН, и дальше вся клавиатура (Xkey25)
// играет его хроматически. Прибор держит АДРЕС, клавиатура берёт НОТУ —
// то самое разделение, ради которого в экосистеме и заводятся два прибора.
slider43:linnfull=0<0,1,1{Off,On}>-FULLLINN: device shows the whole waveform
// ── КВАНТИЗАЦИЯ ПО ТРАНЗИЕНТАМ (просьба пользователя 14 сен) ─────────────
// Обычный Q ровняет по сетке темпа — это правильно для ритма, но убивает
// «человеческий» грув исходника. Q по транзиентам ровняет по САМОМУ
// МАТЕРИАЛУ: нажатие подтягивается к ближайшей найденной атаке, и брейк
// звучит так, будто ты попал в его собственную долю.
// Границы срезов и есть транзиенты — детектор уже разложил их при нарезке,
// искать заново нечего.
slider44:qtrans=0<0,1,1{Off,On}>-Q by transients
// ── ZERO-CROSS (просьба пользователя) ────────────────────────────────────
// Срез, начатый посреди волны, даёт щелчок: сигнал прыгает от нуля к
// текущему значению мгновенно. Сдвигаем старт и конец к ближайшему переходу
// через ноль — разрыва нет, и щелчка тоже.
slider45:zerox=0<0,1,1{Off,On}>-Zero-cross slice edges
// ── ГЛОБАЛЬНЫЙ СТРЕТЧ (просьба пользователя 15 сен) ─────────────────────
// Пер-слайсовый стретч (ряд str и arc) остаётся: он про «этот срез звучит
// вдвое длиннее». Этот слайдер — ОБЩИЙ поверх него, чтобы тянуть ВЕСЬ
// брейк одной ручкой и, главное, АВТОМАТИЗИРОВАТЬ его огибающей: у
// пер-слайсовых значений огибающей нет, они живут в памяти среза.
// Нейтраль 0.5 — та же шкала, что у поля среза (pow(8, 1-2*x)).
slider46:gstretch=0.5<0,1,0.001>Stretch (all slices)
// ── ЭФФЕКТЫ ЧЁРНЫХ КЛАВИШ: ЧЕТЫРЕ НАЗНАЧАЕМЫХ СЛОТА (16 сен) ────────────
// C# занят тогглом реверса, остальные четыре чёрные октавы C2 — слоты, и
// в каждый можно поставить любой алгоритм из набора. Раньше алгоритмы были
// прибиты к клавишам; теперь клавиша это АДРЕС, а что в нём — выбор.
// Набор нарочно короткий: восемь штук, каждый слышно сразу и каждый
// осмыслен на брейке. Длинный список превратил бы игру в поиск по меню.
slider47:kbfx1=1<0,7,1{off,ring,phase,sub,crush,filter,tape,gate}>-Black D#
slider48:kbfx2=2<0,7,1{off,ring,phase,sub,crush,filter,tape,gate}>-Black F#
slider49:kbfx3=3<0,7,1{off,ring,phase,sub,crush,filter,tape,gate}>-Black G#
slider50:kbfx4=4<0,7,1{off,ring,phase,sub,crush,filter,tape,gate}>-Black A#
// ── ПАРАМЕТРЫ ЭФФЕКТОВ ЧЁРНЫХ (16 сен) ─────────────────────────────────
// По две ручки на алгоритм, общие для всех слотов: один и тот же ring
// должен звучать одинаково, в какой бы слот его ни поставили. Крутятся
// с arc, пока клавиша ЗАЖАТА, — тогда энкодеры временно принадлежат ей.
// Значения нормализованы 0..1: так одна ветка arc правит любой параметр,
// а перевод в герцы и биты остаётся в DSP, где он и нужен.
slider51:kbp_ring=0.5<0,1,0.001>-FX ring: freq
slider52:kbp_ring2=0<0,1,0.001>-FX ring: track pitch
slider53:kbp_phase=0.5<0,1,0.001>-FX phase: depth
slider54:kbp_phase2=0.3<0,1,0.001>-FX phase: rate
slider55:kbp_sub=0.5<0,1,0.001>-FX sub: octave
slider56:kbp_crush=0.5<0,1,0.001>-FX crush: bits
slider57:kbp_filt=0.5<0,1,0.001>-FX filter: range
slider58:kbp_filt2=0<0,1,0.001>-FX filter: resonance
slider59:kbp_tape=0.4<0,1,0.001>-FX tape: wow
slider60:kbp_gate=0.5<0,1,0.001>-FX gate: rate
// ── ФОКУС ОКНА (17 сен) ────────────────────────────────────────────────
// Ставит ДЕМОН: 1 тому экземпляру, чьё окно трогали последним, 0 остальным.
// Плагин своего адреса в проекте не знает (в JSFX такого поля нет), а gmem
// у всех экземпляров общий — параметр единственный канал «именно тебе».
// ВИДИМЫЙ, хотя это служебный флаг: скрытые слайдеры (с минусом) НЕ входят
// в список параметров API, и демон не смог бы его найти (проба 17 сен:
// у плагина 47 параметров при 61 слайдере).
slider61:winfocus=0<0,1,1{No,Yes}>Window focus (set by daemon)

// ── ДВА LFO НА ИНСТРУМЕНТ (19 сен) ───────────────────────────────────────
// Их не было вовсе: единственные «колебания» в плагине — фазы внутри
// эффектов. Видимые (не скрытые): LFO — первое, что тянут в автоматизацию.
// Скорость в герцах, а не в долях: при sync доли и так есть у самого лупа,
// а свободный LFO ценен именно тем, что с сеткой не совпадает.
slider82:lfo1_hz=1.0<0.01,20,0.01>LFO1 rate (Hz)
slider83:lfo1_sh=0<0,4,1{sine,triangle,saw down,square,random}>LFO1 shape
slider84:lfo2_hz=0.25<0.01,20,0.01>LFO2 rate (Hz)
slider85:lfo2_sh=1<0,4,1{sine,triangle,saw down,square,random}>LFO2 shape
// jf_tracker (9 окт): запрос вида для DSP-панели трекера. gmem общий для всех
// экземпляров, а параметр — у каждого свой: трекер пишет сюда номер запроса
// ТОМУ экземпляру, что показывает, и он становится владельцем блока TRKV.
slider86:trkv_req=0<0,16777216,1>-Tracker view request

// СЛАЙДЕРЫ 62-81 (четыре слота Airwindows: алгоритм + p1/p2/p3 + mix на
// слот) НА ПЕНСИИ с 25 окт — слоты выпилены, обработка в контейнере REAPER.
// Номера не переиспользуются: это ключи хранения в проектах.
// Артикуляторы снимают слайдеры сплошным циклом 1..85, и дыра им не мешает —
// чтение несуществующего даёт 0, запись уходит в никуда (так же, как дыры
// 16 и 39).

in_pin:left
in_pin:right
// 64 ВЫХОДА = ПРЕДЕЛ JSFX (spl0..spl63). Трек REAPER держит 128 каналов,
// но плагин до них не достаёт, поэтому выход на срез — МОНО (решение
// пользователя 25 окт): срез N -> канал N, панорама и обработка живут в
// контейнере, где они ещё и автоматизируются нативно.
// Имя канала одно на оба режима (out: mix / class / slice), потому что
// out_pin статичен: в режиме mix играют 1-2, в classе 1-14, в slice 1-64.
out_pin:1 (mix L / slice 1)
out_pin:2 (mix R / slice 2)
out_pin:3 (bus1 L / slice 3)
out_pin:4 (bus1 R / slice 4)
out_pin:5 (bus2 L / slice 5)
out_pin:6 (bus2 R / slice 6)
out_pin:7 (bus3 L / slice 7)
out_pin:8 (bus3 R / slice 8)
out_pin:9 (bus4 L / slice 9)
out_pin:10 (bus4 R / slice 10)
out_pin:11 (bus5 L / slice 11)
out_pin:12 (bus5 R / slice 12)
out_pin:13 (bus6 L / slice 13)
out_pin:14 (bus6 R / slice 14)
out_pin:15 (slice 15)
out_pin:16 (slice 16)
out_pin:17 (slice 17)
out_pin:18 (slice 18)
out_pin:19 (slice 19)
out_pin:20 (slice 20)
out_pin:21 (slice 21)
out_pin:22 (slice 22)
out_pin:23 (slice 23)
out_pin:24 (slice 24)
out_pin:25 (slice 25)
out_pin:26 (slice 26)
out_pin:27 (slice 27)
out_pin:28 (slice 28)
out_pin:29 (slice 29)
out_pin:30 (slice 30)
out_pin:31 (slice 31)
out_pin:32 (slice 32)
out_pin:33 (slice 33)
out_pin:34 (slice 34)
out_pin:35 (slice 35)
out_pin:36 (slice 36)
out_pin:37 (slice 37)
out_pin:38 (slice 38)
out_pin:39 (slice 39)
out_pin:40 (slice 40)
out_pin:41 (slice 41)
out_pin:42 (slice 42)
out_pin:43 (slice 43)
out_pin:44 (slice 44)
out_pin:45 (slice 45)
out_pin:46 (slice 46)
out_pin:47 (slice 47)
out_pin:48 (slice 48)
out_pin:49 (slice 49)
out_pin:50 (slice 50)
out_pin:51 (slice 51)
out_pin:52 (slice 52)
out_pin:53 (slice 53)
out_pin:54 (slice 54)
out_pin:55 (slice 55)
out_pin:56 (slice 56)
out_pin:57 (slice 57)
out_pin:58 (slice 58)
out_pin:59 (slice 59)
out_pin:60 (slice 60)
out_pin:61 (slice 61)
out_pin:62 (slice 62)
out_pin:63 (slice 63)
out_pin:64 (slice 64)

// Эффекты слотов — общая библиотека экосистемы (порт Airwindows, MIT).
import jf_fx_airwindows.jsfx-inc
// ДВИЖОК ГОЛОСОВ — общий с jf_splr. Стоит В ЗАГОЛОВКЕ: import в JSFX это
// директива файлового уровня, внутри @init она даёт syntax error.
import jf_voice.jsfx-inc

@init
ext_noinit = 1;
ext_midi_bus = 1;

MAXSL   = 64;
TRKV    = 200000;   // gmem: вид для jf_tracker (выше DATA 16384..81920), см. @block
// 26 окт: заказы трекера живут в gmem и после перекомпиляции / открытия проекта. Счётчики с нуля
// принимали старый заказ за новый — путь из прошлой сессии загружался поверх сэмпла проекта
// (offline/online стёр амен 22 среза). Поэтому при запуске — уже виденными считаются текущие номера
trkv_ld = gmem[TRKV+5000]; trkv_sl = gmem[TRKV+6000]; trkv_op = gmem[TRKV+6100]; trkv_zq = gmem[TRKV+1590];
qs_ver = 1; trkv_qv = -1;   // 27 окт: версия слотов быстрой загрузки (меняется — трекеру переписать пути)
NVOICE  = 16;
TLVOICE = 15;   // last voice is reserved for the timeline player (tsync)
VF      = 68;   // words per voice (поля до fNSF=67; 26 окт: 66 -> 68, V0 + 16*68 = 21568 <= TBL 21632)
MAGIC   = 8888123;
BINSZ   = 256;

// memory map
// busM ПЕРЕЕХАЛ В ХВОСТ TBL (25 окт, вечер). Стоял на 2900 с 12 словами;
// расширение до 64 увело его на 2900..2963 — ПРЯМО НА OVR (2950, оверрайды
// перформанс-эффектов). Голоса срезов 50..63 писали звук в чужие поля, и
// плагин дистортил и играл сам по себе без единой MIDI-ноты.
// Ровно та ловушка, что уже стоила двух дней в сентябре: комментарий
// «свободно» врёт, адреса надо считать. Теперь блок объявлен внутри TBL, и
// его конец входит в TBL_SZ, который проверяет memerr.
busM    = TBL + 3040;         // 64 аккумулятора: 6 стерео-шин класса (12 слов
                              // при outmode 0/1) ИЛИ 64 моно-выхода на срез
OVR     = 2950;               // per-deck performance fx overrides (2 x 16)
OVRN    = 2982;               // note holding each override slot, +1 (2 x 16)
qoff    = 3000;               // pending note-off queue, 32*3
dk_frames = 3200;             // per-deck scalars, index by deck 0/1
dk_srate  = 3204;
dk_nsl    = 3208;
dk_sel    = 3212;
dk_sync   = 3216;             // 0=off 1=repitch 2=stretch
MSEL    = 3300;               // multi-select flags, 1 word per slice (2 x 64)
MSELST  = 64;                 // per-deck stride of MSEL
// QNQ ПЕРЕЕХАЛ В TBL (18 сен). Стоял на 3440 и занимал 96 слов — до 3536,
// а SQ_BASE начинается с 3500: перекрытие 36 слов. При 21-й отложенной
// квантованной ноте очередь затирала первые девять шагов секвенсора.
// Комментарий ниже проверял только НИЖНЮЮ границу (MSEL), верхнюю — никто.
// Найдено расчётом при разведке 18 сен, симптома ещё не было.
QNQMAX  = 32;                 // (MSEL runs to 3428, so QNQ starts clear of it)
// step sequencer (SEQ): 64 steps * (class, slice, prob, vel), accent cycle,
// per-class round-robin counters, pending trigger queue. Constants are SQ_*
// so they cannot collide with the seq_* runtime variables (EEL2 is
// case-insensitive: SEQ and seq would be one variable).
SQ_BASE = 3500;               // 64 * 4 = 256 words
SQ_ACC  = 3760;               // 64 accent multipliers
SQ_RR   = 3830;               // 10 round-robin counters (index = class)
SQQ     = 3850;               // pending seq triggers: 16 * (slice, vel, wait)
SQQMAX  = 16;
// ── МАЛЫЕ ТАБЛИЦЫ: талы, арпеджиатор, цепь эффектов ──────────────────────
// ПЕРЕЕХАЛИ 15 сен ИЗ-ПОД ТАБЛИЦЫ СРЕЗОВ. Они стояли на 13100..13611 с
// комментарием «свободно до самой таблицы срезов» — но таблица срезов
// НАЧИНАЕТСЯ на SL0 = 4096 и растёт ВВЕРХ на NSLF*64 слов. Когда 14 сен
// добавились поля ADSR (145-148) и precalc (149-154), поля 140-148 легли
// ровно на эти адреса: талы затирали OF_MUTE и OF_ATK, арп — OF_DEC / OF_SUS /
// OF_REL, а slice_defaults, заполняя OF_REL всем 64 срезам, обнулял CHORD —
// и все четыре ячейки цепи становились слотом 0. Два дня жалоб на «ADSR с
// задержкой» и «матрица выбирает все четыре» — одна коллизия.
//
// Теперь они СРАЗУ ЗА ГОЛОСАМИ: V0 + NVOICE*VF = 21536, свободно до SCR
// (99328) — банк пресетов PRE, что стоял с 24576, убран (v22, никто не
// звал preset_save/load). Занято 448 слов. Складывать сюда ещё что-то —
// только пересчитав сумму. Обе границы проверяет @init (memerr).
TBL     = 21632;
SQ_TALA = TBL;                // tala table: 32 * 8 = 256 words (nvib, v1..v6, khali mask)
SQ_TPOS = TBL + 256;          // tala map coordinates: 31 * (x, y) = 62 words
SQ_NTALA = 31;
// АРПЕДЖИАТОР: список УДЕРЖИВАЕМЫХ нот в порядке нажатия. Порядок важен:
// режим «as played» играет именно его, а «up»/«down» сортируют копию.
ARPN    = TBL + 320;          // 32 слова: нота+1, 0 = пусто
ARPV    = TBL + 352;          // 32 слова: velocity каждой
ARPS    = TBL + 384;          // 32 слова: буфер сортировки
// ── ЦЕПЬ ЭФФЕКТОВ: ПОРЯДОК И БАЙПАС ───────────────────────────────────────
// Порядок слотов стал ИЗМЕНЯЕМЫМ (перетаскиванием в окне), поэтому он живёт
// в памяти, а не в функции: и звуковая цепь, и окно читают один массив.
// CHORD[i] = какой АЛГОРИТМ стоит на i-й позиции цепи (0..3 — номер банка
// параметров). Банк едет вместе со слотом: переставил — уехали и настройки.
CHORD   = TBL + 416;          // 4 слова: порядок позиций цепи
CHBYP   = TBL + 420;          // 4 слова: 1 = слот обойдён (bypass)
// КАКОЙ АЛГОРИТМ В СЛОТЕ. Раньше это была функция с зашитыми значениями, и
// слот нельзя было ни поменять, ни выбрать другой — «просто отображают и
// ничего не делают» (пользователь, 14 сен). Теперь массив: выбор живёт в
// памяти, переживает сохранение и меняется правым кликом.
CHALG   = TBL + 424;          // 4 слова: id алгоритма из библиотеки
// 256 слов кольцевой задержки phase shift. АДРЕС ПОСЧИТАН, а не подобран:
// KBH кончается на 3964, SL0 начинается с 4096 — 3968 влезал бы в таблицу
// срезов (ровно та коллизия, что стоила двух дней 14-15 сен). Здесь, в
// блоке TBL, запас до SCR измеряется десятками тысяч слов.
KBPH    = TBL + 448;          // 256 слов: TBL+448..TBL+704
KBFXN   = TBL + 704;          // 4 слова: какая нота держит слот эффекта
KBTP    = TBL + 712;          // 2048 слов: стерео-задержка «лента» (2 x 1024) — до TBL+2760
QNQ     = TBL + 2760;         // 96 слов: input-quantize pending notes, 32 * (note,vel,wait)
// FXBUS / FXAWK / FXTCH / FXIDLE (TBL+2856..2876) ушли со слотами 25 окт.
// Место свободно, но ПУСТО НЕ ЗНАЧИТ «бери»: прежде чем сюда что-то класть,
// пересчитать конец блока против соседей (ZWID на TBL+2920).
ZWID    = TBL + 2920;         // 8 слов: ширины зон-рамок из сухого прохода
// ── МАТРИЦА МОДУЛЯЦИИ (решение пользователя 19 сен: «общие на инструмент») ─
// Кабель = тройка (источник, назначение, глубина). Один патч на инструмент,
// как в Aalto: разница между срезами возникает сама — velocity, давление,
// random, огибающая и позиция в срезе у каждого голоса свои.
// Хранится ЧИСЛАМИ, а не указателями: так матрица переживает @serialize и
// диспетчер получается циклом, а не ветвлением в горячем коде.
NCAB    = 8;                  // кабелей в патче: больше в окне не прочитать
CAB     = TBL + 2960;         // NCAB * 3 слова: src, dst, depth
// ВИТРИНА ДЛЯ ОКНА: значения источников, которые у каждого голоса СВОИ
// (огибающая, позиция, random, velocity). Пишет их @sample у последнего
// звучащего голоса, читает @gfx — иначе индикатор показывал бы ноль, ведь
// в окне «голоса вообще» не существует.
MODVIS  = TBL + 3024;         // NSRC слов
SRCV    = TBL + 2992;         // NSRC слов: значение каждого источника 0..1
TBL_SZ  = 3104;               // сумма блока; её и проверяет memerr (busM 3040..3103)

// ── ШАГ ЭНКОДЕРА: АДАПТИВНЫЙ И СТУПЕНЧАТЫЙ (21 сен) ──────────────────────
// Было: шаг ФИКСИРОВАН, mn_d = щелчки * 0.002, и старт среза двигался как
// доля всей деки — 0.002 * 60000 кадров = 120 кадров за щелчок. Попасть в
// сэмпл нельзя было в принципе, а пройти минутную деку — двести оборотов.
//
// АДАПТИВНЫЙ ШАГ (по умолчанию). Скорость меряется ЧИСЛОМ ЩЕЛЧКОВ ЗА ТИК,
// а не временем между ними: очередь разгребается раз в блок, и все щелчки
// одного тика приходят пачкой — их количество И ЕСТЬ скорость. Замер по
// времени внутри @block врал бы: у всей пачки одна временная метка.
//
// Кривая: множитель = (щелчков за тик)^JOG_EXP, ограничен JOG_MAXX.
//
// ПОКАЗАТЕЛЬ ПОСЧИТАН, А НЕ ПОДОБРАН. Требование с двух концов: один
// щелчок = один сэмпл (точность стыка), быстрое вращение проходит минутную
// деку за пару секунд (иначе до конца не доехать). При 30 Гц опроса
// быстрое вращение даёт ~30 щелчков за тик, и чтобы 2.6 млн кадров прошли
// за ~90 тиков, нужен шаг около тысячи кадров на щелчок.
//   EXP=1.6: 30 щелчков -> 231 кадр, дека за 13 c — долго
//   EXP=2.0: 30 щелчков -> 900 кадров, дека за 3.3 c — то, что нужно
// При этом три щелчка дают ещё 9 кадров: точность у медленного края
// квадрат не портит.
JOG_EXP  = 2.0;
JOG_MAXX = 4096;              // потолок: дальше кривая всё равно не растёт
// СТУПЕНИ (кнопка scale на гриде). Шаг в КАДРАХ для позиционных величин;
// для нормированных 0..1 он же делится на длину деки, поэтому одна шкала
// работает и там, и там.
NJOGS = 6;
// 1 = посемплово (точная правка стыка), дальше примерно вчетверо:
// 1 · 16 · 256 · 1024 · 4096 · 16384 кадра. На 44.1 кГц это
// 0.02 мс · 0.4 мс · 6 мс · 23 мс · 93 мс · 372 мс — от щелчка до трети
// секунды, то есть от одного отсчёта до целой доли.
JOGST = TBL + TBL_SZ;         // NJOGS слов: таблица ступеней
// Счётчик щелчков за тик и множитель разгона — НА КАЖДОЕ КОЛЬЦО отдельно:
// две руки на двух кольцах обычное дело, и общая сумма сделала бы
// медленное кольцо быстрым.
jog_cnt = JOGST + NJOGS;      // 4 слова
jog_mul = jog_cnt + 4;        // 4 слова
JOG_SZ = NJOGS + 8;

// ── АРТИКУЛЯТОРЫ ──────────────────────────────────────────────────────────
// Артикулятор = СНИМОК ИНСТРУМЕНТА (решение пользователя 21 сен): слайдеры
// целиком плюс таблицы, которые слайдерами не описываются — кабели матрицы
// и порядок цепи. Не «пресет»: пресет выбирается мышью и живёт до смены,
// а артикулятор надет на кнопку грида и снимается отпусканием.
//
// ПОЧЕМУ ЦЕЛИКОМ, А НЕ ДЕЛЬТОЙ. Дельта («храним только то, что тронул»)
// требует поля «тронуто» на каждый параметр и разбирательства, что делать
// при наложении двух артикуляторов. Снимок такого не требует: применение —
// это копирование массива, откат — копирование обратно. Цена вопроса
// 96 слов на артикулятор, места в этой дыре памяти 74 тысячи.
//
// ЧТО ИМЕННО ВХОДИТ. Слайдеры 1..85 с дырами (16 нет, 39 нет и т.д.) —
// пишем ВСЕ индексы 1..ART_NSL подряд, включая несуществующие: чтение
// несуществующего слайдера даёт 0, запись уходит в никуда, а сплошной
// цикл короче и не может разойтись со списком при добавлении слайдера.
ART_N    = 8;                 // артикуляторов в банке = ряд грида
ART_NSL  = 85;                // слайдеров в снимке: 1..85 подряд
ART_NTBL = 4 + 4 + 4 + NCAB*3;   // CHORD + CHBYP + CHALG + кабели = 36
ART_W    = ART_NSL + ART_NTBL + 1;   // +1 слово: занят ли слот
ART0     = JOGST + JOG_SZ;    // банк: ART_N * ART_W = 8 * 122 = 976 слов
ART_LIVE = ART0 + ART_N*ART_W;       // снимок «как было до артикулятора»
// ОГИБАЮЩАЯ — ОТДЕЛЬНО, и вот почему. ADSR живёт в ТАБЛИЦЕ СРЕЗА (OF_ATK
// и далее, 64 слова на поле), а не в слайдере: у каждого среза своя. Снимок
// слайдеров её не покрывает, а тащить в артикулятор 4x64 слова на каждый
// слот — это 2048 слов ради двух чисел, и при этом артикулятор перестал бы
// накладываться на ЛЮБОЙ набор срезов (он принёс бы чужую нарезку).
// Поэтому артикулятор хранит НАКЛАДКУ: два числа, атака и релиз в секундах,
// -1 = «не трогать». Применяется ко всем срезам разом при надевании,
// исходные значения лежат в ART_ESAV и возвращаются при снятии.
ART_ENV  = ART_LIVE + ART_W;         // ART_N * 2 слова: атака, релиз (-1 = не трогать)
ART_ESAV = ART_ENV + ART_N*2;        // 2*64 слова: атака и релиз срезов «как было»
// Итого: джог 14 + артикуляторы 1242 = 1256 слов, до TBL+4296.
// ПРОВЕРКА СОСЕДЕЙ (правило после коллизии 15 сен): TBL кончается на
// 21632+4296 = 25928, SCR начинается с 99328 — запас 73400 слов.
// Источники. 0 = «нет кабеля», поэтому нумерация с единицы.
SRC_NONE=0; SRC_VEL=1; SRC_AT=2; SRC_MW=3; SRC_ENV=4;
SRC_PHASE=5; SRC_RND=6; SRC_LFO=7; SRC_LFO2=8; SRC_BEND=9; SRC_STEP=10;
NSRC = 11;
// Назначения — ТОЛЬКО то, что уже читается на сэмпле: добавить точку в
// горячий цикл дороже, чем кажется, а этих хватает на весь язык жестов.
DST_NONE=0; DST_PITCH=1; DST_VOL=2; DST_PAN=3; DST_STRETCH=4;
DST_START=5; DST_GLIT=6; DST_STUT=7; DST_FX1=8; DST_FX2=9; DST_FX3=10; DST_FX4=11;
NDST = 12;
CLS_KEY = TBL + 432;          // 7 слов: класс для каждой белой ступени (было 8320 — ВНУТРИ таблицы срезов)
WHITE_PC = TBL + 440;         // 7 слов: полутон каждой белой ступени — конец TBL+448
KBH     = 3900;               // computer-keyboard held notes: 32 * (note+1, expiry)
SL0     = 4096;               // slice table: field stride 64, SLST words total
V0      = 20480;              // voices: 16 * VF (after the wider slice table)
// 26 окт: КОМАНДЫ ТРЕКЕРА НА НОТУ — ждут свою ноту. 8 записей по 8 слов сразу за голосами
// (21568..21631, до TBL). Запись: 0 клавиша (-1 пусто), 1 канал, 2 offset, 3 pan, 4 vol,
// 5 fine, 6 reverse, 7 stretch; -1 — не задано
NPB = V0 + 16*68; NPN = 8;
np_i = 0; while (np_i < NPN*8) ( NPB[np_i] = -1; np_i += 1; );
np_cur = -1;
// PRE (банк пресетов 8 x NSLF*64 с 24576) УБРАН 15 сен: preset_save/load/
// clear никто не звал, а @serialize писал 79360 слов в каждый проект.
// Нативные пресеты REAPER делают то же бесплатно.
SCR     = 99328;              // load scratch / legacy-convert buffer (32768 words, до OVW0)
// ДЕКА 16 СЕКУНД (25 окт, решение пользователя). Было 340 с до самого FXST:
// дека забирала ВСЮ оставшуюся память, и maxmem просил 256 МБ на экземпляр.
// Теперь длина объявлена, а не «сколько осталось», и память считается от неё
// (см. options:maxmem в заголовке — его считать ВМЕСТЕ с этими константами).
DECK_SECS = 16;               // при 48 кГц; файл в своём рейте (96к влезет на 8 с)
DECKFR  = DECK_SECS * 48000;  // кадров в деке
DECKW   = DECKFR * 2;         // слов: стерео interleaved
OVW0    = 132096;             // overview bins: 5 words/bin (min,max,elo,emid,ehi)
NOVW    = (DECKFR/BINSZ + 2) * 5;   // бинов хватает на всю деку, +2 на хвост
BUF0    = OVW0 + NOVW;        // audio: stereo interleaved, one deck
// Состояние эффектов Airwindows НА ГОЛОС: 16 голосов x 4 слота x
// (4 служебных + 24 коэф. + 2 канала x 1536 состояния) = 198400 слов в хвосте.
// ДВА ПАРАЛЛЕЛЬНЫХ ПУТИ (схема Surge XT, решение пользователя 13 сен).
// Было: A и B — два НАБОРА НАСТРОЕК одной цепи, и кроссфейдер морфил
// параметры, а алгоритм переключался скачком на 50%. Отсюда ощущение
// «кроссфейдер просто выбирает слоты» — это буквально и происходило.
// Стало: срез идёт СРАЗУ В ОБЕ цепи, кроссфейдер микширует их ЗВУК.
// Цена — вдвое больше состояния на голос: 8 слотов вместо 4.
// Блок просто сдвинут вниз, под ним 32 млн свободных слов (аудио остаётся
// ~680 секунд стерео вместо 341 — всё равно с запасом).
// FXST ПЕРЕЕХАЛ ЗА ДЕКУ (25 окт). Было `33554432 - 396800` — хвост 256-мегабайтной
// памяти; после урезания деки до 16 с такой памяти не существует, и слоты писали
// бы за её край. Теперь блок стоит сразу за декой, а его размер объявлен
// (FXSTW), а не выпрошен остатком — и входит в maxmem в заголовке.
//   слот = 4 служебных + 24 коэф. + 2 канала x (32 + 16386) = 32864 слова
//   четыре слота = 131456; +8 слов мастер-цепи ниже (MXST = FXST - 8)
// Слоты выпиливаются следующим этапом (выход на каждый срез вместо них), и
// тогда этот блок уходит целиком — но пока он жив, он должен быть В ПАМЯТИ.
// СОСТОЯНИЕ СЛОТОВ УШЛО (25 окт): 131456 слов (четыре слота по 32864) больше
// не нужны — слоты выпилены, обработка в контейнере REAPER. Осталось 8 слов
// мастер-цепи: её @serialize читает у старых проектов (MXSEL), и выбросить
// их значило бы сломать чтение.
FXSTW   = 8;
FXST    = BUF0 + DECKW + 8;   // +8: мастер-цепь читает FXST - 8
// СОСТОЯНИЕ ЧЕТЫРЁХ СЛОТОВ живёт в этом хвосте. Слот — общая шина, а не
// голос, поэтому памяти хватает САМОМУ ЖАДНОМУ алгоритму (Chorus и Vibrato
// просят 16386 слов на канал): запрета aw_fits, из-за которого часть
// библиотеки была недоступна на голосах, здесь нет.
//   слот = 4 служебных + 24 коэф. + 2 канала x (32 + 16386) = 32864 слова
//   четыре слота = 131456 <= 396800
SFX0    = FXST;
SFXCH   = 32 + 16386;         // FXS_SZ + самый длинный fx_need_delay
SFXW     = 4 + 24 + 2*SFXCH;
AW_C = 24; AW_S = 1536;       // = FXC_SZ, FXS_SZ + буфер PhaseNudge (Vibrato исключён)
AW_SLOTW = 4 + AW_C + 2*AW_S;
AW_NPP  = 4;                  // слотов в одном пути
AW_VW   = 4*AW_SLOTW;         // ОДНА цепь из 4 слотов на КАЖДЫЙ голос.
// Было 8 (два параллельных пути): вдвое больше памяти на каждый из 16
// голосов ради схемы, которую ещё надо было держать в голове.
// МАСТЕР-ЦЕПЬ (схема Surge XT): после суммы голосов идут два ОБЩИХ слота.
// Ключевое — «общих»: слоты A/B живут на КАЖДОМ из 16 голосов (срезы звучат
// по-разному), и десять слотов на голос стоили бы 3.8 МБ вместо 1.5 при
// выделенных двух. Мастер один на инструмент, поэтому стоит крохи, а схема
// Surge получается целиком: пути -> сумма -> мастер.
// МАСТЕР-ЦЕПЬ УБРАНА (решение пользователя 13 сен: «четыре эффекта лишние,
// зато очень играбельно»). Четыре слота на срез — всё, что нужно, а восемь
// ячеек в окне были выбором ради выбора. Константы оставлены нулевыми:
// @serialize старых проектов читает этот блок, и убрать его совсем значило
// бы сломать чтение.
MXN     = 0;
MXST    = FXST - 8;
MXSEL   = MXST;
MXOA = 0; MXOP = 0; MXOM = 0;
LRT     = 3430;               // 2 слова для стерео-связанных эффектов (MSEL до 3428, QNQ с 3440)
// ДЕКА СНОВА ЦЕЛАЯ (18 сен, вечер). Утром она делилась пополам — играемая
// копия + оригинал — ради запекания срезов от ручек, потом ради стретча
// нативными движками REAPER. Ручки сняты, а движки оказались недоступны:
// у JSFX нет доступа к питч-шифтерам REAPER, нужен был бы демон — решение
// пользователя «ну его». Потребителя не осталось, половина памяти — обратно.
// DECKW / DECKFR объявлены выше, рядом с BUF0: дека больше не «остаток
// памяти до FXST», а заданная длина. Раньше здесь стояло
//   DECKW = floor((FXST - BUF0) / 2) * 2
// то есть 340 секунд просто потому, что столько оставалось.

// Slice field offsets, stride 64 (one word per slice, field-major).
// The slice itself (position, pitch, routing, class) is shared; only the fx
// chain exists twice, as scene A and scene B. The crossfader morphs between the
// two scenes on the one loaded loop -- that is what A/B means now.
OF_START=0; OF_END=64; OF_PITCH=128; OF_GAIN=192; OF_PAN=256;
OF_CHOKE=320; OF_CLASS=384; OF_MOUT=448; OF_MNUM=512; OF_MCHAN=576;
OF_MBUS=640; OF_MODE=704; OF_OUTCH=768;
OF_WET=832;              // global fx dry/wet for the slice, 0..1
NFX = 12;      // crush stretch comp fm am ring sat down stutter glitch filter fold
FXW = NFX*64;  // width of one fx bank
// Each scene stores four banks per slot: amount, P2, the slot's own dry/wet,
// and the keyboard activation point -- how far a control-octave white key
// pushes this slot when held (velocity scales the travel up to it).
OF_FXA  = 896;           // scene A amounts
OF_FXP  = OF_FXA + FXW;  // scene A p2
OF_FXM  = OF_FXP + FXW;  // scene A per-slot dry/wet
OF_FXK  = OF_FXM + FXW;  // scene A key activation point
OF_FXA2 = OF_FXK + FXW;  // scene B amounts
OF_FXP2 = OF_FXA2 + FXW; // scene B p2
OF_FXM2 = OF_FXP2 + FXW; // scene B per-slot dry/wet
OF_FXK2 = OF_FXM2 + FXW; // scene B key activation point
OF_FT   = OF_FXK2 + FXW; // scene A filter type (0 LP, 1 HP, 2 BP, 3 NOTCH)
OF_FT2  = OF_FT + 64;    // scene B filter type
// Per-slot modulation shape, one word per slot per scene: 0 off, 1 ramp down
// (fades over the slice), 2 ramp up, 3 triangle, 4 random-per-hit. It scales
// the slot's AMOUNT while a voice plays, which is what makes a static slice
// move without any LFO wiring.
OF_MS   = OF_FT2 + 64;
OF_MS2  = OF_MS + FXW;
// Какой эффект Airwindows стоит в слоте: enum, берётся по сцене (как OF_FT),
// а не блендом. 4 слота x 64 среза на сцену.
// OF_FXSEL/OF_FXSEL2 больше НЕ ЧИТАЮТСЯ в звуке: слоты фиксированы
// (13 сен). Поля оставлены, чтобы @serialize старых проектов читался без
// ветвлений — данные просто игнорируются.
OF_FXSEL  = OF_MS2 + FXW;
OF_FXSEL2 = OF_FXSEL + 4*64;
OF_MUTE   = OF_FXSEL2 + 4*64;  // 1 = срез выключен: не звучит в лупе, не играет с пэда, нет ноты в MIDI
// ── ADSR НА СРЕЗ (14 сен) ─────────────────────────────────────────────────
// Раньше огибающая была ОДНА НА ВСЕХ и фиксированная: 1.5 мс атака, 4 мс
// спад, только чтобы не щёлкало. Для брейка этого мало: кику нужен один
// хвост, хэту другой. Поля на срез, как питч и гейн.
//
// АДРЕС ОТ OF_MUTE, А НЕ ЧИСЛОМ. Первая попытка поставила их на 896 — а там
// начинается OF_FXA, банк амплитуд эффектов: атака писалась бы в громкость
// слота. Проверено картой полей.
//
// Хранятся в 0..1, в секунды переводятся при игре: ручка линейна, а
// диапазон можно менять без правки сохранённых проектов.
OF_ATK = OF_MUTE + 64;    // атака   0..1 -> 0.5 мс .. 500 мс
OF_DEC = OF_ATK + 64;     // спад    0..1 -> 1 мс .. 2 с
OF_SUS = OF_DEC + 64;     // уровень удержания 0..1
OF_REL = OF_SUS + 64;     // затухание 0..1 -> 1 мс .. 3 с
// ── PRECALC: SUB · TRI · SQR · BEND (по образцу Xfer Nerve, 14 сен) ──────
// Это НЕ цепь эффектов. Цепь красит звук, а precalc меняет САМ УДАР:
// подмешивает к срезу генератор на его основной частоте и гнёт высоту
// внутри среза. То, ради чего в хип-хопе досыпают синус в бочку.
//
// Почему per-slice: у бочки и хэта нужны разные подмесы, а общий на весь
// кит — это ручка, которую всё равно крутят на каждом срезе отдельно.
//
// ── ЗАПЕКАЕМЫЕ ПАРАМЕТРЫ СРЕЗА (набор пользователя 18 сен) ───────────────
//   pwm · ringmod · sub · bend · snap · fuzz · bitreduct · bend · softclip · phase
// Десять ручек = ровно один ряд. Двигаешь ручку — срез перепекается от
// оригинала и сразу виден на волне. ДВА bend — разные: первый гнёт частоту
// ТОНА (осцилляторы ring/pwm/sub), второй — высоту САМОГО ЗВУКА («808»).
// Частота тона берётся ОТ СРЕЗА (автокорреляция), а не ручкой: «какой у
// этого удара тон» — вопрос к материалу, а не к человеку.
//
// Первые пять полей — бывший живой precalc (sub/tri/sqr/bnd/frq), адреса те
// же: PSUB был синусным кольцом — это и есть ring; PSQR был меандром — это
// pwm при ширине 50 %. PTRI (треугольное кольцо) стал уровнем sub-тона:
// смысл другой, поэтому у старых файлов он обнуляется при чтении.
// АЛГОРИТМ СТРЕТЧА ЭТОГО СРЕЗА (18 сен): 0 grain · 1 cycle · 2 tape ·
// 3 cloud · 4 sync. Свой у каждого среза — бочке одно, вокалу другое.
// Живёт на месте мёртвого OF_BRNG (кольцо запекания, снято в тот же день):
// таблица не растёт, у файлов старше v26 поле обнуляется при чтении.
OF_STALG = OF_REL + 64;
OF_BRNG = OF_STALG;       // старое имя адреса; больше нигде не читается
OF_BSUB = OF_BRNG + 64;   // 0..1  подмес синуса октавой ниже f0    (был OF_PTRI)
OF_BPWM = OF_BSUB + 64;   // 0..1  кольцо импульсом, ширина плывёт  (был OF_PSQR)
OF_PBND = OF_BPWM + 64;   // -1..1 бенд частоты ТОНА внутри среза
OF_PFRQ = OF_PBND + 64;   // найденная основная частота, Гц (0 = не считана)
// ── МИКРОФЛУКТУАЦИИ (просьба пользователя 14 сен) ────────────────────────
// Лекарство от «пулемётного эффекта»: повторы среза звучат машиной, потому
// что каждый удар МАТЕМАТИЧЕСКИ ИДЕНТИЧЕН предыдущему. Живой барабанщик не
// попадает дважды одинаково — ни по громкости, ни по высоте, ни по началу.
// Одна ручка двигает все три разом, каждую в своей малой мере: разводить
// их на три ручки значило бы просить настраивать то, что слышится одним
// свойством — «живостью».
OF_RND  = OF_PFRQ + 64;
// 1 = в играемой копии этого среза лежит НЕ оригинал (хоть одна ручка
// запекания не в нуле). Нужен движку: по нему видно, что при сдвиге границ
// соседям надо вернуть исходный звук.
OF_RSTATE = OF_RND + 64;
OF_BSNP = OF_RSTATE + 64; // 0..1  snap: подъём атаки первых миллисекунд
OF_BFUZ = OF_BSNP + 64;   // 0..1  fuzz: жёсткое несимметричное ограничение
OF_BBIT = OF_BFUZ + 64;   // 0..1  bitreduct: 16 -> 4 бита + удержание отсчётов
OF_BPBD = OF_BBIT + 64;   // -1..1 бенд высоты САМОГО ЗВУКА (ресемплинг с огибающей)
OF_BCLP = OF_BPBD + 64;   // 0..1  softclip: мягкий перегруз
OF_BPHS = OF_BCLP + 64;   // 0..1  phase: четыре allpass-звена, статичный фазер
// КУДА ИДЁТ СРЕЗ: 0 = сухим в общий микс, 1..4 = ЧЕРЕЗ слот эффекта.
// Одно назначение, а не посылы в несколько: слот — вставка, и срез,
// отправленный в два слота сразу, удваивался бы по громкости.
// OF_FXR — МЁРТВОЕ ПОЛЕ с 25 окт (маршрут среза в слот Airwindows). Слоты
// выпилены, но поле остаётся: @serialize старых проектов читает его на своём
// месте, и убрать значило бы сломать чтение (как OF_BRNG..OF_BPHS с 18 сен).
// Не переиспользовать без новой эпохи формата.
OF_FXR  = OF_BPHS + 64;
NSLF = 14 + NFX*10 + 2 + 8 + 1 + 4 + 5 + 1 + 1 + 6 + 1;  // +fxr = 163 поля
// Поля OF_BRNG..OF_BPHS (десять ручек запекания 18 сен) МЕРТВЫ: ручки сняты
// в тот же день. Адреса остаются — иначе переиндексация и ещё одна эпоха
// формата ради нуля пользы.
SLST = 16384;  // slice table stride: a power of two keeps addressing cheap,
               // even though only NSLF*64 = 8704 words of it are used
// ПУТЬ СЭМПЛА ЧЕРЕЗ GMEM и 8 СЛОТОВ БЫСТРОЙ ЗАГРУЗКИ (13 сен).
// [1729] флаг «плагин просит загрузить», [1730] длина, [1731..] коды
// символов. Строки живут в именованных слотах EEL2: 200..207 — пути восьми
// слотов, 210 — путь текущего сэмпла (его публикует демон после загрузки).
// Пути пишутся в @serialize -> НАТИВНЫЙ ПРЕСЕТ REAPER уносит их с собой:
// загрузил пресет — вернулись и параметры, и сэмплы. «Мантра» пользователя:
// нагляднее цифровых пресетов и переносится при миграции.
PATH_FLAG = 1729; PATH_LEN = 1730; PATH_CH = 1731; PATH_MAX = 255;
QS0 = 200;        // строки 200..207 — слоты, 210 — текущий путь
// ПРЕВЬЮ СЛОТОВ (13 сен): демон считает пики файла (PCM_Source_GetPeaks) и
// кладёт 32 столбца на слот. Запрос — cmd 7: путь в PATH_CH, номер слота в
// QSREQ. Плагин шлёт по одному, когда gmem[7] свободен.
QSPK  = 12000;    // 8 * QSW пиков 0..1 (между таблицей китов и DATA 16384)
QSREQ = 11998;    // номер слота, для которого демон считает превью
QSW   = 32;
qs_dirty = 3990;  // 8 флагов «превью не запрошено» (локальная память)

// fx slot indices
FX_CRUSH=0; FX_STRETCH=1; FX_COMP=2; FX_FM=3; FX_AM=4; FX_RING=5;
FX_SAT=6; FX_DOWN=7; FX_STUT=8; FX_GLIT=9; FX_FILT=10; FX_FOLD=11;
// Четыре слота Airwindows сидят на индексах бывших CRUSH/COMP/AM/RING —
// раскладка памяти и сериализация не меняются. SAT/DOWN/FILT/FOLD — мёртвые
// индексы: память за ними сохранена, в UI и цепи их нет. Перформанс-слоты
// (STRETCH, FM, STUT, GLIT) двигают чтение, у Криса таких нет — остаются.
FX_AW1=0; FX_AW2=2; FX_AW3=4; FX_AW4=5; AWN=4;
AW_DEFAULT = 7;   // FX_CAPACITOR2 в слоте 1 по умолчанию — быстрый фильтр под arc-4
AW_SKIP = 9;      // FX_VIBRATO: буфер 16 K на голос не по карману, в списке его нет
// ВЫБОР АЛГОРИТМА ЭНКОДЕРОМ. Ряд грида — ровно 16 кнопок, а библиотека уже
// 25 и будет расти: потолок ряда упёрся, и девять алгоритмов были недоступны
// с устройства вовсе. Жест: ДЕРЖУ кнопку слота — КРУЧУ энкодер, отпустил —
// зафиксировано. Список любой длины, и освобождается ряд 5 под параметры.
// Две руки: левая держит адрес (какой слот), правая выбирает значение.
AW_MAX  = 25;     // последний id в jf_fx_airwindows.jsfx-inc (0 = пусто)
// ПАМЯТЬ РЕШАЕТ, что можно выбрать. У слайсера на канал слота AW_S слов, а
// эффектам с длинной линией задержки нужно больше: Chorus и Vibrato по 16386,
// Hull 4110. Выбрать такой = ЗАТЕРЕТЬ чужую память (соседние слоты и голоса),
// то есть случайный треск через минуту игры, а не честная тишина. Поэтому
// список фильтруется по ФАКТИЧЕСКОМУ требованию, а не по перечню исключений:
// вырастет AW_S — эффекты появятся сами, добавится новый жадный — отсеётся.
function aw_fits(id) ( fx_need_delay(id) <= AW_S - FXS_SZ );
mn_slot_held = -1;   // зажатый слот пути (0..3) или -1
mn_slice_held = -1;  // зажатый ПЭД СРЕЗА: адрес для исправления класса клавишей
cls_fix = -1;        // последний исправленный срез (подпись в окне)
ped_layer = 0;       // слой раскладки от педали экспрессии (CC11), 0..2
// PITCH WHEEL. Колесо — ОБЩИЙ орган, а не свойство ноты: оно тянет все
// звучащие срезы разом, как на любом синтезаторе. Поэтому хранится одним
// множителем скорости чтения, а не полем голоса.
src_chan = 0;        // канал, с которого пришла текущая нота (MPE)
pbend = 0;           // -1..+1, сырое положение колеса
pbmul = 1;           // множитель скорости: 2^(полутона/12)
// Пресет перебивает слайдер: у MPE-приборов диапазон задан прошивкой, и
// подгонять его числом каждый раз неудобно.
function pb_range() ( pbsel < 0.5 ? pbrange : pbsel < 1.5 ? 12 : pbsel < 2.5 ? 5 : 3 );
// ПЕДАЛЬ КАК ЖЕСТ THRU. Нажата — срезы играют насквозь, отпустил — снова
// по одному. Нога держит РЕЖИМ, руки играют: то же разделение, что у
// слоя раскладки. Своего слайдера не заводим — это модификатор, а не
// настройка, и залипать он не должен.
ped_thru = 0;
ped_str = 0;          // педаль-стретч: 1 = афтертач тянет срез
trig_rev = 0;         // «следующий запуск задом наперёд», одноразовый
// Перформанс-эффекты чёрных клавиш (chrom): 0 = не зажата, иначе нота+1
kb_rev_on = 0;       // ТОГГЛ реверса с чёрной C# (не удержание)
kb_ring = 0; kb_phase = 0; kb_sub = 0;
kb_crush = 0; kb_filt = 0; kb_tape = 0; kb_gt = 0;
kb_cnt = 0; kb_hl = 0; kb_hr = 0; kb_lpl = 0; kb_lpr = 0;
kb_tph = 0; kb_twr = 0; kb_gph = 0; kb_genv = 1;
kb_bp1 = 0; kb_bp2 = 0; kb_arc_slot = 0;
kb_rph = 0; kb_pph = 0; kb_sph = 0; kb_wr = 0;
memset(KBFXN, 0, 4);
// ── АРПЕДЖИАТОР: состояние ────────────────────────────────────────────────
arp_n = 0;            // сколько нот удерживается
arp_i = -1;           // индекс текущей ноты в проигрывании
arp_dir = 1;          // направление для up-down
arp_wait = 0;         // сэмплов до следующего шага
arp_note = -1;        // что сейчас звучит (чтобы снять по gate)
arp_gate_left = 0;    // сэмплов до снятия текущей ноты
arp_latch = 0;        // режим защёлки: ноты держатся после отпускания
arp_ped = 0;          // педаль сейчас нажата
arp_rand = 0;
pb_held = 0;          // какая клетка нижнего ряда держит бенд (0 = никакая)
fxdrag_from = -1;     // перетаскивание ячейки цепи: откуда
fxdrag_to = -1;       // и куда (обе позиции, не слоты)
// Списки чистим явно: непроинициализированная память читалась бы как
// набор «зажатых» нот, и арп заиграл бы сам собой при первом включении.
arp_i2 = 0;
while (arp_i2 < 32) ( ARPN[arp_i2] = 0; ARPV[arp_i2] = 0; ARPS[arp_i2] = 0; arp_i2 += 1; );
mn_mx_held = -1;     // зажатый МАСТЕР-слот (0..1) или -1
mn_slot_used = 0;    // за удержание уже листали: обычный выбор не применять
mn_awacc = 0;        // накопитель энкодера: 64 щелчка на оборот — слишком чутко
function aw_idx(k) ( k==0 ? FX_AW1 : k==1 ? FX_AW2 : k==2 ? FX_AW3 : FX_AW4 );
// Яркость LED среза по классу — «вес» удара с одного взгляда. Snare ярче всех,
// но ниже плейхеда (15), kick чуть тише, дальше остальные; без класса — тускло.
// Классы: 1 kick 2 snare 3 hat 4 perc 5 crash 6 ride 7 voice 8 fx.
function cls_led(cls) (
  cls == 2 ? 11 : cls == 1 ? 9 : cls == 5 ? 8 : cls == 6 ? 7 :
  cls == 4 ? 6 : cls == 7 ? 6 : cls == 8 ? 6 : cls == 3 ? 5 : 3;
);
function aw_slot(idx) ( idx==FX_AW1 ? 0 : idx==FX_AW2 ? 1 : idx==FX_AW3 ? 2 : idx==FX_AW4 ? 3 : -1 );
// ВОСЕМЬ ФИКСИРОВАННЫХ ЭФФЕКТОВ (решение пользователя 13 сен).
// Слоты Airwindows с выбором алгоритма убраны: для слайсера это «слишком
// много» — выбор из 25 алгоритмов, состояние на голос, фильтр по памяти,
// меню на 23 пункта. Свои двенадцать эффектов уже написаны и звучат.
// Путь A — ТЕМБР (что звук из себя представляет), путь B — ОКРАСКА и
// разрушение; кроссфейдер ведёт от одного характера к другому.
// Вне слотов остаются те, что двигают ПОЗИЦИЮ ЧТЕНИЯ, а не форму звука:
// stretch (он на афтертаче), stutter, glitch — и фильтр, который крутят
// постоянно и которому место на своей ручке.
NDISP = 4;        // слотов в UI: одна цепь из четырёх
KSNAP = 0.3;      // сила прилипания к точкам полосы: доля шага (см. knob)
NSNAP = 0;        // ТОЧКИ ВЫКЛЮЧЕНЫ у полос (15 сен: «снап — только для питчбенда»);
                  // механизм в knob() остаётся под кольцо питчбенда на arc
// ВОСЕМЬ ФИКСИРОВАННЫХ АЛГОРИТМОВ, по одному на слот. Выбора нет: у
// слайсера он был «слишком много» — 25 вариантов, меню, память под
// состояние. Алгоритмы взяты из библиотеки (код уже написан и проверен),
// но зашиты намертво, поэтому внешне это просто восемь эффектов.
//   путь A — ТЕМБР:   фильтр · сатурация · краш · компрессор
//   путь B — ОКРАСКА: ринг · вейвфолдер · «зуб» · ленточный шум
// ЧЕТЫРЕ ФИКСИРОВАННЫХ АЛГОРИТМА, по одному на слот, в порядке цепи:
// фильтр -> сатурация -> краш -> компрессор. Ровно то, что ставят на канал
// в этом порядке, поэтому объяснять ничего не нужно.
// ЧЕТЫРЕ АЛГОРИТМА В ПОРЯДКЕ ЦЕПИ (раскладка пользователя 13 сен):
//   1 CRUSH  DeRez3    — биткрашер: грязь берётся первой, пока сигнал целый
//   2 RING   RingMod   — кольцевая: даёт металл и негармоничный призвук
//   3 FILT   Capacitor2 — свип-фильтр: убирает то, что наделали выше
//   4 SHAPE  Point     — ТРАНЗИЕНТ-ШЕЙПЕР, лучший из библиотеки для ударных:
//            он работает с атакой напрямую, а не через порог и восстановление,
//            поэтому на барабанах подчёркивает удар без накачки.
// Слот UI -> индекс банка параметров. Банки остались прежними (0..7).
function disp_idx(d) ( d );
function aw_next_id(id) ( id += 1; id >= 17 ? id = 0; id == AW_SKIP ? id += 1; id; );
function aw_prev_id(id) ( id -= 1; id < 0 ? id = 16; id == AW_SKIP ? id -= 1; id; );

// voice fields
fA=0; fS=1; fPOS=2; fRATE=3; fTR=4; fENV=5; fST=6; fGL=7; fGR=8; fNOTE=9;
fVT=10; fPA=11; fPB=12; fPHA=13; fPHB=14; fBCC=15; fBHL=16; fBHR=17;
fPH1=18; fCEN=19; fEND=20; fVEL=21; fONOTE=22; fOCH=23; fOBUS=24;
fDIR=25; fSTART=26; fGRAN=27; fSATL=28; fSATR=29; fDNC=30; fDNL=31; fDNR=32;
fPH2=33; fPH3=34; fSTP=35; fSTC=36; fGLC=37; fGLP=38;
// Karlsen ladder state, 4 poles per channel (adapted from Filther / Ove Karlsen)
fK1L=39; fK2L=40; fK3L=41; fK4L=42;
fK1R=43; fK2R=44; fK3R=45; fK4R=46;
fBPL=47; fBPR=48;   // one-pole follower for the BP/NOTCH filter types
fMRND=57;           // per-hit random, held for the voice's life
fPAT=58;            // poly aftertouch этой ноты 0..1 → стретч голоса
fEPH=59;            // фаза ADSR: 0 атака · 1 спад · 2 удержание · 3 затухание
// РЕВЕРС ЭТОГО УДАРА, а не среза. Прежняя попытка подменяла OF_MODE на
// время запуска и сразу возвращала — но @sample читает режим ЗАНОВО КАЖДЫЙ
// СЭМПЛ, и к первому же сэмплу он уже восстановлен: голос стартовал назад,
// а wrap_pos тут же считал его прямым. Отсюда «реверс на чёрных не играет».
fREV=60;            // 1 = этот голос играет задом наперёд
// КАНАЛ, С КОТОРОГО ПРИШЛА НОТА (не fOCH — тот канал MIDI-ВЫХОДА среза).
// Нужен MPE: прибор шлёт давление и бенд на канал пальца, и адресовать их
// надо той ноте, что этим пальцем взята. Поле 61 — последнее свободное в
// VF=62; вырастет число полей — поднять VF.
fSCH=61;
// ФАЗА ГЕНЕРАТОРА PRECALC (SUB/TRI/SQR). Своя на голос: два срезa с
// подмесом звучат одновременно, и общая фаза дала бы биение между ними.
fPPH=62;
fNST=66;            // 26 окт: растяжение этой ноты (команда трекера SB): множитель времени
fNSF=67;            // ключ: = fMRND удара, которому fNST задан (новый удар — другой fMRND, растяжение не прилипает)
fATS=65;            // 26 окт: сила стретча давлением 0..1 — заливка волны жёлтый → красный (окно и трекер)
// МНОЖИТЕЛИ МИКРОФЛУКТУАЦИЙ этого удара: атака и спад чуть разные у каждого
// нажатия. Держим в голосе, а не считаем в @sample: случайность берётся
// ОДИН раз на удар, иначе огибающая дрожала бы внутри самой ноты.
fRNA=63; fRNK=64;

// DF1 biquad state for the Airwindows-style YN/ZN filter types
fNX1L=49; fNX2L=50; fNY1L=51; fNY2L=52;
fNX1R=53; fNX2R=54; fNY1R=55; fNY2R=56;

// СТРАХОВКА ОТ СЛЕДУЮЩЕЙ КОЛЛИЗИИ. Таблица срезов растёт с каждым новым
// полем, а соседи сверху — голоса (V0). Пересчитать вручную забывается
// (забылось 14 сен), поэтому считает плагин и пишет красным в статус.
// Заодно проверяем, что малые таблицы не вылезли из своего промежутка.
memerr = SL0 + NSLF*64 > V0 || V0 + NVOICE*VF > TBL || TBL + TBL_SZ > SCR ? 1 : 0;

!initdone ? (
  initdone = 1;
  cur = 0;
  cab_hold = 0; cab_used = 0;   // fx_hold / fx_sel ушли со слотами (25 окт)
  memset(CAB, 0, NCAB*3); memset(SRCV, 0, NSRC); memset(MODVIS, 0, NSRC);
  lfo1_ph = 0; lfo2_ph = 0; lfo1_rv = 0; lfo2_rv = 0;
  // ── ЗУМ ВОЛНЫ (просьба пользователя 17 сен) ────────────────────────────
  // «Рендер должен показываться сразу на волне» — он и показывался, но
  // НЕВИДИМО: при 370-секундной деке и ширине ~1900 колонок один срез в две
  // секунды занимает 2-3 пикселя. Правка нужна была не в рендере, а в
  // масштабе. wv_zoom = 0 весь материал, 1 только выделенный срез (с полями).
  wv_zoom = 0;
  dk_sel[0] = -1;
  memset(MSEL, 0, MSELST*2);
  dk_srate[0] = srate; dk_srate[1] = srate;
  pv_req = -1; pv_deck = 0; kb_req = -1; kb_off = -1;
  fld_active = -1;
  fxsel = FX_AW1;
  // мастер-слоты пустые: цепь не трогает звук, пока в неё что-то не поставят
  // ПОРЯДОК ЦЕПИ по умолчанию: слот на своей позиции, ничего не обойдено.
  // Все четыре ВЫКЛЮЧЕНЫ (amount 0): инструмент включается в тишине.
  mxk = 0;
  while (mxk < AW_NPP) ( CHORD[mxk] = mxk; CHBYP[mxk] = 0; mxk += 1; );
  // ЦЕПЬ ПО УМОЛЧАНИЮ в порядке обработки: грязь берётся первой, пока
  // сигнал целый; кольцевая даёт металл; фильтр убирает наделанное выше;
  // транзиент-шейпер в конце — лучший из библиотеки для ударных.
  CHALG[0] = FX_DEREZ3; CHALG[1] = FX_RINGMOD;
  CHALG[2] = FX_CAPACITOR2; CHALG[3] = FX_POINT;
  // ЭФФЕКТЫ ВЛИЯЮТ ТОЛЬКО НА ВСЕ СРЕЗЫ (решение пользователя 13 сен:
  // «отменяем по-срезовые эффекты, это слишком нагружает и мозг, и
  // процессор»). Режима SEL больше нет: цепь ведёт себя как обычная
  // цепочка на канале, и держать в голове «а какой срез сейчас правлю»
  // не нужно. Ограничение делает инструмент, а не мешает ему.
  // ПРАВКА ИДЁТ В ВЫДЕЛЕННЫЕ СРЕЗЫ, А НЕ ВО ВСЕ (правка 14 сен).
  // Было жёстко 1 — «переключателя больше нет», и apply_delta рассылал
  // любое движение ручки по ВСЕМ срезам: кнопки select/all/none/invert
  // ни на что не влияли. Отсюда обе жалобы пользователя разом: «выбираю
  // один слот эффекта — меняются все четыре» и «срезаю атаку, а разницы
  // между срезами нет». Правка физически не могла остаться на одном срезе.
  // Теперь 0: правится выделенный срез, а при явном выделении нескольких —
  // все выделенные (mb[i] в apply_delta). Кнопка «all» по-прежнему даёт
  // прежнее поведение, но это ВЫБОР, а не незаметное умолчание.
  edit_all = 0;
  tmap_x = 0.5; tmap_y = 0.5;
  task = 0;
  auto_det = 1;
  keysmode = 1;  // 0=chromatic, 1=white keys=slices / black keys=fx
  seq_len = 16; seq_divi = 2; seq_swing = 0; seq_hum = 0; seq_seed = 0;
  seq_run = 0; seq_tala = 8;   // rupak
  sq_i = 0; while (sq_i < 64) ( SQ_ACC[sq_i] = 1; sq_i += 1; );
);
// tala table, from jf_QuantumCut: vibhag lengths and which vibhags are khali
// (bit vi set). Filled every init -- it is a constant, not state.
function tala_def(i n a b c d e f km) local(t) (
  t = SQ_TALA + i*8;
  t[0]=n; t[1]=a; t[2]=b; t[3]=c; t[4]=d; t[5]=e; t[6]=f; t[7]=km;
);
tala_def(0, 4, 4,4,4,4,0,0, 4);        // tintal
tala_def(1, 4, 4,4,4,4,0,0, 4);        // tilwada
tala_def(2, 4, 4,4,4,4,0,0, 4);        // addha
tala_def(3, 4, 4,4,4,4,0,0, 4);        // punjabi theka
tala_def(4, 6, 2,2,2,2,2,2, 2|8);      // ektal
tala_def(5, 6, 2,2,2,2,2,2, 2|8);      // chautal
tala_def(6, 4, 2,3,2,3,0,0, 4);        // jhaptal
tala_def(7, 5, 2,2,2,2,2,0, 2|16);     // sultal
tala_def(8, 3, 3,2,2,0,0,0, 1);        // rupak
tala_def(9, 3, 3,2,2,0,0,0, 0);        // teevra
tala_def(10, 2, 4,4,0,0,0,0, 2);       // keherwa
tala_def(11, 2, 3,3,0,0,0,0, 2);       // dadra
tala_def(12, 4, 3,4,3,4,0,0, 4);       // deepchandi
tala_def(13, 4, 5,2,3,4,0,0, 4);       // dhamar
tala_def(14, 4, 3,4,3,4,0,0, 4);       // jhoomra
tala_def(15, 6, 2,2,2,2,2,2, 4|16|64); // ada chautal (7 vibhags: 6 stored + last folded)
tala_def(16, 4, 3,4,4,4,0,0, 2);       // pancham sawari
tala_def(17, 4, 3,4,3,4,0,0, 2);       // farodast
tala_def(18, 4, 6,6,2,3,0,0, 0);       // shikhar
tala_def(19, 4, 1,2,3,3,0,0, 0);       // basant
tala_def(20, 3, 4,2,2,0,0,0, 0);       // adi
tala_def(21, 2, 2,4,0,0,0,0, 0);       // rupaka carnatic
tala_def(22, 3, 3,2,2,0,0,0, 0);       // misra chapu
tala_def(23, 2, 2,3,0,0,0,0, 0);       // khanda chapu
tala_def(24, 1, 4,0,0,0,0,0, 0);       // eka
tala_def(25, 4, 4,2,4,4,0,0, 0);       // dhruva
tala_def(26, 3, 4,2,4,0,0,0, 0);       // matya
tala_def(27, 3, 7,1,2,0,0,0, 0);       // jhampa
tala_def(28, 3, 3,2,2,0,0,0, 0);       // triputa
tala_def(29, 3, 5,2,2,0,0,0, 0);       // khanda triputa
tala_def(30, 4, 5,5,2,2,0,0, 0);       // ata
// Computer keyboard laid out like REAPER's virtual MIDI keyboard: the z-row is
// the lower octave (z s x d c v g b h n j m = C..B), the q-row the upper one
// (q 2 w 3 e r 5 t 6 y 7 u i 9 o 0 p). Lower octave = the control octave (fx
// keys / stretch keys), upper = slices from C1. A key is turned into a MIDI
// note relative to the base note and sent through handle_on, so it behaves
// exactly like the same note from a controller.
function key_rel(ch) local(i r) (
  ch >= 65 && ch <= 90 ? ch += 32;
  r = -1; i = 0;
  while (i < 12 && r < 0) ( str_getchar("zsxdcvgbhnjm", i) == ch ? r = i; i += 1; );
  i = 0;
  while (i < 17 && r < 0) ( str_getchar("q2w3er5t6y7ui9o0p", i) == ch ? r = 12 + i; i += 1; );
  r;
);
// slice i -> its key on the upper rows (chromatic from q), 17 slices covered
// control-octave white key -> its letter, for the fx slot labels
// Подписи клавиш у слотов эффектов убраны вместе с самим жестом:
// показывать клавишу, которая ничего не делает, хуже, чем не показывать.
function fxkey_char(k) ( 0; );

// Map coordinates from the tala's own features, so neighbours sound related:
// x grows with the cycle length (matras), y with how irregular the vibhags are
// plus the khali share. A golden-ratio jitter per index keeps names apart.
tm_i = 0;
while (tm_i < SQ_NTALA) (
  tm_t = SQ_TALA + tm_i*8;
  tm_m = 0; tm_kh = 0; tm_irr = 0; tm_v = 0;
  while (tm_v < tm_t[0]) (
    tm_m += tm_t[1+tm_v];
    (tm_t[7] & (1 << tm_v)) ? tm_kh += 1;
    tm_v += 1;
  );
  tm_v = 0;
  while (tm_v < tm_t[0]) (
    tm_irr += abs(tm_t[1+tm_v] - tm_m/tm_t[0]);
    tm_v += 1;
  );
  tm_irr /= max(1, tm_m);
  SQ_TPOS[tm_i*2]   = min(0.95, max(0.05, (tm_m - 3)/14 * 0.8 + 0.08 + (tm_i*0.618 - floor(tm_i*0.618))*0.10));
  SQ_TPOS[tm_i*2+1] = min(0.95, max(0.05, tm_kh/max(1,tm_t[0])*0.45 + tm_irr*1.2 + 0.10 + (tm_i*0.382 - floor(tm_i*0.382))*0.12));
  tm_i += 1;
);

function tala_name(i dst) (
  i==0 ? strcpy(dst,"tintal/teental") : i==1 ? strcpy(dst,"tilwada") :
  i==2 ? strcpy(dst,"addha/sitarkhani") : i==3 ? strcpy(dst,"punjabi theka") :
  i==4 ? strcpy(dst,"ektal") : i==5 ? strcpy(dst,"chautal") : i==6 ? strcpy(dst,"jhaptal") :
  i==7 ? strcpy(dst,"sultal") : i==8 ? strcpy(dst,"rupak") : i==9 ? strcpy(dst,"teevra/tivra") :
  i==10 ? strcpy(dst,"keherwa/kaharva") : i==11 ? strcpy(dst,"dadra") :
  i==12 ? strcpy(dst,"deepchandi/dipchandi") : i==13 ? strcpy(dst,"dhamar") :
  i==14 ? strcpy(dst,"jhoomra/jhumra") : i==15 ? strcpy(dst,"ada chautal") :
  i==16 ? strcpy(dst,"pancham sawari") : i==17 ? strcpy(dst,"farodast") :
  i==18 ? strcpy(dst,"shikhar") : i==19 ? strcpy(dst,"basant") : i==20 ? strcpy(dst,"adi") :
  i==21 ? strcpy(dst,"rupaka carnatic") : i==22 ? strcpy(dst,"misra chapu") :
  i==23 ? strcpy(dst,"khanda chapu") : i==24 ? strcpy(dst,"eka") : i==25 ? strcpy(dst,"dhruva") :
  i==26 ? strcpy(dst,"matya") : i==27 ? strcpy(dst,"jhampa") : i==28 ? strcpy(dst,"triputa") :
  i==29 ? strcpy(dst,"khanda triputa") : strcpy(dst,"ata");
);

// ---- A/B fx scenes ----------------------------------------------------------
// Each slice carries two fx banks. Reading a parameter blends them at the
// crossfader position, so moving the fader morphs the entire chain on the one
// loaded loop. scn_a/scn_b are recomputed once per block in @block.
// AMOUNT of a slot, with its modulation shape applied. mv_ph is how far the
// playing voice is through its slice (0..1) and is set once per voice per
// sample; mv_rnd is that voice's per-hit random. Shapes: 1 fades out over the
// slice, 2 fades in, 3 triangle, 4 a fixed random level for this hit.
// ПАРАМЕТРЫ ПО ПУТИ, а не смесью двух наборов. Пути теперь независимы
// (см. @sample): путь A играет набор A, путь B — набор B. Смесь здесь была
// бы ошибкой: на середине фейдера обе цепи получили бы одинаковые
// усреднённые настройки, и разницы между ними не стало бы вовсе.
// Читаем глобальную awpath — в EEL2 это дешевле лишнего аргумента и не
// требует править все вызовы.
// ── МАТРИЦА МОДУЛЯЦИИ: ДВИЖОК ────────────────────────────────────────────
// ДВА УРОВНЯ, и это главное решение. Источники, общие на инструмент (LFO,
// modwheel, давление, бенд), считаются РАЗ В БЛОК: они меняются медленно, а
// на сэмпле их пересчёт стоил бы sin() × 16 голосов впустую. На сэмпле
// остаётся только сумма кабелей — и только для тех назначений, у которых
// кабель есть (mod_on: нет кабелей — нет и работы).
//
// Источники на ГОЛОС (огибающая, позиция в срезе, random, velocity) в общую
// таблицу не кладутся: у каждого голоса своё значение. Их подставляет
// mod_val() по номеру, уже внутри цикла голоса.
function lfo_shape(ph sh) (
  sh < 0.5 ? sin(2*$pi*ph) :
  sh < 1.5 ? (ph < 0.5 ? 4*ph - 1 : 3 - 4*ph) :      // треугольник -1..1
  sh < 2.5 ? 1 - 2*ph :                              // пила вниз
  sh < 3.5 ? (ph < 0.5 ? 1 : -1) :                   // меандр
             0;                                      // random: считается в @block
);

// раз в блок: продвинуть LFO и разложить общие источники по SRCV
function mod_block() local(d1 d2) (
  d1 = lfo1_hz / max(1, srate) * samplesblock;
  d2 = lfo2_hz / max(1, srate) * samplesblock;
  lfo1_ph += d1; lfo1_ph >= 1 ? (
    lfo1_ph -= floor(lfo1_ph);
    lfo1_sh > 3.5 ? lfo1_rv = rand(2) - 1;   // random: новое значение за период
  );
  lfo2_ph += d2; lfo2_ph >= 1 ? (
    lfo2_ph -= floor(lfo2_ph);
    lfo2_sh > 3.5 ? lfo2_rv = rand(2) - 1;
  );
  // в SRCV всё лежит в 0..1: двуполярные источники приводятся тут, один раз
  SRCV[SRC_LFO]  = (lfo1_sh > 3.5 ? lfo1_rv : lfo_shape(lfo1_ph, lfo1_sh)) * 0.5 + 0.5;
  SRCV[SRC_LFO2] = (lfo2_sh > 3.5 ? lfo2_rv : lfo_shape(lfo2_ph, lfo2_sh)) * 0.5 + 0.5;
  SRCV[SRC_MW]   = mw0;
  SRCV[SRC_AT]   = at0;
  SRCV[SRC_BEND] = pbend * 0.5 + 0.5;
  SRCV[SRC_STEP] = arp_n > 0 ? arp_i / max(1, arp_n) : 0;
);

// значение источника для ЭТОГО голоса (v уже выбран вызывающим)
function mod_val(src v) (
  src == SRC_VEL   ? v[fVEL] / 127 :
  src == SRC_ENV   ? v[fENV] :
  src == SRC_PHASE ? mv_ph :
  src == SRC_RND   ? v[fMRND] :
  src == SRC_AT    ? max(at0, v[fPAT]) :      // поли перебивает канальный
                     SRCV[src];
);

// сумма кабелей, идущих в назначение dst, для голоса v. Двуполярно:
// -1..+1 от глубины, потому что модуляция ДВИГАЕТ значение, а не задаёт его.
function mod_sum(dst v) local(k acc c) (
  acc = 0; k = 0;
  while (k < NCAB) (
    c = CAB + k*3;
    c[1] == dst && c[0] > 0 ? acc += (mod_val(c[0], v) * 2 - 1) * c[2];
    k += 1;
  );
  acc;
);

// ── СТРЕТЧ: ОКНО cycle И ВЫРАВНИВАНИЕ sync ───────────────────────────────
// cycle — «акаевский» циклический стретч: окно почти прямоугольное, с
// кроссфейдом в 8 % периода. Две головки сдвинуты на полпериода, и их окна
// В СУММЕ ВСЕГДА ДАЮТ ЕДИНИЦУ (спад одной лежит ровно под подъёмом другой) —
// громкость не дышит, а жёсткие склейки и есть тот металлический призвук.
// В нуле фазы окно равно нулю: головка перепрыгивает неслышно, как у Ханна.
function cyc_win(ph) (
  ph < 0.21 ? 0 : ph < 0.29 ? (ph - 0.21) * 12.5 : ph < 0.71 ? 1 : ph < 0.79 ? 1 - (ph - 0.71) * 12.5 : 0;
);

// sync — приём WSOLA: головка прыгает не точно на таймлайн, а туда, где
// новое зерно СОВПАДАЕТ ПО ФАЗЕ с тем, что сейчас играет вторая головка
// (ref). Ищем сдвиг ±8 мс с лучшей корреляцией. Цена посчитана: сдвиги через
// один, 24 умножения на сдвиг = ~8 тыс. операций на прыжок, прыжков ~30 в
// секунду на голос — четверть миллиона операций, на все 16 голосов копейки.
// Корреляция по левому каналу: для выравнивания фазы этого довольно.
function ws_align(g ref lo hi span) local(best bv d k acc a b sp) (
  sp = min(floor(srate*0.008), floor(span*0.25));
  b = floor(ref);
  best = 0; bv = -1000000000;
  b > lo && b + 100 < hi ? (
    d = -sp;
    while (d <= sp) (
      a = floor(g) + d;
      a > lo && a + 100 < hi ? (
        acc = 0; k = 0;
        while (k < 96) ( acc += cd_buf[(a+k)*2] * cd_buf[(b+k)*2]; k += 4; );
        acc > bv ? ( bv = acc; best = d; );
      );
      d += 2;
    );
  );
  g + best;
);

// СЛОТОВ ЭФФЕКТОВ (sfx_sb / sfx_prep / sfx_cell) БОЛЬШЕ НЕТ (25 окт).
// Срез шёл ЧЕРЕЗ слот Airwindows вместо сухого пути (поле OF_FXR), слоты
// были общими шинами с жёстким байпасом в три уровня. Теперь у каждого
// среза СВОЙ ВЫХОД, а обработку берёт контейнер REAPER: любой плагин,
// нативная автоматизация, цепи и plink'и трекера.

// ── АРТИКУЛЯТОРЫ: ДВИЖОК ─────────────────────────────────────────────────
// Три операции и больше ничего: снять снимок, надеть, снять обратно.
// Вся сложность артикуляции живёт в ДАННЫХ, а не в коде — поэтому тут
// нет ни одной ветки «если этот параметр, то по-особому».

// адрес слота
function art_at(k) ( ART0 + k*ART_W );

// СНЯТЬ СНИМОК в адрес a. Слайдеры подряд, потом таблицы.
// Слайдеров с дырами (16, 39, 86...) читать не страшно: несуществующий
// даёт 0 и при восстановлении уходит в никуда. Сплошной цикл не может
// разойтись со списком, когда появится новый слайдер, — а список мог бы.
function art_grab(a) local(i) (
  i = 0;
  while (i < ART_NSL) ( a[i] = slider(i+1); i += 1; );
  memcpy(a + ART_NSL,          CHORD, 4);
  memcpy(a + ART_NSL + 4,      CHBYP, 4);
  memcpy(a + ART_NSL + 8,      CHALG, 4);
  memcpy(a + ART_NSL + 12,     CAB,   NCAB*3);
);

// НАДЕТЬ снимок из адреса a.
// sliderchange(-1) уведомляет хост об ИЗМЕНЕНИИ ВСЕХ слайдеров сразу —
// иначе панель параметров REAPER показывала бы старые значения, а
// автоматизация не узнала бы о смене. Один вызов дешевле 85 отдельных.
function art_put(a) local(i kk) (
  i = 0;
  // 11 окт: slider11 (Input passthrough) — маршрутизация, не звук: снимок её не трогает
  // (иначе вызов снимка мог молча выключить проход аудио трека)
  while (i < ART_NSL) ( i != 10 ? slider(i+1) = a[i]; i += 1; );
  memcpy(CHORD, a + ART_NSL,      4);
  memcpy(CHBYP, a + ART_NSL + 4,  4);
  memcpy(CHALG, a + ART_NSL + 8,  4);
  memcpy(CAB,   a + ART_NSL + 12, NCAB*3);
  sliderchange(-1);
  // Здесь артикулятор пересобирал четыре слота Airwindows (sfx_prep), чтобы
  // первый блок после смены алгоритма не считался старым ядром по новым
  // коэффициентам. Слотов больше нет (25 окт) — пересобирать нечего.
  // mod_on НЕ трогаем: @block пересчитывает его из CAB каждый блок, и
  // выставленное здесь значение прожило бы меньше миллисекунды.
);

// НАКЛАДКА ОГИБАЮЩЕЙ. Артикулятор хранит атаку и релиз В СЕКУНДАХ, а
// срез — в 0..1 (время = v*v*0.5 для атаки и v*v*3 для релиза). Перевод
// здесь, в одном месте: диапазоны ручек можно будет поменять, не трогая
// артикуляторы.
// Дека одна (дека 1 мертва с 15 сен), поэтому адресуем SL0 напрямую:
// slb() определена ниже по файлу, а forward-ссылок в EEL2 нет.
function art_env_on(k) local(i a r) (
  a = ART_ENV[k*2]; r = ART_ENV[k*2 + 1];
  a >= 0 || r >= 0 ? (
    // «как было» — ВСЕГДА, даже если трогаем только атаку: снятие
    // возвращает оба поля одним memcpy, и половинчатое сохранение
    // вернуло бы релизу ноль.
    memcpy(ART_ESAV,      SL0 + OF_ATK, 64);
    memcpy(ART_ESAV + 64, SL0 + OF_REL, 64);
    i = 0;
    while (i < 64) (
      a >= 0 ? SL0[OF_ATK + i] = sqrt(a / 0.5);
      r >= 0 ? SL0[OF_REL + i] = sqrt(r / 3);
      i += 1;
    );
  );
);

function art_env_off(k) (
  ART_ENV[k*2] >= 0 || ART_ENV[k*2 + 1] >= 0 ? (
    memcpy(SL0 + OF_ATK, ART_ESAV,      64);
    memcpy(SL0 + OF_REL, ART_ESAV + 64, 64);
  );
);

// НАДЕТЬ артикулятор k. Снимок «как было» берётся ОДИН РАЗ, при первом
// надевании: иначе второй артикулятор поверх первого запомнил бы состояние
// первого, и отпускание вернуло бы не туда.
function art_on(k) (
  k >= 0 && k < ART_N && art_at(k)[ART_W-1] > 0.5 ? (
    // Смена артикулятора на лету: сначала возвращаем огибающую прежнего,
    // иначе его накладка осталась бы в срезах навсегда.
    art_cur >= 0 && art_cur != k ? art_env_off(art_cur);
    art_cur < 0 ? art_grab(ART_LIVE);
    art_put(art_at(k));
    art_env_on(k);
    art_cur = k;
  );
);

// СНЯТЬ: вернуть состояние до артикулятора.
function art_off() (
  art_cur >= 0 ? (
    art_env_off(art_cur);
    art_put(ART_LIVE);
    art_cur = -1;
  );
);

// ЗАПИСАТЬ текущее состояние в слот k (кнопка «save» в окне).
// Если сейчас надет другой артикулятор — пишем ЖИВОЕ состояние, то есть
// то, что слышно; это ровно то, чего ждёт рука.
function art_save(k) local(i amin amax rmin rmax) (
  k >= 0 && k < ART_N ? (
    art_grab(art_at(k));
    art_at(k)[ART_W-1] = 1;
    // ОГИБАЮЩАЯ ПОПАДАЕТ В АРТИКУЛЯТОР, только если она ОДНА НА ВСЕ СРЕЗЫ.
    // Разные ADSR у разных срезов — это их характер, а не артикуляция;
    // записать «одно число на всех» значило бы стереть его при надевании.
    amin = amax = SL0[OF_ATK]; rmin = rmax = SL0[OF_REL];
    i = 1;
    while (i < 64) (
      amin = min(amin, SL0[OF_ATK+i]); amax = max(amax, SL0[OF_ATK+i]);
      rmin = min(rmin, SL0[OF_REL+i]); rmax = max(rmax, SL0[OF_REL+i]);
      i += 1;
    );
    ART_ENV[k*2]     = amax - amin < 0.001 ? amax*amax*0.5 : -1;
    ART_ENV[k*2 + 1] = rmax - rmin < 0.001 ? rmax*rmax*3   : -1;
    // Слот, записанный поверх надетого, перестаёт быть «надетым»: иначе
    // отпускание вернуло бы состояние ДО записи и стёрло бы работу.
    art_cur == k ? art_cur = -1;
  );
);

function art_clear(k) (
  k >= 0 && k < ART_N ? (
    art_cur == k ? art_off();
    memset(art_at(k), 0, ART_W);
    ART_ENV[k*2] = -1; ART_ENV[k*2 + 1] = -1;
  );
);

function fxa(k i) local(o sh a) (
  o = k*64 + i;
  // ДВА БАНКА ОСТАЛИСЬ, но смысл другой: банк A — четыре слота цепи,
  // банк B — ПЕРФ-ЭФФЕКТЫ (stretch, fm, stutter, glitch). Их индексы
  // пересекаются с номерами слотов, поэтому они и живут отдельно.
  // awpath = 1 означает «читаем перф-эффект», а не «путь B».
  a  = awpath ? cd_sb[OF_FXA2 + o] : cd_sb[OF_FXA + o];
  sh = (awpath ? cd_sb[OF_MS2 + o] : cd_sb[OF_MS + o])|0;
  sh ? a * (
    sh == 1 ? 1 - mv_ph :
    sh == 2 ? mv_ph :
    sh == 3 ? 1 - abs(mv_ph*2 - 1) : mv_rnd
  ) : a;
);
function fxp(k i) local(o) (
  o = k*64 + i;
  awpath ? cd_sb[OF_FXP2 + o] : cd_sb[OF_FXP + o];
);
// per-slot dry/wet, folded together with the slice's own mix and the global one
function fxm(k i) local(o) (
  o = k*64 + i;
  (awpath ? cd_sb[OF_FXM2 + o] : cd_sb[OF_FXM + o]) * slice_wet;
);

// ---- waveshapers adapted from Filther (Joep Vanlier, MIT) -------------------
// Cheap enough to run per voice per sample, which is what a 16-voice sampler
// needs -- Filther's implicit/Newton-solved models are far too costly here.

// x / (1 + |2x|): soft, wide knee, no exp() at all
function f_fasttanh(x) ( x / (1 + abs(2*x)) );

// exp-based tanh; tighter knee than fasttanh, still one exp per call
function f_tanh(x) local(e) ( e = exp(-2*x); 2/(1+e) - 1 );

// polynomial tanh approximation (Filther's speedy_tanh)
function f_stanh(x) local(x2 x3 e) (
  x2 = x*x; x3 = x2*x;
  e = x + 0.16489087*x3 + 0.00985468*x2*x3;
  e * invsqrt(1 + e*e);
);

// sine wavefolder: keeps folding back on itself as drive rises
function f_fold(x) ( sin(2*$pi*x) );

// One DF1 biquad step on 4 state words at p: x1,x2,y1,y2 (Airwindows topology)
function bq_run(p x b0 b1 b2 a1 a2) local(y) (
  y = b0*x + b1*p[0] + b2*p[1] - a1*p[2] - a2*p[3];
  p[1] = p[0]; p[0] = x;
  p[3] = p[2]; p[2] = y;
  y;
);

// Karlsen ladder (Ove Hy Karlsen, via Filther): four one-pole sections around a
// clipped feedback path. p = base pointer to the 4 pole states, cut in 0..1,
// res is the feedback amount (>1 starts to self-oscillate).
function ladder(p x cut res) local(rez vnc) (
  rez = p[3] - x;
  x = x - rez*res;
  vnc = x;
  x = f_fasttanh(x);          // the clipper that gives it its character
  x = vnc + (x - vnc)*0.984;
  p[0] += (x    - p[0])*cut;
  p[1] += (p[0] - p[1])*cut;
  p[2] += (p[1] - p[2])*cut;
  p[3] += (p[2] - p[3])*cut;
  p[3];
);

function slb(d) ( SL0 + d*SLST );
SLB0 = SL0;        // адрес таблицы срезов для общего движка (дека одна)
function dbuf(d) ( BUF0 + d*DECKW );

// ОСНОВНАЯ ЧАСТОТА СРЕЗА для precalc. Автокорреляция по первым 40 мс: там
// тон удара, дальше он уже размыт хвостом. Ищем период в диапазоне 30..300
// Гц — всё, что имеет смысл подменять синусом; выше это уже не «вес», а
// призвук, и подмес слышен как фальшь.
// Считаем ОДИН РАЗ при нарезке, а не на сэмпл: precalc на то и precalc.
function slice_freq(d i) local(bf st_ n lag best bv acc k a b) (
  bf = dbuf(d);
  st_ = slb(d)[OF_START+i]|0;
  n = min(floor(dk_srate[d] * 0.04), max(0, (slb(d)[OF_END+i]|0) - st_));
  n < 256 ? 0 : (
    best = 0; bv = 0;
    // период в кадрах: от srate/300 до srate/30
    lag = floor(dk_srate[d] / 300);
    while (lag < floor(dk_srate[d] / 30) && lag < n/2) (
      acc = 0; k = 0;
      while (k < n - lag) (
        a = bf[(st_+k)*2]; b = bf[(st_+k+lag)*2];
        acc += a*b;
        k += 4;                      // каждый четвёртый: вчетверо дешевле,
      );                             // а период такой длины это не смажет
      acc > bv ? ( bv = acc; best = lag; );
      lag += 1;
    );
    best > 0 && bv > 0 ? dk_srate[d] / best : 0;
  );
);

function slice_defaults(d i) local(sb k) (
  sb = slb(d);
  sb[OF_PITCH+i]=0; sb[OF_GAIN+i]=0; sb[OF_PAN+i]=0;
  sb[OF_CHOKE+i]=0; sb[OF_CLASS+i]=0;
  // PRECALC выключен по умолчанию: включаешь ручкой, когда нужен вес.
  // Частота НЕ считается здесь: slice_defaults зовётся до calc_ends, и
  // конца среза ещё нет — мерить нечего. Плюс автокорреляция по 64 срезам
  // разом заметна в аудиопотоке. Считаем ЛЕНИВО, при первом включении
  // ручки precalc (0 = «ещё не считана»).
  sb[OF_STALG+i]=0; sb[OF_BSUB+i]=0; sb[OF_BPWM+i]=0; sb[OF_PBND+i]=0;
  sb[OF_BSNP+i]=0; sb[OF_BFUZ+i]=0; sb[OF_BBIT+i]=0; sb[OF_BPBD+i]=0; sb[OF_BCLP+i]=0; sb[OF_BPHS+i]=0;
  sb[OF_FXR+i]=0;
  sb[OF_PFRQ+i]=0; sb[OF_RND+i]=0; sb[OF_RSTATE+i]=0;
  // МАТРИЦА ПУТЕЙ ПУСТА ПО УМОЛЧАНИЮ (решение пользователя 13 сен): ни один
  // слот не считается, пока его amount не подняли. Алгоритм за слотом
  // закреплён навсегда (slot_fx), поэтому «пусто» — это нулевой amount,
  // а не нулевой id: включил ручку — эффект появился.
  sb[OF_FXSEL+i]=0; sb[OF_FXSEL+64+i]=0; sb[OF_FXSEL+128+i]=0; sb[OF_FXSEL+192+i]=0;
  sb[OF_FXSEL2+i]=0; sb[OF_FXSEL2+64+i]=0; sb[OF_FXSEL2+128+i]=0; sb[OF_FXSEL2+192+i]=0;
  sb[OF_MUTE+i]=0;
  sb[OF_MOUT+i]=0; sb[OF_MNUM+i]=36+i; sb[OF_MCHAN+i]=0; sb[OF_MBUS+i]=0;
  sb[OF_MODE+i]=0; sb[OF_OUTCH+i]=0; sb[OF_WET+i]=1;
  // ADSR по умолчанию = как звучало ДО его появления: мгновенная атака,
  // полное удержание, короткий хвост. Старые проекты не меняют звук.
  sb[OF_ATK+i]=0; sb[OF_DEC+i]=0; sb[OF_SUS+i]=1; sb[OF_REL+i]=0.02;
  sb[OF_FT+i]=0; sb[OF_FT2+i]=0;
  k = 0; while (k < NFX) ( sb[OF_MS+k*64+i]=0; sb[OF_MS2+k*64+i]=0; k += 1; );
  k = 0;
  while (k < NFX) (
    // stretch sits neutral at 0.5, everything else off, in both scenes; each
    // slot's mix starts fully wet so turning an amount up is immediately heard
    // банк A — только слоты пути A, все выключены (индекс 1 = sat, не stretch!)
    sb[OF_FXA+k*64+i]  = 0;
    sb[OF_FXP+k*64+i]  = 0.5;
    sb[OF_FXM+k*64+i]  = 1;
    sb[OF_FXK+k*64+i]  = 1;   // a held key takes the slot all the way by default
    sb[OF_FXA2+k*64+i] = k == FX_STRETCH ? 0.5 : 0;
    sb[OF_FXP2+k*64+i] = 0.5;
    sb[OF_FXM2+k*64+i] = 1;
    sb[OF_FXK2+k*64+i] = 1;
    k += 1;
  );
);

function sort_slices(d) local(sb i j k p t) (
  sb = slb(d);
  i = 1;
  while (i < dk_nsl[d]) (
    j = i;
    while (j > 0 && sb[OF_START+j-1] > sb[OF_START+j]) (
      k = 0;
      while (k < NSLF) (
        p = sb + k*64 + j;
        t = p[-1]; p[-1] = p[0]; p[0] = t;
        k += 1;
      );
      j -= 1;
    );
    i += 1;
  );
);

// ZERO-CROSS: ближайший переход через ноль к кадру fr, не дальше чем на
// win кадров. Ищем в обе стороны и берём тот, что ближе — сдвиг в одну
// сторону смещал бы весь срез, а тут правка в пределах миллисекунды.
// Смотрим ЛЕВЫЙ канал: на стерео-материале каналы почти всегда пересекают
// ноль рядом, а искать компромисс между двумя — значит не найти ни одного.
function zero_near(d fr win) local(bf i a b lo hi) (
  bf = dbuf(d);
  lo = -1; hi = -1;
  i = 1;
  while (i < win && (lo < 0 || hi < 0)) (
    // назад
    lo < 0 && fr - i > 1 ? (
      a = bf[(fr-i)*2]; b = bf[(fr-i+1)*2];
      (a <= 0 && b > 0) || (a >= 0 && b < 0) ? lo = fr - i + 1;
    );
    // вперёд
    hi < 0 && fr + i < dk_frames[d] - 1 ? (
      a = bf[(fr+i-1)*2]; b = bf[(fr+i)*2];
      (a <= 0 && b > 0) || (a >= 0 && b < 0) ? hi = fr + i;
    );
    i += 1;
  );
  lo < 0 && hi < 0 ? fr :
  lo < 0 ? hi :
  hi < 0 ? lo :
  (fr - lo) <= (hi - fr) ? lo : hi;
);

function calc_ends(d) local(sb i z) (
  sort_slices(d);
  sb = slb(d);
  // ZERO-CROSS СТАРТОВ (просьба пользователя 14 сен): срез, начатый посреди
  // волны, щёлкает — сигнал прыгает от нуля к текущему значению.
  // Правим ЗДЕСЬ, а не в каждом вызывающем: calc_ends зовётся после любой
  // правки границ — нарезка, перетаскивание, чоп на лету, — и одно место
  // накрывает все пути разом.
  // Двигаем только СТАРТЫ: конец каждого среза и так равен старту соседа.
  // Окно 128 кадров (≈3 мс при 44.1к): достаточно, чтобы найти переход даже
  // на басу, и мало, чтобы атака не уехала на слух.
  zerox > 0.5 && dk_frames[d] > 256 ? (
    i = 1;                              // срез 0 от нуля файла — не трогаем
    while (i < dk_nsl[d]) (
      z = zero_near(d, sb[OF_START+i]|0, 128);
      // не заезжаем на соседа: срез короче 64 кадров — это уже не срез
      z > sb[OF_START+i-1] + 64 && z < dk_frames[d] - 64 ? sb[OF_START+i] = z;
      i += 1;
    );
  );
  i = 0;
  while (i < dk_nsl[d]) (
    sb[OF_END+i] = i < dk_nsl[d]-1 ? sb[OF_START+i+1] : dk_frames[d];
    i += 1;
  );
);

// Keyboard activation point for a slot. Global rather than per slice: a control
// octave key acts on the whole instrument, so it reads the currently selected
// slice's setting -- the one whose sliders are on screen when you place the
// tick. Called from @block, so it takes the table itself rather than cd_sb.
// ТОЧКА АКТИВАЦИИ ОТ КЛАВИШИ. Полоса KEY из слота убрана (решение
// пользователя 13 сен: окно перегружено), но сам ЖЕСТ остаётся — белая
// клавиша управляющей октавы вводит эффект, взвешенно по velocity.
// Уровень теперь фиксированный (полный): настраивать его отдельной полосой
// на каждый слот — как раз та сложность, от которой избавляемся.
// ── АРПЕДЖИАТОР ───────────────────────────────────────────────────────────
// Держит список нажатых нот и играет их по одной в темп проекта. Ноты
// уходят тем же путём, что обычная игра (handle_on / release_note), поэтому
// арп автоматически получает всё: стретч, режимы среза, эффекты.
//
// ШАГ В СЭМПЛАХ от темпа проекта: так же считается сетка квантизации, и
// арп попадает ровно в те же линии, что и квантованные ноты.
function arp_step_samples() local(qb) (
  tempo > 0 ? (
    qb = 60/tempo * srate;                       // четверть в сэмплах
    arp_rate == 0 ? qb*4 : arp_rate == 1 ? qb*2 : arp_rate == 2 ? qb :
    arp_rate == 3 ? qb/2 : arp_rate == 4 ? qb/3 :
    arp_rate == 5 ? qb/4 : qb/8;
  ) : srate/4;                                   // нет темпа — 4 шага в секунду
);

// Добавить ноту в список. Повтор не дублируем: клавиатура шлёт нажатие
// повторно при автоповторе, и список бы распух.
function arp_add(note vel) local(i found) (
  found = 0; i = 0;
  while (i < 32) ( ARPN[i] == note + 1 ? found = 1; i += 1; );
  found ? 0 : (
    i = 0;
    while (i < 32 && ARPN[i] != 0) ( i += 1; );
    i < 32 ? ( ARPN[i] = note + 1; ARPV[i] = vel; arp_n += 1; );
  );
);

function arp_remove(note) local(i) (
  i = 0;
  while (i < 32) (
    ARPN[i] == note + 1 ? ( ARPN[i] = 0; ARPV[i] = 0; arp_n = max(0, arp_n - 1); );
    i += 1;
  );
);

function arp_clear() local(i) (
  i = 0; while (i < 32) ( ARPN[i] = 0; ARPV[i] = 0; i += 1; );
  arp_n = 0; arp_i = -1;
);

// Собрать играемый порядок в ARPS. Сортировка КОПИИ: порядок нажатия в
// ARPN остаётся нетронутым, иначе режим «as played» потерял бы смысл.
function arp_build() local(i j n t) (
  n = 0; i = 0;
  while (i < 32) ( ARPN[i] > 0 ? ( ARPS[n] = ARPN[i]; n += 1; ); i += 1; );
  // up и up-down: по возрастанию. down: по убыванию. as played: как есть.
  arp_mode < 3 ? (
    i = 0;
    while (i < n - 1) (
      j = 0;
      while (j < n - 1 - i) (
        ARPS[j] > ARPS[j+1] ? ( t = ARPS[j]; ARPS[j] = ARPS[j+1]; ARPS[j+1] = t; );
        j += 1;
      );
      i += 1;
    );
    arp_mode == 1 ? (                            // down: переворачиваем
      i = 0;
      while (i < n/2) ( t = ARPS[i]; ARPS[i] = ARPS[n-1-i]; ARPS[n-1-i] = t; i += 1; );
    );
  );
  n;
);

// АЛГОРИТМ СЛОТА ИЗ ПАМЯТИ. Раньше это была функция с зашитыми значениями,
// и слот нельзя было ни поменять, ни выбрать другой. Теперь массив: выбор
// живёт в памяти, переживает сохранение и меняется правым кликом.
//
// Объявлена в @init, потому что нужна ОБЕИМ секциям — и звуку (@sample), и
// окну (@gfx). В EEL2 нет forward-ссылок, а секции читаются подряд.
function slot_fx(k) ( CHALG[max(0, min(AW_NPP-1, k))]|0; );

function fxkey(k) ( 1 );

// ---- путь сэмпла: строка <-> gmem --------------------------------------
// gmem хранит только числа, поэтому путь едет посимвольно.
// 26 окт: команда — параметром. Превью слота ставило сначала 6 («загрузить») и потом 7:
// демон, прочитавший 6 между записями, грузил файл слота в деку — «Clean Amen» вместо амена
function path_send_cmd(str_ cmd) local(n i) (
  n = min(strlen(str_), PATH_MAX);
  gmem[PATH_LEN] = n;
  i = 0;
  while (i < n) ( gmem[PATH_CH + i] = str_getchar(str_, i); i += 1; );
  gmem[606] = mn_tok;                 // КТО заказал: ответ придёт ему одному
  gmem[7] = cmd;                      // 6 — загрузить этот путь, 7 — только превью слота
);
function path_send(str_) ( path_send_cmd(str_, 6); );
function path_recv(str_) local(n i) (
  n = min(gmem[PATH_LEN]|0, PATH_MAX);
  strcpy(str_, "");
  i = 0;
  while (i < n) (
    sprintf(#pr_tmp, "%c", gmem[PATH_CH + i]|0);
    strcat(str_, #pr_tmp);
    i += 1;
  );
  n;
);
// имя файла без папки и расширения — подпись слота. strchr в EEL2 нет,
// ищем последний '/' циклом.
function path_base(src_ dst_) local(n i k e) (
  n = strlen(src_); k = 0; i = 0;
  while (i < n) ( str_getchar(src_, i) == 47 ? k = i + 1; i += 1; );
  e = n; i = n - 1;
  while (i > k) ( str_getchar(src_, i) == 46 && e == n ? e = i; i -= 1; );
  strcpy_substr(dst_, src_, k, e - k);
);

// ---- multi-select ----------------------------------------------------------
// MSEL holds one flag per slice; dk_sel stays the anchor (the slice the editor
// panel displays and the one edits are measured against). Invariant: whenever a
// selection exists the anchor is part of it, so "one selected" is just a mask
// with a single flag and every edit path can stay uniform.
function msel_base(d) ( MSEL + d*MSELST );

function msel_clear(d) ( memset(msel_base(d), 0, MSELST); );

// collapse to a single slice: the usual plain-click / programmatic selection
function msel_only(d i) local(mb) (
  mb = msel_base(d);
  memset(mb, 0, MSELST);
  i >= 0 && i < MAXSL ? mb[i] = 1;
  dk_sel[d] = i;
);

function msel_count(d) local(mb i n) (
  mb = msel_base(d); i = 0; n = 0;
  while (i < dk_nsl[d]) ( mb[i] ? n += 1; i += 1; );
  n;
);

// keep the mask inside the current slice count and the anchor inside the mask
function msel_validate(d) local(mb i n) (
  mb = msel_base(d);
  i = dk_nsl[d];
  while (i < MAXSL) ( mb[i] = 0; i += 1; );
  dk_sel[d] >= dk_nsl[d] ? dk_sel[d] = dk_nsl[d]-1;
  n = msel_count(d);
  n == 0 ? (
    dk_sel[d] >= 0 ? mb[dk_sel[d]] = 1;
  ) : (
    // anchor fell outside the mask: adopt the lowest selected slice
    dk_sel[d] < 0 || !mb[dk_sel[d]] ? (
      i = 0;
      while (i < dk_nsl[d]) ( mb[i] ? ( dk_sel[d] = i; i = dk_nsl[d]; ) : i += 1; );
    );
  );
);

function msel_toggle(d i) local(mb) (
  mb = msel_base(d);
  i >= 0 && i < dk_nsl[d] ? (
    mb[i] = mb[i] ? 0 : 1;
    mb[i] ? dk_sel[d] = i : msel_validate(d);
  );
);

// SELECT menu actions. mode: 0=all 1=none 2=invert, 10+c = class c (1..5),
// 20=short, 21=long. Short/long split at the mean slice length of the deck,
// which adapts to the material instead of hardcoding a duration.
function msel_action(d mode) local(mb i n avg len) (
  mb = msel_base(d);
  mode == 0 ? (
    i = 0;
    while (i < dk_nsl[d]) ( mb[i] = 1; i += 1; );
  ) : mode == 1 ? (
    memset(mb, 0, MSELST);
  ) : mode == 2 ? (
    i = 0;
    while (i < dk_nsl[d]) ( mb[i] = mb[i] ? 0 : 1; i += 1; );
  ) : mode >= 10 && mode < 20 ? (
    i = 0;
    while (i < dk_nsl[d]) ( mb[i] = slb(d)[OF_CLASS+i] == mode-10 ? 1 : 0; i += 1; );
  ) : mode >= 20 ? (
    avg = 0; n = 0; i = 0;
    while (i < dk_nsl[d]) (
      avg += slb(d)[OF_END+i] - slb(d)[OF_START+i];
      n += 1; i += 1;
    );
    n > 0 ? (
      avg /= n;
      i = 0;
      while (i < dk_nsl[d]) (
        len = slb(d)[OF_END+i] - slb(d)[OF_START+i];
        mb[i] = (mode == 20 ? len < avg : len >= avg) ? 1 : 0;
        i += 1;
      );
    );
  );
  msel_validate(d);
);

// Apply an edit made on the anchor to every selected slice.
// Continuous fields (pitch/gain/pan/fx amounts) move by the DELTA the user just
// dragged, so the group keeps its internal relative differences and only shifts.
// Enum fields (mode/class/choke/midi/bus) instead take the anchor's new value
// verbatim -- nudging an enum by a delta would be meaningless.
// ── ЧТО ВИЖУ, ТО И ПОЛУЧАЮ (правка 15 сен по жалобе пользователя) ──────
// Было: правка шла ДЕЛЬТОЙ ко всем выделенным. У каждого среза своё
// значение, поэтому «поставил −6 дБ» означало «сдвинул каждый на столько,
// на сколько сдвинулся этот» — на экране одно число, в памяти разные, а
// двойной клик сбрасывал их в разные места. Теперь ставим АБСОЛЮТНОЕ
// значение: слайдер показывает правду для всей выделенной группы.
//
// И ТОЛЬКО ВЫДЕЛЕННЫМ: edit_all из условия убран. Раньше при выключенном
// выделении правка всё равно расползалась на соседние срезы («меняю на
// первом — меняется на втором, третьем»). Выделил один — меняется один.
// Имя apply_delta сохранено: его зовут больше сорока раз, а смысл
// вызывающего («вот старое, вот новое») не изменился.
function apply_delta(d off oldv newv lo hi) local(mb sb i) (
  newv != oldv ? (
    mb = msel_base(d); sb = slb(d);
    i = 0;
    while (i < dk_nsl[d]) (
      mb[i] && i != dk_sel[d] ? sb[off+i] = min(hi, max(lo, newv));
      i += 1;
    );
  );
);

function apply_set(d off oldv newv) local(mb sb i) (
  newv != oldv ? (
    mb = msel_base(d); sb = slb(d);
    i = 0;
    while (i < dk_nsl[d]) (
      mb[i] && i != dk_sel[d] ? sb[off+i] = newv;
      i += 1;
    );
  );
);

// only forget the pending note-off once it is actually queued, otherwise a full
// queue would silently drop it and leave the note hanging on the MIDI target
function qpush(v) local(q) (
  qn < 32 ? (
    q = qoff + qn*3;
    q[0] = v[fOBUS]; q[1] = v[fOCH]; q[2] = v[fONOTE]-1;
    qn += 1;
    v[fONOTE] = 0;
  );
);

// stop every voice of one deck: its buffer/slice table is about to change
// underneath them, and their fSTART/fEND/fS still point into the old content.
// Callers live in @gfx and @block too, so this only flags the release stage --
// the pending MIDI note-off stays the audio thread's job (see qpush), and the
// voice is parked at slice start so the release reads in-bounds either way.
function kill_deck(d) local(vi v) (
  vi = 0;
  while (vi < NVOICE) (
    v = V0 + vi*VF;
    v[fA] ? (
      v[fENV] = 0;   // silent immediately; @sample retires it next sample
      v[fST] = 3;
      v[fPOS] = v[fSTART]; v[fVT] = v[fSTART];
      v[fPA] = v[fSTART]; v[fPB] = v[fSTART];
    );
    vi += 1;
  );
);

function del_slice(d idx) local(sb j k p v) (
  sb = slb(d);
  // voices from idx up are about to be reindexed under them: release them
  // rather than let a held note silently become the neighbouring slice
  j = 0;
  while (j < NVOICE) (
    v = V0 + j*VF;
    v[fA] && v[fS] >= idx ? v[fST] = 3;
    j += 1;
  );
  j = idx;
  while (j < dk_nsl[d]-1) (
    k = 0;
    while (k < NSLF) (
      p = sb + k*64 + j;
      p[0] = p[1];
      k += 1;
    );
    j += 1;
  );
  dk_nsl[d] -= 1;
  // the mask indexes slices too, so it has to shift with them
  j = idx;
  while (j < dk_nsl[d]) ( msel_base(d)[j] = msel_base(d)[j+1]; j += 1; );
  msel_base(d)[dk_nsl[d]] = 0;
  msel_validate(d);
  calc_ends(d);
);

function add_slice(d fr) local(sb i) (
  sb = slb(d);
  dk_nsl[d] < MAXSL && dk_frames[d] > 0 ? (
    fr = max(0, min(dk_frames[d]-64, floor(fr)));
    sb[OF_START+dk_nsl[d]] = fr;
    slice_defaults(d, dk_nsl[d]);
    dk_nsl[d] += 1;
    calc_ends(d);
    i = 0; dk_sel[d] = 0;
    while (i < dk_nsl[d]) ( sb[OF_START+i] == fr ? dk_sel[d] = i; i += 1; );
    msel_only(d, dk_sel[d]);
  );
);

// ── ЧОП НА ЛЕТУ (просьба пользователя 14 сен, как у SP-404 mk2) ─────────
// ГДЕ СЕЙЧАС ЗВУЧИТ: позиция чтения самого свежего активного голоса.
// Именно её слышит ухо, поэтому метка ставится туда, а не на таймлайн
// проекта — тот к сэмплу отношения не имеет.
// Берём ПЕРВЫЙ АКТИВНЫЙ ГОЛОС НЕ В РЕЛИЗЕ — тот, что звучит под пальцем.
// fST это СТАДИЯ огибающей (1 атака, 3 релиз), а не время старта: сначала
// я сортировал по нему как по времени — неверно, отпущенный срез с длинным
// хвостом перебивал бы зажатый.
function play_frame() local(v i) (
  i = 0;
  while (i < TLVOICE) (
    v = V0 + i*VF;
    v[fA] > 0.0001 && v[fST] != 3 ? ( i = TLVOICE + 100 + i; ) : i += 1;
  );
  i >= TLVOICE + 100 ? floor(V0[(i - TLVOICE - 100)*VF + fPOS]) : -1;
);

// ЧОП: поставить срез там, где сейчас играет. Если ничего не звучит —
// вернуть 0, вызывающий решит, что делать (обычно запустить с начала).
function chop_here(d) local(fr) (
  fr = play_frame();
  fr >= 0 && dk_frames[d] > 0 ? ( add_slice(d, fr); 1; ) : 0;
);

function import_markers(d) local(sb n i p) (
  sb = slb(d);
  n = min(gmem[2], MAXSL);
  dk_frames[d] > 0 && n > 0 ? (
    kill_deck(d);  // slice table is rebuilt from scratch below
    dk_nsl[d] = 0;
    i = 0;
    while (i < n) (
      p = floor(gmem[8+i] * dk_srate[d]);
      p >= 0 && p < dk_frames[d] ? (
        sb[OF_START+dk_nsl[d]] = p;
        slice_defaults(d, dk_nsl[d]);
        dk_nsl[d] += 1;
      );
      i += 1;
    );
    calc_ends(d);
    msel_only(d, dk_nsl[d] > 0 ? 0 : -1);
  );
);

// preset_save / preset_load / preset_clear удалены 15 сен вместе с банком PRE.

// ---- РАСКЛАДКА ПО КЛАССАМ (keysmode == 2) --------------------------------
// Кик ВСЕГДА на C2, снейр на D2, хэт на E2 и так далее — независимо от того,
// в каком порядке удары лежат в брейке. Причина: брейки разные, порядок
// ударов в них разный, а кик остаётся киком. Адрес по СМЫСЛУ, а не по
// позиции в файле — тогда мышечная память переносится между брейками, и не
// нужно каждый раз заново искать, где тут бочка.
//
// Белая клавиша -> класс: C=kick D=snare E=hat F=perc G=crash A=ride B=voice.
CLS_KEY[0] = 1;              // C  kick
CLS_KEY[1] = 2;              // D  snare
CLS_KEY[2] = 3;              // E  hat
CLS_KEY[3] = 4;              // F  perc
CLS_KEY[4] = 5;              // G  crash
CLS_KEY[5] = 6;              // A  ride
CLS_KEY[6] = 7;              // B  voice
// полутон белой ступени в октаве: C D E F G A B
WHITE_PC[0] = 0; WHITE_PC[1] = 2; WHITE_PC[2] = 4; WHITE_PC[3] = 5;
WHITE_PC[4] = 7; WHITE_PC[5] = 9; WHITE_PC[6] = 11;

// белая ступень (0..6) по полутону, или -1 если чёрная
function white_step(pc) (
  pc == 0 ? 0 : pc == 2 ? 1 : pc == 4 ? 2 : pc == 5 ? 3 :
  pc == 7 ? 4 : pc == 9 ? 5 : pc == 11 ? 6 : -1;
);

// ПЕРВЫЙ срез класса. Детерминированно, без round-robin: под пальцем должно
// быть одно и то же место, иначе смысл фиксированной раскладки теряется.
// n-й по счёту (nth = 0 — первый) — для октав выше базовой.
function cls_first(cls nth) local(i k r) (
  i = 0; k = 0; r = -1;
  while (i < dk_nsl[0] && r < 0) (
    slb(0)[OF_CLASS+i] == cls ? ( k == nth ? r = i : k += 1; );
    i += 1;
  );
  r;
);

// НОТА -> СРЕЗ. Возвращает номер среза, либо специальный код:
//   -1          ничего не играть
//   -2000 - N   срез N задом наперёд (реверс)
//   -3000 - N   срез N как ЛУП с этой позиции (оригинальный темп)
// Снятие перформанс-эффектов чёрных клавиш. Держим НОМЕР НОТЫ+1, поэтому
// отпускание чужой клавиши не гасит чужой эффект (перекат пальца), а ноль
// значит «не зажата» — 0 это валидная нота C-1.
function kb_fx_off(note) (
  kb_i = 0;
  while (kb_i < 4) ( KBFXN[kb_i] == note + 1 ? KBFXN[kb_i] = 0; kb_i += 1; );
);

function map_note(note) local(rel pc st_ oct sl) (
  rel = note - basenote_a;
  keysmode < 0.5 ? (
    // ── CHROM (переделано 16 сен, решение пользователя) ────────────────
    // СРЕЗЫ ТОЛЬКО НА БЕЛЫХ, две октавы подряд: 14 срезов без пропусков и
    // без «а эта чёрная чей реверс». Раньше чёрные были заняты реверсом —
    // поэтому просьба «слайсы только на белых» и не выполнялась.
    //
    // ЧЁРНЫЕ — УПРАВЛЕНИЕ, по октавам:
    //   октава 1 (C2)  пока клавиша ЗАЖАТА:
    //     C#  РЕВЕРС-МОДИФИКАТОР: следующие нажатые срезы играют задом
    //         наперёд (не действие само по себе — уточнение 16 сен)
    //     D#  ring · F#  phase shift (амижный съезд фазы)
    //     G#  loop ping-pong (тоггл) · A#  суб-модуляция, глубина по аftertouch
    //   октава 2 (C3)  АРПЕДЖИАТОР, ступень скорости (включает арп):
    //     C# 1/4 · D# 1/16 · F# 1/32 · G# 1/64 · A# 1/128
    // Выше и ниже чёрные молчат: лучше тишина, чем случайный эффект под
    // пальцем, когда ушёл в другую октаву.
    rel < 0 ? -1 : (
      pc = rel % 12; oct = floor(rel / 12);
      st_ = white_step(pc);
      st_ >= 0 ? oct*7 + st_ : (
        oct == 1 ? -6000 - pc :
        oct == 2 ? -5000 - (pc == 1 ? 2 : pc == 3 ? 5 : pc == 6 ? 6 : pc == 8 ? 7 : 8) :
        -1;
      );
    );
  ) : keysmode > 1.5 ? (
    // CLASS. Две октавы отвечают на РАЗНЫЕ вопросы:
    //   C2-B2  УАНШОТЫ: белая = первый срез класса, чёрная = он же реверсом;
    //   C3-B3  ЛУП: тот же адрес, но запускает ОРИГИНАЛЬНЫЙ луп с этой
    //          позиции. Один и тот же палец играет либо удар, либо всю фразу
    //          с этого удара — октава и есть переключатель «деталь / целое».
    //   C4+    третий и дальше срез того же класса (второй кик, третий хэт).
    rel < 0 ? -1 : (
      pc = rel % 12; oct = floor(rel / 12) + ped_layer;
      st_ = white_step(pc);
      st_ >= 0 ? (
        oct == 1 ? ( sl = cls_first(CLS_KEY[st_], 0); sl >= 0 ? -3000 - sl : -1; )
                 : cls_first(CLS_KEY[st_], oct > 1 ? oct - 1 : 0);
      ) : oct == 1 ? (
        // ЧЁРНЫЕ ВТОРОЙ ОКТАВЫ = СКОРОСТЬ АРПЕДЖИАТОРА (решение
        // пользователя 14 сен). Первая октава уже отдала чёрные реверсу, а
        // здесь они были свободны: белые играют луп, чёрным делать нечего.
        // Пять чёрных — пять ступеней подряд, слева направо быстрее.
        //   C#  1/4 · D#  1/8 · F#  1/8T · G#  1/16 · A#  1/32
        -5000 - (pc == 1 ? 2 : pc == 3 ? 3 : pc == 6 ? 4 : pc == 8 ? 5 : 6);
      ) : (
        // чёрная: ближайшая белая СЛЕВА, тот же срез, но задом наперёд
        st_ = white_step(pc - 1);
        st_ >= 0 ? (
          sl = cls_first(CLS_KEY[st_], oct > 1 ? oct - 1 : 0);
          sl >= 0 ? -2000 - sl : -1;
        ) : -1;
      );
    );
  ) : rel < 0 ? -1 : rel < 12 ? (
    // PIANO, управляющая октава: чёрные — стретч, белые свободны
    -1000 - rel;
  ) : rel - 12;                           // PIANO: срезы от следующей октавы
);

// СРЕЗ -> НОТА. Обратная map_note для белых клавиш: нужна пэдам, окну и
// экспорту MIDI, чтобы подписи и ноты сходились с тем, что реально играет.
function slice_note(idx) local(oct st_) (
  keysmode < 0.5 ? (
    oct = floor(idx / 7); st_ = idx % 7;
    basenote_a + oct*12 + WHITE_PC[st_];
  ) : keysmode > 1.5 ? (
    st_ = 0;
    while (st_ < 7 && cls_first(CLS_KEY[st_], 0) != idx) ( st_ += 1; );
    st_ < 7 ? basenote_a + 12 + WHITE_PC[st_] : basenote_a + 24 + idx;
  ) : basenote_a + 12 + idx;
);

// СЛОЙ РАСКЛАДКИ — здесь, а НЕ в общем движке: он знает про классы, лупы,
// реверс и стретч чёрных клавиш, то есть про слайсер, а не про голоса.
// Сам движок подключён в заголовке файла (import допустим только там).



// black key -> held stretch factor: C#=1x D#=1.5x F#=2x G#=4x A#=8x.
// Pushes the whole instrument into the granular path at that ratio while the
// key is down, the same mechanism aftertouch uses; 1x is a "granular but not
// slower" texture. Release and the voices drop back to direct reading.
function blackstr(pc) (
  pc == 1 ? 1 : pc == 3 ? 1.5 : pc == 6 ? 2 : pc == 8 ? 4 : 8;
);



// 26 окт: CC 102 — клавиша ноты, к которой относятся следующие CC 103..108 этого канала
// (трекер ставит их перед нотой): 103 offset (/128 среза), 104 pan (64 центр), 105 vol (64 = 1),
// 106 fine (64 = 0, шаг 2 цента), 107 reverse (>= 64), 108 stretch (2^((v-64)/16))
function np_cc(ch cc val) local(i e f) (
  cc == 102 ? (
    f = -1; i = 0;
    while (i < NPN && f < 0) ( e = NPB + i*8; e[0] == val && e[1] == ch ? f = i; i += 1; );
    i = 0; while (i < NPN && f < 0) ( e = NPB + i*8; e[0] < 0 ? f = i; i += 1; );
    f < 0 ? f = 0;   // все заняты (ноты так и не пришли) — затираем первую
    e = NPB + f*8; memset(e, -1, 8); e[0] = val; e[1] = ch;
    np_cur = f;
  ) : np_cur >= 0 ? (
    e = NPB + np_cur*8;
    e[1] == ch ? e[cc - 101] = val;
  );
);
function np_apply(s note) local(i e f v vi len p0 vol pl pr pn fr c) (
  f = -1; i = 0;
  while (i < NPN && f < 0) ( e = NPB + i*8; e[0] == note && e[1] == src_chan ? f = i; i += 1; );
  f >= 0 ? (
    e = NPB + f*8;
    vi = 0; v = -1;
    while (vi < NVOICE && v < 0) ( (V0 + vi*VF)[fA] && (V0 + vi*VF)[fNOTE] == note && (V0 + vi*VF)[fS] == s && (V0 + vi*VF)[fENV] == 0 ? v = V0 + vi*VF; vi += 1; );
    v >= 0 ? (
      len = max(1, v[fEND] - v[fSTART]);
      e[6] >= 64 ? ( v[fREV] = 1; v[fDIR] = -1; );
      fr = e[2] >= 0 ? e[2] / 128 : 0;
      (e[6] >= 64 || e[2] >= 0) ? (
        p0 = v[fDIR] < 0 ? v[fEND] - 2 - fr*len : v[fSTART] + fr*len;
        v[fPOS] = p0; v[fVT] = p0; v[fPA] = p0; v[fPB] = p0;
      );
      (e[3] >= 0 || e[4] >= 0) ? (
        pn = SLB0[OF_PAN + s];
        vol = (v[fGL] + v[fGR]) / max(0.001, 2 - abs(pn));
        e[3] >= 0 ? pn = max(-1, min(1, pn + (e[3] - 64) / 64));
        e[4] >= 0 ? vol *= e[4] / 64;
        pl = min(1, 1 - pn); pr = min(1, 1 + pn);
        v[fGL] = vol*pl; v[fGR] = vol*pr;
      );
      e[5] >= 0 ? ( c = pow(2, (e[5] - 64) * 2 / 1200); v[fTR] *= c; v[fRATE] *= c; );
      e[7] >= 0 ? ( v[fNST] = pow(2, (e[7] - 64) / 16); v[fNSF] = v[fMRND]; );
    );
    memset(e, -1, 8);
    np_cur == f ? np_cur = -1;
  );
);
function handle_on(note vel ofs) local(s pc k sl ov st_) (
  // ИСПРАВЛЕНИЕ КЛАССА. Распознавание вероятностно: рим-шот путается со
  // снейром, открытый хэт с крэшем. Поэтому жест исправления должен быть
  // в одно движение — держу пэд среза (моном/клавиатура), жму белую клавишу
  // класса, и срез переезжает на своё место. Тот же жест, что набор нот в
  // аранжировщике: одна рука держит адрес, другая задаёт значение.
  // Идёт ПЕРВЫМ и звука не даёт: это правка, а не игра.
  st_ = (keysmode > 1.5 && mn_slice_held >= 0) ? white_step((note - basenote_a) % 12) : -1;
  st_ >= 0 ? (
    slb(0)[OF_CLASS + mn_slice_held] = CLS_KEY[st_];
    cls_fix = mn_slice_held;            // для подписи в окне
  ) : (
  s = map_note(note);
  s >= 0 ? (
    // зажата C# — этот удар идёт задом наперёд. Ставим КАЖДЫЙ раз: движок
    // гасит trig_rev сразу после запуска (он одноразовый по замыслу).
    kb_rev_on ? trig_rev = 1;
    trigger_slice(0, s, vel, note, ofs);
    np_apply(s, note);   // 26 окт: команды трекера на эту ноту (offset, pan, vol, fine, reverse, stretch)
    // 26 окт: follow (как в слайсере трекера) — сыгранный срез становится выбранным; выкл — не тянем
    follow_on ? msel_only(0, s);
  ) : s <= -3000 ? (
    // ЛУП С ЭТОЙ ПОЗИЦИИ (октава C3-B3 в режиме CLASS). Не отдельный звук, а
    // та же фраза, пущенная от выбранного удара: прыжок плейхеда по сетке,
    // тем же путём, что клик по пэду при tsync.
    sl = -3000 - s;
    sl >= 0 && sl < dk_nsl[0] ? (
      tsync ? (
        tl_jump = sl;
        tl_jump_pos = qstep > 0 ? ceil(play_position*srate / qstep) * qstep : 0;
      ) : (
        // транспорт не синхронизирован — играем срез длиной до конца лупа,
        // иначе клавиша молчала бы и было бы непонятно, почему
        trigger_slice(0, sl, vel, note, ofs);
      );
      0;
    );
  ) : s <= -6000 ? (
    // ── ЧЁРНЫЕ ОКТАВЫ C2: ПЕРФОРМАНС, пока клавиша зажата ───────────────
    // Держатся до отпускания: это игра, а не настройка, и палец обязан
    // возвращать звук — иначе на сцене останешься с включённым ring и не
    // вспомнишь, чем его гасить. Номер чёрной приходит полутоном (1,3,6,8,10).
    // C# РЕВЕРС — именно МОДИФИКАТОР: сам звука не даёт, а разворачивает
    // те срезы, которые нажмёшь, пока он зажат.
    pc = -6000 - s;
    // C# — ТОГГЛ РЕВЕРСА (16 сен): нажал — все срезы играют задом наперёд,
    // нажал ещё раз — обратно. Удержание не годилось: реверс нужен на целую
    // фразу, а держать клавишу всё это время нечем — остальные пальцы заняты.
    pc == 1 ? ( kb_rev_on = !kb_rev_on ) : (
      // СЛОТ по номеру чёрной: D# F# G# A# = 1..4. Держится, пока зажата.
      kb_slot = pc == 3 ? 1 : pc == 6 ? 2 : pc == 8 ? 3 : 4;
      KBFXN[kb_slot - 1] = note + 1;
    );
    0;
  ) : s <= -5000 ? (
    // СКОРОСТЬ АРПЕДЖИАТОРА С КЛАВИАТУРЫ (чёрные второй октавы в режиме
    // CLASS). Звука не даёт — это настройка, а не игра. Заодно ВКЛЮЧАЕТ
    // арп: нажал ступень и сразу слышишь её.
    //
    // ПОРЯДОК ВЕТОК ВАЖЕН: -5000 МЕНЬШЕ -2000, поэтому проверять его надо
    // РАНЬШЕ. Сначала я вставил эту ветку после реверса — и «s <= -2000»
    // перехватывал всё подряд, обнулив реверс, который только что чинил.
    arp_rate = max(0, min(6, -5000 - s));
    sliderchange(slider34);
    arp_on ? 0 : ( arp_on = 1; sliderchange(slider33); );
  ) : s <= -2000 ? (
    // РЕВЕРС того же среза (чёрная клавиша рядом со своей белой).
    sl = -2000 - s;
    sl >= 0 && sl < dk_nsl[0] ? (
      // Флаг вместо подмены OF_MODE: настройка среза не трогается, и один
      // срез может звучать прямо с белой и реверсом с чёрной ОДНОВРЕМЕННО.
      // Подмена этого не позволяла и вдобавок не работала — @sample
      // перечитывает режим каждый сэмпл и видел уже восстановленный.
      trig_rev = 1;
      trigger_slice(0, sl, vel, note, ofs);
    );
  ) : s <= -1000 ? (
    pc = -1000 - s;
    (pc==1 || pc==3 || pc==6 || pc==8 || pc==10) ? (
      // held stretch: velocity scales how far toward the key's ratio we go,
      // so a soft press on the 8x key gives a mild stretch, a hard one the full 8x
      kstr_ratio = 1 + (blackstr(pc) - 1) * vel/127;
      kstr_on = 1;
      kstr_note = note + 1;
    ) : (
      // White key: push this slot up to its activation point (the blue tick on
      // the mini slider), scaled by velocity. Setting the point in advance is
      // what makes the key predictable -- you dial the sound once, then play it.
      // БЫСТРЫЙ ЗАПУСК ЭФФЕКТОВ С КЛАВИАТУРЫ УБРАН (решение пользователя
      // 13 сен: «чем проще, тем лучше»). Белая клавиша управляющей октавы
      // больше не держит слот: эффекты крутятся ручками и с грида, а
      // клавиатура играет срезы — одна роль на орган.
      // Записей в OVR больше нет: подстановка k = -1 писала бы ЗА границу
      // массива, а это тихая порча соседней памяти. Ветка оставлена пустой
      // (0 обязателен: блок из одних комментариев — синтаксическая ошибка).
      0;
    );
  );
  );            // закрываем ветку «исправление класса / обычная игра»
);



// clear by remembered holder, not by re-running map_note: keysmode / base note
// can change while a black key is held, which would otherwise strand the fx on
function handle_off(note) local(k) (
  k = 0;
  while (k < 16) (
    OVRN[k] == note + 1 ? ( OVR[k] = 0; OVRN[k] = 0; );
    k += 1;
  );
  kstr_note == note + 1 ? ( kstr_on = 0; kstr_note = 0; kstr_ratio = 1; );
);


// Copy scene A's fx into scene B verbatim -- the starting point for tweaking a
// variant by hand rather than from scratch.
/* A>B убран (13 сен): пути A и B несут РАЗНЫЕ алгоритмы, копировать
   параметры filt→ring бессмысленно.
function scene_copy_ab() local(sb) (
  sb = slb(0);
  memcpy(sb + OF_FXA2, sb + OF_FXA, FXW);
  memcpy(sb + OF_FXP2, sb + OF_FXP, FXW);
  memcpy(sb + OF_FXM2, sb + OF_FXM, FXW);
  memcpy(sb + OF_FXK2, sb + OF_FXK, FXW);
  memcpy(sb + OF_FT2, sb + OF_FT, 64);
  memcpy(sb + OF_MS2, sb + OF_MS, FXW);
  memcpy(sb + OF_FXSEL2, sb + OF_FXSEL, 256);
);
*/

// WRECK убран вместе с путями A/B: он красил «второй путь», которого
// больше нет. Функция scene_wreck_b оставлена пустой, чтобы не искать все
// вызовы в окне — они просто ничего не делают.
function scene_wreck_b() ( 0; );

// convert pre-v5 slice tables (old layout in SCR) to the fx-chain layout
function conv_old_slices(d nf) local(sb i e a p k) (
  sb = slb(d);
  memset(sb, 0, SLST);
  i = 0;
  while (i < 64) (
    sb[OF_START+i] = SCR[i];
    sb[OF_END+i]   = SCR[64+i];
    sb[OF_PITCH+i] = SCR[128+i];
    sb[OF_GAIN+i]  = SCR[192+i];
    sb[OF_PAN+i]   = SCR[256+i];
    sb[OF_CHOKE+i] = SCR[512+i];
    sb[OF_CLASS+i] = SCR[576+i];
    sb[OF_MOUT+i]  = SCR[640+i];
    sb[OF_MNUM+i]  = SCR[704+i];
    sb[OF_MCHAN+i] = SCR[768+i];
    sb[OF_MBUS+i]  = SCR[832+i];
    sb[OF_MODE+i]  = nf >= 15 ? SCR[896+i] : 0;
    sb[OF_WET+i] = 1;
    k = 0;
    while (k < NFX) (
      sb[OF_FXA+k*64+i] = 0;
      sb[OF_FXP+k*64+i] = 0.5;
      sb[OF_FXM+k*64+i] = 1;
      sb[OF_FXA2+k*64+i] = k == FX_STRETCH ? 0.5 : 0;   // перф — в банке B
      sb[OF_FXP2+k*64+i] = 0.5;
      k += 1;
    );
    e = SCR[320+i]; a = SCR[384+i]; p = SCR[448+i];
    e == 2 ? (
      sb[OF_FXA2+FX_STRETCH*64+i] = (1 - log(pow(4, 1-2*a))/log(8))/2;
      sb[OF_FXP2+FX_STRETCH*64+i] = p;
    ) : (e >= 1 && e <= 8) ? (
      k = e == 1 ? 0 : e - 1;
      sb[OF_FXA+k*64+i] = a;
      sb[OF_FXP+k*64+i] = p;
    );
    i += 1;
  );
  // old projects had no second scene: start B as a copy of A so the crossfader
  // is a no-op until the user actually dials a variant in
  memcpy(sb + OF_FXA2, sb + OF_FXA, FXW);
  memcpy(sb + OF_FXP2, sb + OF_FXP, FXW);
  memcpy(sb + OF_FXM2, sb + OF_FXM, FXW);
  memcpy(sb + OF_FXK2, sb + OF_FXK, FXW);
);

// Перестройка бинов обзора для диапазона кадров (осталась от рендера среза:
// пригодится всякому, кто правит буфер на месте).
function ovw_range(d f0 f1) local(bf b0 b1 b k k0 k1 cm bmn bmx el em eh lp lp2 klo khi bi) (
  // перестроить бины обзора для кадров [f0, f1): та же формула, что в
  // load_sample, иначе кусок волны после рендера рисовался бы иначе
  bf = dbuf(d);
  klo = 1 - exp(-2*$pi*200/max(1, dk_srate[d]));
  khi = 1 - exp(-2*$pi*4000/max(1, dk_srate[d]));
  b0 = floor(f0/BINSZ); b1 = floor(max(f0, f1-1)/BINSZ);
  b = b0;
  while (b <= b1) (
    k0 = b*BINSZ; k1 = min(dk_frames[d], k0 + BINSZ);
    bmn = 1; bmx = -1; el = 0; em = 0; eh = 0; lp = 0; lp2 = 0;
    k = k0;
    while (k < k1) (
      cm = (bf[k*2] + bf[k*2+1])*0.5;
      cm > bmx ? bmx = cm; cm < bmn ? bmn = cm;
      lp += (cm - lp)*klo; lp2 += (cm - lp2)*khi;
      el += lp*lp; em += (lp2-lp)*(lp2-lp); eh += (cm-lp2)*(cm-lp2);
      k += 1;
    );
    bi = OVW0 + b*5;
    bi[0]=bmn; bi[1]=bmx; bi[2]=el; bi[3]=em; bi[4]=eh;
    b += 1;
  );
);

// finish_capture() УДАЛЕНА вместе с записью (25 окт). Она дописывала хвостовой
// обзорный бин и запускала автодетект после остановки записи. Загрузка сэмпла
// (load_sample / стрим от демона) делает то же самое сама — у неё свои bmn/bmx
// и свой вызов автодетекта, общего кода не было.

// 2 ноя: пересборка обзора после загрузки проекта — по nstep кадров за вызов. Зовут @gfx (окно открыто)
// и @block, когда окна нет (раньше обзор строился только в @gfx: трекер не видел волну, пока не откроешь GUI)
function ov_rebuild_step(nstep)
(
  dk_frames[0] <= 0 ? task = 0 : (
    (
      tk_buf = dbuf(0);
      tk_ovb = OVW0;
      ov_klo = 1 - exp(-2*$pi*200/max(dk_srate[0],1));
      ov_khi = 1 - exp(-2*$pi*4000/max(dk_srate[0],1));
      ov_n = min(ov_i + nstep, dk_frames[0]);
      while (ov_i < ov_n) (
        (ov_i & (BINSZ-1)) == 0 ? ( ovmin = 1; ovmax = -1; ov_el = 0; ov_em = 0; ov_eh = 0; );
        cmm = (tk_buf[ov_i*2] + tk_buf[ov_i*2+1]) * 0.5;
        cmm > ovmax ? ovmax = cmm;
        cmm < ovmin ? ovmin = cmm;
        ov_lp += (cmm - ov_lp) * ov_klo;
        ov_lp2 += (cmm - ov_lp2) * ov_khi;
        ov_el += ov_lp*ov_lp;
        ov_em += (ov_lp2 - ov_lp)*(ov_lp2 - ov_lp);
        ov_eh += (cmm - ov_lp2)*(cmm - ov_lp2);
        ((ov_i & (BINSZ-1)) == (BINSZ-1) || ov_i == dk_frames[0]-1) ? (
          tk_ovp = tk_ovb + floor(ov_i/BINSZ)*5;
          tk_ovp[0] = ovmin; tk_ovp[1] = ovmax;
          tk_ovp[2] = ov_el; tk_ovp[3] = ov_em; tk_ovp[4] = ov_eh;
        );
        ov_i += 1;
      );
      ov_i >= dk_frames[0] ? ( task = 0; ov_i = 0; );
    );
  );
);

function load_sample(d fpath_)
local(fh_ nch fsr frames base chunkfr wrp n i scr_ l_ r_ cm_ ovp bmn bmx el em eh lp lp2 klo khi bi)
(
  fh_ = file_open(fpath_);
  fh_ > 0 ? (
    nch = 0; fsr = 0;
    file_riff(fh_, nch, fsr);
    nch > 0 && fsr > 0 ? (
      frames = min(floor(file_avail(fh_)/nch), DECKFR);
      frames > 0 ? (
        base = dbuf(d);
        ovp = OVW0;
        scr_ = SCR;
        chunkfr = max(1, floor(28672/nch));
        klo = 1 - exp(-2*$pi*200/fsr);
        khi = 1 - exp(-2*$pi*4000/fsr);
        bmn = 1; bmx = -1; el = 0; em = 0; eh = 0; lp = 0; lp2 = 0;
        wrp = 0;
        while (wrp < frames) (
          n = min(chunkfr, frames - wrp);
          file_mem(fh_, scr_, n*nch);
          i = 0;
          while (i < n) (
            l_ = scr_[i*nch];
            r_ = nch > 1 ? scr_[i*nch+1] : l_;
            base[(wrp+i)*2] = l_;
            base[(wrp+i)*2+1] = r_;
            cm_ = (l_ + r_)*0.5;
            cm_ > bmx ? bmx = cm_;
            cm_ < bmn ? bmn = cm_;
            lp += (cm_ - lp)*klo;
            lp2 += (cm_ - lp2)*khi;
            el += lp*lp;
            em += (lp2 - lp)*(lp2 - lp);
            eh += (cm_ - lp2)*(cm_ - lp2);
            ( ((wrp+i) & (BINSZ-1)) == (BINSZ-1) || wrp+i == frames-1 ) ? (
              bi = ovp + floor((wrp+i)/BINSZ)*5;
              bi[0]=bmn; bi[1]=bmx; bi[2]=el; bi[3]=em; bi[4]=eh;
              bmn = 1; bmx = -1; el = 0; em = 0; eh = 0;
            );
            i += 1;
          );
          wrp += n;
        );
        kill_deck(d);  // old voices point into the buffer we just replaced
        dk_frames[d] = frames;
        dk_srate[d] = fsr;
        dk_nsl[d] = 0; msel_only(d, -1);
        auto_det ? ( auto_det_req = 1; auto_det_d = d; );
      );
    );
    file_close(fh_);
  );
);

// ============================ SEQ: console step sequencer ====================
// A pattern is one token per step, cycling over seq_len steps. Class tokens
// pick a slice ROUND-ROBIN from that class's pool (the scramble_item idea from
// jf_QuantumCut): deterministic re-voicing reads as musical where plain random
// does not. Step record at SQ_BASE + i*4: [0] class (0 rest, -1 any, -2 explicit,
// 1..8 = KICK..FX), [1] explicit slice, [2] probability %, [3] base velocity.
function seq_rand() (
  seq_seed > 0 ? (
    seq_rng = (seq_rng*1103515245 + 12345) & 2147483647;
    seq_rng / 2147483648;
  ) : rand(1);
);

// slice for a class: the (rr)th slice of that class, then advance rr
function seq_pick(cls) local(sb n i k tgt) (
  sb = slb(0); n = 0; i = 0;
  while (i < dk_nsl[0]) ( sb[OF_CLASS+i] == cls ? n += 1; i += 1; );
  n == 0 ? (
    // class absent (loop not classified, or just has no kicks): any slice,
    // round-robin, rather than silence -- a pattern should always sound
    dk_nsl[0] > 0 ? ( tgt = SQ_RR[9] % dk_nsl[0]; SQ_RR[9] += 1; tgt; ) : -1;
  ) : (
    tgt = SQ_RR[cls] % n; SQ_RR[cls] += 1;
    k = 0; i = 0;
    while (i < dk_nsl[0] && !(sb[OF_CLASS+i] == cls && k == tgt)) (
      sb[OF_CLASS+i] == cls ? k += 1;
      i += 1;
    );
    i;
  );
);

function seq_clear() local(i) (
  i = 0;
  while (i < 64) ( SQ_BASE[i*4] = 0; SQ_BASE[i*4+1] = 0; SQ_BASE[i*4+2] = 100; SQ_BASE[i*4+3] = 100; i += 1; );
);

// tokenizer: two-char tokens first (oh, cr), then one-char; digits after a
// token are its probability, a bare number is an explicit slice; ! accent,
// , ghost; - and . rest; ? any slice; * keeps the step as it is
function seq_parse(sstr) local(n i c c2 st cls num hasnum sl) (
  n = strlen(sstr); i = 0; st = 0;
  seq_clear();
  while (i < n && st < 64) (
    c = str_getchar(sstr, i); c2 = i+1 < n ? str_getchar(sstr, i+1) : 0;
    c >= 65 && c <= 90 ? c += 32;  c2 >= 65 && c2 <= 90 ? c2 += 32;
    cls = 0; sl = 0;
    (c == 111 && c2 == 104) ? ( cls = 6; i += 2; ) :          // oh -> ride/open
    (c == 99 && c2 == 114) ? ( cls = 5; i += 2; ) :           // cr
    c == 107 ? ( cls = 1; i += 1; ) : c == 115 ? ( cls = 2; i += 1; ) :
    c == 104 ? ( cls = 3; i += 1; ) : c == 112 ? ( cls = 4; i += 1; ) :
    c == 114 ? ( cls = 6; i += 1; ) : c == 118 ? ( cls = 7; i += 1; ) :
    c == 102 ? ( cls = 8; i += 1; ) :
    c == 63  ? ( cls = -1; i += 1; ) :                          // ?
    (c == 45 || c == 46) ? ( cls = 0; i += 1; sl = 1; ) :       // - .
    c == 42  ? ( cls = -3; i += 1; ) :                          // *
    (c >= 48 && c <= 57) ? ( cls = -2; ) :                      // bare number = slice
    ( i += 1; sl = -1; );                                       // skip junk
    sl >= 0 ? (
      // explicit slice number, or a probability suffix
      num = 0; hasnum = 0;
      while (i < n && str_getchar(sstr,i) >= 48 && str_getchar(sstr,i) <= 57) (
        num = num*10 + str_getchar(sstr,i) - 48; hasnum = 1; i += 1;
      );
      SQ_BASE[st*4] = cls;
      cls == -2 ? ( SQ_BASE[st*4+1] = max(0, num-1); SQ_BASE[st*4+2] = 100; ) :
                  ( SQ_BASE[st*4+2] = hasnum ? min(100, num) : 100; );
      // bare number followed by more digits after a space is a new token
      cls == -2 && i < n && str_getchar(sstr,i) == 37 ? ( i += 1; ); // allow "12%" no-op
      SQ_BASE[st*4+3] = 100;
      i < n && str_getchar(sstr,i) == 33 ? ( SQ_BASE[st*4+3] = 120; i += 1; );
      i < n && str_getchar(sstr,i) == 44 ? ( SQ_BASE[st*4+3] = 60; i += 1; );
      st += 1;
    );
  );
  st;
);

// tala -> pattern: sam = K (oh if the first vibhag is khali), vibhag start =
// S (oh if khali), every other matra = h; len = matras
function seq_apply_tala(ti) local(t vi j st km) (
  t = SQ_TALA + ti*8; km = t[7];
  seq_clear(); st = 0; vi = 0;
  while (vi < t[0]) (
    j = 0;
    while (j < t[1+vi] && st < 64) (
      st == 0 ? SQ_BASE[st*4] = (km & 1) ? 6 : 1 :
      j == 0  ? SQ_BASE[st*4] = (km & (1 << vi)) ? 6 : 2 :
                SQ_BASE[st*4] = 3;
      SQ_BASE[st*4+2] = 100; SQ_BASE[st*4+3] = j == 0 ? 110 : 90;
      st += 1; j += 1;
    );
    vi += 1;
  );
  seq_len = max(1, st);
  seq_tala = ti;
);

// The tala map morph. The cursor weights every tala by inverse squared
// distance; the strongest sets the length, and each step picks its token from
// one of the three nearest talas by a DETERMINISTIC per-step hash weighted by
// those distances. Deterministic matters: dragging morphs the pattern
// smoothly -- steps flip one at a time as weights cross, nothing reshuffles.
function seq_map_apply(mx my) local(i d wt_ w1 w2 w3 i1 i2 i3 st hs_ pickt tl j) (
  w1 = 0; w2 = 0; w3 = 0; i1 = 0; i2 = 0; i3 = 0;
  i = 0;
  while (i < SQ_NTALA) (
    d = sqr(mx - SQ_TPOS[i*2]) + sqr(my - SQ_TPOS[i*2+1]);
    wt_ = 1/(d + 0.004);
    wt_ > w1 ? ( w3=w2; i3=i2; w2=w1; i2=i1; w1=wt_; i1=i; ) :
    wt_ > w2 ? ( w3=w2; i3=i2; w2=wt_; i2=i; ) :
    wt_ > w3 ? ( w3=wt_; i3=i; );
    i += 1;
  );
  // pure tala right on a name: crush the others once one dominates
  w1 > (w2+w3)*4 ? ( w2 = 0; w3 = 0; );
  seq_apply_tala(i1);               // sets len + base pattern from the strongest
  st = 0;
  while (st < seq_len) (
    hs_ = (sin(st*127.1 + seq_seed*311.7 + 0.5)*43758.5453);
    hs_ -= floor(hs_);
    pickt = hs_*(w1+w2+w3) < w1 ? i1 : hs_*(w1+w2+w3) < w1+w2 ? i2 : i3;
    pickt != i1 ? (
      // rebuild this one step from the other tala's cycle
      tl = SQ_TALA + pickt*8;
      j = st;
      // walk the picked tala's own matra cycle
      tm_m = 0; tm_v = 0;
      while (tm_v < tl[0]) ( tm_m += tl[1+tm_v]; tm_v += 1; );
      j = st % max(1, tm_m);
      tm_v = 0; tm_c = 0;
      while (tm_v < tl[0] && j >= tl[1+tm_v]) ( j -= tl[1+tm_v]; tm_c += 1; tm_v += 1; );
      SQ_BASE[st*4] = (st == 0 && j == 0) ? ((tl[7] & 1) ? 6 : 1) :
                      j == 0 ? ((tl[7] & (1 << tm_c)) ? 6 : 2) : 3;
      SQ_BASE[st*4+2] = 100;
      SQ_BASE[st*4+3] = j == 0 ? 110 : 90;
    );
    st += 1;
  );
);

function seq_find_tala(q) local(i r) (
  sprintf(#sq_pat, "*%s*", q);
  r = -1; i = 0;
  while (i < SQ_NTALA && r < 0) (
    tala_name(i, #sq_nm);
    matchi(#sq_pat, #sq_nm) ? r = i;
    i += 1;
  );
  r;
);

// One-level undo for destructive edits. The audio snapshot lives in the free
// tail of the deck buffer itself (the buffer holds ~344 s, loops are seconds),
// the slice table copy in the load scratch above the gate's peak area.
function undo_save() local(fr) (
  fr = dk_frames[0];
  undo_have = fr > 0 && fr*4 + 64 <= DECKW;
  undo_have ? (
    memcpy(dbuf(0) + DECKW - fr*2, dbuf(0), fr*2);
    memcpy(SCR + 1024, slb(0), NSLF*64);
    undo_fr = fr; undo_nsl = dk_nsl[0]; undo_sr = dk_srate[0];
  );
);

function undo_restore() (
  undo_have ? (
    kill_deck(0);
    memcpy(dbuf(0), dbuf(0) + DECKW - undo_fr*2, undo_fr*2);
    memcpy(slb(0), SCR + 1024, NSLF*64);
    dk_frames[0] = undo_fr; dk_nsl[0] = undo_nsl; dk_srate[0] = undo_sr;
    calc_ends(0);
    msel_only(0, dk_nsl[0] > 0 ? 0 : -1);
    task = 3; ov_i = 0;      // the overview must match the restored audio
    undo_have = 0;
  );
);

// Delete slices whose attack peak sits more than `db` below the loudest
// slice's -- QuantumCut's relative gate. This SPLICES THE AUDIO: the quiet
// slice's samples are cut out of the buffer and everything after moves left,
// so the wave ends up shorter, not just differently marked. Peaks first (into
// SCR), then top-down so reindexing cannot shift what is still unchecked.
function gate_slices(db) local(i j pk mx thr n en st ln) (
  n = dk_nsl[0]; mx = 0.000000001;
  i = 0;
  while (i < n) (
    pk = 0;
    j = slb(0)[OF_START+i];
    en = min(slb(0)[OF_END+i], j + floor(0.03*dk_srate[0]));   // 30 ms attack window
    while (j < en) (
      pk = max(pk, abs(dbuf(0)[j*2]) + abs(dbuf(0)[j*2+1]));
      j += 1;
    );
    SCR[i] = pk; pk > mx ? mx = pk;
    i += 1;
  );
  thr = mx * pow(10, -abs(db)/20);
  undo_save();
  kill_deck(0);              // voices read the buffer we are about to shift
  j = 0; i = n - 1;
  while (i >= 0) (
    SCR[i] < thr ? (
      st = slb(0)[OF_START+i]; en = slb(0)[OF_END+i]; ln = en - st;
      // close the hole: everything after the slice slides down
      memcpy(dbuf(0) + st*2, dbuf(0) + en*2, (dk_frames[0] - en)*2);
      dk_frames[0] -= ln;
      // later slices sit ln frames earlier now
      en = i + 1;
      while (en < dk_nsl[0]) ( slb(0)[OF_START+en] -= ln; en += 1; );
      del_slice(0, i);
      j += 1;
    );
    i -= 1;
  );
  j ? ( calc_ends(0); task = 3; ov_i = 0; );   // rebuild the overview
  j;
);

// one console line: a command, or else a pattern
function seq_exec(sstr) local(v i n c num k) (
  // trim trailing spaces
  n = strlen(sstr);
  while (n > 0 && str_getchar(sstr, n-1) == 32) ( n -= 1; );
  strcpy_substr(#sq_ln, sstr, 0, n);
  seq_msg_t = time_precise();
  matchi("tala %s", #sq_ln, #sq_arg) ? (
    v = seq_find_tala(#sq_arg);
    v >= 0 ? ( seq_apply_tala(v); tala_name(v, #sq_nm);
               sprintf(#seq_msg, "tala %s: %d steps", #sq_nm, seq_len); strcpy(#seq_last, #sq_ln); )
           : sprintf(#seq_msg, "unknown tala: %s", #sq_arg);
  ) : matchi("len %d", #sq_ln, v) ? (
    seq_len = max(1, min(64, v)); sprintf(#seq_msg, "len %d", seq_len);
  ) : matchi("div %d", #sq_ln, v) ? (
    seq_divi = v >= 32 ? 3 : v >= 16 ? 2 : v >= 8 ? 1 : 0; sprintf(#seq_msg, "div 1/%d", 4 << seq_divi);
  ) : matchi("swing %d", #sq_ln, v) ? (
    seq_swing = max(0, min(100, v)); sprintf(#seq_msg, "swing %d%%", seq_swing);
  ) : matchi("hum %d", #sq_ln, v) ? (
    seq_hum = max(0, min(64, v)); sprintf(#seq_msg, "humanize +-%d", seq_hum);
  ) : matchi("seed %d", #sq_ln, v) ? (
    seq_seed = v; seq_rng = v; sprintf(#seq_msg, v ? "seed %d" : "seed off", v);
  ) : matchi("acc %d%s", #sq_ln, v, #sq_arg) ? (
    // "acc 12: 3 6 8 10 12" -- counts listed get the accent, others sit back
    i = 0; while (i < 64) ( SQ_ACC[i] = 0.9; i += 1; );
    n = strlen(#sq_arg); i = 0; k = 0;
    while (i < n) (
      c = str_getchar(#sq_arg, i);
      c >= 48 && c <= 57 ? ( num = 0;
        while (i < n && str_getchar(#sq_arg,i) >= 48 && str_getchar(#sq_arg,i) <= 57) ( num = num*10 + str_getchar(#sq_arg,i) - 48; i += 1; );
        num >= 1 && num <= 64 ? ( SQ_ACC[num-1] = 1.2; k += 1; );
      ) : i += 1;
    );
    seq_acclen = max(1, min(64, v));
    sprintf(#seq_msg, "accent cycle %d: %d accents", seq_acclen, k);
  ) : matchi("gate %d", #sq_ln, v) ? (
    i = gate_slices(v);
    sprintf(#seq_msg, "gate -%ddB: dropped %d quiet slice%s", abs(v), i, i == 1 ? "" : "s");
  ) : matchi("run", #sq_ln) ? ( seq_run = 1; strcpy(#seq_msg, "seq running"); )
    : matchi("stop", #sq_ln) ? ( seq_run = 0; strcpy(#seq_msg, "seq stopped"); )
    : matchi("clear", #sq_ln) ? ( seq_clear(); strcpy(#seq_last, ""); strcpy(#seq_msg, "pattern cleared"); )
    : matchi("help", #sq_ln) ? (
    strcpy(#seq_msg, "K S h oh CR p R V F | 12=slice | ?=any | -=rest | K75=prob | !=accent ,=ghost | tala/len/div/swing/hum/seed/acc N: a b/run/stop/clear");
  ) : (
    n = seq_parse(#sq_ln);
    n > 0 ? ( seq_len = n; strcpy(#seq_last, #sq_ln); sprintf(#seq_msg, "pattern: %d steps", n); )
          : strcpy(#seq_msg, "nothing to play in that line");
  );
);

// ── ШАГ ЭНКОДЕРА: таблица ступеней ───────────────────────────────────────
// Заполняется один раз. Значения в КАДРАХ; ступень 0 — один сэмпл.
!jog_inited ? (
  jog_inited = 1;
  JOGST[0] = 1; JOGST[1] = 16; JOGST[2] = 256;
  JOGST[3] = 1024; JOGST[4] = 4096; JOGST[5] = 16384;
  jog_mode = 0;      // 0 = адаптивный (умолчание по просьбе), 1..NJOGS = ступень
  jog_scale_hold = 0;
  jog_scale_used = 0;
);

// ── АРТИКУЛЯТОРЫ: ЗАВОДСКИЕ ТРИ ──────────────────────────────────────────
// Три штуки, которые попросил пользователь. Делаются одним приёмом:
// снять снимок ТЕКУЩЕГО состояния, испортить в нём пару слов, положить в
// слот. Так заводской артикулятор гарантированно согласован со всем
// остальным — он отличается от «сейчас» ровно тем, что названо, и ничем
// больше. Список параметров дублировать не нужно, и он не устареет.
//
// -1 = ничего не надето. Объявляем ДО заполнения: art_save её читает.
art_cur = -1;
!art_inited ? (
  art_inited = 1;
  memset(ART0, 0, ART_N*ART_W + ART_W);
  // -1 во ВСЕХ накладках огибающей: ноль означал бы «мгновенная атака»,
  // и каждый пустой слот молча срезал бы транзиент при надевании.
  art_i = 0;
  while (art_i < ART_N*2) ( ART_ENV[art_i] = -1; art_i += 1; );

  // 1. АРП ВКЛЮЧЁН ЖЁСТКО. Восьмыми, вверх, гейт короткий — иначе ноты
  //    слипаются и арп звучит как дрожащая педаль, а не как рисунок.
  art_grab(art_at(0));
  art_at(0)[33-1] = 1;      // arp_on
  art_at(0)[34-1] = 3;      // arp_rate = 1/8
  art_at(0)[35-1] = 0;      // arp_mode = up
  art_at(0)[36-1] = 0.45;   // arp_gate
  art_at(0)[37-1] = 0;      // arp_pedal = off: держать педаль не надо
  art_at(0)[ART_W-1] = 1;

  // 2. СЪЕДЕННАЯ АТАКА. Атака не нулевая, а «мягкая»: транзиент срезан,
  //    но звук не расплывается. 18 мс — это ровно тот порог, за которым
  //    удар перестаёт читаться как удар (у бочки и рабочего транзиент
  //    укладывается в 10-15 мс).
  art_grab(art_at(1));
  art_at(1)[7-1]  = 0;      // gatemode = one-shot: гейт тут мешает
  art_at(1)[17-1] = 0;      // preroll = 0: предудар незачем, атаки нет
  art_at(1)[ART_W-1] = 1;
  // ADSR живёт в таблице СРЕЗА, а не в слайдере, поэтому у него свой путь:
  // артикулятор помечает, что должен тронуть атаку срезов (см. art_apply_env).
  ART_ENV[1*2]     = 0.018;   // атака, с
  ART_ENV[1*2 + 1] = -1;      // релиз не трогаем

  // 3. ОЧЕНЬ КОРОТКОЕ ЗАВЕРШЕНИЕ + ГЕЙТ. Стаккато: отпустил — нота ушла.
  //    12 мс релиза, а не ноль: щелчок на обрыве слышнее, чем сам хвост.
  art_grab(art_at(2));
  art_at(2)[7-1] = 1;       // gatemode = gate
  art_at(2)[ART_W-1] = 1;
  ART_ENV[2*2]     = -1;      // атаку не трогаем
  ART_ENV[2*2 + 1] = 0.012;   // релиз, с
);

!seq_inited ? ( seq_inited = 1; seq_apply_tala(8); );

@slider

@block
smp_i = 0;   // сэмпл внутри блока: морф коэффициентов эффектов по блоку
// 2 ноя: окно закрыто (@gfx не шёл полсекунды) — обзор после загрузки строится здесь, мелкими шагами
task == 3 && time_precise() - ovgfx_t > 0.5 ? ov_rebuild_step(16384);
gmem[6] = 0;  // single deck; kept for companion scripts that still read it
// The helper publishes the host track's colour and name here; the plugin cannot
// see its own track, so this is the only way to pick them up.
gmem[8] != hb_last ? ( hb_last = gmem[8]; hb_t = time_precise(); );
helper_ok = time_precise() - hb_t < 2;
trkcol = helper_ok ? gmem[240] : 0;
// rebuild the track name string only when the helper changes it
helper_ok && gmem[241] != tname_len ? (
  tname_len = gmem[241];
  strcpy(#trkname, "");
  tn_i = 0;
  while (tn_i < tname_len && tn_i < 40) (
    tn_c = gmem[242 + tn_i];
    tn_c < 32 || tn_c > 126 ? tn_c = 63;   // keep it printable
    sprintf(#tn_ch, "%c", tn_c);
    strcat(#trkname, #tn_ch);
    tn_i += 1;
  );
);

// dropped file from @gfx
drop_req ? (
  drop_req = 0;
  // ДРОП ЧЕРЕЗ ДЕМОН: он читает любой формат (AudioAccessor). Прямой путь
  // file_riff остаётся запасным, когда демона нет — но он берёт только
  // несжатый WAV/AIFF, и mp3/flac из Media Explorer молча не грузились.
  helper_ok ? path_send(#droppath) : load_sample(0, #droppath);
);

// ---- audio stream from jf_slixer_load_sample.lua (any file, any folder) ----
// ── АУДИО-СТРИМ АДРЕСОВАН ЗАКАЗЧИКУ (17 сен) ──────────────────────────
// Главный канал, по которому приходит сам сэмпл. Заголовок видели ОБА
// экземпляра, оба начинали приём и получали один и тот же звук — отсюда
// «нажал слот, поменялось на обоих». Теперь берёт только тот, чей жетон
// лежит в gmem[606]; ноль = «для всех» (команды, не ставящие адрес).
// Чужой заголовок НЕ СБРАСЫВАЕМ: его должен прочитать адресат.
gmem[100] == 1 && gmem[606] != 0 && gmem[606] != mn_tok ? (
  0;   // не наш стрим: проходим мимо, флаг оставляем адресату
) :
gmem[100] == 1 ? (  // header
  xh_d = 0;   // дека одна: dbuf(1) лежит за пределами буфера
  xh_sr = gmem[102];
  xh_total = min(gmem[103], DECKFR);
  xh_wr = 0;
  xh_sr > 0 && xh_total > 0 ? (
    xh_active = 1;
    kill_deck(xh_d);  // chunks overwrite the buffer from the next block on
    xh_bmn = 1; xh_bmx = -1;
    xh_el = 0; xh_em = 0; xh_eh = 0;
    xh_lp = 0; xh_lp2 = 0;
    xh_klo = 1 - exp(-2*$pi*200/xh_sr);
    xh_khi = 1 - exp(-2*$pi*4000/xh_sr);
  ) : xh_active = 0;
  gmem[100] = 0;
) : gmem[100] == 2 && xh_active ? (  // chunk of interleaved stereo at gmem[16384]
  xn = gmem[104];
  xbase = dbuf(xh_d);
  xovp = OVW0;
  xi = 0;
  while (xi < xn && xh_wr < xh_total) (
    xl = gmem[16384 + xi*2];
    xr = gmem[16384 + xi*2 + 1];
    xbase[xh_wr*2] = xl; xbase[xh_wr*2+1] = xr;
    xcm = (xl + xr)*0.5;
    xcm > xh_bmx ? xh_bmx = xcm;
    xcm < xh_bmn ? xh_bmn = xcm;
    xh_lp += (xcm - xh_lp)*xh_klo;
    xh_lp2 += (xcm - xh_lp2)*xh_khi;
    xh_el += xh_lp*xh_lp;
    xh_em += (xh_lp2 - xh_lp)*(xh_lp2 - xh_lp);
    xh_eh += (xcm - xh_lp2)*(xcm - xh_lp2);
    (xh_wr & (BINSZ-1)) == (BINSZ-1) ? (
      xp = xovp + floor(xh_wr/BINSZ)*5;
      xp[0]=xh_bmn; xp[1]=xh_bmx; xp[2]=xh_el; xp[3]=xh_em; xp[4]=xh_eh;
      xh_bmn = 1; xh_bmx = -1;
      xh_el = 0; xh_em = 0; xh_eh = 0;
    );
    xh_wr += 1; xi += 1;
  );
  gmem[100] = 0;
) : gmem[100] == 3 && xh_active ? (  // done
  xh_active = 0;
  xh_wr > 0 ? (
    (xh_wr & (BINSZ-1)) ? (
      xp = OVW0 + floor(xh_wr/BINSZ)*5;
      xp[0]=xh_bmn; xp[1]=xh_bmx; xp[2]=xh_el; xp[3]=xh_em; xp[4]=xh_eh;
    );
    dk_frames[xh_d] = xh_wr;
    dk_srate[xh_d] = xh_sr;
    dk_nsl[xh_d] = 0; msel_only(xh_d, -1);
    kt_pending ? (
      // slicing from the kit file, with the per-slice settings it stored
      kt_pending = 0;
      kt_n = min(gmem[601], MAXSL);
      dk_nsl[0] = 0;
      kt_i = 0;
      while (kt_i < kt_n) (
        kt_p = 610 + kt_i*8;
        gmem[kt_p] >= 0 && gmem[kt_p] < dk_frames[0] - 32 ? (
          slb(0)[OF_START + dk_nsl[0]] = gmem[kt_p];
          slice_defaults(0, dk_nsl[0]);
          slb(0)[OF_CLASS + dk_nsl[0]] = gmem[kt_p+1];
          slb(0)[OF_PITCH + dk_nsl[0]] = gmem[kt_p+2];
          slb(0)[OF_GAIN  + dk_nsl[0]] = gmem[kt_p+3];
          slb(0)[OF_PAN   + dk_nsl[0]] = gmem[kt_p+4];
          slb(0)[OF_MODE  + dk_nsl[0]] = gmem[kt_p+5];
          slb(0)[OF_CHOKE + dk_nsl[0]] = gmem[kt_p+6];
          slb(0)[OF_OUTCH + dk_nsl[0]] = gmem[kt_p+7];
          dk_nsl[0] += 1;
        );
        kt_i += 1;
      );
      calc_ends(0);
      msel_only(0, dk_nsl[0] > 0 ? 0 : -1);
    ) : gmem[130] > 1 ? (
      // the file brought its own slice map (wav cue points, REX slices):
      // that beats guessing at transients
      fm_i = 0;
      while (fm_i < min(gmem[130], MAXSL)) (
        fm_p = floor(gmem[131 + fm_i] * dk_srate[0]);
        fm_p >= 0 && fm_p < dk_frames[0] - 64 ? (
          slb(0)[OF_START + dk_nsl[0]] = fm_p;
          slice_defaults(0, dk_nsl[0]);
          dk_nsl[0] += 1;
        );
        fm_i += 1;
      );
      gmem[130] = 0;
      calc_ends(0);
      msel_only(0, dk_nsl[0] > 0 ? 0 : -1);
      dk_nsl[0] > 0 ? ( task = 2; cls_new = 1; tsk_d = 0; );   // classify them
    ) : auto_det ? ( auto_det_req = 1; auto_det_d = xh_d; );
  );
  gmem[100] = 0;
);

mvol = pow(10, mgain_db/20);
gcoef = glide_ms <= 0 ? 1 : 1 - exp(-1/(glide_ms * 0.001 * srate));
atk_inc = 1 / max(1, 0.0015*srate);
rel_c = exp(-1/(0.004*srate));
// scene morph weights: a plain linear blend, because these interpolate fx
// parameters rather than sum two audio signals (equal-power would overshoot
// in the middle and make the fader's centre read as "more" of both scenes)
scn_b = xfade;
scn_a = 1 - xfade;

// tempo-sync multiplier: fit the loop to the nearest whole beat count
scene_sm = 1;
loop_beats = 0;
dk_frames[0] > 0 && dk_srate[0] > 0 && tempo > 0 ? (
  smb = dk_frames[0]/dk_srate[0] * tempo / 60;
  loop_beats = max(1, floor(smb + 0.5));
  dk_sync[0] ? scene_sm = smb/loop_beats;
);

// ---- input quantize --------------------------------------------------------
// The grid in samples at the current tempo. Quantising works on the sample
// offset midirecv reports, so a note is nudged inside the block it arrived in;
// snapping backwards would mean playing it before its own block, which cannot
// be done, so notes only ever move forward to the next grid line.
qstep = 0;
qgrid > 0 && tempo > 0 ? (
  qbeat = 60/tempo * srate;                  // samples per quarter note
  qstep = qgrid == 1 ? qbeat/8 :             // 1/32
          qgrid == 2 ? qbeat/6 :             // 1/16 triplet
          qgrid == 3 ? qbeat/4 :             // 1/16
          qgrid == 4 ? qbeat/3 :             // 1/8 triplet
          qgrid == 5 ? qbeat/2 : qbeat;      // 1/8, 1/4
);

// ---- lock the loop to the project timeline ---------------------------------
// With tsync on, the loop is not free-running: its read position is derived
// from the project's beat position every block, so it follows the transport,
// loops with it, and rides the tempo envelope for free (beat_position already
// accounts for tempo curves -- deriving from beats rather than seconds is what
// makes a tempo ramp work without any extra handling here).
// cheap flag so @sample only scans the pending queue when something is in it
qnq_any = 0;
qnn = 0;
while (qnn < QNQMAX) ( QNQ[qnn*3+2] > 0 ? qnq_any = 1; qnn += 1; );


// ---- SEQ clock ------------------------------------------------------------
// Steps are counted in beats: from beat_position while the transport runs (so
// the sequencer sits on the project grid and rides tempo changes), from an own
// accumulator when it is stopped. Boundaries that fall inside this block are
// queued with their sample offset -- odd steps pushed by the swing amount --
// and fired from @sample, so timing is sample-accurate, not block-accurate.
seq_div = 4 << seq_divi;
seq_bps = tempo > 0 ? tempo/60/srate : 0;          // beats per sample
seq_spb = seq_div/4;                                // steps per beat
seq_run && dk_nsl[0] > 0 && seq_bps > 0 ? (
  (play_state & 1) ? seq_beat = beat_position : seq_beat += samplesblock*seq_bps;
  seq_stepq = seq_beat*seq_spb;
  // steps whose boundary lies inside [now, now+block)
  sq_next = floor(seq_stepq) + 1;
  seq_lastq < 0 || abs(sq_next - seq_lastq) > 4 ? seq_lastq = sq_next - 1;  // (re)sync
  sq_n = 0;
  while (sq_next - seq_lastq >= 1 && (sq_next - seq_stepq)/seq_spb/seq_bps < samplesblock && sq_n < 8) (
    sq_ofs = floor((sq_next - seq_stepq)/seq_spb/seq_bps);
    sq_st = sq_next % seq_len;
    sq_st & 1 ? sq_ofs += floor(seq_swing/100 * 0.5 / seq_spb / seq_bps);
    sq_cls = SQ_BASE[sq_st*4];
    sq_go = sq_cls != 0 && sq_cls != -3 && seq_rand()*100 < SQ_BASE[sq_st*4+2];
    sq_go ? (
      sq_sl = sq_cls == -2 ? min(SQ_BASE[sq_st*4+1], dk_nsl[0]-1) :
              sq_cls == -1 ? floor(seq_rand()*dk_nsl[0]) : seq_pick(sq_cls);
      sq_sl >= 0 ? (
        sq_vel = SQ_BASE[sq_st*4+3] * (seq_acclen > 0 ? SQ_ACC[sq_st % seq_acclen] : 1);
        seq_hum > 0 ? sq_vel += (seq_rand()*2-1)*seq_hum;
        sq_vel = max(1, min(127, floor(sq_vel+0.5)));
        sq_q = 0; while (sq_q < SQQMAX && SQQ[sq_q*3+2] > 0) ( sq_q += 1; );
        sq_q < SQQMAX ? ( SQQ[sq_q*3] = sq_sl; SQQ[sq_q*3+1] = sq_vel; SQQ[sq_q*3+2] = max(1, sq_ofs); );
      );
    );
    seq_lastq = sq_next; sq_next += 1; sq_n += 1;
  );
  seq_curstep = floor(seq_stepq) % seq_len;
) : seq_lastq = -1;
sqq_any = 0; sq_q = 0;
while (sq_q < SQQMAX) ( SQQ[sq_q*3+2] > 0 ? sqq_any = 1; sq_q += 1; );

tl_active = tsync && (play_state & 1) && dk_frames[0] > 0 && loop_beats > 0;
tl_active ? (
  tl_ph = beat_position / loop_beats;
  tl_ph -= floor(tl_ph);                     // 0..1 through the loop
  // Прыжок плейхеда на срез (грид, ряды 7-8): луп по-прежнему привязан к
  // таймлайну, но со смещением tl_off — грув не ломается, меняется только то,
  // какой срез звучит на какой доле. Квант: 0 сразу, 1 доля, 2 такт.
  tl_jump >= 0 && play_position*srate >= tl_jump_pos - 1 ? (
    tl_off = cd_sb[OF_START + tl_jump] - tl_ph * dk_frames[0];
    tl_jump = -1;
  );
  tl_new = tl_ph * dk_frames[0] + tl_off;
  tl_new >= dk_frames[0] ? tl_new -= dk_frames[0];
  tl_new < 0 ? tl_new += dk_frames[0];
  // Step per sample comes from where this block starts and where the next one
  // will: reading it back from the timeline each block keeps a tempo ramp exact
  // instead of integrating a rate that is already out of date. On a jump (loop
  // wrap, locate) fall back to the plain rate so the loop does not scrub.
  tl_had ? (
    tl_step = (tl_new - tl_pos) / max(1, samplesblock);
    abs(tl_step) > 8 || tl_step < 0 ? tl_step = dk_srate[0]/srate * scene_sm;
  ) : tl_step = dk_srate[0]/srate * scene_sm;
  tl_pos = tl_new;
  tl_had = 1;
) : tl_had = 0;

qi = 0;
while (qi < qn) (
  q = qoff + qi*3;
  midi_bus = q[0];
  midisend(0, $x80 | q[1], q[2], 0);
  qi += 1;
);
qn = 0;

// ---- publish slice timing for the MIDI-export helper ------------------------
// gmem[200] = request flag, [201] = count, [202] = sample rate,
// [203] = loop length in frames, then per slice at 210: start frame, note,
// velocity from class, length in frames. The helper turns these into a MIDI
// item at the project tempo -- the analysis (where the transients are and how
// long each hit rings) lives here, the item building lives there.
// gmem[600] = save-kit request. The plugin owns the slice data, the helper
// owns the file: [601] slice count, [602] sample rate, [603] frames, then per
// slice at 610 + i*8: start frame, class, pitch, gain, pan, mode, choke, out.
kit_req ? (
  kit_req = 0;
  kt_sb = slb(0);
  kt_n = min(dk_nsl[0], 64);
  gmem[601] = kt_n; gmem[602] = dk_srate[0]; gmem[603] = dk_frames[0];
  kt_i = 0;
  while (kt_i < kt_n) (
    kt_p = 610 + kt_i*8;
    gmem[kt_p]   = kt_sb[OF_START+kt_i];
    gmem[kt_p+1] = kt_sb[OF_CLASS+kt_i];
    gmem[kt_p+2] = kt_sb[OF_PITCH+kt_i];
    gmem[kt_p+3] = kt_sb[OF_GAIN+kt_i];
    gmem[kt_p+4] = kt_sb[OF_PAN+kt_i];
    gmem[kt_p+5] = kt_sb[OF_MODE+kt_i];
    gmem[kt_p+6] = kt_sb[OF_CHOKE+kt_i];
    gmem[kt_p+7] = kt_sb[OF_OUTCH+kt_i];
    kt_i += 1;
  );
  gmem[600] = 1;
);

gmem[605] > 0.5 && (gmem[606] == 0 || gmem[606] == mn_tok) ? (
  gmem[605] = 0;
  strcpy(#seq_msg, "kit saved next to the sample (.jfkit) and added to FAVS");
  seq_msg_t = time_precise();
);

// A kit came back from the helper with its audio: apply the slicing it carries
// instead of detecting transients.
// ОТВЕТ АДРЕСОВАН? (17 сен, жалоба «нажимаю слот — меняется на обоих»)
// gmem общий для всех экземпляров, и флаг «пришёл кит» видели ОБА: каждый
// применял чужую нарезку к своему сэмплу. Теперь заказчик оставляет свой
// жетон в gmem[606], демон возвращает его нетронутым, а экземпляры с
// другим жетоном проходят мимо. Ноль в 603 = «ответ для всех» — так
// работают старые команды, которые адреса не ставят.
gmem[604] > 0.5 && (gmem[606] == 0 || gmem[606] == mn_tok) ? (
  kt_pending = 1;
  gmem[604] = 0;
  gmem[606] = 0;
);

// gmem[220] = request to write MIDI note names onto the plugin's track.
// The plugin knows what every key does; Lua knows how to name them.
// [221] base note, [222] slice count, [223] keysmode, then class per slice.
names_req ? (
  names_req = 0;
  nm_sb = slb(0);
  gmem[221] = basenote_a;
  gmem[222] = min(dk_nsl[0], 64);
  gmem[223] = keysmode;
  nm_i = 0;
  while (nm_i < min(dk_nsl[0], 64)) (
    gmem[230 + nm_i] = nm_sb[OF_CLASS+nm_i];
    nm_i += 1;
  );
  gmem[220] = 1;
);

midi_req ? (
  midi_req = 0;
  mx_sb = slb(0);
  midi_req_mode == 1 ? (
    // SEQ pattern: one pass of the loop, round-robin and probability resolved
    // here (the helper only places notes). [204]=1, [205]=step length in
    // quarter notes, per event at 210: step, note, vel, length in steps
    gmem[204] = 1;
    gmem[205] = 1 / (4 << seq_divi) * 4;
    gmem[203] = seq_len;
    mx_n = 0; mx_i = 0;
    while (mx_i < seq_len && mx_n < 64) (
      mx_c = SQ_BASE[mx_i*4];
      mx_go = mx_c != 0 && mx_c != -3 && seq_rand()*100 < SQ_BASE[mx_i*4+2];
      mx_go ? (
        mx_sl = mx_c == -2 ? min(SQ_BASE[mx_i*4+1], dk_nsl[0]-1) :
                mx_c == -1 ? floor(seq_rand()*dk_nsl[0]) : seq_pick(mx_c);
        mx_sl >= 0 ? (
          mx_p = 210 + mx_n*4;
          gmem[mx_p]   = mx_i;
          gmem[mx_p+1] = slice_note(mx_sl);
          gmem[mx_p+2] = max(1, min(127, floor(SQ_BASE[mx_i*4+3] * (seq_acclen > 0 ? SQ_ACC[mx_i % seq_acclen] : 1) + 0.5)));
          gmem[mx_p+3] = 1;
          mx_n += 1;
        );
      );
      mx_i += 1;
    );
    gmem[201] = mx_n;
  ) : (
    gmem[204] = 0;
    gmem[202] = dk_srate[0];
    gmem[203] = dk_frames[0];
    mx_i = 0; mx_n = 0;
    while (mx_i < min(dk_nsl[0], 64)) (
      mx_sb[OF_MUTE+mx_i] < 0.5 ? (          // мьютнутый срез — без ноты
        mx_p = 210 + mx_n*4;
        gmem[mx_p]   = mx_sb[OF_START+mx_i];
        gmem[mx_p+1] = slice_note(mx_i);
        // velocity from class: kicks and snares hit harder than hats by default,
        // which makes the exported loop read musically instead of flat 100s
        mx_c = mx_sb[OF_CLASS+mx_i];
        gmem[mx_p+2] = mx_c == 1 ? 118 : mx_c == 2 ? 110 : mx_c == 3 ? 80 :
                       mx_c == 4 ? 95  : mx_c == 5 ? 105 : 100;
        gmem[mx_p+3] = mx_sb[OF_END+mx_i] - mx_sb[OF_START+mx_i];
        mx_n += 1;
      );
      mx_i += 1;
    );
    gmem[201] = mx_n;
  );
  gmem[200] = 1;
);

// ---- вид для jf_tracker (9 окт) ------------------------------------------
// Владелец — экземпляр, которому трекер последним прислал trkv_req (слайдер
// 86); номер запроса лежит в gmem[TRKV+31]. Владелец каждый блок пишет:
//   +1 кадров деки, +2 sr, +3 срезов, +4 выбранный (-1), +5 пиков N,
//   +6 голосов, +7 тик, +8..+23 позиции голосов (кадры), +24..+39 их срезы,
//   +40 версия пиков,
//   +100+i начало среза i, +200+i конец (кадры), +300+2i / +301+2i макс / мин
//   пика i (0..1, моно); +0 = номер запроса, на который ответ готов.
// Пики пересчитываются при смене кадров / числа срезов / контрольной суммы,
// не чаще 4 раз в секунду (во время записи дека растёт каждый блок), и
// с шагом не больше 256 чтений на пик — длинная дека не душит аудиопоток.
trkv_req != trkv_last ? ( trkv_last = trkv_req; gmem[TRKV+31] = trkv_req; trkv_sig = -1; trkv_qv = -1; trkv_ld = gmem[TRKV+5000]; trkv_sl = gmem[TRKV+6000]; trkv_op = gmem[TRKV+6100]; );   // старый заказ пути — не наш
trkv_last > 0 && gmem[TRKV+31] == trkv_last ? (
  trkv_fr = dk_frames[0]|0;
  trkv_sb = slb(0);
  trkv_bf = dbuf(0);
  gmem[TRKV+1] = trkv_fr; gmem[TRKV+2] = dk_srate[0]; gmem[TRKV+3] = dk_nsl[0]; gmem[TRKV+4] = dk_sel[0];
  trkv_i = 0;
  while (trkv_i < MAXSL) (
    gmem[TRKV+100+trkv_i] = trkv_i < dk_nsl[0] ? trkv_sb[OF_START+trkv_i] : 0;
    gmem[TRKV+200+trkv_i] = trkv_i < dk_nsl[0] ? trkv_sb[OF_END+trkv_i] : 0;
    trkv_i += 1;
  );
  trkv_n = 0; trkv_i = 0;
  while (trkv_i < NVOICE) (
    trkv_v = V0 + trkv_i*VF;
    trkv_v[fA] && trkv_v[fST] < 3 ? (
      gmem[TRKV+8+trkv_n] = trkv_v[fGRAN] > 0 ? trkv_v[fVT] : trkv_v[fPOS]; gmem[TRKV+24+trkv_n] = trkv_v[fS];
      gmem[TRKV+41+trkv_n] = trkv_v[fATS];   // 26 окт: стретч давлением — трекер красит заливку
      trkv_n += 1;
    );
    trkv_i += 1;
  );
  gmem[TRKV+6] = trkv_n;
  gmem[TRKV+7] = (gmem[TRKV+7] + 1) % 1000000;
  // контрольная сумма: 32 точки деки + кадры + срезы
  trkv_cs = trkv_fr * 3 + dk_nsl[0] * 7;
  trkv_fr > 0 ? ( trkv_i = 0; while (trkv_i < 32) ( trkv_cs += trkv_bf[floor(trkv_i * trkv_fr / 32) * 2] * (trkv_i + 1); trkv_i += 1; ); );
  trkv_cs != trkv_sig && time_precise() - trkv_pt > 0.25 ? (
    trkv_sig = trkv_cs; trkv_pt = time_precise();
    trkv_np = 512;
    trkv_i = 0;
    while (trkv_i < trkv_np) (
      trkv_a = floor(trkv_i * trkv_fr / trkv_np); trkv_b = floor((trkv_i + 1) * trkv_fr / trkv_np);
      trkv_st = max(1, floor((trkv_b - trkv_a) / 256));
      trkv_mx = 0; trkv_mn = 0;
      trkv_k = trkv_a;
      while (trkv_k < trkv_b) (
        trkv_x = (trkv_bf[trkv_k*2] + trkv_bf[trkv_k*2+1]) * 0.5;
        trkv_mx = max(trkv_mx, trkv_x); trkv_mn = min(trkv_mn, trkv_x);
        trkv_k += trkv_st;
      );
      gmem[TRKV+300+trkv_i*2] = trkv_mx; gmem[TRKV+301+trkv_i*2] = trkv_mn;
      // 31 окт: +4100+i — спектральный центроид точки (0 низ .. 1 верх, -1 тишина) из обзора деки: трекер красит
      // волну, как вид waveform окна
      trkv_k = floor(trkv_a / BINSZ); trkv_x = 0; trkv_st = 0; trkv_cs2 = 0;
      while (trkv_k < max(floor(trkv_a / BINSZ) + 1, floor(trkv_b / BINSZ))) (
        trkv_x += OVW0[trkv_k*5+2]; trkv_st += OVW0[trkv_k*5+3]; trkv_cs2 += OVW0[trkv_k*5+4];
        trkv_k += 1;
      );
      gmem[TRKV+4100+trkv_i] = trkv_x + trkv_st + trkv_cs2 > 0 ? (trkv_st*0.5 + trkv_cs2) / (trkv_x + trkv_st + trkv_cs2) : -1;
      trkv_i += 1;
    );
    gmem[TRKV+5] = trkv_np;
    gmem[TRKV+40] = (gmem[TRKV+40] + 1) % 1000000;   // версия пиков: трекер перечитывает только по ней
  );
  // 26 окт: снайперский зум пульта трекера (как прицел его слайсера) — настоящие сэмплы окна у границы.
  // Заказ: +1590 номер, +1591 первый кадр (может быть < 0), +1592 кадров, +1593 точек (<= 1024).
  // Ответ: +1600+2i max, +1601+2i min (за краями деки — 0), +1594 = номер готового заказа
  gmem[TRKV+1590] > 0 && gmem[TRKV+1590] != trkv_zq ? (
    trkv_zq = gmem[TRKV+1590];
    trkv_za = floor(gmem[TRKV+1591]); trkv_zn = max(1, floor(gmem[TRKV+1592])); trkv_zp = max(1, min(1024, gmem[TRKV+1593]|0));
    trkv_i = 0;
    while (trkv_i < trkv_zp) (
      trkv_a = trkv_za + floor(trkv_i * trkv_zn / trkv_zp);
      trkv_b = max(trkv_a + 1, trkv_za + floor((trkv_i + 1) * trkv_zn / trkv_zp));
      trkv_mx = 0; trkv_mn = 0; trkv_got = 0;
      trkv_k = max(0, trkv_a);
      while (trkv_k < min(trkv_b, trkv_fr)) (
        trkv_x = (trkv_bf[trkv_k*2] + trkv_bf[trkv_k*2+1]) * 0.5;
        trkv_got ? ( trkv_mx = max(trkv_mx, trkv_x); trkv_mn = min(trkv_mn, trkv_x); ) : ( trkv_mx = trkv_mn = trkv_x; trkv_got = 1; );
        trkv_k += 1;
      );
      gmem[TRKV+1600+trkv_i*2] = trkv_mx; gmem[TRKV+1601+trkv_i*2] = trkv_mn;
      trkv_i += 1;
    );
    gmem[TRKV+1594] = trkv_zq;
  );
  gmem[TRKV] = trkv_last;
  // 11 окт: бросок файла на волну slixer в DSP трекера — путь заказом:
  // +5000 номер заказа, +5001 длина, +5002.. коды символов. Владелец берёт
  // его как свой бросок (drop_req: через демон любой формат, без него — WAV)
  gmem[TRKV+5000] > 0 && gmem[TRKV+5000] != trkv_ld ? (
    trkv_ld = gmem[TRKV+5000];
    tl_n = min(gmem[TRKV+5001]|0, PATH_MAX);
    strcpy(#droppath, "");
    tl_i = 0;
    while (tl_i < tl_n) ( sprintf(#pr_tmp, "%c", gmem[TRKV+5002+tl_i]|0); strcat(#droppath, #pr_tmp); tl_i += 1; );
    tl_n > 0 ? ( drop_req = 1; drop_x = drop_y = -1; );   // не на плитку слота (координаты прошлого броска)
  );
  // 25 окт: нарезка из трекера (его слайсер — «где резать», slixer — «чем играть»):
  // +6000 номер заказа, +6001 срезов, +6002.. начала в секундах файла. Только владелец вида —
  // общий gmem другие экземпляры не трогают (в отличие от MAGIC-маркеров для всех)
  gmem[TRKV+6000] > 0 && gmem[TRKV+6000] != trkv_sl ? (
    trkv_sl = gmem[TRKV+6000];
    dk_frames[0] > 0 ? (
      trkv_sn = min(gmem[TRKV+6001]|0, MAXSL);
      kill_deck(0);
      dk_nsl[0] = 0;
      trkv_i = 0;
      while (trkv_i < trkv_sn) (
        trkv_p = floor(gmem[TRKV+6002+trkv_i] * dk_srate[0]);
        trkv_p >= 0 && trkv_p < dk_frames[0] ? (
          trkv_sb[OF_START+dk_nsl[0]] = trkv_p;
          slice_defaults(0, dk_nsl[0]);
          dk_nsl[0] += 1;
        );
        trkv_i += 1;
      );
      calc_ends(0);
      msel_only(0, dk_nsl[0] > 0 ? 0 : -1);
      auto_det_req = 0;   // нарезка трекера главнее: отложенная автодетекция (ждёт открытия окна) её не затрёт
    );
  );
  // 25 окт: пульт slixer в DSP трекера (1 в 1 с окном) — команды: +6100 номер, +6101 код, +6102 аргумент.
  // 1 выбрать срез, 2 послушать срез, 3 снять нарезку, 4 auto, 5 keys, 6 sync (0 off 1 pitch 2 str),
  // 7 артикулятор (повтор — снять). Что живёт только в окне (detect, classify, gate, undo, midi, names) —
  // трекер открывает окно и жмёт клавишу; detect трекер делает своим слайсером
  gmem[TRKV+6100] > 0 && gmem[TRKV+6100] != trkv_op ? (
    trkv_op = gmem[TRKV+6100];
    trkv_c = gmem[TRKV+6101]|0; trkv_a = gmem[TRKV+6102];
    trkv_c == 1 ? ( trkv_a >= 0 && trkv_a < dk_nsl[0] ? msel_only(0, trkv_a|0); ) :
    trkv_c == 2 ? ( trkv_a >= 0 && trkv_a < dk_nsl[0] ? ( msel_only(0, trkv_a|0); pv_deck = 0; pv_req = trkv_a|0; ); ) :
    trkv_c == 3 ? ( kill_deck(0); dk_nsl[0] = 0; msel_only(0, -1); ) :
    trkv_c == 4 ? auto_det = trkv_a > 0.5 :
    trkv_c == 5 ? keys_on = trkv_a > 0.5 :
    trkv_c == 6 ? dk_sync[0] = max(0, min(2, trkv_a|0)) :
    trkv_c == 7 ? ( art_cur == (trkv_a|0) ? ( art_off(); art_latch = 0; ) : ( art_on(trkv_a|0); art_latch = 1; ); ) :
    trkv_c == 9 ? keysmode = max(0, min(2, trkv_a|0)) :   // раскладка нот: 0 chrom, 1 piano, 2 class
    trkv_c == 8 ? hk_next = trkv_a|0 :   // клавиша окна (classify, gate, undo, midi, names): сработает кадром @gfx, окно трекер открыл
    // 27 окт: 10 — загрузить слот быстрой загрузки N (0..7) тем же путём, что бросок файла
    // 27 окт: 12 — начало среза N (аргумент) в кадр gmem[TRKV+6103]; +6104 = 1 — и сыграть его (spam при протяжке в DSP)
    trkv_c == 12 ? (
      trkv_k = trkv_a|0;
      trkv_k >= 0 && trkv_k < dk_nsl[0] ? (
        trkv_lo = trkv_k > 0 ? trkv_sb[OF_START+trkv_k-1] + 64 : 0;
        trkv_hi = trkv_k < dk_nsl[0]-1 ? trkv_sb[OF_START+trkv_k+1] - 64 : dk_frames[0] - 64;
        trkv_sb[OF_START+trkv_k] = max(trkv_lo, min(trkv_hi, floor(gmem[TRKV+6103])));
        calc_ends(0);
        gmem[TRKV+6104] > 0.5 ? ( msel_only(0, trkv_k); pv_deck = 0; pv_req = trkv_k; );
      );
    ) :
    // 31 окт: 13 — поле стретча выбранного среза (и выделенных): аргумент 1 алгоритм, 2 размер зерна, 3 растяжение;
    // значение — gmem[TRKV+6103]
    trkv_c == 13 ? (
      trkv_fs = dk_sel[0];
      trkv_fs >= 0 && trkv_fs < dk_nsl[0] ? (
        trkv_fo = (trkv_a|0) == 1 ? OF_STALG : (trkv_a|0) == 2 ? OF_FXP2+FX_STRETCH*64 : OF_FXA2+FX_STRETCH*64;
        trkv_fv = gmem[TRKV+6103];
        trkv_ov = slb(0)[trkv_fo+trkv_fs]; slb(0)[trkv_fo+trkv_fs] = trkv_fv;
        apply_set(0, trkv_fo, trkv_ov, trkv_fv);
      );
    ) :
    trkv_c == 10 ? ( trkv_a >= 0 && trkv_a < 8 && strlen(QS0 + (trkv_a|0)) > 0 ? ( strcpy(#droppath, QS0 + (trkv_a|0)); drop_req = 1; drop_x = drop_y = -1; ); );
  );
  // 27 окт: пути 8 слотов быстрой загрузки — трекеру (плитки в шапке модуля): +7000 версия,
  // +7001+i*258 длина, дальше коды символов (до 256). Переписываются только при смене слотов / владельца
  qs_ver != trkv_qv ? (
    trkv_qv = qs_ver;
    trkv_qi = 0;
    while (trkv_qi < 8) (
      trkv_ql = min(256, strlen(QS0 + trkv_qi));
      trkv_qb = TRKV + 7001 + trkv_qi * 258;
      gmem[trkv_qb] = trkv_ql;
      trkv_qk = 0; while (trkv_qk < trkv_ql) ( gmem[trkv_qb + 1 + trkv_qk] = str_getchar(QS0 + trkv_qi, trkv_qk); trkv_qk += 1; );
      trkv_qi += 1;
    );
    gmem[TRKV+7000] = (gmem[TRKV+7000] + 1) % 1000000;
  );
  // состояния для пульта: +60 auto, +61 keys, +62 sync, +63 артикулятор (-1), +64..+71 слоты заняты (1/0),
  // +1400+i нота среза i, +1470+i класс среза i (пики — +300..+1323)
  // 31 окт: стретч выбранного среза — трекеру: +80 алгоритм (0..4), +81 размер зерна 0..1, +82 растяжение 0..1
  trkv_fs = dk_sel[0];
  trkv_fs >= 0 && trkv_fs < dk_nsl[0] ? (
    gmem[TRKV+80] = slb(0)[OF_STALG+trkv_fs]; gmem[TRKV+81] = slb(0)[OF_FXP2+FX_STRETCH*64+trkv_fs]; gmem[TRKV+82] = slb(0)[OF_FXA2+FX_STRETCH*64+trkv_fs];
  ) : ( gmem[TRKV+80] = -1; );
  gmem[TRKV+60] = auto_det; gmem[TRKV+61] = keys_on; gmem[TRKV+62] = dk_sync[0]; gmem[TRKV+63] = art_cur; gmem[TRKV+72] = keysmode; gmem[TRKV+73] = playthru || ped_thru;   // 31 окт: +73 thru (нота играет дальше своего среза)
  trkv_i = 0; while (trkv_i < 8) ( gmem[TRKV+64+trkv_i] = trkv_i < ART_N ? (art_at(trkv_i)[ART_W-1] > 0.5) : 0; trkv_i += 1; );
  trkv_i = 0;
  while (trkv_i < MAXSL) (
    gmem[TRKV+1400+trkv_i] = trkv_i < dk_nsl[0] ? slice_note(trkv_i) : -1;
    gmem[TRKV+1470+trkv_i] = trkv_i < dk_nsl[0] ? trkv_sb[OF_CLASS+trkv_i] : 0;
    // 31 окт: +4000+i растяжение среза i (0..1, 0.5 = x1, с общим Stretch) — трекер рисует волну ноты нужной длины
    // (+1600..+3647 — пики зума, не трогать)
    gmem[TRKV+4000+trkv_i] = trkv_i < dk_nsl[0] ? max(0, min(1, trkv_sb[OF_FXA2+FX_STRETCH*64+trkv_i] + (gstretch - 0.5))) : 0.5;
    trkv_i += 1;
  );
);

gmem[0] == MAGIC && gmem[1] != g_serial ? (
  g_serial = gmem[1];
  import_markers(0);
);

pv_req >= 0 ? (
  trigger_slice(pv_deck, pv_req, 100, -1, 0);
  pv_req = -1;
);
// computer keyboard (from @gfx) takes the same path as MIDI notes
kb_req >= 0 ? ( handle_on(kb_req, kb_vel, 0); midi_act = 1; kb_req = -1; );
kb_off >= 0 ? ( handle_off(kb_off); release_note(kb_off); kb_fx_off(kb_off); kb_off = -1; );

// ── МОНОМ (grid 128 + arc 4) через общую шину ────────────────────────────────
// Плагин видит только своё gmem "jf_slixer", шину "jf_mono" читать не может.
// Переходником работает jf_slixer_helper.lua: он кладёт нажатия в MNB_* ниже
// и забирает оттуда кадр светодиодов. Мы здесь знаем только «пэд номер N».
//
// Раскладка grid (16 x 8), ряд 1 сверху — философия ЛУПА, не пэдов:
//   ряды 1-3  — 48 пэдов one-shot (x + y*16), тем же путём, что и ноты
//   ряд 4     — выбор слота эффекта (4 кнопки на слот)
//   ряд 5     — эффект выбранного слота (16 кнопок, повтор = пусто), ALL/SEL
//   ряд 6     — 0 TSYNC (луп насквозь) · 1 сетка Q (та же, что input quantize) ·
//               2 ALL/SEL · 15 страница arc
//   ряды 7-8  — ЛУП: срезы 17-32 (ряд 7) и 1-16 (ряд 8, нижний, у плейхеда).
//               Плейхед бежит по ним; нажатие = прыжок плейхеда на срез по
//               кванту (при TSYNC), без TSYNC — запуск среза как пэда.
//               В режиме SEL нажатие ещё и выбирает срез для arc/правок.
// arc стр.1: старт, питч, гран. скорость, слот 1 p1; стр.2: длина, слот 1 p2, гейн, пан;
// стр.3: amount слотов 1-4; стр.4: p2 слотов 1-4. Кнопка arc / кнопка 15 ряда 8 листает.
//
// Адресация полей: поля лежат СТОЛБЦАМИ — все 64 начала подряд, потом все 64
// конца. Поэтому slb(0)[OF_PITCH + номер], а не отдельная база на срез.
MNB     = 1200;   // NB: не MB — в EEL2 совпало бы с локальной mb в msel_*
MNB_HB   = MNB;      MNB_STATE = MNB+1;
MNB_KEYN = MNB+2;    MNB_KEYS  = MNB+3;
MNB_ENCN = MNB+99;   MNB_ENCS  = MNB+100;
MNB_AKEYN= MNB+132;  MNB_AKEYS = MNB+133;
MNB_LEDVER = MNB+141; MNB_LEDS = MNB+142;
// КОЛЬЦА ARC: четыре по 64 светодиода. Их у слайсера не было вовсе — arc
// показывал пустоту, и «крутить эффекты на арке» приходилось вслепую.
MNB_ARING = MNB+280;
// ── КАРТИНКА ДЛЯ LINNSTRUMENT (14 сен) ───────────────────────────────────
// Прибор даёт ЦВЕТ, которого у монома нет, и для слайсера это главное:
// класс среза (kick/snare/hat/…) виден цветом, не считая рядов.
// Публикуем ГОТОВЫЕ КЛЕТКИ: 8x8 слева (срезы) и 8x8 справа (управление).
// Раз в блок: клетка стоит трёх MIDI-сообщений, чаще незачем.
// АДРЕС 9000, А НЕ MNB+560: блок вырос до 450 слов и с MNB (1200) дотянулся
// бы до 2209, а с 2000 начинается БРАУЗЕР КИТОВ (fv_b = 2000 + i*96) —
// затирали бы карточки, и нашлось бы это по пропавшим превью. Поймано
// расчётом карты памяти до первого запуска; тот же класс ошибки в этом
// проекте ловился уже трижды. 9000..9449 свободны: ниже 12000 (QSPK).
MNB_LCOL = 9000;        // 8 рядов x 24 колонки: цвет клетки срезов
MNB_LBRI = 9192;        // то же: 1 = ярко (выбранный срез)
MNB_RCOL = 9384;        // 8 x 8: цвет правой панели управления
MNB_LVER = 9448;        // версия кадра: модуль перерисовывает по изменению
MNB_LNP  = 9449;        // сколько полос 8x8 занято срезами (1..3)
// ── AMENHOTEP ────────────────────────────────────────────────────────────
// Кольцевой буфер огибающей выхода: 24 колонки прибора. В каждой — пик и
// три полосы энергии (низ/середина/верх), из них считается центроид и цвет.
// Считаем В @sample по окну, а не БПФ: три однополюсных фильтра на отсчёт
// вместо преобразования — осциллографу хватает, а процессор не замечает.
AMW_N   = 24;   // имя НЕ AMN_N: EEL2 без регистра, совпало бы с amn_n
AMW_PK  = 9460;   // и не AMN_PK: столкнулось бы с amn_pk         // 24: пик колонки 0..1
AMW_LO  = 9484;         // 24: энергия низа
AMW_MD  = 9508;         // 24: энергия середины
AMW_HI  = 9532;         // 24: энергия верха
amn_col = 0;            // текущая колонка
amn_n   = 0;            // отсчётов в ней
amn_pk  = 0; amn_el = 0; amn_em = 0; amn_eh = 0;
amn_lp  = 0; amn_lp2 = 0;   // состояние фильтров-разделителей
amn_klo = 1 - exp(-2*$pi*250/srate);
amn_khi = 1 - exp(-2*$pi*3000/srate);
// столбец держим ~40 мс: 25 кадров в секунду, волна «бежит» как на экране
amn_len = max(64, floor(srate * 0.04));
// Цвет LinnStrument по классу среза — ТОТ ЖЕ смысл, что у classcol в окне:
// одна величина одинаково выглядит и на экране, и на приборе.
//   1 красный · 2 жёлтый · 3 зелёный · 4 голубой · 5 синий · 6 фиолетовый
//   7 розовый · 8 оранжевый · 9 лайм · 10 морской · 11 белый
function cls_colour(cls) (
  cls == 1 ? 1  :   // kick   красный
  cls == 2 ? 2  :   // snare  жёлтый
  cls == 3 ? 4  :   // hat    голубой
  cls == 4 ? 3  :   // perc   зелёный
  cls == 5 ? 6  :   // crash  фиолетовый
  cls == 6 ? 5  :   // ride   синий
  cls == 7 ? 8  :   // voice  оранжевый
  cls == 8 ? 10 :   // fx     морской
             11 ;   // без класса — белый
);
MNB_PEDAL = MNB+160;   // слой педали экспрессии от демона (0..2)
MNB_RINGS = MNB+170;   // 8 слов: значения слотов наружу, для колец внешнего контроллера (0..1)
// ── АРБИТРАЖ ЭКЗЕМПЛЯРОВ (17 сен) ────────────────────────────────────────
// ДВА СЛАЙСЕРА В ПРОЕКТЕ ПИСАЛИ LED В ОДНУ ПАМЯТЬ. Оба видели «владеем
// мономом» (бит 4 общего состояния относится к ПЛАГИНУ, а не к экземпляру)
// и каждый блок клали свой кадр в MNB_LEDS — грид получал то один, то
// другой, отсюда мигание; на кольцах то же, но заметно слабее, потому что
// часть значений у экземпляров совпадала.
//
// Решение — ЗАХВАТ, а не выбор по треку: плагин не знает, выделен ли его
// трек (такого поля в JSFX нет), зато знает, работает ли он сам. Первый
// экземпляр пишет в MNB_OWN свой жетон и обновляет MNB_OWNT каждый блок;
// остальные видят живой жетон и молчат. Умер владелец (закрыли проект,
// сняли плагин) — счётчик перестаёт расти, и через полсекунды поверхность
// забирает следующий.
MNB_OWN  = MNB+178;    // жетон экземпляра-владельца (0 = свободно)
MNB_FOCUS = MNB+182;   // ключ окна в фокусе от демона (трек*1000 + индекс FX)
MNB_OWNT = MNB+179;    // «когда владелец отмечался», в общих тиках
                       // MNB+180 — общие тики (двигают все экземпляры)
                       // MNB+181 — раздатчик жетонов: каждый новый экземпляр +1
// ── ФЕЙДЕРЫ UC4 (14 сен) ──────────────────────────────────────────────────
// Абсолютные органы идут ОТДЕЛЬНОЙ очередью: энкодеры шлют дельту, фейдер —
// положение, и смешивать их в одну очередь значило бы гадать по значению.
// Адрес 1900: диапазон 1900..1999 в плагине свободен (проверено грепом),
// браузер начинается с 2000. Пара (номер фейдера 0..7, значение 0..1).
MNB_FADN = 1900;  MNB_FADS = 1901;   // до 16 пар за тик
tl_jump = -1;   // ожидающий прыжок плейхеда (срез) и его доля

// СЛОЙ ПЕДАЛИ от демона: он один читает CC11 на всю экосистему и кладёт
// сюда. Читаем БЕЗУСЛОВНО, не только когда владеем мономом: педаль глобальна,
// и слой должен действовать, даже если моном сейчас у другого модуля.
gmem[MNB_HB] ? ped_layer = gmem[MNB_PEDAL];
// Значения четырёх слотов наружу. Внешний контроллер убран, но публикация
// стоит копейки и пригодится любому будущему прибору.
mn_r = 0;
while (mn_r < AW_NPP) (
  gmem[MNB_RINGS + mn_r] = dk_sel[0] >= 0 ? slb(0)[OF_FXA + mn_r*64 + dk_sel[0]] : 0;
  mn_r += 1;
);
// ЖЕТОН экземпляра, один раз за жизнь. rand() тут НЕ ГОДИТСЯ: у JSFX он
// одинаково засеян, и все экземпляры получали один жетон (проба 17 сен
// показала own=9 у обоих — то есть арбитраж не работал вовсе).
// Берём общий счётчик: каждый новый экземпляр увеличивает его и забирает
// себе результат — номера гарантированно разные и без совпадений.
mn_tok == 0 ? (
  gmem[MNB_OWN + 3] = gmem[MNB_OWN + 3] + 1;
  mn_tok = gmem[MNB_OWN + 3];
);
// ЧАСЫ ОБЩИЕ, а не свои у каждого: сравнивать чужую отметку со своим
// счётчиком нельзя — экземпляры стартуют в разное время, и «протухло»
// срабатывало бы случайно. Считаем в ОБЩЕЙ ячейке: её двигают все, поэтому
// она монотонна для всех сразу. time_precise() в @block у JSFX нет.
gmem[MNB_OWNT + 1] = gmem[MNB_OWNT + 1] + 1;
mn_clk = gmem[MNB_OWNT + 1];
mn_gfxlive = time_precise() - mn_gfxt < 0.5;
// Владелец отмечается каждый блок; чужой жетон протух, если не обновлялся
// дольше ~0.5 с. Порог берём от размера блока, чтобы не зависеть от буфера.
mn_to = max(20, srate / max(64, samplesblock) * 0.5);
gmem[MNB_OWN] == mn_tok ? gmem[MNB_OWNT] = mn_clk :
  (gmem[MNB_OWN] == 0 || mn_clk - gmem[MNB_OWNT] > mn_to) ? (
    gmem[MNB_OWN] = mn_tok; gmem[MNB_OWNT] = mn_clk;
  );
// ── ФОКУС ОКНА ЗАБИРАЕТ ВЛАДЕНИЕ (17 сен, решение пользователя) ────────
// Демон кладёт в MNB_FOCUS ключ экземпляра, чьё окно трогали последним
// (номер трека*1000 + индекс FX — GetFocusedFX2). Плагин своего адреса не
// знает, поэтому узнаёт его иначе: в момент, когда демон СМЕНИЛ ключ, окно
// в фокусе — наше, если у нас открыт @gfx (gfx_w > 0). Кто увидел новый
// ключ и рисует — тот и забирает жетон.
gmem[MNB_FOCUS] != mn_fseen ? (
  mn_fseen = gmem[MNB_FOCUS];
  mn_gfxlive ? ( gmem[MNB_OWN] = mn_tok; gmem[MNB_OWNT] = mn_clk; );
);
// ФОКУС ОКНА ЗАБИРАЕТ ВЛАДЕНИЕ (17 сен, решение пользователя). Демон
// ставит winfocus = 1 тому экземпляру, чьё окно трогали последним
// (GetFocusedFX2), и 0 остальным. Кликнул по окну — этот слайсер получил
// грид и кольца; ни одного окна не открыто — работает захват по живости.
winfocus > 0.5 ? ( gmem[MNB_OWN] = mn_tok; gmem[MNB_OWNT] = mn_clk; );
mn_mine = gmem[MNB_OWN] == mn_tok;

gmem[MNB_STATE] & 4 && mn_mine ? (   // владеем мономом И мы тот экземпляр
  mn_sb = slb(0);

  // ---- нажатия ----
  mn_i = 0; mn_n = min(gmem[MNB_KEYN], 32);
  while (mn_i < mn_n) (
    mn_b = MNB_KEYS + mn_i*3;
    mn_x = gmem[mn_b]; mn_y = gmem[mn_b+1]; mn_s = gmem[mn_b+2];
    mn_y < 4 ? (
      // ── РЯДЫ 1-4: АРПЕДЖИАТОР ЦЕЛИКОМ (16 сен, решение пользователя) ──
      // Срезы с сетки убраны совсем: их место — клавиатура (белые клавиши),
      // а грид отдан тому, что на клавиатуре играть неудобно, — настройке
      // арпа под пальцами, не глядя.
      //   ряд 1  РЕЙТ, семь ступеней: 1/1 1/2 1/4 1/8 1/8T 1/16 1/32
      //          нажал ступень — арп включился (кнопка «вкл» не нужна:
      //          выбор скорости и есть намерение играть)
      //   ряд 2  ПОРЯДОК: up · down · up-down · random · as played
      //   ряд 3  ГЕЙТ (длина ноты) шестнадцатью ступенями по всей ширине
      //   ряд 4  0 вкл/выкл · 2 педаль-роль · 4 октава вверх (запас)
      mn_s ? (
        mn_y == 0 ? (
          mn_x < 7 ? (
            arp_rate = mn_x; sliderchange(slider34);
            arp_on ? 0 : ( arp_on = 1; sliderchange(slider33); );
          );
        ) : mn_y == 1 ? (
          mn_x < 5 ? ( arp_mode = mn_x; sliderchange(slider35); );
        ) : mn_y == 2 ? (
          // 16 клеток на диапазон 0.05..1: ползунок под пальцем
          arp_gate = 0.05 + (mn_x/15) * 0.95; sliderchange(slider36);
        ) : (
          mn_x == 0 ? (
            arp_on = !arp_on; sliderchange(slider33);
            !arp_on ? ( arp_note >= 0 ? release_note(arp_note); arp_note = -1; arp_clear(); );
          ) : mn_x == 2 ? (
            arp_pedal = arp_pedal + 1 > 2 ? 0 : arp_pedal + 1; sliderchange(slider37);
          );
        );
      );
    ) : mn_y == 4 ? (
      // РЯД 5: РЕЖИМ ВЫХОДА (клетка 1) и ВЫХОД ВЫДЕЛЕННОГО СРЕЗА (3-16).
      // Здесь были четыре слота Airwindows; они выпилены 25 окт, и ряд
      // занял то, что пришло им на смену — маршрутизация срезов.
      //   клетка 1  — режим по кругу: mix -> class -> slice
      //   клетки 3-16 — выход выделенного среза: 1..14 (повторный тап = 0,
      //     то есть обратно в общий микс). Выходов 64, клеток 16: ряд даёт
      //     первые четырнадцать, остальное — окно и пульт трекера, где
      //     номер набирается цифрой.
      mn_s ? (
        mn_x == 0 ? ( outmode = outmode + 1 > 2 ? 0 : outmode + 1; sliderchange(slider13); ) :
        mn_x >= 2 && mn_sl >= 0 ? (
          mn_sb[OF_OUTCH + mn_sl] = (mn_sb[OF_OUTCH + mn_sl]|0) == mn_x - 1 ? 0 : mn_x - 1;
        );
      );
    ) : mn_y == 5 ? (
      // РЯД 6: управление. 1 tsync · 2 Q · 3 LOOP · 4 all/sel · 16 страница arc
      // (мастер-слоты убраны: их алгоритм выбирается в окне, энкодером — нет)
      mn_s ? (
        mn_x == 0  ? ( tsync = !tsync; ) :
        mn_x == 1  ? ( qgrid = qgrid + 1 > 6 ? 0 : qgrid + 1; ) :
        mn_x == 2  ? ( sloop = !sloop; ) :
        // кнопка all/sel убрана: эффекты всегда на все срезы
        mn_x == 3  ? 0 :
        // АРП на гриде: кнопка 5 включает, 6-12 задают скорость. Семь
        // ступеней подряд — попадаешь не глядя, как в ряд транспорта.
        mn_x == 4  ? (
          arp_on = !arp_on;
          !arp_on ? ( arp_note >= 0 ? release_note(arp_note); arp_note = -1; arp_clear(); );
        ) :
        (mn_x >= 5 && mn_x <= 11) ? ( arp_rate = mn_x - 5; ) :
        mn_x == 12 ? ( arp_mode = arp_mode + 1 > 4 ? 0 : arp_mode + 1; ) :
        // ── SCALE: ШАГ ЭНКОДЕРА (21 сен) ────────────────────────────────
        // ЗАЖАЛ — нижний ряд стал выбором ступени (клетки 1-6), плюс
        // клетка 0 = вернуть адаптивный. Отпустил, ничего не выбрав —
        // переключение «адаптивный ↔ последняя ступень».
        //
        // Тот же жест, что у слотов и кабелей: держишь адрес — задаёшь
        // значение. Рука не учит третий способ.
        mn_x == 14 ? ( jog_scale_hold = 1; jog_scale_used = 0; );
        // Клетка 16 (mn_x == 15) БОЛЬШЕ НЕ НАША: столбец управления
        // принадлежит хосту в любом режиме — там запись, макросы, входы
        // (правило консистентности, 24 сен). События этой колонки демон
        // нам теперь и не присылает. Страница arc листается кнопками
        // самого arc, где ей и место.
      ) : mn_x == 14 ? (
        // отпустили scale
        !jog_scale_used ? jog_mode = jog_mode > 0 ? 0 : max(1, jog_last);
        jog_scale_hold = 0;
      );
    ) : mn_y == 7 && jog_scale_hold ? (
      // НИЖНИЙ РЯД ПОД SCALE: 0 = адаптивный, 1..NJOGS = ступень.
      // Перехват стоит ВЫШЕ обычного разбора ряда 8 (кабели матрицы),
      // поэтому пока кнопка зажата, кабели не трогаются.
      mn_s ? (
        mn_x == 0 ? ( jog_mode = 0; jog_scale_used = 1; ) :
        mn_x <= NJOGS ? ( jog_mode = mn_x; jog_last = mn_x; jog_scale_used = 1; );
      );
    ) : mn_y >= 16 ? (
      // ── LINNSTRUMENT: ЛЕВОЕ ПОЛЕ 8x8 = СРЕЗЫ (14 сен) ────────────────
      // Приходит с виртуальным рядом y = 16 + ряд прибора (0..7), чтобы не
      // пересечься ни с сеткой монома (0..7), ни с кнопками UC4 (8).
      // Ряд задаёт СПОСОБ игры, столбец — срез; цвет клетки = класс среза.
      //   0 +7 · 1 +5 · 2 +3 · 3 РЕВЕРС · 4 обычно · 5 −3 · 6 −5 · 7 −7
      // Транспонирование делается САМОЙ НОТОЙ: движок уже умеет играть срез
      // выше/ниже, отдельного кода не нужно. Реверс — флагом trig_rev,
      // тем же, что у чёрных клавиш.
      ln_row = mn_y - 16;
      // FULLLINN: колонка = кусок ВОЛНЫ, а не номер среза. Нажал — выбрал
      // тот срез, которому кусок принадлежит, и дальше его играет
      // КЛАВИАТУРА (Xkey25) по всей длине, хроматически. Сам прибор при
      // этом не звучит: он держит адрес, а не берёт ноту.
      linnfull > 0.5 ? (
        mn_s && dk_frames[0] > 0 ? (
          ln_f = (mn_x + 0.5) / 24 * dk_frames[0];
          ln_i = 0; ln_k = 0;
          while (ln_k < dk_nsl[0]) (
            mn_sb[OF_START + ln_k] <= ln_f ? ln_i = ln_k;
            ln_k += 1;
          );
          msel_only(0, ln_i);
          // клавиатура в хроматику: выбранный срез по всей длине
          // keysmode — внутренняя переменная, НЕ слайдер: sliderchange тут
          // не нужен (сначала позвал его с номером мёртвой темы — поймал
          // грепом до запуска).
          keysmode = 0;
        );
        mn_i += 1;
        mn_x = -1;            // дальше не разбираем: жест закрыт
      );
      // Колонка приходит АБСОЛЮТНОЙ (0..23): границу «срезы | управление»
      // держит модуль прибора, он же её и двигает при росте числа полос.
      ln_i = mn_x;
      ln_sem = ln_row == 0 ? 7 : ln_row == 1 ? 5 : ln_row == 2 ? 3 :
               ln_row == 5 ? -3 : ln_row == 6 ? -5 : ln_row == 7 ? -7 : 0;
      mn_s && mn_x < 24 ? (
        ln_i < dk_nsl[0] ? (
          // СУЩЕСТВУЮЩИЙ СРЕЗ.
          // Здесь был чопинг на лету (chop_here при записи, как у SP-404) —
          // ушёл вместе с записью со входа 25 окт.
          !edit_all ? msel_only(0, ln_i);
          ln_row == 3 ? trig_rev = 1;
          kb_req = slice_note(ln_i) + ln_sem; kb_vel = 100;
        ) : dk_frames[0] > 0 ? (
          // ПУСТАЯ КЛЕТКА — поведение SP-404 mk2:
          //   срезов нет вовсе → первая клетка ЗАПУСКАЕТ сэмпл целиком
          //     (одним срезом от нуля: играть-то надо, чтобы услышать, где
          //      ставить метки);
          //   срезы есть → метка встаёт ТАМ, ГДЕ СЕЙЧАС ИГРАЕТ, а если
          //     тишина — в конце последнего среза, чтобы клетка не пропала
          //     впустую.
          dk_nsl[0] == 0 ? (
            add_slice(0, 0);
            kb_req = slice_note(0); kb_vel = 100;
          ) : ln_i == dk_nsl[0] ? (
            chop_here(0) ? 0 : add_slice(0, min(dk_frames[0]-64, slb(0)[OF_END + dk_nsl[0]-1]));
            kb_req = slice_note(dk_nsl[0]-1); kb_vel = 100;
          );
        );
      ) : !mn_s && mn_x < 24 && ln_i < dk_nsl[0] ? (
        kb_off = slice_note(ln_i) + ln_sem;
      );
    ) : mn_y >= 24 ? (
      // ── LINNSTRUMENT: ПРАВОЕ ПОЛЕ 8x8 = УПРАВЛЕНИЕ ───────────────────
      // Приходит с y = 24 + ряд. Нижний ряд — АРПЕДЖИАТОР: семь ступеней
      // рейта и режим. Отдельной кнопки «включить» НЕТ (просьба
      // пользователя): нажал ступень — арп включился, ровно как на чёрных
      // клавишах (строка 1245). Выключение — клетка 0 предпоследнего ряда.
      ln_row = mn_y - 24;
      mn_s ? (
        ln_row == 7 ? (
          mn_x < 7 ? (
            arp_rate = mn_x; sliderchange(slider34);
            arp_on ? 0 : ( arp_on = 1; sliderchange(slider33); );
          ) : ( arp_mode = arp_mode + 1 > 4 ? 0 : arp_mode + 1; );
        ) : ln_row == 6 ? (
          mn_x == 0 && arp_on ? (
            arp_on = 0; sliderchange(slider33);
            arp_note >= 0 ? release_note(arp_note); arp_note = -1; arp_clear();
          );
        ) : (
          // ряды 0-5: слот цепи по паре столбцов, высота = amount
          ln_k = floor(mn_x / 2);
          ln_v = (6 - ln_row) / 6;
          ln_o = ln_k*64 + max(0, dk_sel[0]);
          mn_sb[OF_FXA + ln_o] = max(0, min(1, ln_v));
          mn_sb[OF_FXA2 + ln_o] = mn_sb[OF_FXA + ln_o];
          fxsel = ln_k;
        );
      );
    ) : mn_y >= 8 ? (
      // ── ВИРТУАЛЬНЫЙ РЯД 8+ = КНОПКИ UC4 (14 сен) ─────────────────────
      // Сетки 16x8 у прибора нет, кнопки приходят с y = 8 — за краем
      // сетки, поэтому ни с одним пэдом не пересекаются.
      //   0-7   пэды срезов 1-8: играют, как ряды 1-4 сетки (SP-1200: пэд =
      //         голос, и тот же путь kb_req, что клавиатура и MIDI)
      //   8-10  функция фейдеров VOL / PITCH / START
      //   11    TSYNC · 12 LOOP · 13 THRU
      mn_x < 8 ? (
        mn_x < dk_nsl[0] ? (
          mn_s ? (
            !edit_all ? msel_only(0, mn_x);
            kb_req = slice_note(mn_x); kb_vel = 100;
          ) : ( kb_off = slice_note(mn_x); );
        );
      ) : mn_s ? (
        mn_x == 11 ? ( tsync = !tsync; ) :
        mn_x == 12 ? ( sloop = !sloop; ) :
        mn_x == 13 ? ( playthru = !playthru; ) : 0;
      );
    ) : mn_y == 6 ? (
      // РЯД 7: слева АЛГОРИТМ СТРЕТЧА, справа АРТИКУЛЯТОРЫ.
      // Клетки 0-4 — стретч выделенного среза, в том же порядке, что
      // кнопки в окне: grain · cycle · tape · cloud · sync.
      mn_s && mn_x < 5 && mn_sl >= 0 ? mn_sb[OF_STALG + mn_sl] = mn_x :
      // Клетки 8-15 — ВОСЕМЬ АРТИКУЛЯТОРОВ (21 сен). Жест МГНОВЕННЫЙ:
      // держишь — артикулятор надет, отпустил — снят. Это и есть
      // артикуляция в смысле игры: акцент живёт ровно столько, сколько
      // палец на кнопке, как у духовика язык на трости.
      //
      // ЗАЩЁЛКА — тот же палец, но с намерением: держишь ДОЛЬШЕ 400 мс и
      // отпускаешь — артикулятор остаётся надетым. Второй тап снимает.
      // Порог во времени, а не вторая кнопка: рука на сцене не ищет
      // модификатор, а удержать чуть дольше умеет не глядя.
      mn_x >= 8 ? (
        art_k = mn_x - 8;
        mn_s ? (
          art_hold = art_k + 1;
          art_hold_t = 0;
          // Уже защёлкнут этот же — тап снимает.
          art_cur == art_k && art_latch ? ( art_off(); art_latch = 0; art_hold = 0; )
                                        : art_on(art_k);
        ) : art_hold == art_k + 1 ? (
          art_hold = 0;
          // ДЕРЖАЛ ДОЛГО → защёлка (намерение оставить), КОРОТКО → снять
          // (был акцент). Порог 400 мс: короче — это уже темп игры.
          art_hold_t > srate*0.4 ? art_latch = 1 : ( art_off(); art_latch = 0; );
        );
      ) : 0;
    ) : (
      // РЯД 8: ВОСЕМЬ КАБЕЛЕЙ МАТРИЦЫ. Тап = включить/выключить кабель
      // (запомнив источник и назначение — их выбирают в окне). ДЕРЖИШЬ
      // клетку и крутишь ЛЮБОЙ энкодер arc — глубина ЭТОГО кабеля: тот же
      // жест, что у слотов эффектов (ряд 5) и ручек стретча.
      mn_x < NCAB ? (
        mn_s ? ( cab_hold = mn_x + 1; cab_used = 0; ) : cab_hold == mn_x + 1 ? (
          // кабель без источника включать нечем — тап тогда не делает ничего
          !cab_used && CAB[mn_x*3] > 0 ?
            CAB[mn_x*3+2] = CAB[mn_x*3+2] != 0 ? 0 : 0.5;
          cab_hold = 0;
        );
      );
    );
    mn_i += 1;
  );

  // ---- фейдеры UC4: восемь срезов, громкость ----
  // Фейдер N крутит громкость среза N — как линейка микшера. Раньше ЧТО
  // именно крутит фейдер выбиралось кнопками SP-мода; SP-мод убран (15 сен),
  // и с ним ушла эта развилка. Громкость — единственное, что осмысленно
  // держать на АБСОЛЮТНОМ органе: положение фейдера И ЕСТЬ уровень, тогда
  // как старт и питч после смены среза врали бы (ровно та причина, по
  // которой на мономе arc, а не фейдеры).
  mn_i = 0; mn_n = min(gmem[MNB_FADN], 16);
  while (mn_i < mn_n) (
    mn_f = gmem[MNB_FADS + mn_i*2] | 0;
    mn_fv = max(0, min(1, gmem[MNB_FADS + mn_i*2 + 1]));
    mn_f >= 0 && mn_f < 8 && mn_f < dk_nsl[0] ? (
      // фейдер 0..1 → -24..+12 дБ, 0.667 = 0 дБ, как у mgain
      mn_sb[OF_GAIN + mn_f] = -24 + mn_fv*36;
    );
    mn_i += 1;
  );
  gmem[MNB_FADN] = 0;   // забрали — обнуляем сами, демон пишет по событию

  // ---- энкодеры arc ----
  // Параметры эффектов читаются СМЕСЬЮ сцен A и B (см. fxa/fxp), поэтому
  // пишем в обе: иначе крутишь энкодер, а звук не меняется, потому что
  // играет вторая сцена. Когда A/B станут параллельными потоками —
  // пересмотреть: писать нужно будет в активный поток.
  mn_i = 0; mn_n = min(gmem[MNB_ENCN], 16);
  // ── СКОРОСТЬ ВРАЩЕНИЯ: СЧИТАЕТСЯ ДО ЦИКЛА ───────────────────────────
  // Щелчки одного тика лежат в очереди пачкой, и их КОЛИЧЕСТВО и есть
  // скорость. Считать внутри цикла нельзя: первое событие пачки не знает,
  // сколько их всего, и разгон отставал бы на тик.
  //
  // Считаем по каждому энкодеру отдельно: две руки на двух кольцах —
  // обычное дело, и общая сумма сделала бы медленное кольцо быстрым.
  jog_i = 0; while (jog_i < 4) ( jog_cnt[jog_i] = 0; jog_i += 1; );
  jog_i = 0;
  while (jog_i < mn_n) (
    jog_k = gmem[MNB_ENCS + jog_i*2]|0;
    jog_k >= 0 && jog_k < 4 ? jog_cnt[jog_k] += abs(gmem[MNB_ENCS + jog_i*2 + 1]);
    jog_i += 1;
  );
  // Множитель на каждое кольцо. Один щелчок за тик — множитель 1, то есть
  // базовый шаг; дальше степенной разгон до потолка.
  jog_i = 0;
  while (jog_i < 4) (
    jog_mul[jog_i] = jog_cnt[jog_i] > 1 ?
      min(JOG_MAXX, pow(jog_cnt[jog_i], JOG_EXP)) : 1;
    jog_i += 1;
  );
  while (mn_i < mn_n) (
    mn_e = gmem[MNB_ENCS + mn_i*2];
    mn_d = gmem[MNB_ENCS + mn_i*2 + 1] * 0.002;
    // ── ШАГ ДЛЯ ПОЗИЦИОННЫХ ВЕЛИЧИН (кадры) ───────────────────────────
    // mn_dfr — сдвиг В КАДРАХ для этого щелчка. Адаптивный режим берёт
    // сэмпл за единицу и разгоняет его скоростью руки; ступенчатый — шаг
    // из таблицы, один и тот же независимо от скорости (для точной
    // правки стыка, где разгон только мешает).
    mn_dfr = gmem[MNB_ENCS + mn_i*2 + 1] *
      (jog_mode > 0 ? JOGST[min(NJOGS - 1, jog_mode - 1)]
                    : (mn_e >= 0 && mn_e < 4 ? jog_mul[mn_e|0] : 1));
    // ── РАЗГОН ДЛЯ НОРМИРОВАННЫХ 0..1: СВОЯ КРИВАЯ ────────────────────
    // Питч, стретч, глубина кабеля живут в 0..1 (или ±1), и кадры к ним не
    // применить. Кривая ДРУГАЯ, и это не лень, а разная арифметика:
    // у позиции диапазон 2.6 млн кадров, у нормированной — единица.
    // Квадрат с потолком 4096 прошёл бы её за два щелчка.
    //
    // Берём КОРЕНЬ ИЗ ПОЗИЦИОННОГО множителя, потолок 24: базовый шаг
    // 0.002, значит быстрое вращение даёт 0.048 за щелчок — полный ход за
    // 21 щелчок, то есть за треть оборота. Медленно по-прежнему 0.002,
    // это 1/500 диапазона: питч правится по центам.
    // Ступенчатый режим нормированных НЕ трогает: ступени заданы в кадрах,
    // и «256 кадров питча» не значит ничего.
    mn_d = mn_d * (jog_mode > 0 ? 1 :
      (mn_e >= 0 && mn_e < 4 ? min(24, sqrt(jog_mul[mn_e|0])) : 1));
    mn_sl = dk_sel[0];
    // ОРГАНЫ ВНЕШНЕГО КОНТРОЛЛЕРА УБРАНЫ (13 сен): прибор требовал USB-моста,
    // тот терял устройство и спорил за порт. Здесь были кнопки слотов,
    // спид-дайл, защёлка лупа, кроссфейдер и вторая четвёрка энкодеров.
    // Моном делает то же самое надёжнее, без единого внешнего процесса.
    // ДЕРЖАТ КЛЕТКУ СЛОТА (ряд 5) — энкодеры 1-4 = p1 · p2 · p3 · mix слота.
    // Стоит первым: адрес задан рукой на гриде, страница arc тут ни при чём.
    // держат клетку кабеля (ряд 8) — любой энкодер крутит его глубину
    cab_hold > 0 && mn_e < 4 ? (
      mn_bo = CAB + (cab_hold - 1)*3 + 2;
      mn_bo[0] = max(-1, min(1, mn_bo[0] + mn_d*2));
      cab_used = 1;
    ) :
    mn_e >= 8 ? (
      // ЭНКОДЕРЫ 9-12 (UC4, вторая четвёрка): огибающая выделенного среза
      // и питч. Вместе с 5-8 восемь энкодеров UC4 закрывают всю строку
      // ручек среза: pitch · gain · pan · length · atk · dec · sus · rel.
      mn_sl >= 0 ? (
        mn_e == 8  ? mn_sb[OF_PITCH + mn_sl] = max(-24, min(24, mn_sb[OF_PITCH + mn_sl] + mn_d*48)) :
        mn_e == 9  ? mn_sb[OF_ATK + mn_sl] = max(0, min(1, mn_sb[OF_ATK + mn_sl] + mn_d)) :
        mn_e == 10 ? mn_sb[OF_DEC + mn_sl] = max(0, min(1, mn_sb[OF_DEC + mn_sl] + mn_d)) :
        mn_e == 11 ? mn_sb[OF_REL + mn_sl] = max(0, min(1, mn_sb[OF_REL + mn_sl] + mn_d)) : 0;
      );
    ) : mn_e >= 4 ? (
      // энкодеры 5-8: вторая четвёрка параметров выделенного среза —
      // гейн, панорама, длина среза, amount слота 2
      mn_sl >= 0 ? (
        mn_e == 4 ? mn_sb[OF_GAIN + mn_sl] = max(-24, min(12, mn_sb[OF_GAIN + mn_sl] + mn_d*24)) :
        mn_e == 5 ? mn_sb[OF_PAN + mn_sl] = max(-1, min(1, mn_sb[OF_PAN + mn_sl] + mn_d*2)) :
        mn_e == 6 ? (
          mn_sl < dk_nsl[0] - 1 ? (
            mn_lo2 = mn_sb[OF_START + mn_sl] + 1;
            mn_hi2 = mn_sl < dk_nsl[0] - 2 ? mn_sb[OF_START + mn_sl + 2] - 1 : dk_frames[0] - 1;
            // UC4: шаг в кадрах тот же, но без адаптива — у mn_dfr для
            // энкодеров вне arc множитель 1, то есть сэмпл за щелчок
            // (ступенчатый режим действует и здесь).
            mn_sb[OF_START + mn_sl + 1] = max(mn_lo2, min(mn_hi2, mn_sb[OF_START + mn_sl + 1] + mn_dfr));
            calc_ends(0);
          );
        ) : (
          mn_o = 1*64 + mn_sl;           // слот 2 (sat) пути A
          mn_v = max(0, min(1, mn_sb[OF_FXA + mn_o] + mn_d));
          mn_sb[OF_FXA + mn_o] = mn_v; mn_sb[OF_FXA2 + mn_o] = mn_v;
        );
      );
    ) :
    // Листание алгоритмов убрано вместе с выбором: слоты фиксированы.
    (

    // ── ЗАЖАТА ЧЁРНАЯ С ЭФФЕКТОМ: ARC КРУТИТ ЕГО ПАРАМЕТРЫ (16 сен) ────
    // Пока клавиша держится, энкодеры принадлежат ей — как и всё остальное
    // в этот момент. Отпустил — вернулись к своим страницам. Своей страницы
    // эффектам не даём: их четыре, а рука одна, и «найти страницу» дороже,
    // чем «держать клавишу».
    kb_arc_slot > 0 ? (
      mn_a = kb_arc_slot == 1 ? kbfx1 : kb_arc_slot == 2 ? kbfx2 :
             kb_arc_slot == 3 ? kbfx3 : kbfx4;
      mn_a == 1 ? (
        mn_e == 0 ? ( kbp_ring = max(0, min(1, kbp_ring + mn_d)); sliderchange(slider51); ) :
        mn_e == 1 ? ( kbp_ring2 = max(0, min(1, kbp_ring2 + mn_d)); sliderchange(slider52); ) : 0;
      ) : mn_a == 2 ? (
        mn_e == 0 ? ( kbp_phase = max(0, min(1, kbp_phase + mn_d)); sliderchange(slider53); ) :
        mn_e == 1 ? ( kbp_phase2 = max(0, min(1, kbp_phase2 + mn_d)); sliderchange(slider54); ) : 0;
      ) : mn_a == 3 ? (
        mn_e == 0 ? ( kbp_sub = max(0, min(1, kbp_sub + mn_d)); sliderchange(slider55); );
      ) : mn_a == 4 ? (
        mn_e == 0 ? ( kbp_crush = max(0, min(1, kbp_crush + mn_d)); sliderchange(slider56); );
      ) : mn_a == 5 ? (
        mn_e == 0 ? ( kbp_filt = max(0, min(1, kbp_filt + mn_d)); sliderchange(slider57); ) :
        mn_e == 1 ? ( kbp_filt2 = max(0, min(1, kbp_filt2 + mn_d)); sliderchange(slider58); ) : 0;
      ) : mn_a == 6 ? (
        mn_e == 0 ? ( kbp_tape = max(0, min(1, kbp_tape + mn_d)); sliderchange(slider59); );
      ) : mn_a == 7 ? (
        mn_e == 0 ? ( kbp_gate = max(0, min(1, kbp_gate + mn_d)); sliderchange(slider60); );
      ) : 0;
    ) :
    mn_sl >= 0 && mn_sl < MAXSL ? (
      mn_arcpage == 0 ? (
        mn_e == 0 ? (
          mn_lo = mn_sl > 0 ? mn_sb[OF_START + mn_sl - 1] + 1 : 0;
          mn_hi = mn_sl < dk_nsl[0] - 1 ? mn_sb[OF_START + mn_sl + 1] - 1 : dk_frames[0] - 1;
          // ШАГ В КАДРАХ, а не доля деки: адаптивно — от сэмпла и вверх
          // по скорости руки, ступенчато — ровно столько, сколько выбрано.
          mn_sb[OF_START + mn_sl] = max(mn_lo, min(mn_hi, mn_sb[OF_START + mn_sl] + mn_dfr));
          calc_ends(0);
        ) :
        mn_e == 1 ? mn_sb[OF_PITCH + mn_sl] = max(-24, min(24, mn_sb[OF_PITCH + mn_sl] + mn_d*24)) :
        mn_e == 2 ? mn_sb[OF_FXA2 + FX_STRETCH*64 + mn_sl] = max(0, min(1, mn_sb[OF_FXA2 + FX_STRETCH*64 + mn_sl] + mn_d)) :
        (
          // ПИТЧ-БЕНД НА ЭНКОДЕРЕ (15 сен): ±1 = ±диапазон; ЛЕГКО ПРИЛИПАЕТ К
          // ПОЛУТОНАМ (снап — только здесь), кнопка arc возвращает в ноль.
          mn_pr = pb_range();
          mn_semi = (pbend + mn_d*2) * mn_pr;
          mn_semi = max(-mn_pr, min(mn_pr, mn_semi));
          abs(mn_semi - floor(mn_semi + 0.5)) < KSNAP ? mn_semi = floor(mn_semi + 0.5);
          pbend = mn_semi / mn_pr;
          pbmul = pow(2, mn_semi / 12);
        );
      ) : mn_arcpage == 1 ? (
        // СТРАНИЦА 2 была «ручки слота Airwindows» — слоты выпилены 25 окт.
        // Теперь первый энкодер выбирает ВЫХОД выделенного среза (0 = общий
        // микс, 1..64 = свой канал), остальные свободны под будущее.
        mn_e == 0 && mn_sl >= 0 ? (
          mn_sb[OF_OUTCH + mn_sl] =
            max(0, min(64, floor(mn_sb[OF_OUTCH + mn_sl] + mn_d*64 + 0.5)));
        );
      ) : (
        mn_e == 0 ? (
          mn_sl < dk_nsl[0] - 1 ? (
            mn_lo = mn_sb[OF_START + mn_sl] + 1;
            mn_hi = mn_sl < dk_nsl[0] - 2 ? mn_sb[OF_START + mn_sl + 2] - 1 : dk_frames[0] - 1;
            mn_sb[OF_START + mn_sl + 1] = max(mn_lo, min(mn_hi, mn_sb[OF_START + mn_sl + 1] + mn_dfr));
            calc_ends(0);
          );
        ) :
        mn_e == 1 ? mn_sb[OF_GAIN + mn_sl] = max(-24, min(12, mn_sb[OF_GAIN + mn_sl] + mn_d*24)) :
        mn_e == 2 ? mn_sb[OF_PAN + mn_sl] = max(-1, min(1, mn_sb[OF_PAN + mn_sl] + mn_d*2)) :
                    mn_sb[OF_RND + mn_sl] = max(0, min(1, mn_sb[OF_RND + mn_sl] + mn_d));
      );
    );
    );            // закрываем ветку «зажат слот / обычные страницы»
    mn_i += 1;
  );

  // ---- кнопки arc: переключают страницу ----
  mn_i = 0; mn_n = min(gmem[MNB_AKEYN], 4);
  while (mn_i < mn_n) (
    gmem[MNB_AKEYS + mn_i*2 + 1] ? (
      // Кнопка 1 arc (индекс 0) — ГЛОБАЛЬНЫЙ выход в GRID, её забирает
      // демон и нам не присылает. Последняя — питч-бенд в ноль (у энкодера
      // нет отпускания, возврат делается кнопкой). Средние листают страницы.
      gmem[MNB_AKEYS + mn_i*2] >= 3 ? ( pbend = 0; pbmul = 1; )
                                    : mn_arcpage = (mn_arcpage + 1) % 3;
    );
    mn_i += 1;
  );

  // ---- светодиоды ----
  // Раз в 4 блока: моном обновляется ~60 Гц, чаще незачем, а 128 записей
  // в gmem на каждый блок — заметная трата впустую.
  mn_ledt += 1;
  mn_ledt >= 4 ? (
    mn_ledt = 0;
    memset(MNB_LEDS, 0, 128);
    // ── РЯДЫ 1-4: ПАНЕЛЬ АРПЕДЖИАТОРА (16 сен) ─────────────────────────
    // Срезы отсюда убраны: они на клавиатуре. Здесь настройка, и каждый ряд
    // показывает СВОЙ выбор — выбранное ярко, остальное тускло, чтобы
    // состояние читалось не глядя.
    mn_i = 0;
    while (mn_i < 7) (
      gmem[MNB_LEDS + mn_i] = arp_rate == mn_i ? (arp_on ? 15 : 8) : 3;
      mn_i += 1;
    );
    mn_i = 0;
    while (mn_i < 5) (
      gmem[MNB_LEDS + 16 + mn_i] = arp_mode == mn_i ? 13 : 3;
      mn_i += 1;
    );
    // гейт: заполнение слева направо, как полоса
    mn_g = floor((arp_gate - 0.05) / 0.95 * 15 + 0.5);
    mn_i = 0;
    while (mn_i < 16) (
      gmem[MNB_LEDS + 32 + mn_i] = mn_i <= mn_g ? (mn_i == mn_g ? 15 : 7) : 2;
      mn_i += 1;
    );
    gmem[MNB_LEDS + 48] = arp_on ? (arp_n > 0 ? 15 : 11) : 3;
    gmem[MNB_LEDS + 50] = 4 + arp_pedal*3;      // роль педали: ярче = дальше по кругу
    // ряд 5: режим выхода (клетка 1) + выход выделенного среза (3-16).
    // Клетка 1 светится по режиму: mix тускло, class средне, slice ярко —
    // видно с грида, куда уходит звук. Выход среза — 15 на своей клетке,
    // 2 на остальных; без выделенного среза ряд тёмный.
    gmem[MNB_LEDS + 4*16] = outmode > 1.5 ? 15 : outmode > 0.5 ? 7 : 3;
    gmem[MNB_LEDS + 4*16 + 1] = 0;
    mn_k = 2;
    while (mn_k < 16) (
      gmem[MNB_LEDS + 4*16 + mn_k] =
        mn_sl >= 0 && (mn_sb[OF_OUTCH + mn_sl]|0) == mn_k - 1 ? 15 : 2;
      mn_k += 1;
    );
    // ряд 8: кабели. Держат — 15; кабель работает — яркость по |глубине|;
    // источник выбран, но глубина ноль — 3; пусто — 0.
    // ПОД ЗАЖАТЫМ SCALE ряд показывает СТУПЕНИ, а не кабели: поверхность
    // говорит, что сейчас под пальцем, а не что там вообще бывает.
    jog_scale_hold ? (
      mn_k = 0;
      while (mn_k < 16) (
        gmem[MNB_LEDS + 7*16 + mn_k] =
          mn_k == 0 ? (jog_mode == 0 ? 15 : 5) :               // адаптивный
          mn_k <= NJOGS ? (jog_mode == mn_k ? 15 : 3 + mn_k) : // ступени: чем крупнее, тем ярче
          0;
        mn_k += 1;
      );
    ) : (
      mn_k = 0;
      while (mn_k < NCAB) (
        gmem[MNB_LEDS + 7*16 + mn_k] = cab_hold == mn_k + 1 ? 15 :
          CAB[mn_k*3] > 0 ? (CAB[mn_k*3+2] != 0 ? 4 + floor(min(1, abs(CAB[mn_k*3+2]))*11) : 3) : 0;
        mn_k += 1;
      );
    );
    // кнопка scale: держат — 15; ступенчатый режим — ярко ровно;
    // адаптивный (умолчание) — тускло: это «ничего не навязано».
    gmem[MNB_LEDS + 5*16 + 14] = jog_scale_hold ? 15 : (jog_mode > 0 ? 9 : 3);
    // ряд 7: пять алгоритмов стретча, текущий у выделенного среза — ярко
    mn_k = 0;
    while (mn_k < 5) (
      gmem[MNB_LEDS + 6*16 + mn_k] = mn_sl >= 0 && (mn_sb[OF_STALG + mn_sl]|0) == mn_k ? 13 : 3;
      mn_k += 1;
    );
    // ряд 7 справа: восемь артикуляторов. ЗАЩЁЛКНУТЫЙ МИГАЕТ — по правилу
    // экосистемы «выключено/особое состояние показывается изменением во
    // времени, а не яркостью»: яркость тут уже занята под «слот записан».
    // Надетый пальцем горит ровно, записанный — вполнакала, пустой темнее.
    mn_k = 0;
    while (mn_k < ART_N) (
      gmem[MNB_LEDS + 6*16 + 8 + mn_k] =
        art_cur == mn_k ? (art_latch ? (mn_ledblink ? 15 : 6) : 15) :
        art_at(mn_k)[ART_W-1] > 0.5 ? 6 : 1;
      mn_k += 1;
    );
    gmem[MNB_LEDS + 5*16 + 0]  = tsync ? 15 : 4;
    gmem[MNB_LEDS + 5*16 + 1]  = qgrid == 0 ? 3 : 5 + qgrid;   // Q: off тускло, чем крупнее сетка — ярче
    gmem[MNB_LEDS + 5*16 + 2]  = sloop ? 15 : 4;
    gmem[MNB_LEDS + 5*16 + 3]  = 0;   // бывшая all/sel: кнопка убрана
    // арп: кнопка включения и семь ступеней скорости
    gmem[MNB_LEDS + 5*16 + 4] = arp_on ? (arp_n > 0 ? 15 : 10) : 3;
    mn_k = 0;
    while (mn_k < 7) (
      gmem[MNB_LEDS + 5*16 + 5 + mn_k] = arp_rate == mn_k ? (arp_on ? 14 : 7) : 2;
      mn_k += 1;
    );
    gmem[MNB_LEDS + 5*16 + 12] = arp_on ? 6 : 2;
    // Клетка 16 не подсвечивается: колонка принадлежит хосту, он и рисует
    // там свои кнопки. Страницу arc видно на кольцах.

    // НИЖНИЙ РЯД — ПИТЧ-БЕНД. Центр помечен всегда, зажатая клетка горит
    // максимумом: видно и где ноль, и куда увело.
    // КОЛЬЦА ARC (15 сен). Страница 0: start · pitch · stretch · PITCH BEND;
    // 1: sub · tri · sqr · bend (precalc); 2: length · gain · pan · rnd.
    // Кольцо питчбенда БИПОЛЯРНОЕ с делениями по полутонам: ноль наверху,
    // метки тускло — сетка величины, как у джога с долями такта.
    mn_r = 0;
    while (mn_r < 4) (
      mn_sl2 = dk_sel[0];
      mn_k = 0; while (mn_k < 64) ( gmem[MNB_ARING + mn_r*64 + mn_k] = 0; mn_k += 1; );
      // ── SCALE ЗАЖАТ: КОЛЬЦА ПОКАЗЫВАЮТ ШАГ ──────────────────────────
      // Семь меток по кольцу — адаптивный и шесть ступеней, текущая ярко.
      // Правило экосистемы «кольцо = значение И ЕГО СЕТКА»: видно и где
      // ты, и сколько всего положений, не глядя на экран.
      jog_scale_hold ? (
        mn_k = 0;
        while (mn_k <= NJOGS) (
          gmem[MNB_ARING + mn_r*64 + ((mn_k*64/(NJOGS+1))|0)] = jog_mode == mn_k ? 15 : 4;
          mn_k += 1;
        );
      ) :
      mn_arcpage == 0 && mn_r == 3 ? (
        mn_pr = pb_range();
        mn_k = -mn_pr;
        while (mn_k <= mn_pr) (
          gmem[MNB_ARING + mn_r*64 + ((32 + floor(mn_k * 31 / mn_pr + 0.5)) & 63)] = 4;
          mn_k += 1;
        );
        gmem[MNB_ARING + mn_r*64 + ((32 + floor(pbend * 31 + 0.5)) & 63)] = 15;
      ) : (
        mn_rv = mn_sl2 < 0 || dk_frames[0] <= 0 ? 0 :
          mn_arcpage == 0 ? (
            mn_r == 0 ? mn_sb[OF_START + mn_sl2] / dk_frames[0] :
            mn_r == 1 ? (mn_sb[OF_PITCH + mn_sl2] + 24) / 48 :
                        mn_sb[OF_FXA2 + FX_STRETCH*64 + mn_sl2]
          ) : mn_arcpage == 1 ? (
            // страница 2: выход среза на первом кольце (было: ручки слота)
            mn_r == 0 ? mn_sb[OF_OUTCH + mn_sl2] / 64 : 0
          ) : (
            mn_r == 0 ? (mn_sb[OF_END + mn_sl2] - mn_sb[OF_START + mn_sl2]) / dk_frames[0] :
            mn_r == 1 ? (mn_sb[OF_GAIN + mn_sl2] + 24) / 36 :
            mn_r == 2 ? (mn_sb[OF_PAN + mn_sl2] + 1) / 2 : mn_sb[OF_RND + mn_sl2]
          );
        mn_rv = max(0, min(1, mn_rv));
        mn_k = 0;
        while (mn_k < 64) (
          gmem[MNB_ARING + mn_r*64 + mn_k] = mn_k < mn_rv*64 ? 11 : 1;
          mn_k += 1;
        );
        mn_rv > 0 ? gmem[MNB_ARING + mn_r*64 + min(63, floor(mn_rv*64))] = 15;
      );
      mn_r += 1;
    );
    mn_ledblink = !mn_ledblink;
    gmem[MNB_LEDVER] = gmem[MNB_LEDVER] + 1;


  );
);


// Бюджет 16384 кадра на блок: при блоке 512 @ 44.1к это ~11 мс звука, а
// цепочка на кадр стоит ~60 операций — около миллисекунды счёта. Срез в
// две секунды печётся за шесть блоков, то есть быстрее, чем рука отпустит
// ручку. Во время захвата, потоковой загрузки и задач нарезки молчим: они
// сами пишут в буфер или читают его целиком.
// ── МАТРИЦА: раз в блок ──────────────────────────────────────────────────
// mod_on — тот же приём жёсткого байпаса, что у слотов: ни одного кабеля,
// и @sample матрицы не касается вовсе (одно сравнение на голос).
// АРТИКУЛЯТОР: сколько сэмплов держат кнопку. Считается в блоках, а не по
// времени системы: play_position стоит на паузе, а рука держит по-настоящему.
art_hold > 0 ? art_hold_t += samplesblock;

mod_on = 0; mk_ = 0;
while (mk_ < NCAB) ( CAB[mk_*3] > 0 && CAB[mk_*3+2] != 0 ? mod_on = 1; mk_ += 1; );
mod_on ? mod_block();

// БЛОКА СЛОТОВ ЗДЕСЬ БОЛЬШЕ НЕТ (25 окт). Он раз в блок считал fxnet_on,
// готовил четыре слота Airwindows (sfx_prep) и усыплял их после 4 секунд
// тишины. Слоты выпилены — обработка срезов живёт в контейнере REAPER.



// ── КАРТИНКА ДЛЯ LINNSTRUMENT — ВНЕ БЛОКА «ВЛАДЕЕМ МОНОМОМ» (правка 14 сен)
// Была ВНУТРИ него, и потому не рисовалась вовсе: моном у GRID-мода, а
// LinnStrument — отдельный прибор, к владению мономом отношения не имеет.
// Симптом был точный: «на приборе не видно ничего», при этом модуль жив и
// прибор подключён — плагин просто не публиковал кадр.
// Рисуем всегда, когда есть что рисовать: модуль сам решает, показывать ли
// (он проверяет, наш ли выделенный трек).
//
// СВОЯ БАЗА СРЕЗОВ: mn_sb присваивается ВНУТРИ монómного блока, и снаружи
// хранила бы ноль — обращения ушли бы по адресу 0, то есть в чужую память.
// Берём деку заново, это одна операция на кадр.
mn_sb = slb(0);
// ── КАРТИНКА ДЛЯ LINNSTRUMENT ────────────────────────────────────────
// ЛЕВОЕ ПОЛЕ 8x8 — СРЕЗЫ, ряд задаёт способ игры (раскладка пользователя,
// 14 сен). Ряды сверху вниз:
//   1  +7 полутонов   2  +5   3  +3
//   4  РЕВЕРС среза   5  обычное проигрывание
//   6  -3             7  -5   8  -7
// Обычная игра в 5-м ряду, а не в 1-м: пальцы лежат на нём в покое, а
// питч разбегается вверх и вниз симметрично — это читается как клавиши,
// а не как список. Цвет = КЛАСС среза, одинаковый во всех рядах:
// столбец узнаётся по цвету, ряд — по высоте руки.
// СКОЛЬКО ПОЛОС СРЕЗОВ: приоритет у срезов (просьба пользователя).
// До 8 срезов — одна полоса слева, управление справа. Больше — полос
// столько, сколько нужно, панель управления уезжает правее; на модели
// 128 (16 колонок) вторая полоса съедает управление целиком, поэтому
// на ней остаётся только арпеджиатор нижним рядом.
// AMENHOTEP: границы «срезы | управление» нет вовсе — весь прибор экран,
// иначе волна обрывалась бы на восьмой колонке. Полос столько, сколько
// колонок у прибора (24 хватает и полноразмерной модели).
// при обоих (мог остаться из старого пресета) приоритет у РАБОТЫ:
// FULLLINN несёт смысл, AMENHOTEP только вид
amen > 0.5 && linnfull > 0.5 ? amen = 0;
ln_np = amen > 0.5 ? 3 : max(1, min(3, ceil(dk_nsl[0] / 8)));
gmem[MNB_LNP] = ln_np;
// FULLLINN: вся сетка — ВОЛНА, поделённая на срезы. Колонка = кусок
// сэмпла; цвет = класс среза, которому кусок принадлежит, поэтому
// границы срезов читаются стыком цветов. Высота столбца = громкость
// куска: видно и форму, и нарезку разом.
// Выбранный срез горит ярко (белым) — его и играет клавиатура.
linnfull > 0.5 && dk_frames[0] > 0 ? (
  ln_c = 0;
  while (ln_c < 24) (
    // какой срез покрывает эту колонку
    ln_f = (ln_c + 0.5) / 24 * dk_frames[0];
    ln_i = 0; ln_k = 0;
    while (ln_k < dk_nsl[0]) (
      mn_sb[OF_START + ln_k] <= ln_f ? ln_i = ln_k;
      ln_k += 1;
    );
    // громкость куска из профиля обзора (5 слов на бин: min, max, …)
    ln_b = OVW0 + floor(ln_f / BINSZ)*5;
    ln_v = min(1, max(abs(ln_b[0]), abs(ln_b[1])));
    ln_h = max(1, floor(ln_v * 8 + 0.5));
    ln_col = mn_sb[OF_MUTE + ln_i] > 0.5 ? 0 : cls_colour(mn_sb[OF_CLASS + ln_i]|0);
    ln_r = 0;
    while (ln_r < 8) (
      // столбец снизу вверх: ряд 7 низ
      gmem[MNB_LCOL + ln_r*24 + ln_c] = (7 - ln_r) < ln_h ? ln_col : 0;
      gmem[MNB_LBRI + ln_r*24 + ln_c] = (ln_i == dk_sel[0] && (7 - ln_r) < ln_h) ? 1 : 0;
      ln_r += 1;
    );
    ln_c += 1;
  );
  ln_np = 3;               // весь прибор под волну, панели нет
  gmem[MNB_LNP] = ln_np;
) : (
// Полосы срезов: до трёх по 8 колонок. ПУСТЫЕ КЛЕТКИ НЕ ГОРЯТ (просьба
// пользователя): тёмная клетка = «сюда можно поставить метку», и на
// приборе сразу видно, докуда нарезано. Кроме ОДНОЙ клетки сразу за
// последним срезом — она тускло-белая: это «добавить сюда», и без неё
// жест был бы невидимым.
ln_r = 0;
while (ln_r < 8) (
  ln_c = 0;
  while (ln_c < 24) (
    ln_i = ln_c;                       // колонка = срез, полосы подряд
    ln_col = 0; ln_bri = 0;
    // AMENHOTEP: клетки срезов НЕ рисуем вовсе (решение пользователя
    // 14 сен) — прибор становится чистым экраном, и волна не спорит с
    // цветами классов за внимание. Играть при этом можно как обычно:
    // раскладка жива, просто не подсвечена.
    amen < 0.5 && ln_c < ln_np*8 ? (
      ln_i < dk_nsl[0] ? (
        mn_sb[OF_MUTE + ln_i] > 0.5 ? ln_col = 0 : (
          ln_col = cls_colour(mn_sb[OF_CLASS + ln_i]|0);
          // цвет несёт КЛАСС, ряд — способ игры: две независимые оси
          ln_bri = (ln_i == dk_sel[0]) ? 1 : 0;
        );
      ) : ln_i == dk_nsl[0] && dk_frames[0] > 0 && ln_r == 4 ? (
        ln_col = 11;                   // «добавить сюда», только ряд игры
      );
    );
    gmem[MNB_LCOL + ln_r*24 + ln_c] = ln_col;
    gmem[MNB_LBRI + ln_r*24 + ln_c] = ln_bri;
    ln_c += 1;
  );
  ln_r += 1;
);
);
// ПРАВОЕ ПОЛЕ 8x8 — управление. Нижние два ряда: АРПЕДЖИАТОР (жёлтый,
// тот же цвет, что у snare — жёлтый закреплён за арпом по просьбе
// пользователя). Семь ступеней рейта + режим. Отдельной кнопки «вкл»
// НЕТ: нажал ступень — арп включился (так же работают чёрные клавиши,
// строка 1245). Выше — слайдеры параметров эффектов цепи.
ln_r = 0;
while (ln_r < 8) (
  ln_c = 0;
  while (ln_c < 8) (
    ln_col = 0;
    amen > 0.5 ? 0 :
    ln_r == 7 ? (
      // нижний ряд: семь ступеней рейта, 8-я клетка — режим арпа
      ln_c < 7 ? ln_col = (arp_rate == ln_c) ? (arp_on ? 2 : 9) : (arp_on ? 9 : 0) :
                 ln_col = arp_on ? 8 : 0;
    ) : ln_r == 6 ? (
      // предпоследний: выключить арп (первая клетка) — жест обратный
      ln_c == 0 ? ln_col = arp_on ? 2 : 0 : ln_col = 0;
    ) : (
      // ряды 1-6: четыре слота цепи по два столбца, уровень amount
      ln_k = floor(ln_c / 2);
      ln_v = mn_sb[OF_FXA + ln_k*64 + max(0, dk_sel[0])];
      ln_col = (6 - ln_r) <= ln_v*6 ? (CHBYP[ln_k] > 0.5 ? 5 : 4) : 0;
    );
    gmem[MNB_RCOL + ln_r*8 + ln_c] = ln_col;
    ln_c += 1;
  );
  ln_r += 1;
);
// ── AMENHOTEP: ВОЛНА ПОВЕРХ КЛЕТОК ───────────────────────────────────
// Рисуем ПОСЛЕ раскладки, поэтому она видна сквозь паузы: где волна
// тихая, проступают цвета срезов. Форма симметрична от середины, как у
// осциллографа; цвет столбца — по спектральному центроиду ТОЙ ЖЕ
// формулой, что волна в окне: низ янтарный (8), середина зелёная (3),
// верх голубой (4), совсем верх синий (5).
amen > 0.5 ? (
  ln_c = 0;
  while (ln_c < AMW_N) (
    // колонки бегут так, чтобы свежая была справа: прибор читается
    // как экран, слева направо
    amn_k = (amn_col + ln_c) % AMW_N;
    amn_v = AMW_PK[amn_k];
    amn_e = AMW_LO[amn_k] + AMW_MD[amn_k] + AMW_HI[amn_k];
    amn_ct = amn_e > 0 ? (AMW_MD[amn_k]*0.5 + AMW_HI[amn_k]) / amn_e : 0;
    // ЦВЕТ КАК У СПЕКТРАЛЬНЫХ ПИКОВ REAPER (уточнение пользователя):
    // чем НИЖЕ частота, тем ТЕМНЕЕ — низ уходит в тёмно-синий, верх
    // вспыхивает белым. Так бас не забивает картинку, а хэты видно
    // издалека. У прибора нет полутонов яркости, поэтому «темнее»
    // выражается ЦВЕТОМ: синий тёмный, фиолетовый, голубой, лайм,
    // белый — ряд по возрастанию видимой светлоты.
    amn_col2 = amn_ct < 0.25 ? 5 :    // низ      синий (самый тёмный)
               amn_ct < 0.45 ? 6 :    // низ-сер  фиолетовый
               amn_ct < 0.65 ? 4 :    // середина голубой
               amn_ct < 0.85 ? 9 :    // верх-сер лайм
                               11;    // верх     белый (самый яркий)
    // высота: половина от середины вверх и вниз, минимум одна клетка,
    // чтобы линия не пропадала на тишине
    amn_h = max(0, min(4, floor(amn_v * 4 + 0.5)));
    ln_r = 0;
    while (ln_r < 8) (
      // расстояние ряда от середины (3.5): 0.5 у центральных
      amn_d = abs(ln_r - 3.5);
      amn_d <= amn_h ? gmem[MNB_LCOL + ln_r*24 + ln_c] = amn_col2;
      ln_r += 1;
    );
    ln_c += 1;
  );
  ln_r += 1;
);

// ПОСЛЕДНИЙ СЫГРАННЫЙ СРЕЗ — одна розовая точка (7), ПОСЛЕ волны:
// нарисуй её раньше — волна бы её затёрла. Единственное, что остаётся
// от раскладки: видно, где палец, и картинка не «мёртвая».
amen > 0.5 && dk_sel[0] >= 0 && dk_sel[0] < 24 ?
  gmem[MNB_LCOL + 4*24 + dk_sel[0]] = 7;

gmem[MNB_LVER] = gmem[MNB_LVER] + 1;

while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & $xF0;
  mch = m1 & $x0F;
  src_chan = mch;          // движок положит его в голос при запуске ноты
  chok = mcha == 0 || mch == mcha-1;
  st == $xB0 && m2 >= 102 && m2 <= 108 ? np_cc(mch, m2, m3) :   // 26 окт: команды трекера на ноту
  st == $x90 && m3 > 0 ? (
    chok && arp_on ? (
      // АРП ВКЛЮЧЁН: нота не играет сразу, а встаёт в список. Играть их
      // будет генератор в @sample, по одной, в темп.
      midi_act = 1;
      // первая нота после паузы начинает отсчёт с нуля: арп трогается
      // сразу, а не ждёт остатка предыдущего шага
      arp_n == 0 ? ( arp_wait = 0; arp_i = -1; arp_dir = 1; );
      arp_add(m2, m3);
    ) :
    chok ? (
      midi_act = 1;
      // Input quantize: hold the note until the next grid line. The wait is
      // usually longer than one block (a 1/16 at 120bpm is ~6000 samples), so
      // it is counted down in @sample rather than nudging the block offset.
      // Q ПО ТРАНЗИЕНТАМ (просьба пользователя 14 сен). Работает НЕ как
      // сеточный: ждать следующего транзиента нельзя — они нерегулярны, и
      // ожидание растянулось бы на полсекунды. Вместо ожидания подтягиваем
      // ТОЧКУ ВХОДА: играем сразу, но с ближайшей найденной атаки.
      // Границы срезов и есть транзиенты — детектор уже разложил их при
      // нарезке, искать заново нечего.
      //
      // Толк в этом такой: нажатие остаётся твоим, а материал начинается со
      // своей атаки — брейк звучит так, будто ты попал в его собственную
      // долю, и грув исходника не ломается сеткой темпа.
      qtrans > 0.5 && dk_nsl[0] > 1 && tl_active ? (
        // где сейчас идёт таймлайн внутри сэмпла
        qtf = (play_position*srate + ofs);
        qtf = qtf - floor(qtf / dk_frames[0]) * dk_frames[0];
        // ближайшая граница среза к этой точке
        qtb = 0; qtd = dk_frames[0];
        qti = 0;
        while (qti < dk_nsl[0]) (
          qtdd = abs(slb(0)[OF_START + qti] - qtf);
          qtdd < qtd ? ( qtd = qtdd; qtb = qti; );
          qti += 1;
        );
        // играем СРАЗУ, но срезом, чья атака ближе всего к моменту нажатия
        handle_on(slice_note(qtb), m3, ofs);
      ) :
      qstep > 0 ? (
        qpos = play_position*srate + ofs;
        qwait = qstep - (qpos - floor(qpos/qstep)*qstep);
        qwait >= qstep - 1 ? qwait = 0;   // already on the line
        qwait <= 0 ? handle_on(m2, m3, ofs) : (
          qnn = 0;
          while (qnn < QNQMAX && QNQ[qnn*3+2] > 0) ( qnn += 1; );
          qnn < QNQMAX ? (
            QNQ[qnn*3] = m2; QNQ[qnn*3+1] = m3; QNQ[qnn*3+2] = qwait;
          ) : handle_on(m2, m3, ofs);   // queue full: play it straight away
        );
      ) : handle_on(m2, m3, ofs);
    );
  ) : (st == $x80 || (st == $x90 && m3 == 0)) ? (
    // ЗАЩЁЛКА: в этом режиме отпускание НЕ убирает ноту — набор держится,
    // пока не нажмёшь новый. Иначе арп замолкал бы, едва снял пальцы.
    chok && arp_on && arp_latch ? 0 :
    chok && arp_on ? arp_remove(m2) :
    chok ? ( handle_off(m2); release_note(m2); kb_fx_off(m2); );
  ) : st == $xA0 ? (
    // poly aftertouch -> стретч ТОЛЬКО этой ноты: сильнее давишь — сильнее
    // тянется (CME-клавиатура пользователя даёт полифонический AT)
    // at_in — СЫРОЕ входящее давление для индикатора в окне: пишется ДО
    // всех условий (канал, совпадение ноты), чтобы отличать «MIDI не
    // доходит» от «доходит, но не к той ноте».
    at_in = m3/127;
    chok ? (
      pa_i = 0;
      while (pa_i < NVOICE) (
        pa_v = V0 + pa_i*VF;
        pa_v[fA] && pa_v[fNOTE] == m2 ? pa_v[fPAT] = m3/127;
        pa_i += 1;
      );
    );
  ) : st == $xD0 ? (
    // ДАВЛЕНИЕ -> ГЛУБИНА СТРЕТЧА в реальном времени.
    // Без MPE это канальный афтертач: один на всё (at0).
    // В MPE прибор шлёт давление НА КАНАЛ ПАЛЬЦА, поэтому кладём его в ту
    // ноту, что звучит на этом канале, — получается настоящий поли-стретч:
    // каждый срез тянется своим пальцем.
    at_in = m2/127;
    mpe > 0.5 ? (
      pa_i = 0;
      while (pa_i < TLVOICE) (
        pa_v = V0 + pa_i*VF;
        pa_v[fA] && pa_v[fSCH] == mch ? pa_v[fPAT] = m2/127;
        pa_i += 1;
      );
    ) : chok ? at0 = m2/127;
  ) : st == $xB0 && m2 == 11 ? (
    // ПЕДАЛЬ ЭКСПРЕССИИ (CC11) -> СЛОЙ РАСКЛАДКИ в режиме class.
    // Клавиатура пользователя — Xkey25, это ровно две октавы, поэтому третий
    // слой («второй срез класса») физически недостижим клавишами. Педаль
    // решает это лучше кнопки: нога держит АДРЕС, руки берут значение — то
    // же разделение, что во всех жестах экосистемы.
    // СТУПЕНЯМИ, а не плавно: положение ноги само показывает слой, и между
    // ступенями нельзя «застрять» (решение пользователя 13 сен).
    // Своё чтение остаётся как запасной путь: педаль воткнута прямо в трек,
    // демон не запущен — жест всё равно работает. Демон, когда жив,
    // перетирает это значение через MNB_PEDAL (одно решение на экосистему).
    chok ? ped_layer = m3 < 43 ? 0 : m3 < 86 ? 1 : 2;
  ) : st == $xE0 ? (
    // PITCH WHEEL: 14 бит, центр 8192. Диапазон — пресетом или слайдером.
    // В РЕЖИМЕ MPE принимаем с ЛЮБОГО канала: LinnStrument шлёт бенд на
    // канал пальца (2-16), и фильтр по каналу глушил бы прибор целиком.
    (chok || mpe > 0.5) ? (
      pbend = ((m3*128 + m2) - 8192) / 8192;
      pbmul = pow(2, pbend * pb_range() / 12);
    );
  ) : st == $xB0 && m2 == 64 ? (
    // ПЕДАЛЬ (CC64). Её роль выбирается слайдером arp_pedal:
    //   off    — как раньше: THRU на время удержания
    //   hold   — арп играет, ПОКА педаль нажата (нога держит режим)
    //   latch  — нажатие ПЕРЕКЛЮЧАЕТ арп и защёлкивает набор нот
    // Нога держит режим, руки играют — то же разделение, что у слоя
    // раскладки и у THRU.
    chok ? (
      arp_ped = m3 >= 64;
      // РОЛЬ 3 — СТРЕТЧ ПО ПЕДАЛИ (16 сен, просьба пользователя): пока
      // педаль нажата, афтертач тянет срез; отпустил — стретч выключен
      // целиком, как бы сильно ни давил. Даёт играть с давлением, не боясь
      // случайно растянуть ноту: педаль решает, слушать ли его вообще.
      arp_pedal == 3 ? ped_str = arp_ped :
      arp_pedal == 0 ? ped_thru = arp_ped :
      arp_pedal == 1 ? (
        arp_on = arp_ped;
        sliderchange(slider33);
        !arp_on ? ( arp_note >= 0 ? release_note(arp_note); arp_note = -1; arp_clear(); );
      ) : (
        // latch срабатывает по НАЖАТИЮ: отпускание ничего не меняет,
        // иначе режим снимался бы сам собой
        arp_ped ? (
          arp_on = !arp_on;
          arp_latch = arp_on;
          sliderchange(slider33);
          !arp_on ? ( arp_note >= 0 ? release_note(arp_note); arp_note = -1; arp_clear(); );
        );
      );
    );
  ) : st == $xB0 && m2 == 1 ? (
    // МОДКОЛЕСО. При включённом арпе крутит ЕГО СКОРОСТЬ: семь ступеней от
    // целой до тридцать второй, по колесу снизу вверх. Ступенями, а не
    // плавно: значение должно быть музыкальным, а не «где-то между».
    //
    // Прежняя роль (смещение фазы чтения внутри среза) остаётся, когда арп
    // выключен: колесо — один орган, и делить его между двумя смыслами
    // одновременно было бы хуже, чем отдать активному режиму.
    chok ? (
      arp_on ? (
        arp_rate = min(6, floor(m3 / 127 * 6.999));
        sliderchange(slider34);
      ) : mw0 = m3/127;
    );
  ) : st == $xB0 && (m2 == 123 || m2 == 120) ? (
    // паника обязана снять и арп: иначе он продолжит долбить в тишину
    arp_clear(); arp_note = -1; arp_gate_left = 0;
    kill_all();
  );
  !(st == $xB0 && m2 >= 102 && m2 <= 108) ? midisend(ofs, m1, m2, m3);
);

@sample
// ЗАПИСИ СО ВХОДА БОЛЬШЕ НЕТ (25 окт, решение пользователя: «в жопу запись,
// это ненужная тема в 99% случаев, и если что есть jf_rec»). Здесь стоял блок
// armed/capturing: он писал вход в деку и ПО ПУТИ считал обзорные бины —
// два однополюсных фильтра и три накопителя энергии НА КАЖДЫЙ СЭМПЛ, то есть
// 48000 раз в секунду, всегда, даже когда никто не записывал.
// Звук в деку кладёт загрузка через демона (gmem[7] = 1/2), а записывать
// умеет jf_rec: его «почтовый ящик вставки» печатает кусок кольца айтемом на
// таймлайн, оттуда slixer берёт его обычной загрузкой.
// Вход в деку сквозь плагин — slider11 thru, он с записью не связан.

// sequencer triggers waiting for their sample offset (note = -2 marks them)
sqq_any ? (
  sq_q = 0;
  while (sq_q < SQQMAX) (
    SQQ[sq_q*3+2] > 0 ? (
      SQQ[sq_q*3+2] -= 1;
      SQQ[sq_q*3+2] <= 0 ? trigger_slice(0, SQQ[sq_q*3], SQQ[sq_q*3+1], -2, 0);
    );
    sq_q += 1;
  );
);

// quantized notes waiting for their grid line
qnq_any ? (
  qnn = 0;
  while (qnn < QNQMAX) (
    QNQ[qnn*3+2] > 0 ? (
      QNQ[qnn*3+2] -= 1;
      QNQ[qnn*3+2] <= 0 ? handle_on(QNQ[qnn*3], QNQ[qnn*3+1], 0);
    );
    qnn += 1;
  );
);

// ── АРПЕДЖИАТОР: ТАКТОВЫЙ ГЕНЕРАТОР ──────────────────────────────────────
// Считаем В САМПЛАХ, как и квантизация: так арп попадает ровно в те же
// линии сетки, что квантованные ноты, и не плывёт относительно них.
//
// Ноты уходят обычным путём (handle_on / release_note), поэтому арп сам
// собой получает всё остальное: режимы среза, стретч, цепь эффектов.
arp_on && arp_n > 0 ? (
  // снятие предыдущей ноты по gate: длина ноты — доля шага, поэтому
  // короткий gate даёт стаккато, длинный — почти легато
  arp_gate_left > 0 ? (
    arp_gate_left -= 1;
    arp_gate_left <= 0 && arp_note >= 0 ? ( release_note(arp_note); arp_note = -1; );
  );
  arp_wait > 0 ? arp_wait -= 1 : (
    arp_step = arp_step_samples();
    arp_wait = arp_step;
    arp_cnt = arp_build();
    arp_cnt > 0 ? (
      // выбор следующей ноты по режиму
      arp_mode == 3 ? (
        arp_i = floor(rand(1) * arp_cnt);
        arp_i >= arp_cnt ? arp_i = arp_cnt - 1;
      ) : arp_mode == 2 ? (
        // up-down: на краях РАЗВОРАЧИВАЕМСЯ, не повторяя крайнюю ноту
        // дважды — иначе в конце каждого прохода слышен заикающийся дубль
        arp_i < 0 ? ( arp_i = 0; arp_dir = 1; ) : (
          arp_i += arp_dir;
          arp_i >= arp_cnt ? ( arp_dir = -1; arp_i = max(0, arp_cnt - 2); );
          arp_i < 0 ? ( arp_dir = 1; arp_i = min(arp_cnt - 1, 1); );
        );
      ) : (
        arp_i += 1;
        arp_i >= arp_cnt ? arp_i = 0;
      );
      // снимаем то, что звучало, и берём следующую
      arp_note >= 0 ? ( release_note(arp_note); arp_note = -1; );
      arp_play = ARPS[arp_i] - 1;
      arp_play >= 0 ? (
        // velocity берём из списка: тихо нажал — тихо и повторяется
        arp_vel = 100;
        arp_k = 0;
        while (arp_k < 32) (
          ARPN[arp_k] == arp_play + 1 ? arp_vel = ARPV[arp_k];
          arp_k += 1;
        );
        handle_on(arp_play, arp_vel, 0);
        arp_note = arp_play;
        arp_gate_left = max(64, arp_step * arp_gate);
      );
    );
  );
) : (
  // арп выключили или сняли все ноты — гасим хвост
  arp_note >= 0 ? ( release_note(arp_note); arp_note = -1; arp_gate_left = 0; );
);

bi_ = 0;
while (bi_ < (outmode > 1.5 ? 64 : 12)) ( busM[bi_] = 0; bi_ += 1; );

// ---- voice loop -------------------------------------------------------------
// One deck, one loop. Each fx parameter is read as a blend of scene A and scene
// B at the crossfader position, so the fader morphs the whole chain instead of
// mixing two separate decks.
cd_buf = dbuf(0);
cd_frames = dk_frames[0];
cd_sb = slb(0);
cd_syncmode = dk_sync[0];

// ---- timeline player -------------------------------------------------------
// With TSYNC on, the loop plays itself in time with the project. Rather than a
// separate signal path, it drives the reserved voice: the fx chain, the slice
// parameters and the routing below all apply to it unchanged. Its slice index
// follows the read position, so each part of the loop gets its own slice's fx.
tl_active ? (
  tv = V0 + TLVOICE*VF;
  !tv[fA] ? (
    // starting: take the slice under the current position
    tv[fA] = 1; tv[fST] = 1; tv[fENV] = 0;
    tv[fGL] = 1; tv[fGR] = 1; tv[fDIR] = 1; tv[fGRAN] = -1;
    tv[fNOTE] = -1; tv[fVEL] = 100; tv[fONOTE] = 0;
    tv[fRATE] = 1; tv[fTR] = 1;
    tl_off = 0; tl_jump = -1;               // новый старт лупа — без смещения
    tv[fBCC] = 0; tv[fDNC] = 0; tv[fSTC] = 0; tv[fGLC] = 0;
    tv[fCEN] = 0; tv[fSATL] = 0; tv[fSATR] = 0;
    tv[fPH1] = 0; tv[fPH2] = 0; tv[fPH3] = 0;
    tl_s = -1;
  );
  tv[fPOS] = tl_pos;
  tv[fVT] = tl_pos;
  // which slice are we inside? scan forward from the last one, since the
  // position advances monotonically except at the loop wrap
  tl_pos < cd_sb[OF_START+max(tl_s,0)] ? tl_s = -1;
  ts_ = max(tl_s, 0);
  while (ts_ < dk_nsl[0]-1 && cd_sb[OF_START+ts_+1] <= tl_pos) ( ts_ += 1; );
  dk_nsl[0] > 0 ? (
    // ОГИБАЮЩАЯ ПЕРЕЗАПУСКАЕТСЯ НА КАЖДОМ СРЕЗЕ (просьба пользователя
    // 14 сен: «если проигрывается весь луп, каждый слайс должен
    // отыгрываться по своему ADSR»). Раньше таймлайновый голос брал
    // огибающую ОДИН раз при старте лупа, и срезанная атака слышалась
    // только на первом срезе — дальше звук шёл сплошняком.
    // Перезапуск по СМЕНЕ НОМЕРА среза: на границе он меняется ровно один
    // раз, и лишних ретригов не будет.
    ts_ != tl_s ? ( tv[fST] = 1; tv[fEPH] = 0; tv[fENV] = 0; );
    tl_s = ts_;
    tv[fS] = tl_s;
    tv[fSTART] = cd_sb[OF_START+tl_s];
    tv[fEND] = cd_sb[OF_END+tl_s];
    // мьют: срез молчит в лупе, длина и сетка остаются — «дырка» в ритме
    tv[fGL] = cd_sb[OF_MUTE+tl_s] > 0.5 ? 0 : 1; tv[fGR] = tv[fGL];
  ) : (
    tv[fS] = 0; tv[fSTART] = 0; tv[fEND] = cd_frames;
  );
  tl_pos += tl_step;
  tl_pos >= cd_frames ? tl_pos -= cd_frames;
) : (
  tv = V0 + TLVOICE*VF;
  tv[fA] && tv[fNOTE] == -1 ? ( tv[fST] = 3; );   // transport stopped: release
);

aol = 0; aor = 0;
vi = 0;
while (vi < NVOICE) (
  v = V0 + vi*VF;
  v[fA] ? (
    s = v[fS];
    // ГДЕ ГОЛОС ВНУТРИ СРЕЗА — считается ПЕРВЫМ ДЕЛОМ. Стояло ниже, у формы
    // модуляции слотов, и кабели «позиция в срезе → питч/старт/стретч»
    // читали бы значение ПРОШЛОГО сэмпла, а на первом сэмпле ноты — остаток
    // от другого голоса. gran здесь ещё не выбран: путь чтения определяется
    // ниже, поэтому берём прошлый флаг голоса (fGRAN) — он верен для всех
    // сэмплов, кроме первого после переключения пути, где оба указывают в
    // одно и то же место.
    mv_ph = min(1, max(0, ((v[fGRAN] > 0 ? v[fVT] : v[fPOS]) - v[fSTART]) / max(1, v[fEND] - v[fSTART])));
    mv_rnd = v[fMRND];
    // витрина для окна: пишет ЛЮБОЙ звучащий голос, последний побеждает.
    // Выбирать «голос выделенного среза» дороже и бессмысленно: индикатор
    // показывает жизнь инструмента, а не конкретной ноты.
    mod_on ? (
      MODVIS[SRC_VEL] = v[fVEL]/127; MODVIS[SRC_ENV] = v[fENV];
      MODVIS[SRC_PHASE] = mv_ph; MODVIS[SRC_RND] = mv_rnd;
    );
    smode = cd_sb[OF_MODE+s];
    // ЧЁРНАЯ КЛАВИША играет тот же срез задом наперёд. Флаг живёт в ГОЛОСЕ,
    // поэтому настройка среза не трогается вовсе: один и тот же срез может
    // звучать прямо с белой и реверсом с чёрной ОДНОВРЕМЕННО.
    v[fREV] > 0.5 && smode < 1.5 ? smode = 1;
    // LOOP (как на Amiga-семплерах): пока пэд зажат, срез крутится —
    // вперёд, назад (режим rev) или туда-сюда (режим PP). Не для голоса
    // таймлайна: при TSYNC луп и так идёт насквозь до конца.
    // LOOP зацикливает ТОЛЬКО пока пэд реально зажат: у отпущенной ноты
    // (fST == 3, огибающая гаснет) срез доигрывает как есть и замолкает.
    // Иначе отпущенный звук крутился бы в петле до конца затухания.
    sloop && vi != TLVOICE && v[fST] != 3 ?
      smode = smode == 0 ? 2 : smode == 1 ? 4 : smode;
    v[fRATE] += (v[fTR] - v[fRATE]) * gcoef;
    // pbmul — колесо высоты: тянет ЧТЕНИЕ, поэтому стоит здесь же, рядом с
    // синхронизацией. Границы среза и режим петли оно не трогает.
    rt = v[fRATE] * (cd_syncmode == 1 ? scene_sm : 1) * pbmul;
    // МОДУЛЯЦИЯ ПИТЧА: ±12 полутонов на полной глубине. Множителем, а не
    // прибавкой к rate: полутон — величина логарифмическая.
    mod_on ? ( md_ = mod_sum(DST_PITCH, v); md_ != 0 ? rt *= pow(2, md_); );
    sliceln = max(1, v[fEND] - v[fSTART]);
    voff = mw0 * sliceln;  // modwheel phase offset
    mod_on ? voff += mod_sum(DST_START, v) * sliceln * 0.5;

    // ПЕРФ-ЭФФЕКТЫ (FM, STRETCH, GLIT, STUT) читают БАНК B: их индексы 1/3/8/9
    // в банке A заняты слотами пути A (0-3), а путь B читает только 4-7 —
    // в банке B индексы 1, 3, 8, 9 свободны. Раньше awpath оставался тем,
    // на чём кончился цикл путей (2), и это работало случайно.
    awpath = 1;
    // FM modulates the read position
    fma = fxa(FX_FM, s);
    fma > 0.003 ? (
      v[fPH1] += 30*pow(2, fxp(FX_FM, s)*7)/srate * 2*$pi;
      voff += sin(v[fPH1]) * fma*fma*400;
    );

    sta = fxa(FX_STRETCH, s);
    mod_on ? sta = max(0, min(1, sta + mod_sum(DST_STRETCH, v)*0.5));
    // ГЛОБАЛЬНЫЙ СТРЕТЧ складывается со срезовым В ЛОГАРИФМЕ: обе величины —
    // это множители скорости, и «вдвое медленнее у среза» плюс «вдвое
    // медленнее глобально» должно дать вчетверо, а не сумму долей.
    // Обе шкалы одинаковы (0.5 = 1x), поэтому сложение смещений от нейтрали
    // и есть произведение множителей.
    gstretch != 0.5 ? sta = max(0, min(1, sta + (gstretch - 0.5)));
    // Кривая применяется ЗДЕСЬ, в одной точке: и канальный, и полифонический
    // афтертач проходят через неё, а всё, что ниже, работает как раньше.
    atv = max(at0, v[fPAT]);      // канальный или полифонический AT — что сильнее
    // СТРЕТЧ ПО ДАВЛЕНИЮ РАБОТАЕТ ВСЕГДА (решение пользователя 18 сен: «чтобы
    // не нужно было даже нажимать педаль»). Была роль педали STR, глушившая
    // давление при отпущенной педали, — и она же стояла умолчанием: стретч
    // «не работал» у каждого, кто не нашёл эту кнопку. Роль убрана совсем.
    atcurve != 1 && atv > 0 ? atv = pow(atv, atcurve);
    v[fATS] = min(1, atv);
    // АЛГОРИТМ СТРЕТЧА СРЕЗА. tape не гранулярный вовсе: он идёт прямым
    // путём чтения, просто с другой скоростью — поэтому gran для него ложь.
    salg = cd_sb[OF_STALG+s]|0;
    vns = v[fNSF] != 0 && v[fNSF] == v[fMRND] ? max(0.0625, min(16, v[fNST])) : 1;   // 26 окт: растяжение ноты (SB)
    gran = salg != 2 && (abs(sta - 0.5) > 0.01 || cd_syncmode == 2 || atv > 0.003 || kstr_on || vns != 1);
    gran != v[fGRAN] ? (
      // seamless path switch (e.g. aftertouch pressed mid-voice)
      v[fGRAN] = gran;
      gran ? (
        v[fVT] = v[fPOS]; v[fPA] = v[fPOS]; v[fPB] = v[fPOS];
        v[fPHA] = 0; v[fPHB] = 0.5;
      ) : v[fPOS] = v[fVT];
    );

    gran ? (
      // granular: 2 hann-windowed heads, timeline independent of pitch;
      // forced when deck sync is STRETCH or aftertouch is pressed
      // АФТЕРТАЧ ДО УПОРА = ДОЛГИЙ ЛУП (решение пользователя 13 сен).
      // pow(0.25, atv) замедляет всего вчетверо — на срезе в полсекунды это
      // две секунды, то есть «быстро прекращается». Выше 0.85 глубина растёт
      // резко: к единице это уже в 64 раза, десятки секунд из одного среза.
      // Порог, а не плавность: палец должен ЧУВСТВОВАТЬ, где начинается
      // другой режим, иначе жест неуправляем.
      atdeep = atv > 0.85 ? (atv - 0.85) / 0.15 : 0;
      spd = pow(8, 1 - 2*sta)
            * (dk_srate[0] > 0 ? dk_srate[0]/srate : 1)
            * (cd_syncmode ? scene_sm : 1)
            * pow(0.25, atv) * pow(0.0625, atdeep)
            / (kstr_on ? kstr_ratio : 1) / vns;   // black-key stretch: slower timeline; vns — команда ноты
      glen = (0.02 + fxp(FX_STRETCH, s)*0.1) * srate;
      v[fVT] += spd * v[fDIR];
      // На глубоком афтертаче чтение ЗАЦИКЛИВАЕТСЯ, даже если у среза режим
      // «один раз»: замедление само по себе только отодвигает конец, а нужен
      // бесконечный тянущийся звук. Отпустил палец — режим среза вернулся.
      wrap_pos(v, fVT, atdeep > 0 ? 2 : smode);
      v[fPA] += rt; v[fPB] += rt;
      v[fPHA] += 1/glen; v[fPHB] += 1/glen;
      v[fPHA] >= 1 ? (
        v[fPHA] -= 1;
        gpn = v[fVT] + voff;
        // cloud: прыжок со случайным разбросом в полтора зерна — таймлайн
        // тот же, но каждое зерно берёт звук чуть не оттуда: размытие
        salg == 3 ? gpn += (rand(2) - 1) * glen * 1.5;
        gpn >= v[fEND] ? gpn -= sliceln;
        gpn < v[fSTART] ? gpn += sliceln;
        salg == 4 ? gpn = ws_align(gpn, v[fPB], v[fSTART], v[fEND], glen);
        v[fPA] = gpn;
      );
      v[fPHB] >= 1 ? (
        v[fPHB] -= 1;
        gpn = v[fVT] + voff;
        salg == 3 ? gpn += (rand(2) - 1) * glen * 1.5;
        gpn >= v[fEND] ? gpn -= sliceln;
        gpn < v[fSTART] ? gpn += sliceln;
        salg == 4 ? gpn = ws_align(gpn, v[fPA], v[fSTART], v[fEND], glen);
        v[fPB] = gpn;
      );
      salg == 1 ? ( wa = cyc_win(v[fPHA]); wb = cyc_win(v[fPHB]); ) : (
        wa = 0.5 - 0.5*cos(2*$pi*v[fPHA]);
        wb = 0.5 - 0.5*cos(2*$pi*v[fPHB]);
      );
      l = readsmp(v[fPA],0)*wa + readsmp(v[fPB],0)*wb;
      r = readsmp(v[fPA],1)*wa + readsmp(v[fPB],1)*wb;
    ) : (
      rp = v[fPOS] + voff;
      rp >= v[fEND] ? rp -= sliceln;
      rp < v[fSTART] ? rp += sliceln;
      l = readsmp(rp,0); r = readsmp(rp,1);
      // the timeline voice's position is written by the transport each sample,
      // so it must not advance or wrap itself
      vi != TLVOICE || !tl_active ? (
        // TAPE: стретч = скорость ленты, высота едет вместе с ней. Те же
        // множители, что у гранулярного пути (ряд str, глобальный стретч,
        // давление, чёрные клавиши), поэтому ручки и афтертач ведут себя
        // одинаково во всех пяти алгоритмах. Глубокое давление (> 0.85)
        // зацикливает срез — как там же: лента почти встала и тянется.
        salg == 2 && (abs(sta - 0.5) > 0.01 || atv > 0.003 || kstr_on || cd_syncmode == 2 || vns != 1) ? (
          atdeep = atv > 0.85 ? (atv - 0.85) / 0.15 : 0;
          v[fPOS] += rt * v[fDIR] * pow(8, 1 - 2*sta) * (cd_syncmode == 2 ? scene_sm : 1)
                     * pow(0.25, atv) * pow(0.0625, atdeep) / (kstr_on ? kstr_ratio : 1) / vns;
          wrap_pos(v, fPOS, atdeep > 0 ? 2 : smode);
        ) : (
          v[fPOS] += rt * v[fDIR];
          wrap_pos(v, fPOS, smode);
        );
      );
    );

    // ---- fx chain: every slot runs at once; black keys push amounts up ----
    // Each audio slot below is wrapped in its own dry/wet: the pre-effect signal
    // is kept and mixed back after, so the next slot receives the mixed result.
    // FM and STRETCH are not in this scheme -- they move the read position
    // rather than shape the sample, and crossfading two read points is a comb
    // filter, not a mix. gl/gr keep the untouched read for the global dry/wet.
    slice_wet = cd_sb[OF_WET+s];
    gl_ = l; gr_ = r;
    // glitch: random jump repeats (amt=probability, p2=interval)
    ga = max(fxa(FX_GLIT, s), OVR[9]);
    mod_on ? ga = max(0, min(1, ga + mod_sum(DST_GLIT, v)));
    ga > 0.003 ? (
      v[fGLC] -= 1;
      v[fGLC] <= 0 ? (
        v[fGLC] = (0.02 + fxp(FX_GLIT, s)*0.2) * srate;
        v[fGLP] = rand(1) < ga ? floor(rand(sliceln)) : 0;
      );
      v[fGLP] > 0 ? (
        gp = (gran ? v[fVT] : v[fPOS]) + v[fGLP];
        gp >= v[fEND] ? gp -= sliceln;
        gp < v[fSTART] ? gp += sliceln;
        wm = fxm(FX_GLIT, s);
        l = l*(1-wm) + readsmp(gp,0)*wm;
        r = r*(1-wm) + readsmp(gp,1)*wm;
      );
    );
    // stutter: loop a latched chunk (amt=mix, p2=loop length)
    ua = max(fxa(FX_STUT, s), OVR[8]);
    mod_on ? ua = max(0, min(1, ua + mod_sum(DST_STUT, v)));
    ua > 0.003 ? (
      stper = (0.01 + fxp(FX_STUT, s)*0.24) * srate;
      v[fSTC] <= 0 ? (
        v[fSTP] = gran ? v[fVT] : v[fPOS];
        v[fSTC] = stper;
      );
      v[fSTC] -= 1;
      sp_ = v[fSTP] + (stper - v[fSTC]) * rt;
      sp_ >= v[fEND] ? sp_ -= sliceln;
      sp_ < v[fSTART] ? sp_ += sliceln;
      wm = ua * fxm(FX_STUT, s);   // amount is the stutter's own depth
      l = l*(1-wm) + readsmp(sp_,0)*wm;
      r = r*(1-wm) + readsmp(sp_,1)*wm;
    ) : v[fSTC] = 0;
    // ---- ДВА ПАРАЛЛЕЛЬНЫХ ПУТИ A и B (схема Surge XT) ----
    // ── ПЕРФОРМАНС-ЭФФЕКТЫ ЧЁРНЫХ КЛАВИШ (16 сен) ────────────────────
    // Держатся, пока клавиша зажата. Считаются ПОСЛЕ чтения среза и до
    // огибающей: это окраска голоса, а не изменение того, что читается.
    // Какие алгоритмы сейчас зажаты: собираем флаги из четырёх слотов.
    // Один алгоритм может стоять в двух слотах — тогда он просто включён,
    // а не считается дважды (иначе ring от двух клавиш давал бы двойную
    // модуляцию и тишину на разностной частоте).
    kb_ring = 0; kb_phase = 0; kb_sub = 0; kb_crush = 0;
    kb_filt = 0; kb_tape = 0; kb_gt = 0;
    kb_arc_slot = 0;          // какой слот сейчас держит arc (0 = никакой)
    kb_i = 0;
    while (kb_i < 4) (
      KBFXN[kb_i] ? (
        kb_arc_slot = kb_i + 1;      // держим последний: он под пальцем
        kb_a = kb_i == 0 ? kbfx1 : kb_i == 1 ? kbfx2 : kb_i == 2 ? kbfx3 : kbfx4;
        kb_a == 1 ? kb_ring = 1 : kb_a == 2 ? kb_phase = 1 : kb_a == 3 ? kb_sub = 1 :
        kb_a == 4 ? kb_crush = 1 : kb_a == 5 ? kb_filt = 1 : kb_a == 6 ? kb_tape = 1 :
        kb_a == 7 ? kb_gt = 1 : 0;
      );
      kb_i += 1;
    );
    kb_ring || kb_phase || kb_sub || kb_crush || kb_filt || kb_tape || kb_gt ? (
      // RING: кольцевая модуляция синусом. Частота — от основной частоты
      // среза, если она посчитана (precalc), иначе 220 Гц: тон, который
      // слышно на любом материале.
      kb_ring ? (
        // частота: ручка 0..1 -> 20 Гц..2 кГц логарифмически; вторая ручка
        // подмешивает СЛЕЖЕНИЕ за высотой среза (0 = фиксированная частота,
        // 1 = ровно f0 среза, и тогда ring звучит гармонично)
        kbf = exp(log(20) + (log(2000) - log(20)) * kbp_ring);
        cd_sb[OF_PFRQ+s] > 20 ? kbf = kbf*(1-kbp_ring2) + cd_sb[OF_PFRQ+s]*kbp_ring2;
        kb_rph += kbf/srate; kb_rph >= 1 ? kb_rph -= 1;
        kbm = sin(2*$pi*kb_rph);
        l *= kbm; r *= kbm;
      );
      // PHASE SHIFT: правый канал отстаёт на доли миллисекунды, и задержка
      // МЕДЛЕННО ПЛЫВЁТ — тот самый «съезд фазы» у амижных сэмплеров, где
      // два голоса шли с чуть разной скоростью. Дорогого гребёнчатого
      // фильтра не строим: одна дробная задержка даёт тот же эффект.
      kb_phase ? (
        kb_pph += (0.02 + kbp_phase2*0.5)/srate; kb_pph >= 1 ? kb_pph -= 1;
        kb_pd = (0.5 + 0.5*sin(2*$pi*kb_pph)) * (0.0002 + kbp_phase*0.003) * srate;
        kb_wr = (kb_wr + 1) % 256;
        KBPH[kb_wr] = r;
        kb_ri = kb_wr - kb_pd;
        kb_ri < 0 ? kb_ri += 256;
        kb_i0 = floor(kb_ri); kb_fr = kb_ri - kb_i0;
        r = KBPH[kb_i0 % 256]*(1-kb_fr) + KBPH[(kb_i0+1) % 256]*kb_fr;
      );
      // СУБ-МОДУЛЯЦИЯ: синус на октаву ниже основной частоты, ГЛУБИНА ПО
      // АФТЕРТАЧУ (просьба пользователя). Не подмешиваем тон, а МОДУЛИРУЕМ
      // амплитуду — тот же принцип, что у precalc: слышен материал, а не
      // генератор поверх него.
      kb_sub ? (
        // октава: 0 = на две ниже, 0.5 = на одну, 1 = в унисон
        kbf = (cd_sb[OF_PFRQ+s] > 20 ? cd_sb[OF_PFRQ+s] : 110) * (0.25 + kbp_sub*0.75);
        kb_sph += kbf/srate; kb_sph >= 1 ? kb_sph -= 1;
        kbd = max(at0, v[fPAT]);          // канальный или поли — что сильнее
        kbm = 1 - kbd + kbd * (0.5 + 0.5*sin(2*$pi*kb_sph));
        l *= kbm; r *= kbm;
      );
      // CRUSH: разрядность и частота дискретизации разом. Глубина по
      // афтертачу: лёгкий нажим — 10 бит, полный — 4. Держим отсчёт между
      // выборками, иначе получилось бы просто тише, а не грубее.
      kb_crush ? (
        kbd = max(at0, v[fPAT]);
        // ручка задаёт ВЕРХНЮЮ границу разрядности, афтертач уводит вниз
        kb_bits = (14 - kbp_crush*6) - floor(kbd*8);
        kb_q = pow(2, kb_bits - 1);
        kb_step = 1 + floor(kbd*7);
        kb_cnt += 1;
        kb_cnt >= kb_step ? (
          kb_cnt = 0;
          kb_hl = floor(l*kb_q + 0.5)/kb_q;
          kb_hr = floor(r*kb_q + 0.5)/kb_q;
        );
        l = kb_hl; r = kb_hr;
      );
      // FILTER: однополюсный НЧ, частота по афтертачу — от открытого к
      // глухому. Однополюсный, а не биквад: на брейке нужен характер, а не
      // крутизна, и он не звенит при быстром движении частоты.
      kb_filt ? (
        kbd = max(at0, v[fPAT]);
        // ручка сжимает диапазон хода: при 0 фильтр ходит от 18k до 2k
        // (лёгкая окраска), при 1 — до 80 Гц (полное закрытие)
        kb_flo = exp(log(2000) + (log(80) - log(2000)) * kbp_filt);
        kb_fc = exp(log(18000) + (log(kb_flo) - log(18000)) * kbd);
        kb_k = 1 - exp(-2*$pi*kb_fc/srate);
        // резонанс: подмешиваем разницу «вход минус выход» обратно в фильтр
        kb_lpl += (l - kb_lpl + (kb_lpl - kb_bp1)*kbp_filt2*3)*kb_k;
        kb_lpr += (r - kb_lpr + (kb_lpr - kb_bp2)*kbp_filt2*3)*kb_k;
        kb_bp1 = kb_lpl; kb_bp2 = kb_lpr;
        l = kb_lpl; r = kb_lpr;
      );
      // TAPE: плывущая задержка + мягкое насыщение — «поплывшая лента».
      // Медленнее, чем phase shift, и в обоих каналах: там расстройка
      // стерео, здесь качание высоты.
      kb_tape ? (
        kb_tph += (0.1 + kbp_tape*1.2)/srate; kb_tph >= 1 ? kb_tph -= 1;
        kb_td = (0.5 + 0.5*sin(2*$pi*kb_tph)) * (0.001 + kbp_tape*0.008) * srate;
        kb_twr = (kb_twr + 1) % 1024;
        KBTP[kb_twr] = l; KBTP[1024 + kb_twr] = r;
        kb_tri = kb_twr - kb_td;
        kb_tri < 0 ? kb_tri += 1024;
        kb_ti = floor(kb_tri); kb_tf = kb_tri - kb_ti;
        l = KBTP[kb_ti % 1024]*(1-kb_tf) + KBTP[(kb_ti+1) % 1024]*kb_tf;
        r = KBTP[1024 + kb_ti % 1024]*(1-kb_tf) + KBTP[1024 + (kb_ti+1) % 1024]*kb_tf;
        l = l - l*l*l*0.25; r = r - r*r*r*0.25;      // мягкое насыщение
      );
      // GATE: рубит хвост по темпу проекта — «строб». Скважность по
      // афтертачу: слабый нажим почти не режет, полный даёт рваный пунктир.
      kb_gt ? (
        kbd = max(at0, v[fPAT]);
        // ручка выбирает дробь: 1/4 .. 1/32 пятью ступенями
        kb_gdiv = 1 + floor(kbp_gate*4);
        kb_gstep = srate * 60 / max(20, tempo) / pow(2, kb_gdiv);
        kb_gph += 1; kb_gph >= kb_gstep ? kb_gph -= kb_gstep;
        kb_gopen = kb_gph < kb_gstep * (1 - kbd*0.8) ? 1 : 0;
        kb_genv += (kb_gopen - kb_genv) * 0.01;          // без щелчков
        l *= kb_genv; r *= kb_genv;
      );
    );

    // ЦЕПЬ ЭФФЕКТОВ СНЯТА 15 сен (решение пользователя: «удалить все
    // эффекты и слоты кроме precalc»). Обработка теперь запекается от ручек — bk_run.
    // Перф-эффекты (стретч/FM/статтер/глитч) выше остались: они двигают
    // чтение, а не красят звук.

    // ── ADSR СРЕЗА ────────────────────────────────────────────────────
    // Атака и спад ЛИНЕЙНЫЕ, затухание ЭКСПОНЕНЦИАЛЬНОЕ: нарастание слух
    // воспринимает линейно, а угасание — как постоянную времени, и
    // линейный спад в конце «обрывается».
    ea = cd_sb[OF_ATK+s]; ed = cd_sb[OF_DEC+s];
    es = cd_sb[OF_SUS+s]; er = cd_sb[OF_REL+s];
    // АТАКА НОЛЬ = МГНОВЕННО (правка 14 сен: «ADSR работает неадекватно,
    // возникает задержка»). Было max(0.0005, ...) — при ручке в нуле атака
    // всё равно 0.5 мс, это 22 отсчёта: на перкуссии слышно как смазанный
    // удар, «щелчок опаздывает». Теперь ноль на ручке — ноль по времени,
    // огибающая сразу в единице.
    eat = ea <= 0.0001 ? 0 : ea*ea*0.5;
    // микрофлуктуации огибающей: множители посчитаны при старте ноты
    v[fRNA] > 0 ? eat = eat * v[fRNA];
    edt = max(0.001,  ed*ed*2) * (v[fRNK] > 0 ? v[fRNK] : 1);
    ert = max(0.001,  er*er*3);
    v[fST] == 1 ? (
      v[fEPH] < 0.5 ? (
        // нулевая атака — сразу в единицу, без деления на ноль
        eat <= 0 ? ( v[fENV] = 1; v[fEPH] = 1; ) : (
          v[fENV] += 1/(eat*srate);                     // АТАКА
          v[fENV] >= 1 ? ( v[fENV] = 1; v[fEPH] = 1; );
        );
      ) : (
        v[fENV] -= (1 - es)/(edt*srate);                // СПАД до удержания
        v[fENV] <= es ? ( v[fENV] = es; v[fEPH] = 2; v[fST] = 2; );
      );
      // нулевое удержание и есть «один удар»: голос гаснет сам
      v[fENV] <= 0.0005 ? ( v[fENV] = 0; v[fST] = 3; );
    ) : v[fST] == 3 ? (
      v[fENV] *= exp(-1/(ert*srate));
      v[fENV] < 0.001 ? (
        // hold the (silent) voice alive until its note-off is really queued,
        // so a full queue retries next block instead of hanging the note
        v[fONOTE] ? qpush(v);
        v[fONOTE] ? 0 : v[fA] = 0;
      );
    );
    // ЖИВОГО PRECALC ЗДЕСЬ БОЛЬШЕ НЕТ (18 сен): кольцо, sub и бенд тона
    // запекаются в срез движком bk_run по движению ручки. Раньше блок
    // считался на КАЖДОМ сэмпле КАЖДОГО из 16 голосов — sin, pow и exp на
    // голос. Слово «precalc» наконец означает то, что написано.
    // Одно отличие на слух: запечённый тон транспонируется ВМЕСТЕ со срезом
    // при хроматической игре (раньше стоял на месте в герцах) — он остаётся
    // в гармонии с материалом, как и положено части сэмпла.
    // СРЕЗ ИДЁТ ЧЕРЕЗ СЛОТ — вместо сухого пути, а не в добавок к нему.
    // Шина слота возвращается в общий микс 1/2 (не в шину класса): у слота
    // один выход на всех, кто в него играет.
    // ГРОМКОСТЬ И ПАНОРАМА — здесь, на выходе голоса: fGL/fGR свёрнуты при
    // запуске ноты (гейн × velocity × панорама), и модулировать их на месте
    // значило бы пересчитывать panning каждый сэмпл. Дешевле домножить.
    mvl = v[fGL]; mvr = v[fGR];
    mod_on ? (
      md_ = mod_sum(DST_VOL, v);
      md_ != 0 ? ( md_ = max(0, 1 + md_); mvl *= md_; mvr *= md_; );
      md_ = mod_sum(DST_PAN, v);
      md_ != 0 ? (
        // равномощностно: на краю один канал не глохнет в ноль рывком
        md_ = max(-1, min(1, md_));
        mvl *= cos(($pi/4)*(1 + md_)) * 1.41421356;
        mvr *= sin(($pi/4)*(1 + md_)) * 1.41421356;
      );
    );
    // ── КУДА ИДЁТ ГОЛОС ────────────────────────────────────────────────
    // Здесь была развилка «через слот Airwindows или в микс». Слотов больше
    // нет (25 окт): срез идёт в СВОЙ ВЫХОД, а обработку берёт контейнер
    // REAPER — там любой плагин, а не только библиотека Airwindows, и всё
    // автоматизируется нативно.
    //   outmode 0 mix   — микс 1/2, как было
    //   outmode 1 class — шина класса 1..6 на каналах 3-14, как было
    //   outmode 2 slice — СРЕЗ N -> КАНАЛ N (моно), 64 канала = предел JSFX
    outmode > 1.5 ? (
      // МОНО: panning среза делает контейнер. Суммируем L и R голоса, иначе
      // срез, запанорамированный в край, звучал бы вдвое тише центрального.
      busM[min(63, s)] += (l * mvl + r * mvr) * v[fENV];
    ) : (
      oc = outmode > 0.5 ? cd_sb[OF_OUTCH+s] : 0;
      oc > 0 ? (
        bp = busM + (min(oc,6)-1)*2;
        bp[0] += l * v[fENV] * mvl;
        bp[1] += r * v[fENV] * mvr;
      ) : (
        aol += l * v[fENV] * mvl;
        aor += r * v[fENV] * mvr;
      );
    );
  );
  vi += 1;
);

// ЧЕТЫРЁХ СЛОТОВ AIRWINDOWS БОЛЬШЕ НЕТ (25 окт, решение пользователя:
// «слоты airwindows выпилить придётся, просто сделать выходы для каждого
// слайса и там уже контейнер разберётся»). Здесь крутился sfx_cell на
// четыре шины каждый сэмпл плюс пробуждение/засыпание по тишине.
// Теперь обработка — в контейнере REAPER: любой плагин, нативная
// автоматизация, цепи и plink'и, которые уже работают в трекере.

outmode > 1.5 ? (
  // SLICE: срез N -> канал N (моно). Микса здесь НЕТ — все 64 канала отданы
  // срезам, суммирует контейнер.
  // ВХОД ЧИТАЕМ ДО ЗАПИСИ: spl(0) — это и вход, и выход канала 1, а цикл
  // ниже его перезаписывает. thru остаётся на 1/2, чтобы сквозной звук трека
  // проходил и в этом режиме.
  thru0 = spl0*thru; thru1 = spl1*thru;
  ob_ = 0;
  while (ob_ < 64) ( spl(ob_) = busM[ob_] * mvol; ob_ += 1; );
  spl0 += thru0; spl1 += thru1;
) : outmode > 0.5 ? (
  // CLASS: mix on 1/2, per-class buses on 3-14
  spl0 = spl0*thru + aol*mvol;
  spl1 = spl1*thru + aor*mvol;
  ob_ = 0;
  while (ob_ < 6) (
    spl(2 + ob_*2) = busM[ob_*2] * mvol;
    spl(3 + ob_*2) = busM[ob_*2+1] * mvol;
    ob_ += 1;
  );
) : (
  spl0 = spl0*thru + aol*mvol;
  spl1 = spl1*thru + aor*mvol;
);

// ── AMENHOTEP: снимаем огибающую и спектр выхода ─────────────────────────
// Два однополюсных фильтра делят сигнал на низ / середину / верх — то же
// разделение, что у волны в окне (там оно в OVW0), только живое.
amen > 0.5 ? (
  amn_s = (spl0 + spl1) * 0.5;
  amn_lp += (amn_s - amn_lp) * amn_klo;          // низ
  amn_lp2 += (amn_s - amn_lp2) * amn_khi;        // низ + середина
  amn_el += amn_lp * amn_lp;
  amn_em += (amn_lp2 - amn_lp) * (amn_lp2 - amn_lp);
  amn_eh += (amn_s - amn_lp2) * (amn_s - amn_lp2);
  amn_a = abs(amn_s); amn_a > amn_pk ? amn_pk = amn_a;
  amn_n += 1;
  amn_n >= amn_len ? (
    AMW_PK[amn_col] = min(1, amn_pk);
    AMW_LO[amn_col] = amn_el; AMW_MD[amn_col] = amn_em; AMW_HI[amn_col] = amn_eh;
    amn_col = (amn_col + 1) % AMW_N;
    amn_n = 0; amn_pk = 0; amn_el = 0; amn_em = 0; amn_eh = 0;
  );
);

smp_i += 1;

@serialize
// v12: OF_FXSEL/OF_FXSEL2 — Airwindows effect id per slot (4 x 64 per scene).
// v8: slots gained a keyboard activation point, so each scene now stores four
// banks (amount, P2, mix, key). v7 had three; v6 had two and no per-slice WET.
// Older files are read at their own offsets and spread into the new layout with
// the missing banks defaulting to fully wet / fully open, which reproduces the
// old sound exactly.
// v2-v5 files had two decks: deck A becomes the loop, its fx become both
// scenes, and deck B's audio and slicing are dropped -- nowhere to put them.
// v15: МАСТЕР-ЦЕПЬ — 8 слов MXSEL (id x2, amount x2, p2 x2, mix x2).
// Пишется в КОНЕЦ блока, поэтому файлы v14 и старше читаются как раньше:
// у них этих слов просто нет, и мастер остаётся пустым.
// v29 ОСТАЁТСЯ и после выпила слотов (25 окт): раскладка полей не менялась.
// OF_OUTCH существовал и писался раньше, изменился только ДИАПАЗОН значений
// (было 0..6 шин класса, стало 0..64 каналов среза) — старые значения
// валидны и в новом диапазоне, поэтому проекты читаются без перевода.
// OF_FXR (маршрут в слот) остаётся мёртвым полем на своём месте.
srz_ver = 29;
file_var(0, srz_ver);
srz_wr = file_avail(0) < 0;
srz_wr ? cur = cur > 0.5 ? 1 : 0;
file_var(0, cur);
(srz_ver >= 3 || srz_wr) ? file_var(0, auto_det);
(srz_ver >= 5 || srz_wr) ? file_var(0, keysmode);
(srz_ver >= 13 || srz_wr) ? file_var(0, edit_all);
// мастер-цепь: 8 слов подряд из MXSEL. Состояние эффектов (MXST) НЕ пишем —
// это рабочая память фильтров, она строится заново при первом же prep.
// v17: мастер стал ЧЕТЫРЁХ слотов (16 слов). Старые проекты (v15/v16) несут
// 8 слов на два слота — читаем их в старой раскладке и раскладываем по новой,
// иначе amount второго слота попал бы в id третьего.
// v18: МАСТЕР УБРАН. Старые проекты несут его слова, и пропустить их
// нельзя — сдвинется весь остаток блока. Читаем В МУСОРНЫЙ БУФЕР (SCR) и
// выбрасываем: место в файле занято, а данные больше не нужны.
srz_ver >= 18 || srz_wr ? 0 :
srz_ver == 17 ? file_mem(0, SCR, 16) :
srz_ver >= 15 ? file_mem(0, SCR, 8) : 0;
// v18: ПОРЯДОК ЦЕПИ и байпасы. В конец блока, чтобы старые версии читались
// как раньше: у них этих слов просто нет, и порядок остаётся умолчательным.
(srz_ver >= 18 || srz_wr) ? (
  file_mem(0, CHORD, 4);
  file_mem(0, CHBYP, 4);
  // v19: ВЫБРАННЫЕ АЛГОРИТМЫ. В самый конец блока, чтобы v18 читался как
  // раньше: у него этих слов нет, и цепь остаётся умолчательной.
  srz_ver >= 19 || srz_wr ? file_mem(0, CHALG, 4) : (
    CHALG[0] = FX_DEREZ3; CHALG[1] = FX_RINGMOD;
    CHALG[2] = FX_CAPACITOR2; CHALG[3] = FX_POINT;
  );
  // САНАЦИЯ: проекты, сохранённые 14-15 сен, несут CHORD = 0,0,0,0 —
  // его затёрла коллизия памяти (см. TBL). Порядок цепи обязан быть
  // перестановкой 0..3; всё прочее — мусор, возвращаем умолчание.
  !srz_wr ? (
    srz_mask = 0; srz_k = 0;
    while (srz_k < AW_NPP) (
      srz_c = CHORD[srz_k]|0;
      srz_c >= 0 && srz_c < AW_NPP ? srz_mask |= (1 << srz_c);
      srz_k += 1;
    );
    srz_mask != 15 ? (
      srz_k = 0;
      while (srz_k < AW_NPP) ( CHORD[srz_k] = srz_k; CHBYP[srz_k] = 0; srz_k += 1; );
    );
  );
) : (
  srz_k = 0;
  while (srz_k < AW_NPP) ( CHORD[srz_k] = srz_k; CHBYP[srz_k] = 0; srz_k += 1; );
);
// v16: восемь путей слотов быстрой загрузки. Строки в @serialize —
// file_string; в конец блока, чтобы v15 и старше читались как раньше.
(srz_ver >= 16 || srz_wr) ? (
  srz_k = 0;
  while (srz_k < 8) ( file_string(0, QS0 + srz_k); qs_dirty[srz_k] = 1; srz_k += 1; );
  qs_ver += 1;
);
// per-deck scalars: frames, srate, nsl, sel (+sync from v4)
file_mem(0, 3200, (srz_ver >= 4 || srz_wr) ? 24 : 16);

srz_ver >= 12 || srz_wr ? (
  // v14: 145 полей (+OF_MUTE), обе сцены внутри, потом аудио.
  // v12/v13: 144 поля, пресеты другого стрида — читаем кусками и отбрасываем.
  // v18: +4 поля ADSR (149 вместо 145). Файлы v14..v17 несут 145 — читаем
  // ровно столько, сколько там есть, иначе сдвинется весь остаток блока,
  // и аудио прочиталось бы как мусор.
  // v20: +5 полей precalc (154 вместо 149). Файлы v18..v19 несут 149 —
  // читаем ровно столько, сколько там есть, иначе сдвинется весь остаток
  // блока и аудио прочиталось бы как мусор. Тот же приём, что для ADSR.
  // v23: +OF_RSTATE (156 вместо 155). Файлы v21..v22 несут 155 — читаем
  // ровно столько, сколько там есть. Тот же приём, что для ADSR и precalc:
  // прочитать текущим размером значило бы сдвинуть весь остаток блока, и
  // аудио пришло бы мусором.
  // v24: +6 полей запекания (162 вместо 156). Файлы v23 несут 156.
  // Новые поля всегда дописываются В КОНЕЦ, поэтому у каждой старой ветки
  // просто растёт хвостовой memset — на те же шесть полей.
  // v25: +OF_FXR, маршрут среза в слот (163 вместо 162). Файлы v24 несут 162.
  srz_wr || srz_ver >= 25 ? (
    file_mem(0, slb(0), NSLF*64);
  ) : srz_ver >= 24 ? (
    file_mem(0, slb(0), 162*64);
    memset(slb(0) + OF_FXR, 0, 64);
  ) : srz_ver >= 23 ? (
    file_mem(0, slb(0), 156*64);
    memset(slb(0) + OF_BSNP, 0, 7*64);   // 6 запекания + fxr
  ) : srz_ver >= 21 ? (
    file_mem(0, slb(0), 155*64);
    memset(slb(0) + OF_RSTATE, 0, 8*64); // rstate + 6 запекания + fxr
  ) : srz_ver >= 20 ? (
    file_mem(0, slb(0), 154*64);
    memset(slb(0) + OF_RND, 0, 9*64);    // rnd + rstate + 6 запекания + fxr: звук как был
  ) : srz_ver >= 18 ? (
    file_mem(0, slb(0), 149*64);
    memset(slb(0) + OF_BRNG, 0, 4*64); // ring sub pwm bend — подряд: звук не меняется
    memset(slb(0) + OF_PFRQ, 0, 64);
    memset(slb(0) + OF_RND, 0, 9*64);    // rnd + rstate + 6 запекания + fxr
  ) : srz_ver >= 14 ? (
    file_mem(0, slb(0), 145*64);
    memset(slb(0) + OF_BRNG, 0, 14*64);  // precalc (5) + rnd + rstate + 6 запекания + fxr — подряд
    // ADSR в старом файле нет — ставим умолчание, то самое, при котором
    // звук не меняется: мгновенная атака, полное удержание, короткий хвост
    srz_i = 0;
    while (srz_i < 64) (
      slb(0)[OF_ATK+srz_i] = 0; slb(0)[OF_DEC+srz_i] = 0;
      slb(0)[OF_SUS+srz_i] = 1; slb(0)[OF_REL+srz_i] = 0.02;
      srz_i += 1;
    );
  ) : (
    file_mem(0, slb(0), 144*64);
    memset(slb(0) + OF_MUTE, 0, 64);
    memset(slb(0) + OF_BRNG, 0, 14*64);
    srz_i = 0;
    while (srz_i < 64) (
      slb(0)[OF_ATK+srz_i] = 0; slb(0)[OF_DEC+srz_i] = 0;
      slb(0)[OF_SUS+srz_i] = 1; slb(0)[OF_REL+srz_i] = 0.02;
      srz_i += 1;
    );
  );
  // v27: МАТРИЦА МОДУЛЯЦИИ, NCAB*3 слова. Пишется ПОСЛЕ таблицы срезов и
  // ДО аудио: у файлов v26 её нет, и читать блок из них нельзя — сдвинулось
  // бы аудио (тот же класс ошибки, что с полями среза).
  srz_wr || srz_ver >= 27 ? file_mem(0, CAB, NCAB*3) : memset(CAB, 0, NCAB*3);

  file_avail(0) < 0 ? ( srz_aud = saveaudio && dk_frames[0] > 0 ? 1 : 0; );
  file_var(0, srz_aud);
  srz_aud ? file_mem(0, dbuf(0), dk_frames[0]*2);
  // v22: БАНКА ПРЕСЕТОВ БОЛЬШЕ НЕТ. Старые файлы его несут — пропускаем
  // ровно столько слов, сколько было в ТОЙ версии (стрид = поля x 64 той
  // эпохи; читать 8*PRESLOT текущего размера, как раньше, значило
  // сдвинуть весь хвост у v18..v20). Читаем в SCR кусками по одному слоту.
  !srz_wr && srz_ver < 22 ? (
    // Сюда попадают только v < 22, поэтому ветки 21+ довольно: банка
    // пресетов в v22 и новее нет вовсе.
    srz_ps = srz_ver >= 21 ? 155*64 : srz_ver >= 20 ? 154*64 : srz_ver >= 18 ? 149*64 : 9216;
    srz_k = 0; while (srz_k < 8) ( file_mem(0, SCR, srz_ps); srz_k += 1; );
  );
) : srz_ver == 11 ? (
  // v11: 136 fields, no OF_FXSEL. Slot 1 gets the default filter; presets had
  // a different stride and are discarded (read in SCR-sized pieces).
  file_mem(0, slb(0), 136*64);
  memset(slb(0) + OF_FXSEL, 0, 512);
  srz_i = 0;
  while (srz_i < 64) (
    slb(0)[OF_FXSEL + srz_i] = AW_DEFAULT; slb(0)[OF_FXSEL2 + srz_i] = AW_DEFAULT;
    srz_i += 1;
  );
  file_var(0, srz_aud);
  srz_aud ? file_mem(0, dbuf(0), dk_frames[0]*2);
  srz_k = 0; while (srz_k < 8) ( file_mem(0, SCR, 8704); srz_k += 1; );
  0;
) : srz_ver == 10 ? (
  // v10: 112 fields, no modulation-shape banks yet
  file_mem(0, SCR, 112*64);
  memset(slb(0), 0, NSLF*64);
  memcpy(slb(0), SCR, 112*64);
  memset(slb(0) + OF_MS, 0, FXW*2);
  file_var(0, srz_aud);
  srz_aud ? file_mem(0, dbuf(0), dk_frames[0]*2);
  file_mem(0, SCR, 8*8192);      // v10 presets: different stride, discarded
  0;
) : srz_ver >= 8 ? (
  // v8/v9: same layout minus the appended filter-type and modulation fields
  file_mem(0, SCR, 110*64);
  memset(slb(0), 0, NSLF*64);
  memcpy(slb(0), SCR, 110*64);
  memset(slb(0) + OF_FT, 0, 128);
  memset(slb(0) + OF_MS, 0, FXW*2);
  file_var(0, srz_aud);
  srz_aud ? file_mem(0, dbuf(0), dk_frames[0]*2);
  file_mem(0, SCR, 8*8192);      // v8/v9 presets: different stride, discarded
  0;
) : srz_ver == 7 ? (
  // v7: 86 fields, three banks per scene at 896/1664/2432/3200/3968/4736
  file_mem(0, SCR, 86*64);
  memset(slb(0), 0, SLST);
  memcpy(slb(0), SCR, 14*64);              // shared fields incl. OF_WET
  memcpy(slb(0) + OF_FXA,  SCR + 896,  FXW);
  memcpy(slb(0) + OF_FXP,  SCR + 1664, FXW);
  memcpy(slb(0) + OF_FXM,  SCR + 2432, FXW);
  memcpy(slb(0) + OF_FXA2, SCR + 3200, FXW);
  memcpy(slb(0) + OF_FXP2, SCR + 3968, FXW);
  memcpy(slb(0) + OF_FXM2, SCR + 4736, FXW);
  srz_i = 0;
  while (srz_i < 64) (
    srz_k = 0;
    while (srz_k < NFX) (
      slb(0)[OF_FXK  + srz_k*64 + srz_i] = 1;   // v7 keys went all the way
      slb(0)[OF_FXK2 + srz_k*64 + srz_i] = 1;
      srz_k += 1;
    );
    srz_i += 1;
  );
  file_var(0, srz_aud);
  srz_aud ? file_mem(0, dbuf(0), dk_frames[0]*2);
  file_mem(0, SCR, 8*8192);   // v7 presets: different field layout, discarded
  0;
) : srz_ver == 6 ? (
  // v6: 61 fields, two banks per scene at 832/1600/2368/3136
  file_mem(0, SCR, 61*64);
  memset(slb(0), 0, SLST);
  memcpy(slb(0), SCR, 13*64);            // shared slice fields are unchanged
  memcpy(slb(0) + OF_FXA,  SCR + 832,  FXW);
  memcpy(slb(0) + OF_FXP,  SCR + 1600, FXW);
  memcpy(slb(0) + OF_FXA2, SCR + 2368, FXW);
  memcpy(slb(0) + OF_FXP2, SCR + 3136, FXW);
  srz_i = 0;
  while (srz_i < 64) (
    slb(0)[OF_WET+srz_i] = 1;
    srz_k = 0;
    while (srz_k < NFX) (
      slb(0)[OF_FXM  + srz_k*64 + srz_i] = 1;   // v6 had no per-slot mix:
      slb(0)[OF_FXM2 + srz_k*64 + srz_i] = 1;   // fully wet reproduces it
      slb(0)[OF_FXK  + srz_k*64 + srz_i] = 1;
      slb(0)[OF_FXK2 + srz_k*64 + srz_i] = 1;
      srz_k += 1;
    );
    srz_i += 1;
  );
  file_var(0, srz_aud);
  srz_aud ? file_mem(0, dbuf(0), dk_frames[0]*2);
  file_mem(0, SCR, 8*4096);   // v6 presets: different stride, discarded
  0;
) : (
  // legacy two-deck layout: read both, keep deck A, discard deck B
  srz_d = 0;
  while (srz_d < 2) (
    srz_ver >= 5 ? (
      srz_d == 0 ? file_mem(0, slb(0), 33*64) : file_mem(0, SCR, 33*64);
    ) : (
      srz_n = srz_ver >= 4 ? 15 : 14;
      file_mem(0, SCR, srz_n*64);
      srz_d == 0 ? conv_old_slices(0, srz_n);
    );
    file_var(0, srz_aud);
    srz_aud ? (
      srz_d == 0 ? file_mem(0, dbuf(0), dk_frames[0]*2)
                 : file_mem(0, SCR, dk_frames[1]*2);
    );
    srz_d += 1;
  );
  srz_ver >= 5 ? (
    // v5 stored 10 fx banks contiguously at 832/1472; spread them into scene A
    // and mirror into B (the old second deck is not a scene, it was other audio)
    memcpy(SCR, slb(0) + 832, 10*64);
    memcpy(SCR + 640, slb(0) + 1472, 10*64);
    memset(slb(0) + OF_FXA, 0, FXW*8);
    memcpy(slb(0) + OF_FXA, SCR, 10*64);
    memcpy(slb(0) + OF_FXP, SCR + 640, 10*64);
    srz_i = 0;
    while (srz_i < 64) (
      slb(0)[OF_WET+srz_i] = 1;
      slb(0)[OF_FXA + FX_FILT*64 + srz_i] = 0;
      slb(0)[OF_FXA + FX_FOLD*64 + srz_i] = 0;
      slb(0)[OF_FXP + FX_FILT*64 + srz_i] = 0.5;
      slb(0)[OF_FXP + FX_FOLD*64 + srz_i] = 0.5;
      srz_k = 0;
      while (srz_k < NFX) (
        slb(0)[OF_FXM + srz_k*64 + srz_i] = 1;
        slb(0)[OF_FXK + srz_k*64 + srz_i] = 1;
        srz_k += 1;
      );
      srz_i += 1;
    );
    memcpy(slb(0) + OF_FXA2, slb(0) + OF_FXA, FXW);
    memcpy(slb(0) + OF_FXP2, slb(0) + OF_FXP, FXW);
    memcpy(slb(0) + OF_FXM2, slb(0) + OF_FXM, FXW);
  );
  file_mem(0, SCR, 16*1024);    // old presets: incompatible layout, discarded
  0;
  dk_frames[1] = 0; dk_nsl[1] = 0;
);

// v9 appends the sequencer: steps, accent cycle, scalars, last console line
(srz_ver >= 9 || srz_wr) ? (
  file_mem(0, SQ_BASE, 256);
  file_mem(0, SQ_ACC, 64);
  file_var(0, seq_len); file_var(0, seq_divi); file_var(0, seq_swing);
  file_var(0, seq_hum); file_var(0, seq_seed); file_var(0, seq_run);
  file_var(0, seq_tala); file_var(0, seq_acclen);
  file_string(0, #seq_last);
);

// v28: АРТИКУЛЯТОРЫ. В самый конец блока — v27 и старше читаются как
// раньше: у них этих слов просто нет, и банк остаётся заводским.
// Флаг art_inited НЕ пишем: он про «@init уже отработал», а не про данные.
(srz_ver >= 28 || srz_wr) ? (
  file_mem(0, ART0,    ART_N*ART_W);
  file_mem(0, ART_ENV, ART_N*2);
  // v29: режим шага энкодера. Это НАСТРОЙКА РУКИ, но она про конкретный
  // материал: на минутной деке и на секундном срезе удобны разные шаги.
  srz_ver >= 29 || srz_wr ? ( file_var(0, jog_mode); file_var(0, jog_last); );
  // art_cur в файл не идёт: «надето» — это состояние РУКИ, а не проекта.
  // Проект сохраняется вместе с уже надетым артикулятором, и при открытии
  // он должен читаться как обычное состояние, а не ждать отпускания
  // кнопки, которую никто не держит.
  !srz_wr ? art_cur = -1;
);

file_avail(0) >= 0 ? (
  dk_srate[0] <= 0 ? dk_srate[0] = srate;
  seq_len = max(1, min(64, seq_len|0)); seq_len < 1 ? seq_len = 16;
  seq_rng = seq_seed; seq_lastq = -1;
  memset(MSEL, 0, MSELST*2);
  dk_sel[0] >= 0 && dk_sel[0] < dk_nsl[0] ? msel_base(0)[dk_sel[0]] = 1;
  // страховка: файл не может быть длиннее деки
  dk_frames[0] = min(dk_frames[0], DECKFR);
  memset(slb(0) + OF_RSTATE, 0, 64);   // метки рендера мертвы
  // Ручки запекания сняты 18 сен, их поля мертвы — обнуляем ВСЕГДА, чтобы
  // значения из файлов того дня не всплыли, если поля когда-нибудь оживут.
  // OF_PFRQ между ними не трогаем отдельно: он идёт в том же блоке.
  // v26: на месте OF_BRNG живёт алгоритм стретча — у старых файлов там
  // значения снятого кольца, обнуляем; у новых поле настоящее, не трогаем.
  srz_ver < 26 ? memset(slb(0) + OF_STALG, 0, 64);
  memset(slb(0) + OF_BSUB, 0, 4*64);
  memset(slb(0) + OF_BSNP, 0, 6*64);
  dk_frames[0] > 0 ? ( task = 3; ov_d = 0; ov_i = 0; );
);

// ВЫСОТА 900, А НЕ 740 (19 сен): зона MOD добавила ~120 px, и при 740
// панель параметров не помещалась ЦЕЛИКОМ — окно молча показывало одни
// пэды. Посчитано: при u=1 нужно 836 px от верха до низа панели.
@gfx 1000 900
ovgfx_t = time_precise();   // 2 ноя: окно открыто — обзор строит @gfx

// имена эффектов библиотеки (id как в jf_fx_airwindows.jsfx-inc), коротко —
// слоты узкие
// ── ИМЕНА ИСТОЧНИКОВ И НАЗНАЧЕНИЙ ────────────────────────────────────────
function src_name(i dst) (
  i == SRC_VEL ? strcpy(dst,"vel") : i == SRC_AT ? strcpy(dst,"press") :
  i == SRC_MW ? strcpy(dst,"wheel") : i == SRC_ENV ? strcpy(dst,"env") :
  i == SRC_PHASE ? strcpy(dst,"phase") : i == SRC_RND ? strcpy(dst,"rnd") :
  i == SRC_LFO ? strcpy(dst,"lfo 1") : i == SRC_LFO2 ? strcpy(dst,"lfo 2") :
  i == SRC_BEND ? strcpy(dst,"bend") : i == SRC_STEP ? strcpy(dst,"arp") :
  strcpy(dst,"--");
);
function dst_name(i dst) (
  i == DST_PITCH ? strcpy(dst,"pitch") : i == DST_VOL ? strcpy(dst,"vol") :
  i == DST_PAN ? strcpy(dst,"pan") : i == DST_STRETCH ? strcpy(dst,"stretch") :
  i == DST_START ? strcpy(dst,"start") : i == DST_GLIT ? strcpy(dst,"glitch") :
  i == DST_STUT ? strcpy(dst,"stutter") :
  i >= DST_FX1 && i <= DST_FX4 ? sprintf(dst,"fx %d", i - DST_FX1 + 1) :
  strcpy(dst,"--");
);

function aw_name(id dst) (
  id==1 ? strcpy(dst,"hsoft") : id==2 ? strcpy(dst,"sqrt") : id==3 ? strcpy(dst,"FRAC2") :
  id==4 ? strcpy(dst,"facet") : id==5 ? strcpy(dst,"kalmn") : id==6 ? strcpy(dst,"bqnl") :
  id==7 ? strcpy(dst,"CAP2")  : id==8 ? strcpy(dst,"ring")  : id==9 ? strcpy(dst,"vibr") :
  id==10 ? strcpy(dst,"trem") : id==11 ? strcpy(dst,"PRES6") : id==12 ? strcpy(dst,"point") :
  id==13 ? strcpy(dst,"phndg") : id==14 ? strcpy(dst,"derez") : id==15 ? strcpy(dst,"dust") :
  id==16 ? strcpy(dst,"stfx") :
  // Второй батч Airwindows и своё: раньше обрывалось на 16, и девять
  // алгоритмов библиотеки подписывались «----», хотя работали.
  id==17 ? strcpy(dst,"chor") : id==18 ? strcpy(dst,"flut") :
  id==19 ? strcpy(dst,"bite") : id==20 ? strcpy(dst,"creat") :
  id==21 ? strcpy(dst,"excit") : id==22 ? strcpy(dst,"hull") :
  id==23 ? strcpy(dst,"swide") : id==24 ? strcpy(dst,"sgate") :
  id==25 ? strcpy(dst,"eros") : strcpy(dst,"----");
);
// Имя параметра j (1..3) алгоритма id. Таблица повторяет mx_pname из
// jf_fx_matrix.jsfx-inc: одни и те же алгоритмы должны называть свои ручки
// одинаково во всех плагинах экосистемы. Пустая строка = параметра нет.
function mx_pname(id j dst) (
  strcpy(dst, "");
  id == 1  ? ( j==1 ? strcpy(dst,"dep")  : j==2 ? strcpy(dst,"brt") : strcpy(dst,"stages") ) :
  id == 2  ? ( j==1 ? strcpy(dst,"in")     : j==2 ? strcpy(dst,"soar")   : strcpy(dst,"out") ) :
  id == 3  ? ( j==1 ? strcpy(dst,"drive")  : j==2 ? strcpy(dst,"thresh") : strcpy(dst,"stages") ) :
  id == 4  ? ( j==1 ? strcpy(dst,"facet")  : 0 ) :
  id == 5  ? ( j==1 ? strcpy(dst,"kalman") : 0 ) :
  id == 6  ? ( j==1 ? strcpy(dst,"type")   : j==2 ? strcpy(dst,"freq")   : strcpy(dst,"q") ) :
  id == 7  ? ( j==1 ? strcpy(dst,"lowpass"): j==2 ? strcpy(dst,"highpass"): strcpy(dst,"nonlin") ) :
  id == 8  ? ( j==1 ? strcpy(dst,"freq L") : j==2 ? strcpy(dst,"freq R") : strcpy(dst,"soar") ) :
  id == 9  ? ( j==1 ? strcpy(dst,"dep")  : j==2 ? strcpy(dst,"speed")  : strcpy(dst,"fm") ) :
  id == 10 ? ( j==1 ? strcpy(dst,"freq")   : 0 ) :
  id == 11 ? ( j==1 ? strcpy(dst,"compress") : 0 ) :
  id == 12 ? ( j==1 ? strcpy(dst,"point")  : j==2 ? strcpy(dst,"trim")   : strcpy(dst,"react") ) :
  id == 13 ? ( j==1 ? strcpy(dst,"nudge")  : 0 ) :
  id == 14 ? ( j==1 ? strcpy(dst,"rate")   : j==2 ? strcpy(dst,"bits")   : 0 ) :
  id == 15 ? ( j==1 ? strcpy(dst,"dust")   : 0 ) :
  id == 16 ? ( j==1 ? strcpy(dst,"wide")   : j==2 ? strcpy(dst,"monobass"): strcpy(dst,"squish") ) :
  id == 17 ? ( j==1 ? strcpy(dst,"compress") : 0 ) :
  id == 18 ? ( j==1 ? strcpy(dst,"treble") : j==2 ? strcpy(dst,"bass")   : 0 ) :
  id == 19 ? ( j==1 ? strcpy(dst,"width")  : j==2 ? strcpy(dst,"center") : 0 ) :
  id == 20 ? ( j==1 ? strcpy(dst,"drive")  : j==2 ? strcpy(dst,"dep")  : 0 ) :
  id == 21 ? ( j==1 ? strcpy(dst,"freq")   : j==2 ? strcpy(dst,"excite") : 0 ) :
  id == 22 ? ( j==1 ? strcpy(dst,"freq")   : j==2 ? strcpy(dst,"brt") : 0 ) :
  id == 23 ? ( j==1 ? strcpy(dst,"soar")   : j==2 ? strcpy(dst,"wide")   : 0 ) :
  id == 24 ? ( j==1 ? strcpy(dst,"thresh") : j==2 ? strcpy(dst,"darken") : 0 ) :
  id == 25 ? ( j==1 ? strcpy(dst,"freq")   : j==2 ? strcpy(dst,"width")  : strcpy(dst,"color") ) : 0;
);

// Подпись = ИМЯ АЛГОРИТМА из библиотеки: раз он выбирается, выдуманное
// слово вроде «crush» врало бы, как только слот поменяли.
function slot_name(k dst) ( aw_name(slot_fx(k), dst); );

function aw_p2name(id dst) (
  id==1 ? strcpy(dst,"brt") : id==2 ? strcpy(dst,"soar") : id==3 ? strcpy(dst,"thresh") :
  id==6 ? strcpy(dst,"freq") : id==7 ? strcpy(dst,"highpass") : id==8 ? strcpy(dst,"detune") :
  id==9 ? strcpy(dst,"speed") : id==12 ? strcpy(dst,"trim") : id==14 ? strcpy(dst,"bits") :
  id==16 ? strcpy(dst,"monobass") :
  id==17 ? strcpy(dst,"range") : id==18 ? strcpy(dst,"speed") :
  id==19 ? strcpy(dst,"out") : id==20 ? strcpy(dst,"dep") :
  id==21 ? strcpy(dst,"excite") : id==22 ? strcpy(dst,"brt") :
  id==23 ? strcpy(dst,"wide") : id==24 ? strcpy(dst,"darken") :
  id==25 ? strcpy(dst,"width") : strcpy(dst,"P2");
);
// подпись слота: у Airwindows-слота — имя выбранного эффекта текущего среза/сцены
// Подпись слота = его ФИКСИРОВАННОЕ имя по смыслу (filt/sat/crush/…).
// Раньше читалось имя выбранного алгоритма из памяти среза — выбора больше
// нет, поэтому и читать нечего.
function fxlabel(k dst) ( slot_name(k, dst) );
// КЛАСС — ДВЕ СТРОЧНЫЕ БУКВЫ (15 сен). Цветовая кодировка классов убрана
// вместе с остальным цветом: интерфейс чёрно-белый, а две буквы читаются
// быстрее, чем вспоминается, какой оттенок — хэт. Полные имена остались
// только в подсказке ручки cls (classfull).
function classname(i dst) (
  i==0 ? strcpy(dst,"--")  : i==1 ? strcpy(dst,"kk") : i==2 ? strcpy(dst,"sn") :
  i==3 ? strcpy(dst,"hh")  : i==4 ? strcpy(dst,"pc") : i==5 ? strcpy(dst,"cr") :
  i==6 ? strcpy(dst,"rd")  : i==7 ? strcpy(dst,"vo") : strcpy(dst,"fx");
);
function classfull(i dst) (
  i==0 ? strcpy(dst,"none")  : i==1 ? strcpy(dst,"kick")  : i==2 ? strcpy(dst,"snare") :
  i==3 ? strcpy(dst,"hat")   : i==4 ? strcpy(dst,"perc")  : i==5 ? strcpy(dst,"crash") :
  i==6 ? strcpy(dst,"ride")  : i==7 ? strcpy(dst,"voice") : strcpy(dst,"fx");
);
function moutname(i dst) (
  i==0 ? strcpy(dst,"off") : i==1 ? strcpy(dst,"note") : strcpy(dst,"cc");
);
function modename(i dst) (
  i==0 ? strcpy(dst,"fwd") : i==1 ? strcpy(dst,"rev") : i==2 ? strcpy(dst,"loop") : strcpy(dst,"pp");
);
function notename(n dst) local(pc oct) (
  n = floor(n + 0.5);
  pc = n % 12; oct = floor(n/12) - 1;
  pc==0  ? sprintf(dst,"C%d",oct)  : pc==1  ? sprintf(dst,"C#%d",oct) :
  pc==2  ? sprintf(dst,"D%d",oct)  : pc==3  ? sprintf(dst,"D#%d",oct) :
  pc==4  ? sprintf(dst,"E%d",oct)  : pc==5  ? sprintf(dst,"F%d",oct)  :
  pc==6  ? sprintf(dst,"F#%d",oct) : pc==7  ? sprintf(dst,"G%d",oct)  :
  pc==8  ? sprintf(dst,"G#%d",oct) : pc==9  ? sprintf(dst,"A%d",oct)  :
  pc==10 ? sprintf(dst,"A#%d",oct) : sprintf(dst,"B%d",oct);
);

// Palette roles: 0 background, 1 panel, 2 fill, 3 accent, 4 text.
// In the terminal theme a "panel" is a dim outline in the channel colour rather
// than a grey plate -- same gfx_rect call, so widget code does not change.
// РОЛИ ЦВЕТА. 0 фон · 1 панель · 2 заливка · 3 акцент · 4 текст, и с 25 окт
// 5 GREY · 6 DIM · 7 LINE — три уровня типографики трекера именами, а не
// альфой на месте вызова (раньше «тише» означало разное в разных углах).
function pset(role) (
  role == 0 ? gfx_set(cb_r,cb_g,cb_b,1) :
  role == 1 ? gfx_set(cp_r,cp_g,cp_b,1) :
  role == 2 ? gfx_set(cf_r,cf_g,cf_b,0.9) :
  role == 3 ? gfx_set(ca_r,ca_g,ca_b,1) :
  role == 5 ? gfx_set(cg_r,cg_g,cg_b,1) :
  role == 6 ? gfx_set(cd_r,cd_g,cd_b,1) :
  role == 7 ? gfx_set(cl_r,cl_g,cl_b,1) :
              gfx_set(ct_r,ct_g,ct_b,1);
);
function pseta(role a) (
  role == 0 ? gfx_set(cb_r,cb_g,cb_b,a) :
  role == 1 ? gfx_set(cp_r,cp_g,cp_b,a) :
  role == 2 ? gfx_set(cf_r,cf_g,cf_b,a) :
  role == 3 ? gfx_set(ca_r,ca_g,ca_b,a) :
  role == 5 ? gfx_set(cg_r,cg_g,cg_b,a) :
  role == 6 ? gfx_set(cd_r,cd_g,cd_b,a) :
  role == 7 ? gfx_set(cl_r,cl_g,cl_b,a) :
              gfx_set(ct_r,ct_g,ct_b,a);
);

// КНОПКА: чёрное поле в белой рамке; включена — белая, текст чёрный.
// Наведение — рамка в полную яркость: заливки-подсветки нет, потому что
// серого нет.
// ── СКРУГЛЕНИЕ 2 px (просьба пользователя 18 сен: «всё такое острое») ────
// Рамки и заливки окна — прямоугольники из gfx_rect, и заливка «включено»
// идёт до самых углов. Скруглять каждую по отдельности — править сотню
// мест. Поэтому скругление — ПОСЛЕДНИЙ МАЗОК поверх готового виджета:
// в каждом углу три пикселя гасятся фоном, а один, по диагонали внутрь,
// ставится цветом рамки. Это и есть пиксельная дуга радиуса 2 — и она
// одинаково срезает и пустую рамку, и залитую кнопку, и полосу с блитом.
// ── СКРУГЛЕНИЯ СНЯТЫ (просьба пользователя 21 сен) ──────────────────────
// Тело оставлено, но не исполняется: вызовов шесть, и вырезать их значило бы
// потерять точки, где скругление возвращается одной строкой. Гасим здесь —
// в одном месте, где решение и принимается.
function rcorn(x y w_ h_ a) local(x1 y1) (
  0 ? (
    x1 = x + w_ - 1; y1 = y + h_ - 1;
    pset(0);
    gfx_rect(x, y, 2, 1);      gfx_rect(x, y + 1, 1, 1);
    gfx_rect(x1 - 1, y, 2, 1); gfx_rect(x1, y + 1, 1, 1);
    gfx_rect(x, y1, 2, 1);     gfx_rect(x, y1 - 1, 1, 1);
    gfx_rect(x1 - 1, y1, 2, 1); gfx_rect(x1, y1 - 1, 1, 1);
    pseta(4, a);
    gfx_rect(x + 1, y + 1, 1, 1);  gfx_rect(x1 - 1, y + 1, 1, 1);
    gfx_rect(x + 1, y1 - 1, 1, 1); gfx_rect(x1 - 1, y1 - 1, 1, 1);
  );
);

// ── ЦВЕТ МОДУЛЕЙ (просьба пользователя 18 сен: «от чёрно-белого глаза
// напрягаются, нужен минимальный color coding для каждого модуля») ────────
// МИНИМАЛЬНЫЙ значит: цветом красятся только РАМКА модуля и его ПОДПИСЬ.
// Ручки, кнопки и текст остаются белыми — цвет говорит «чьё это», а не
// «что тут нажато»; состояние по-прежнему несёт заливка.
// Оттенки приглушённые и одной светлоты: на чёрном у всех контраст выше
// 7:1 (посчитано по WCAG), ни один не кричит громче соседа.
//   0 sample  голубой      4 arp     оранжевый    8 fx   фиолетовый
//   1 slice   янтарный     5 play    зелёный      9 ruler: в сетке
//   2 sync    зелёный      6 adsr    лососёвый   10 ruler: мимо сетки
//   3 midi    синий        7 stretch бирюзовый
function mcol(m a) (
  m == 0 ? gfx_set(0.55, 0.78, 0.95, a) : m == 1 ? gfx_set(0.95, 0.76, 0.40, a) :
  m == 2 ? gfx_set(0.55, 0.86, 0.55, a) : m == 3 ? gfx_set(0.58, 0.70, 0.98, a) :
  m == 4 ? gfx_set(0.98, 0.66, 0.36, a) : m == 5 ? gfx_set(0.55, 0.86, 0.55, a) :
  m == 6 ? gfx_set(0.96, 0.60, 0.58, a) : m == 7 ? gfx_set(0.45, 0.86, 0.80, a) :
  m == 8 ? gfx_set(0.80, 0.64, 0.98, a) : m == 9 ? gfx_set(0.50, 0.88, 0.55, a) :
           gfx_set(0.98, 0.70, 0.30, a);
);

// ── ПАНЕЛЬ МОДУЛЯ (просьба пользователя 18 сен: «используй мои референсы от
// Madrona Labs, там лучшее разделение») ──────────────────────────────────
// У Aalto и Kaivo модуль — не обведённая группа, а ПАНЕЛЬ: свой фон, рамка
// и ВОЗДУХ между рамкой и органами. Разделение держится на заливке и
// отступах. Первая версия рамок была тонкой линией вплотную к кнопкам — она
// не разделяла, а добавляла шума («графически не очень прикольно»).
//   * заливка — цвет модуля на 9 %: на чёрном это еле заметный тон, но
//     глаз сразу видит, где кончается один прибор и начинается другой;
//   * рамка 2 px, скруглена (радиус 3), цвет модуля на 70 %;
//   * органы внутри остаются чёрными с белой рамкой — как тёмные ручки
//     на светлой панели у Madrona, только в негативе.
// Отступы MPX/MPY задаёт раскладка: панель рисуется СНАРУЖИ от органов.
// ── ПАНЕЛЬ МОДУЛЯ: БЕЗ РАМКИ (21 сен) ───────────────────────────────────
// Рамка со скруглёнными углами обводила каждый модуль, и на восьми модулях
// это восемь замкнутых контуров поверх и без того плотной сетки виджетов —
// линий на экране становилось больше, чем содержания.
// Осталась ЗАЛИВКА: группа читается как область другой светлоты, а не как
// обведённая коробка. Тот же приём, что у зебры строк матрицы — различать
// тоном, а не рёбрами.
function mpanel(x y w_ h_ m) local(x1 y1) (
  w_ >= 12 && h_ >= 12 ? (
    mcol(m, 0.09);
    gfx_rect(x + 2, y + 2, w_ - 4, h_ - 4);
  );
);
// заголовок панели ВЕРХОМ НА РАМКЕ (для панелей высотой в один ряд, где
// внутри места под заголовок нет): под текстом рамка гасится фоном
// Заголовок панели. Гашение фона под текстом снято вместе с рамкой (21 сен):
// гасить было нечего, а чёрная полоска поверх заливки оставалась бы шрамом.
function mptitle(x y lab m) local(tw th) (
  gfx_measurestr(lab, tw, th);
  mcol(m, 1); gfx_x = x + floor(12*u); gfx_y = y - floor(th/2) + 1; gfx_drawstr(lab);
);

// ── ЗНАЧКИ НА КНОПКАХ (29 сен) ──────────────────────────────────────────
// Рисуются ПРИМИТИВАМИ, не шрифтом: SMuFL и эмодзи в JSFX недоступны, а
// gfx_circle/rect/line есть всегда и масштабируются вместе с u.
//
// Значок НЕ ЗАМЕНЯЕТ подпись, а встаёт слева от неё. На шестнадцати кнопках
// в ряду одни картинки пришлось бы заучивать; значок помогает НАЙТИ кнопку
// глазом, слово — понять, что она делает.
//
// id: 1 rec (красная точка) · 2 detect (лупа) · 3 clear (кисточка)
//     4 undo (стрелка назад) · 5 gate (воронка) · 6 save (дискета)
// ico() УДАЛЕНА (25 окт, решение пользователя: значков нет, только буквы).
// Рисовала лупу / кисточку / стрелку на кнопках тулбара. Её место на
// кнопке занял ХОТКЕЙ — см. btni: подпись плюс тусклая буква справа.


// Кнопка со значком: то же, что btn, но подпись сдвинута вправо на ширину
// значка. Отдельная функция, а не параметр btn — у btn десяток вызовов, и
// добавлять им всем лишний аргумент значило бы править то, что работает.
// КНОПКА С ХОТКЕЕМ (25 окт). Раньше здесь был НАРИСОВАННЫЙ ЗНАЧОК (лупа,
// кисточка, стрелка) — решение пользователя: значков нет, только буквы.
// Место значка занял хоткей: буква тускло справа от подписи, тем же
// шрифтом. Он отвечает на вопрос «а как это с клавиатуры», не отвлекая:
// глаз читает подпись, а клавишу находит, когда ищет её.
// key = код символа (0 = нет хоткея, кнопка рисуется как обычная).
// 26 окт: буква клавиши — частью слова: первая такая буква подписи (без учёта регистра); нет — -1
function key_in(lab key) local(i n c r) (
  r = -1; i = 0; n = strlen(lab);
  key > 0 ? while (i < n && r < 0) ( c = str_getchar(lab, i); (c == key || c == key - 32) ? r = i; i += 1; );
  r;
);
function btni(x y bw_ bh_ lab on key) local(hit r txw txh kw kh gap tx ki pw ph) (
  hit = mouse_x >= x && mouse_x < x+bw_ && mouse_y >= y && mouse_y < y+bh_;
  on ? pset(3) : pset(0);
  gfx_rect(x,y,bw_,bh_);
  hit ? pset(4) : pset(7);
  gfx_rect(x,y,bw_,1); gfx_rect(x,y+bh_-1,bw_,1); gfx_rect(x,y,1,bh_); gfx_rect(x+bw_-1,y,1,bh_);
  gfx_measurestr(lab, txw, txh);
  ki = key_in(lab, key);
  ki >= 0 ? (
    // буква в слове: подпись целиком, поверх — эта буква акцентом
    tx = x + (bw_-txw)/2;
    on ? pset(0) : pset(4);
    gfx_x = tx; gfx_y = y + (bh_-txh)/2; gfx_drawstr(lab);
    ki > 0 ? ( strcpy_substr(#bk_p, lab, 0, ki); gfx_measurestr(#bk_p, pw, ph); ) : pw = 0;   // длина 0 в strcpy_substr = вся строка
    strcpy_substr(#bk_s, lab, ki, 1);
    on ? pset(0) : pset(3);
    gfx_x = tx + pw; gfx_y = y + (bh_-txh)/2; gfx_drawstr(#bk_s);
    on ? ( gfx_rect(tx + pw, y + bh_ - 3, max(1, floor(txw / max(1, strlen(lab)))), 1); );   // на включённой — черта под буквой
  ) : key > 0 ? (
    sprintf(#bk_s, "%c", key);
    gfx_measurestr(#bk_s, kw, kh);
    gap = 3;
    // подпись и хоткей как ОДНО ЦЕЛОЕ по центру: иначе на узкой кнопке
    // подпись уезжает влево, а буква жмётся к краю
    tx = x + (bw_ - (txw + gap + kw))/2;
    on ? pset(0) : pset(4);
    gfx_x = tx; gfx_y = y + (bh_-txh)/2;
    gfx_drawstr(lab);
    // 25 окт: хоткей ЯРКО (акцент трекера), строчной — как подсказки трекера; на включённой — цветом фона
    on ? pset(0) : pset(3);
    gfx_x = tx + txw + gap; gfx_y = y + (bh_-kh)/2;
    gfx_drawstr(#bk_s);
  ) : (
    on ? pset(0) : pset(4);
    gfx_x = x + (bw_-txw)/2; gfx_y = y + (bh_-txh)/2;
    gfx_drawstr(lab);
  );
  r = hit && lclick;
  r;
);

// КНОПКА В СТИЛЕ ТРЕКЕРА (25 окт): рамка цветом LINE (тихая, 2.3:1), а не
// текстом в 60 % — рамки больше не спорят с подписями. Включённая залита
// акцентом, её текст — цветом фона. Наведение поднимает рамку до текста.
function btn(x y bw_ bh_ lab on) local(hit r txw txh) (
  hit = mouse_x >= x && mouse_x < x+bw_ && mouse_y >= y && mouse_y < y+bh_;
  on ? pset(3) : pset(0);
  gfx_rect(x,y,bw_,bh_);
  hit ? pset(4) : pset(7);
  gfx_rect(x,y,bw_,1); gfx_rect(x,y+bh_-1,bw_,1); gfx_rect(x,y,1,bh_); gfx_rect(x+bw_-1,y,1,bh_);
  on ? pset(0) : pset(4);
  // txw/txh — ЛОКАЛЬНЫЕ. Раньше тут стояло gfx_measurestr(lab, btw, bth), а
  // bth в EEL2 — та же переменная, что BTH: каждая кнопка затирала высоту
  // кнопки высотой текста. Кнопки рисовались в строку текста при рядах,
  // зарезервированных под 22u; первая за кадр (setup) выходила выше прочих.
  gfx_measurestr(lab, txw, txh);
  gfx_x = x + (bw_-txw)/2; gfx_y = y + (bh_-txh)/2;
  gfx_drawstr(lab);
  rcorn(x, y, bw_, bh_, hit ? 1.0 : 0.6);
  r = hit && lclick;
  r;
);

// Auto-width button: measures its own label so it fits at any UI scale, draws at
// (bx, y + brow*rowstep) and advances bx past it. Removes every hardcoded pixel
// width from the toolbars, which is what used to make labels collide when
// scaled. When a button would run past the right edge it wraps to a new row --
// bwrap counts how many extra rows the caller ended up using, so the layout
// below can make room for them instead of letting buttons fall off the edge.
// Hover help. Widgets call tip() when the pointer is over them; the text is
// drawn at the very end of @gfx so it floats above everything else. Storing it
// rather than drawing immediately is what keeps it from being painted over.
function tip(txt) ( strcpy(#tiptext, txt); tipshow = 1; );

// FNV-1a over a string, so a tag always gets the same colour without any
// configuration -- the jf_pm_browser rule (hash % 7 into the Finder palette)
function fnv1a(fstr) local(i hv_) (
  hv_ = 2166136261;
  i = 0;
  while (i < strlen(fstr)) (
    hv_ = (hv_ ~ str_getchar(fstr, i)) * 16777619;
    hv_ = hv_ - floor(hv_/4294967296)*4294967296;
    i += 1;
  );
  hv_;
);
function tagcol(idx) (
  idx == 0 ? gfx_set(0.85,0.35,0.35,1) : idx == 1 ? gfx_set(0.90,0.60,0.25,1) :
  idx == 2 ? gfx_set(0.90,0.82,0.30,1) : idx == 3 ? gfx_set(0.45,0.80,0.45,1) :
  idx == 4 ? gfx_set(0.40,0.70,0.90,1) : idx == 5 ? gfx_set(0.65,0.50,0.90,1) :
             gfx_set(0.70,0.70,0.72,1);
);

// ── ИНВЕРСИЯ ПОПИКСЕЛЬНО (15 сен, скриншот пользователя: «pa» пропадало на
// белой заливке) ────────────────────────────────────────────────────────
// Клиппинга в gfx нет, но gfx_blit умеет под-прямоугольник. Содержимое
// полосы рисуется дважды в закадровые картинки — белым по чёрному (IMG_A) и
// чёрным по белому (IMG_B), — а на экран идёт залитая часть из B и
// остальное из A. Граница режет букву ровно по заливке: «pa» читается
// чёрным на белом, «rts» — белым на чёрном, каждая буква или её часть.
// Картинки одного размера на все полосы: setimgdim с меняющимися размерами
// перевыделял бы память на каждую полосу каждого кадра.
// vert = 1: заливка снизу, разрез по строкам; имя сверху, значение внизу.
IMG_A = 0; IMG_B = 1; IMG_W = 1024; IMG_H = 96;
function inv_bar(x y iw ih kf vert lab disp) local(tw th tw2 ty lx vx vy ib_n) (
  iw = min(iw, IMG_W); ih = min(ih, IMG_H);
  gfx_measurestr(lab, tw, th); gfx_measurestr(disp, tw2, th);
  // 25 окт (битмап): подпись и значение не налезают — значение важнее, подпись укорачивается
  // по символу, пока не влезет с зазором; не влезло ничего — без подписи
  !vert && tw + tw2 + 9 > iw ? (
    strcpy(#ib_lab, lab); ib_n = strlen(#ib_lab);
    while (ib_n > 0 && tw + tw2 + 9 > iw) (
      ib_n -= 1;
      ib_n > 0 ? strncpy(#ib_lab, lab, ib_n) : strcpy(#ib_lab, "");   // strncpy(…, 0) в EEL2 — БЕЗ предела, не пусто
      gfx_measurestr(#ib_lab, tw, th);
    );
    lab = #ib_lab;
  );
  vert ? ( lx = 3; ty = 1; vx = iw - tw2 - 3; vy = ih - th - 1; )
       : ( lx = 3; ty = (ih - th)/2; vx = iw - tw2 - 3; vy = ty; );
  // A: белый текст на чёрном
  gfx_dest = IMG_A; gfx_set(0,0,0,1); gfx_rect(0, 0, iw, ih);
  pset(4); gfx_x = lx; gfx_y = ty; gfx_drawstr(lab); gfx_x = vx; gfx_y = vy; gfx_drawstr(disp);
  // B: чёрный текст на белом
  gfx_dest = IMG_B; gfx_set(1,1,1,1); gfx_rect(0, 0, iw, ih);
  gfx_set(0,0,0,1); gfx_x = lx; gfx_y = ty; gfx_drawstr(lab); gfx_x = vx; gfx_y = vy; gfx_drawstr(disp);
  gfx_dest = -1;
  gfx_set(1,1,1,1); gfx_mode = 0;
  kf = max(0, min(vert ? ih : iw, floor(kf + 0.5)));
  vert ? (
    ih - kf > 0 ? gfx_blit(IMG_A, 1, 0, 0, 0, iw, ih - kf, x, y, iw, ih - kf);
    kf > 0     ? gfx_blit(IMG_B, 1, 0, 0, ih - kf, iw, kf, x, y + ih - kf, iw, kf);
  ) : (
    kf > 0     ? gfx_blit(IMG_B, 1, 0, 0, 0, kf, ih, x, y, kf, ih);
    iw - kf > 0 ? gfx_blit(IMG_A, 1, 0, kf, 0, iw - kf, ih, x + kf, y, iw - kf, ih);
  );
);

// ── ПОЛОСА (единственный вид слайдера в плагине, 15 сен) ─────────────────
// Тонкая чёрная дорожка в белой рамке, заполняется белым; имя слева и
// значение справа лежат ПРЯМО НА ПОЛОСЕ и инвертируются над заливкой.
// Одна высота на всё окно: ряд из десяти полос читается как таблица.
//
// SNAP-ТОЧКИ (идея пользователя 15 сен): на дорожке ns делений (8 — как
// ряд кнопок на гриде). При перетаскивании значение ЛЕГКО прилипает к
// ближайшей точке, между точками ставится свободно; SHIFT отключает
// прилипание совсем. ns = 0 — без точек (перечисления). Сила прилипания —
// одно число KSNAP: доля шага, внутри которой тянет к точке.
//
// Тянется по длинной оси (широкая — горизонтально); двойной клик —
// умолчание.
function knob(id x y kw_ val lo hi def lab disp ns) local(hit t cx cy r nv tw th tw2 ky kh kf kty ki kx ks kn) (
  hit = mouse_x >= x && mouse_x < x+kw_ && mouse_y >= y && mouse_y < y+KNH;
  hit && lclick ? (
    dbl ? val = def : ( fld_active = id; fld_v0 = val; fld_y0 = mouse_y; fld_x0 = mouse_x; );
  );
  fld_active == id && (mouse_cap & 1) ? (
    kw_ >= KNH ? (
      nv = fld_v0 + (mouse_x - fld_x0) * (hi-lo) / max(40, kw_) * ((mouse_cap & 4) ? 0.1 : 1);
    ) : (
      nv = fld_v0 + (fld_y0 - mouse_y) * (hi-lo) / 160 * ((mouse_cap & 4) ? 0.1 : 1);
    );
    val = min(hi, max(lo, nv));
    // прилипание к точкам, если их просили и SHIFT не зажат
    ns > 1 && hi > lo && !(mouse_cap & 8) ? (
      ks = 1 / (ns - 1);
      t = (val - lo) / (hi - lo);
      kn = floor(t / ks + 0.5);
      abs(t - kn*ks) < ks*KSNAP ? val = lo + kn*ks*(hi - lo);
    );
  );
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  t = hi > lo ? (val - lo) / (hi - lo) : 0;

  // ── ПОДПИСЬ И ЗНАЧЕНИЕ НА САМОМ СЛАЙДЕРЕ (14 сен, референс Noise
  // Engineering). Раньше подпись стояла НАД дорожкой, значение ПОД ней —
  // три этажа на одну величину, и ряд из десяти ручек занимал втрое больше
  // места, чем нёс смысла. Теперь текст лежит ВНУТРИ дорожки: слева имя,
  // справа значение, а над заполненной частью он ИНВЕРТИРУЕТСЯ — тёмным по
  // светлому. Читается на любом положении ручки, и высота строки одна.
  ky = y + floor(2*u);
  kh = floor(20*u);
  // дорожка: чёрная, белая рамка (ярче под мышью)
  pset(0);
  gfx_rect(x, ky, kw_, kh);
  pseta(4, hit || fld_active == id ? 1.0 : 0.6);
  gfx_rect(x, ky, kw_, 1); gfx_rect(x, ky+kh-1, kw_, 1);
  gfx_rect(x, ky, 1, kh); gfx_rect(x+kw_-1, ky, 1, kh);
  // ЗАПОЛНЕНИЕ И ТЕКСТ — одним блитом с попиксельной инверсией (inv_bar)
  kf = max(0, (kw_-2)*t);
  inv_bar(x+1, ky+1, kw_-2, kh-2, kf, 0, lab, disp);
  rcorn(x, ky, kw_, kh, hit || fld_active == id ? 1.0 : 0.6);
  // ТОЧКИ SNAP — штрихи в треть высоты у нижней кромки, инверсные над заливкой
  ns > 1 ? (
    ki = 0;
    while (ki < ns) (
      kx = x + 1 + floor((kw_-2) * ki / (ns-1));
      kx < x + 1 + kf ? gfx_set(0,0,0,0.6) : pseta(4, 0.45);
      gfx_rect(kx, ky + kh - 1 - floor(kh/3), 1, floor(kh/3));
      ki += 1;
    );
  );

  val;
);

// ── СТРОКА В СТИЛЕ ТРЕКЕРА (26 окт, просьба: «под вид трекера, компактнее») ──
// Как модуль DSP трекера: имя · дорожка · значение в одну строку PNRH.
// kind 0 — полоса (зелёная заливка), 1 — от нуля (бирюзовая линия + ромб),
// 2 — ступени lo..hi квадратиками (перечисление), 3 — флажок (щелчок).
// Тянуть по строке — значение (Ctrl мелко), колесо — шаг st (0 — сотая
// диапазона), двойной щелчок — умолчание. Наведение красит имя и значение.
function prow(id x y w_ val lo hi def lab disp kind st) local(hit hot nw vw bx bw2 t t0 zx px n k cs cy ty tw th sz) (
  gfx_measurestr("mmmm", nw, th);
  strlen(lab) == 0 ? nw = 0 : nw += floor(4*u);
  gfx_measurestr("000 ms", vw, th);
  bx = x + nw; bw2 = max(8, w_ - nw - vw - floor(6*u));
  hit = mouse_x >= x && mouse_x < x + w_ && mouse_y >= y && mouse_y < y + PNRH - 1;
  hit && lclick ? (
    kind == 3 ? ( val = val > (lo + hi) * 0.5 ? lo : hi; ) :
    dbl ? val = def : ( fld_active = id; fld_v0 = val; fld_x0 = mouse_x; );
  );
  fld_active == id && (mouse_cap & 1) ? (
    val = max(lo, min(hi, fld_v0 + (mouse_x - fld_x0) * (hi - lo) / max(40, bw2) * ((mouse_cap & 4) ? 0.1 : 1)));
    kind == 2 ? val = floor(val + 0.5);
  );
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  hit && mouse_wheel != 0 && kind != 3 ? (
    val = max(lo, min(hi, val + (mouse_wheel > 0 ? 1 : -1) * (st > 0 ? st : (hi - lo) / 100) * ((mouse_cap & 4) && st <= 0 ? 0.1 : 1)));
    mouse_wheel = 0;
  );
  hot = hit || fld_active == id;
  ty = y + max(0, floor((PNRH - 1 - th) / 2));
  cy = y + floor((PNRH - 1) / 2);
  nw > 0 ? ( hot ? pset(3) : pset(4); gfx_x = x; gfx_y = ty; gfx_drawstr(lab); );
  t = hi > lo ? max(0, min(1, (val - lo) / (hi - lo))) : 0;
  sz = max(2, floor(th * 0.35));
  kind == 0 ? (
    pset(7); gfx_rect(bx, cy, bw2, 1);
    mcol(9, hot ? 1 : 0.8); gfx_rect(bx, cy - sz, max(1, floor(bw2 * t)), sz * 2 + 1);
  ) : kind == 1 ? (
    t0 = hi > lo ? max(0, min(1, (0 - lo) / (hi - lo))) : 0.5;
    zx = bx + floor(bw2 * t0); px = bx + floor(bw2 * t);
    pset(7); gfx_rect(bx, cy, bw2, 1); gfx_rect(zx, cy - sz, 1, sz * 2 + 1);
    mcol(7, hot ? 1 : 0.8); gfx_rect(min(zx, px), cy - 1, max(1, abs(px - zx)), 3);
    gfx_triangle(px - sz - 1, cy, px, cy - sz - 1, px + sz + 1, cy, px, cy + sz + 1);
  ) : kind == 2 ? (
    n = floor(hi - lo + 1.5);
    cs = min(sz * 2 + 1, floor((bw2 - (n - 1) * 2) / max(1, n)));
    cs >= 3 ? (
      k = 0;
      while (k < n) (
        lo + k == floor(val + 0.5) ? ( mcol(7, 1); gfx_rect(bx + k * (cs + 2), cy - floor(cs / 2), cs, cs); )
                                    : ( pseta(4, hot ? 0.8 : 0.5); gfx_rect(bx + k * (cs + 2), cy - floor(cs / 2), cs, 1); gfx_rect(bx + k * (cs + 2), cy - floor(cs / 2) + cs - 1, cs, 1);
                                        gfx_rect(bx + k * (cs + 2), cy - floor(cs / 2), 1, cs); gfx_rect(bx + k * (cs + 2) + cs - 1, cy - floor(cs / 2), 1, cs); );
        k += 1;
      );
    ) : ( pset(7); gfx_rect(bx, cy, bw2, 1); mcol(7, 1); gfx_rect(bx + floor((bw2 - 2) * t), cy - sz, 2, sz * 2 + 1); );
  ) : (
    cs = sz * 2 + 1;
    val > (lo + hi) * 0.5 ? ( pset(4); gfx_rect(bx, cy - sz, cs, cs); )
                          : ( pseta(4, hot ? 0.9 : 0.6); gfx_rect(bx, cy - sz, cs, 1); gfx_rect(bx, cy + sz, cs, 1); gfx_rect(bx, cy - sz, 1, cs); gfx_rect(bx + cs - 1, cy - sz, 1, cs); );
  );
  gfx_measurestr(disp, tw, th);
  hot ? pset(3) : pset(4);
  gfx_x = x + w_ - tw - floor(2*u); gfx_y = ty; gfx_drawstr(disp);
  val;
);
// заголовок секции: имя акцентом и черта под ним во всю колонку (как main / osc в DSP)
function psec(x y w_ lab) local(tw th) (
  gfx_measurestr(lab, tw, th);
  pset(3); gfx_x = x; gfx_y = y + max(0, floor((PNRH - 1 - th) / 2)); gfx_drawstr(lab);
  pset(7); gfx_rect(x, y + PNRH - 2, w_, 1);
);
// укладка секций колонками: высоты секций в строках, lim — потолок колонки
function pn_hk(k) ( k == 0 ? pn_h0 : k == 1 ? pn_h1 : k == 2 ? pn_h2 : k == 3 ? pn_h3 : k == 4 ? pn_h4 : pn_h5; );
// 28 окт: порядок секций на экране — out перед stretch (out под adsr, stretch — в начале второй колонки)
function pn_ord(k) ( k == 2 ? 3 : k == 3 ? 2 : k; );
function pn_cols(lim) local(c h k) (
  c = 1; h = 0; k = 0;
  while (k < 6) ( h > 0 && h + pn_hk(pn_ord(k)) > lim ? ( c += 1; h = 0; ); h += pn_hk(pn_ord(k)); k += 1; );
  c;
);

// ── ГРАФИК ADSR ───────────────────────────────────────────────────────────
// Четыре числа не дают представления о форме, а ломаная даёт сразу: видно
// и резкость атаки, и есть ли вообще удержание. Рисуем пропорционально
// РЕАЛЬНОМУ времени, поэтому длинный хвост и выглядит длинным.
// ── ГРАФИК ADSR, РЕДАКТИРУЕМЫЙ ТОЧКАМИ (по образцу Nerve, 14 сен) ───────
// Раньше это была картинка: форму показывал, править приходилось четырьмя
// ручками отдельно. Теперь тянешь узел — меняется параметр, и рука видит
// результат там же, где его задаёт.
//   узел 1 (конец атаки)      по X — время атаки
//   узел 2 (конец спада)      X время спада, Y уровень удержания
//   узел 3 (конец затухания)  по X — время затухания
// Возвращает 1, если что-то изменилось: вызывающий пишет параметры.
// Значения кладёт в adsr_a / adsr_d / adsr_s / adsr_r.
function adsr_edit(gx gy gw gh a d sus r) local(ta td tr tot x1 x2 x3 x4 ybase ytop hit nx ny ch) (
  ta = a <= 0.0001 ? 0 : a*a*0.5; td = max(0.001, d*d*2); tr = max(0.001, r*r*3);
  tot = max(0.0001, ta + td + tr);
  ybase = gy + gh - floor(2*u); ytop = gy + floor(2*u);
  x1 = gx + floor(2*u);
  x2 = x1 + (gw - floor(4*u))*0.75 * ta/tot;
  x3 = x2 + (gw - floor(4*u))*0.75 * td/tot;
  x4 = x3 + (gw - floor(4*u))*0.25;
  adsr_a = a; adsr_d = d; adsr_s = sus; adsr_r = r; ch = 0;
  // ЗАХВАТ УЗЛА: берём ближайший по X, в пределах восьми пикселей. Не по
  // расстоянию до точки: узлы стоят на разной высоте, и тянуться к ним
  // по диагонали неудобно — палец ищет колонку, а не точку.
  hit = mouse_x >= gx && mouse_x < gx+gw && mouse_y >= gy && mouse_y < gy+gh;
  hit && lclick ? (
    adsr_grab = abs(mouse_x - x2) < floor(9*u) ? 1 :
                abs(mouse_x - x3) < floor(9*u) ? 2 :
                abs(mouse_x - x4) < floor(9*u) ? 3 : 0;
    adsr_grab ? fld_active = 900;
  );
  fld_active == 900 && (mouse_cap & 1) && adsr_grab ? (
    nx = min(1, max(0, (mouse_x - gx - floor(2*u)) / max(1, gw - floor(4*u))));
    ny = min(1, max(0, 1 - (mouse_y - ytop) / max(1, ybase - ytop)));
    adsr_grab == 1 ? (
      // атака: доля ширины -> время -> обратно в ручку (корень, т.к. квадрат)
      adsr_a = sqrt(min(1, nx / 0.75 * tot / 0.5)); ch = 1;
    ) : adsr_grab == 2 ? (
      adsr_d = sqrt(min(1, max(0, (nx - (x2-gx)/max(1,gw)) / 0.75 * tot / 2)));
      adsr_s = ny; ch = 1;
    ) : (
      adsr_r = sqrt(min(1, max(0, (1 - nx) / 0.75 * tot / 3))); ch = 1;
    );
    adsr_a = min(1, max(0, adsr_a)); adsr_d = min(1, max(0, adsr_d));
    adsr_s = min(1, max(0, adsr_s)); adsr_r = min(1, max(0, adsr_r));
  );
  fld_active == 900 && !(mouse_cap & 1) ? ( fld_active = -1; adsr_grab = 0; );
  ch;
);

// узел графика ADSR: ромб; hot — акцентом, иначе приглушённый текст
function adsr_node(x y hot) local(r) (
  r = max(2, floor(2.5*u));
  hot ? pset(3) : pseta(4, 0.55);
  gfx_triangle(x - r, y, x, y - r, x + r, y, x, y + r);
);
// мышь у узла: тот же захват по X, что в adsr_edit (±9u), и внутри графика
function adsr_near(gx gy gw gh nx) (
  mouse_x >= gx && mouse_x < gx+gw && mouse_y >= gy && mouse_y < gy+gh && abs(mouse_x - nx) < floor(9*u);
);
function adsr_draw(gx gy gw gh a d sus r) local(ta td tr tot x1 x2 x3 x4 ybase ytop) (
  pset(0);
  gfx_rect(gx, gy, gw, gh);
  pseta(4, 0.6);
  gfx_rect(gx,gy,gw,1); gfx_rect(gx,gy+gh-1,gw,1);
  gfx_rect(gx,gy,1,gh); gfx_rect(gx+gw-1,gy,1,gh);
  // времена в секундах — те же формулы, что в звуке
  ta = a <= 0.0001 ? 0 : a*a*0.5; td = max(0.001, d*d*2); tr = max(0.001, r*r*3);
  // на удержание отводим четверть ширины: это не время, а «сколько держишь»
  tot = ta + td + tr;
  ybase = gy + gh - floor(2*u); ytop = gy + floor(2*u);
  x1 = gx + floor(2*u);
  x2 = x1 + (gw - floor(4*u))*0.75 * ta/tot;
  x3 = x2 + (gw - floor(4*u))*0.75 * td/tot;
  x4 = x3 + (gw - floor(4*u))*0.25;
  pset(3);
  gfx_line(x1, ybase, x2, ytop);                                  // атака
  gfx_line(x2, ytop, x3, ybase - (ybase-ytop)*sus);               // спад
  gfx_line(x3, ybase - (ybase-ytop)*sus, x4, ybase - (ybase-ytop)*sus);  // удержание
  gfx_line(x4, ybase - (ybase-ytop)*sus,
           x4 + (gw - floor(4*u))*0.75 * tr/tot, ybase);          // затухание
  // УЗЛЫ: видно, что график можно тянуть. Захваченный ярче — палец знает,
  // что держит.
  // 26 окт: узлы — маленькие ромбы (как ручки трекера); под мышью и захваченный — ярче
  adsr_node(x2, ytop, adsr_grab == 1 || (!adsr_grab && adsr_near(gx, gy, gw, gh, x2)));
  adsr_node(x3, ybase - (ybase-ytop)*sus, adsr_grab == 2 || (!adsr_grab && adsr_near(gx, gy, gw, gh, x3) && !adsr_near(gx, gy, gw, gh, x2)));
  adsr_node(x4, ybase - (ybase-ytop)*sus, adsr_grab == 3 || (!adsr_grab && adsr_near(gx, gy, gw, gh, x4) && !adsr_near(gx, gy, gw, gh, x2) && !adsr_near(gx, gy, gw, gh, x3)));
);

// ГРАФИК КРИВОЙ АФТЕРТАЧА. Число «1.35» ничего не говорит пальцу, а форма
// линии говорит сразу: выгнута вверх — эффект берётся от лёгкого нажима,
// прогнута вниз — вся глубина в конце хода, прямая — как приходит.
// Правится тем же жестом, каким читается: тянешь мышью вверх и вниз.
// Возвращает новое значение кривой.
function atgraph(gx gy gw gh val) local(i x0 y0 x1 y1 t nv) (
  // рамка и диагональ-ориентир: без неё непонятно, где «линейно»
  pset(0);
  gfx_rect(gx, gy, gw, gh);
  pseta(4, 0.6);
  gfx_rect(gx,gy,gw,1); gfx_rect(gx,gy+gh-1,gw,1);
  gfx_rect(gx,gy,1,gh); gfx_rect(gx+gw-1,gy,1,gh);
  pseta(4, 0.3);
  gfx_line(gx, gy+gh-1, gx+gw-1, gy);
  // мышь: вертикаль задаёт показатель степени. Вверх — мягче (0.25),
  // вниз — жёстче (4). Диапазон логарифмический: единица ровно посередине.
  mouse_x >= gx && mouse_x < gx+gw && mouse_y >= gy && mouse_y < gy+gh ? (
    lclick ? atg_drag = 1;
    tip("aftertouch curve: drag up for an early response, down to keep the depth for the end of the travel");
  );
  atg_drag && (mouse_cap & 1) ? (
    t = min(1, max(0, (mouse_y - gy) / max(1, gh - 1)));
    nv = exp(log(0.25) + (log(4) - log(0.25)) * t);
    val = nv;
  );
  atg_drag && !(mouse_cap & 1) ? atg_drag = 0;
  // сама кривая
  pset(3);
  i = 0;
  while (i < gw - 2) (
    x0 = i / max(1, gw - 3); x1 = (i + 1) / max(1, gw - 3);
    y0 = pow(x0, val); y1 = pow(x1, val);
    gfx_line(gx + 1 + i, gy + gh - 2 - y0*(gh - 3),
             gx + 2 + i, gy + gh - 2 - y1*(gh - 3));
    i += 1;
  );
  val;
);

// ОБОЗНАЧЕНИЕ КЛАВИШИ — буква В РАМКЕ (решение пользователя 13 сен:
// «возьми в квадратик, чтобы было понятно, что это обозначение клавиши»).
// Голая буква в углу читалась как часть подписи; рамка сразу говорит
// «это клавиша на клавиатуре». Возвращает ширину занятого места.
// keycap() удалена вместе с подписями клавиш на пэдах (25 окт).

// ЯЧЕЙКА ГРАФА (Surge XT): рамка, имя алгоритма по центру, полоска amount
// снизу. Ничего больше — параметры живут в строке под графом. Выделенная
// горит акцентом, пустая (amount = 0) рисуется тускло.
// cellname/cellval заполняет вызывающий: у пути они из среза, у мастера из
// MXSEL, и тянуть обе ветки внутрь функции значило бы дублировать адресацию.
// ЯЧЕЙКА ЦЕПИ: чёрная в белой рамке; ВЫБРАННАЯ — белая целиком, текст
// чёрный (тот же язык, что у пэдов и кнопок). Пустой amount — рамка тусклее.
function fxbox(cx cy cw ch selq val nm) local(tw th cut) (
  selq ? ( pset(3); gfx_rect(cx, cy, cw, ch); );
  pseta(4, selq ? 1.0 : val > 0.003 ? 0.6 : 0.35);
  gfx_rect(cx, cy, cw, 1); gfx_rect(cx, cy+ch-1, cw, 1);
  gfx_rect(cx, cy, 1, ch); gfx_rect(cx+cw-1, cy, 1, ch);
  strlen(nm) ? (
    strcpy(#fb_nm, nm);
    gfx_measurestr(#fb_nm, tw, th);
    while (tw > cw - floor(6*u) && strlen(#fb_nm) > 1) (
      strcpy_substr(#fb_cut, #fb_nm, 0, strlen(#fb_nm) - 1); strcpy(#fb_nm, #fb_cut);
      gfx_measurestr(#fb_nm, tw, th);
    );
    selq ? gfx_set(0,0,0,1) : val > 0.003 ? pset(4) : pseta(4, 0.5);
    gfx_x = cx + (cw - tw)/2; gfx_y = cy + (ch - th)/2 - floor(1*u);
    gfx_drawstr(#fb_nm);
    // полоска amount по нижнему краю: сколько эффекта в ячейке
    selq ? gfx_set(0,0,0,0.6) : pset(3);
    gfx_rect(cx + 2, cy + ch - 3, max(0, (cw - 4)*val), 2);
  ) : (
    // пустой инсерт — прочерк по центру, как в Surge
    pseta(4, 0.35);
    gfx_line(cx + cw/2 - floor(4*u), cy + ch/2, cx + cw/2 + floor(4*u), cy + ch/2);
  );
);

// ЯЧЕЙКА ЦЕПИ ПО ПОЗИЦИИ. pos — место в цепи (0 слева), слот берётся из
// CHORD: порядок изменяемый, поэтому позиция и слот — разные вещи.
function fxcell_at(pos cx cy cw ch) local(k val hit byp) (
  k = max(0, min(AW_NPP-1, CHORD[pos]|0));
  val = gsel >= 0 && gsel < dk_nsl[0] ? gsb[OF_FXA + k*64 + gsel] : 0;
  OVR[k] > 0.003 ? val = 1;
  byp = CHBYP[k] > 0.5;
  slot_name(k, #fc_nm);
  hit = mouse_x >= cx && mouse_x < cx+cw && mouse_y >= cy && mouse_y < cy+ch;

  // ОБОЙДЁННЫЙ слот рисуется как «сквозной»: рамка тусклая, имя зачёркнуто
  // линией. Не гасим совсем — он остаётся в цепи и его место занято.
  byp ? (
    pseta(4, 0.22);
    gfx_rect(cx, cy, cw, 1); gfx_rect(cx, cy+ch-1, cw, 1);
    gfx_rect(cx, cy, 1, ch); gfx_rect(cx+cw-1, cy, 1, ch);
    pseta(4, 0.30);
    gfx_measurestr(#fc_nm, fc_tw, fc_th);
    gfx_x = cx + (cw - fc_tw)/2; gfx_y = cy + (ch - fc_th)/2;
    gfx_drawstr(#fc_nm);
    gfx_line(cx + floor(6*u), cy + ch/2, cx + cw - floor(6*u), cy + ch/2);
  ) : fxbox(cx, cy, cw, ch, (fxsel|0) == k, val, #fc_nm);

  // источник перетаскивания — двойная рамка, цель под курсором — заливка
  fxdrag_from == pos ? ( pset(3); gfx_rect(cx+2, cy+2, cw-4, ch-4, 0); );
  fxdrag_from >= 0 && fxdrag_from != pos && hit ? (
    fxdrag_to = pos;
    pseta(3, 0.25); gfx_rect(cx+1, cy+1, cw-2, ch-2);
  );

  hit ? (
    lclick ? ( fxsel = k; fxdrag_from = pos; fxdrag_to = -1; );
    // ПРАВЫЙ КЛИК = ВЫБОР АЛГОРИТМА из библиотеки. Слот перестал быть
    // жёстко зашитым: меню показывает всё, что влезает в память слота
    // (aw_fits), остальное просто не предлагается.
    // SHIFT+правый = BYPASS: отдельный флаг, а не «amount в ноль», чтобы
    // выключить и включить обратно, не потеряв настройки.
    rclick && (mouse_cap & 8) ? CHBYP[k] = byp ? 0 : 1 :
    rclick ? (
      gfx_x = cx; gfx_y = cy + ch;
      fc_m = gfx_showmenu("HSOFT hypersoft|SQRT squareroot|FRAC2 fracture|FACET|KALMN kalman|BQNL biquad|CAP2 capacitor|RING ringmod|TREM tremosquare|PRES6 pressure|POINT transient|PHNDG phasenudge|DEREZ derez3|DUST tapedust|STFX stereofx|FLUT flutter2|BITE bite|CREAT creature|EXCIT exciter|SWIDE sweetwide|SGATE softgate|EROS erosion");
      fc_m > 0 ? (
        // номера пунктов -> id библиотеки: пропущены те, что не влезают
        // в память слота (Vibrato, Chorus, Hull) — их в меню и нет
        CHALG[k] = fc_m <= 8 ? fc_m :
                   fc_m == 9 ? 10 : fc_m == 10 ? 11 : fc_m == 11 ? 12 :
                   fc_m == 12 ? 13 : fc_m == 13 ? 14 : fc_m == 14 ? 15 :
                   fc_m == 15 ? 16 : fc_m == 16 ? 18 : fc_m == 17 ? 19 :
                   fc_m == 18 ? 20 : fc_m == 19 ? 21 : fc_m == 20 ? 23 :
                   fc_m == 21 ? 24 : 25;
        // поставил эффект — открываем глубину, иначе непонятно, слышно
        // ли его вообще: слот с нулевым amount молчит
        gsel >= 0 && gsb[OF_FXA + k*64 + gsel] <= 0.003 ? (
          ov = gsb[OF_FXA + k*64 + gsel];
          gsb[OF_FXA + k*64 + gsel] = 0.5;
          apply_delta(0, OF_FXA + k*64, ov, 0.5, 0, 1);
        );
        fxsel = k;
      );
    );
    aw_name(slot_fx(k), #fc_al);
    sprintf(#fc_tip, "%s%s - click sends its parameters to arc, right-click picks the algorithm, shift+right bypasses, drag reorders",
            #fc_nm, byp ? " (BYPASSED)" : "");
    tip(#fc_tip);
  );
);

// hairline between sections, the tracker way: full width, quiet
function hr(y) (
  pseta(4, 0.22);
  gfx_rect(WX, y, WW, 1);
);

function tbmeasure(lab) local(tw th bw_) (
  gfx_measurestr(lab, tw, th);
  bw_ = floor(tw + BPAD);
  mx + bw_ > W - floor(8*u) ? ( mx = WX; mrow += 1; );
  mx += bw_ + BGAP;
);

// Перенос строки в потоке кнопок — ОДНО место на всех. Зона (zlab..zend)
// меряет свою ширину БЕЗ учёта переносов: на переносе накопленное уходит
// в z_acc, отсчёт сегмента начинается заново. Иначе ширину зоны нельзя
// узнать, не зная, где её перенесёт, — а перенос зависит от ширины.
function zwrap() ( z_acc += bx - z_seg; bx = WX; bwrap += 1; z_seg = WX; );

// One button in a wrapping toolbar row. With tb_dry set nothing is drawn and
// only the cursor advances: the row is run twice, first to count its lines,
// then to draw them. Measuring the row itself rather than a parallel list of
// labels is what keeps the two from drifting apart -- which is exactly how the
// rows came to overlap before.
function btnw(y lab on) local(tw th bw_ r by_) (
  gfx_measurestr(lab, tw, th);
  bw_ = floor(tw + BPAD);
  bx + bw_ > W - floor(8*u) ? zwrap();
  by_ = y + bwrap*ROWSTEP;
  tb_dry ? r = 0 : (
    r = btn(bx, by_, bw_, BTH, lab, on);
    bhx = bx; bhy = by_; bhw = bw_;   // remembered so btnh() can hit-test it
  );
  bx += bw_ + BGAP;
  r;
);

// То же, но со значком (29 сен). Ширина больше на значок и зазор — иначе
// подпись вылезала бы за рамку.
// Кнопка с хоткеем: ширина меряется ВМЕСТЕ с буквой, поэтому она никогда
// не вылезает за рамку и не налезает на подпись (та самая ошибка, из-за
// которой подписи клавиш убрали с пэдов).
function btnwi(y lab on key) local(tw th kw kh bw_ r by_) (
  gfx_measurestr(lab, tw, th);
  key > 0 ? ( sprintf(#bk_m, "%c", key); gfx_measurestr(#bk_m, kw, kh); ) : kw = 0;
  bw_ = floor(tw + BPAD + (key > 0 && key_in(lab, key) < 0 ? kw + 3 : 0));
  bx + bw_ > W - floor(8*u) ? zwrap();
  by_ = y + bwrap*ROWSTEP;
  tb_dry ? r = 0 : (
    r = btni(bx, by_, bw_, BTH, lab, on, key);
    bhx = bx; bhy = by_; bhw = bw_;
  );
  bx += bw_ + BGAP;
  r;
);

// КНОПКА-ВЫПАДАШКА (21 сен). Возвращает НОМЕР ПУНКТА 1..N, 0 = не выбрали.
//
// Почему не тоггл. Тоггл честен для двух состояний: один клик — и ты в
// другом, оба видны в подписи. На трёх и больше он врёт: списка не видно,
// а до нужного пункта бывает шесть кликов, и промахнувшись ты идёшь по
// кругу заново. Выпадашка показывает всё сразу и стоит один клик — так же
// выбирается алгоритм слота, и это тот же жест, что в нативных меню REAPER.
//
// Треугольник справа — признак «тут список», а не значение: без него
// кнопка неотличима от тоггла, и рука не знает, чего ждать от клика.
function btnm(y lab on items) local(tw th bw_ r by_ ax ay) (
  gfx_measurestr(lab, tw, th);
  bw_ = floor(tw + BPAD) + 9;      // +9 под треугольник
  bx + bw_ > W - floor(8*u) ? zwrap();
  by_ = y + bwrap*ROWSTEP;
  tb_dry ? r = 0 : (
    btn(bx, by_, bw_, BTH, lab, on) ? (
      gfx_x = bx; gfx_y = by_ + BTH;       // меню под кнопкой, как в REAPER
      r = gfx_showmenu(items);
    ) : r = 0;
    // треугольник вниз у правого края, в цвете подписи
    on ? pset(0) : pseta(4, 0.75);
    ax = bx + bw_ - 9; ay = by_ + BTH/2 - floor(1*u);
    gfx_triangle(ax, ay, ax + floor(6*u), ay, ax + floor(3*u), ay + floor(4*u));
    bhx = bx; bhy = by_; bhw = bw_;
  );
  bx += bw_ + BGAP;
  r;
);

// 25 окт: выпадашка с клавишей — буква на кнопке ярко, клавиша открывает меню под кнопкой (как щелчок)
function btnmk(y lab on items key) local(tw th kw kh bw_ r by_ ax ay) (
  gfx_measurestr(lab, tw, th);
  sprintf(#bk_m, "%c", key); gfx_measurestr(#bk_m, kw, kh);
  bw_ = floor(tw + BPAD) + (key_in(lab, key) < 0 ? kw + 3 : 0) + 9;
  bx + bw_ > W - floor(8*u) ? zwrap();
  by_ = y + bwrap*ROWSTEP;
  tb_dry ? r = 0 : (
    btni(bx, by_, bw_, BTH, lab, on, key) || hk_fire == key ? (
      gfx_x = bx; gfx_y = by_ + BTH;
      r = gfx_showmenu(items);
    ) : r = 0;
    on ? pset(0) : pseta(4, 0.75);
    ax = bx + bw_ - 8; ay = by_ + BTH/2 - 1;
    gfx_triangle(ax, ay, ax + 6, ay, ax + 3, ay + 4);
    bhx = bx; bhy = by_; bhw = bw_;
  );
  bx += bw_ + BGAP;
  r;
);

// btnw + hover help: call right after a btnw whose meaning is not obvious
function btnh(txt) (
  !tb_dry && mouse_x >= bhx && mouse_x < bhx+bhw && mouse_y >= bhy && mouse_y < bhy+BTH ?
    tip(txt);
);

/* hslid не используется: в плагине один вид поля, с вертикальным жестом и
   вертикальным индикатором. Код оставлен как справка.
// horizontal 0..1 slider: label left inside, value right inside, drag anywhere
function hslid(id x y ww_ hh_ val lab disp) local(hit tw th) (
  hit = mouse_x >= x && mouse_x < x+ww_ && mouse_y >= y && mouse_y < y+hh_;
  hit && lclick ? fld_active = id;
  fld_active == id && (mouse_cap & 1) ? val = min(1, max(0, (mouse_x - x)/ww_));
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  pseta(1, 0.85); gfx_rect(x, y, ww_, hh_);
  pseta(2, fld_active == id ? 0.9 : 0.55); gfx_rect(x, y, ww_*val, hh_);
  pseta(4, 0.35); gfx_rect(x,y,ww_,1); gfx_rect(x,y+hh_-1,ww_,1); gfx_rect(x,y,1,hh_); gfx_rect(x+ww_-1,y,1,hh_);
  pset(4);
  gfx_x = x+floor(4*u); gfx_y = y + (hh_-gfx_texth)/2; gfx_drawstr(lab);
  gfx_measurestr(disp, tw, th);
  gfx_x = x + ww_ - tw - floor(4*u); gfx_y = y + (hh_-th)/2; gfx_drawstr(disp);
  val;
);
*/

function fxp2name(k dst) local(sl) (
  // слоты фиксированы: имя второго параметра берётся из библиотеки по
  // алгоритму слота (раньше «sat» подписывался grain, «comp» — freq)
  k >= 0 && k < NDISP ? aw_p2name(slot_fx(k), dst) :
  k==FX_STRETCH ? strcpy(dst,"grain") :
  k==FX_COMP ? strcpy(dst,"release") : k==FX_FM ? strcpy(dst,"freq") :
  k==FX_AM ? strcpy(dst,"rate") : k==FX_RING ? strcpy(dst,"freq") :
  k==FX_SAT ? strcpy(dst,"shape") : k==FX_DOWN ? strcpy(dst,"jitter") :
  k==FX_STUT ? strcpy(dst,"length") : k==FX_GLIT ? strcpy(dst,"interval") :
  k==FX_FILT ? strcpy(dst,"reso") : strcpy(dst,"bias");
);
function satshape_name(v dst) (
  v < 0.125 ? strcpy(dst,"fasttanh") : v < 0.25 ? strcpy(dst,"tanh") :
  v < 0.375 ? strcpy(dst,"poly") : v < 0.5 ? strcpy(dst,"fold") :
  v < 0.625 ? strcpy(dst,"clip") : v < 0.75 ? strcpy(dst,"asym") :
  v < 0.875 ? strcpy(dst,"spiral") : strcpy(dst,"density");
);

function ufield(id x y bw_ bh_ lo hi def isenum val lab disp) local(hit nv tw th tw2 uf_t uf_f uf_yf uf_ty) (
  hit = mouse_x >= x && mouse_x < x+bw_ && mouse_y >= y && mouse_y < y+bh_;
  hit && lclick ? (
    dbl ? (
      val = def;
    ) : isenum ? (
      val = val+1 > hi ? lo : val+1;
    ) : (
      // НАПРАВЛЕНИЕ ЖЕСТА ОПРЕДЕЛЯЕТ ФОРМА ВИДЖЕТА. Широкое поле тянется
      // горизонтально, высокое — вертикально. Одно правило на все поля
      // разом, без ручной разметки каждого: иначе рано или поздно
      // появляется горизонтальная полоса, которую надо тянуть вверх, и это
      // ровно то, на что жалуется рука.
      fld_active = id; fld_v0 = val;
      fld_y0 = mouse_y; fld_x0 = mouse_x;
    );
  );
  fld_active == id && (mouse_cap & 1) ? (
    // ход берём по той оси, вдоль которой виджет длиннее: так расстояние
    // до края и есть весь диапазон, а не случайная доля от него
    bw_ >= bh_ ? (
      nv = fld_v0 + (mouse_x - fld_x0) * (hi-lo) / max(40, bw_) * ((mouse_cap & 4) ? 0.1 : 1);
    ) : (
      nv = fld_v0 + (fld_y0 - mouse_y) * (hi-lo) / 160 * ((mouse_cap & 4) ? 0.1 : 1);
    );
    val = min(hi, max(lo, nv));
  );
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  // РИСУНОК — ТОТ ЖЕ, ЧТО У knob(): чёрная дорожка, белая рамка, белая
  // заливка, имя и значение НА полосе с инверсией над заливкой. Одна
  // картинка на все поля окна (15 сен: «все слайдеры сделать реально просто
  // тоненько белая полоска»). Перечисления — без заливки, только текст.
  pset(0);
  gfx_rect(x,y,bw_,bh_);
  // заливка + текст одним блитом с попиксельной инверсией (inv_bar);
  // перечисление — без заливки (kf = 0)
  uf_f = 0;
  !isenum && hi > lo ? (
    uf_t = (val - lo) / (hi - lo);
    uf_f = bw_ >= bh_ ? uf_t*(bw_-2) : uf_t*(bh_-2);
  );
  inv_bar(x+1, y+1, bw_-2, bh_-2, uf_f, bw_ >= bh_ ? 0 : 1, lab, disp);
  pseta(4, hit || fld_active == id ? 1.0 : 0.6);
  gfx_rect(x,y,bw_,1); gfx_rect(x,y+bh_-1,bw_,1); gfx_rect(x,y,1,bh_); gfx_rect(x+bw_-1,y,1,bh_);
  rcorn(x, y, bw_, bh_, hit || fld_active == id ? 1.0 : 0.6);
  val;
);

// 27 окт: поле-значение как в трекере (кнопка «sens 0.28»): рамка, подпись — текстом, значение — бирюзой, без заливки;
// тянуть вбок (Cmd — мелко), колесо — шаг, двойной щелчок — по умолчанию (как ufield)
function vbtn(id x y bw_ bh_ lo hi def stp val lab disp) local(hit nv tw th) (
  hit = mouse_x >= x && mouse_x < x+bw_ && mouse_y >= y && mouse_y < y+bh_;
  hit && lclick ? ( dbl ? val = def : ( fld_active = id; fld_v0 = val; fld_x0 = mouse_x; ); );
  fld_active == id && (mouse_cap & 1) ? (
    nv = fld_v0 + (mouse_x - fld_x0) * (hi-lo) / max(40, 2*bw_) * ((mouse_cap & 4) ? 0.1 : 1);
    val = min(hi, max(lo, nv));
  );
  fld_active == id && !(mouse_cap & 1) ? fld_active = -1;
  hit && mouse_wheel != 0 ? ( val = min(hi, max(lo, val + (mouse_wheel > 0 ? stp : -stp))); mouse_wheel = 0; );
  pset(0); gfx_rect(x, y, bw_, bh_);
  pseta(4, hit || fld_active == id ? 1.0 : 0.6);
  gfx_rect(x,y,bw_,1); gfx_rect(x,y+bh_-1,bw_,1); gfx_rect(x,y,1,bh_); gfx_rect(x+bw_-1,y,1,bh_);
  gfx_measurestr(lab, tw, th);
  pset(4); gfx_x = x + floor(4*u); gfx_y = y + (bh_ - th)/2; gfx_drawstr(lab);
  gfx_measurestr(disp, tw, th);
  gfx_set(0.42, 0.72, 0.78, 1); gfx_x = x + bw_ - tw - floor(4*u); gfx_y = y + (bh_ - th)/2; gfx_drawstr(disp);
  val;
);

W = gfx_w; H = gfx_h;
// ОКНО ЭТОГО ЭКЗЕМПЛЯРА ОТКРЫТО: @gfx вызывается только у видимых окон,
// поэтому сам факт входа сюда и есть признак. Держим отметку по времени —
// закрыли окно, и через полсекунды экземпляр перестаёт считаться «живым
// на экране».
mn_gfxt = time_precise();
// закадровые картинки для inv_bar: размер постоянный, setimgdim без смены размера бесплатен
gfx_setimgdim(IMG_A, IMG_W, IMG_H); gfx_setimgdim(IMG_B, IMG_W, IMG_H);

// ---- palette ----------------------------------------------------------------
// ONE palette for the whole ecosystem (jf_grid window, transport box, phatfx,
// reel). Five themes used to live here (graphite / light / lcd / amber / blue /
// terminal) -- they made every plugin look like a different program. Removed:
// the point is that this feels like one thing together with REAPER.
//
// Colours go through pset(role) rather than literal gfx_set calls, so swapping
// the palette is this block alone. Five roles: background, panel, fill, accent,
// text. Meaning-carrying colours (slice classes, the spectral waveform) stay
// literal on purpose -- they encode information, not styling.
//
// Reference: Windows-G E-Expander600 and the terminal DAW -- black ground,
// cyan for values and levels, amber for what is active. No grey on grey.
// ── ЧИСТЫЙ ЧЁРНЫЙ И ЧИСТЫЙ БЕЛЫЙ (15 сен, просьба пользователя: «убрать
// серый фон, сделать чёрным, все линии ярко-контрастными, слайдеры реально
// чёрно-белыми»). Панелей-плит больше нет: роль 1 равна фону, и всё, что
// раньше было «чуть светлее фона», исчезает само — остаются только линии.
// ── ПАЛИТРА jf_tracker (25 окт, решение пользователя: «сделай вид как у
// трекера, а то от этого тошнит») ────────────────────────────────────────
// Было: фон ЧИСТО ЧЁРНЫЙ (0,0,0), текст и акцент ЧИСТО БЕЛЫЕ (1,1,1) —
// контраст 21:1, максимум из возможного. Отсюда и резь: глазу не на чем
// отдохнуть, каждая рамка бьёт в полную силу.
// Стало: значения из jf_tracker_ui.lua при его теме по умолчанию. Там они
// ВЫЧИСЛЯЮТСЯ (readable тянет цвет до нужного контраста с фоном), а здесь
// записаны числами — JSFX не видит темы REAPER. Контраст у каждого
// проверен расчётом и подписан.
// Когда палитру начнёт публиковать демон (приём уже работает в jf_rec:
// gmem[39]=1, gmem[40+роль]), эти числа станут умолчанием на случай, что
// демон не запущен.
cb_r=0.055; cb_g=0.062; cb_b=0.068;   // BG: фон окна, чуть синеватый, не чёрный
cp_r=0.089; cp_g=0.098; cp_b=0.104;   // PANEL: фон панели, на шаг светлее фона
// МОНОХРОМ (решение 14 сен, референс Noise Engineering) СОХРАНЁН: цвет
// только там, где он информация (классы срезов, спектр волны, цвет трека).
// Трекер устроен так же, поэтому палитры совместимы.
cf_r=0.620; cf_g=0.660; cf_b=0.660;   // fill: заполнение слайдера = TEXT (7.9:1)
ca_r=0.920; ca_g=0.520; ca_b=0.220;   // accent: AMBER трекера (7.2:1) — включённое
ct_r=0.620; ct_g=0.660; ct_b=0.660;   // TEXT: первый уровень типографики (7.9:1)
// ТРИ УРОВНЯ ТЕКСТА, как в трекере: TEXT / GREY (тише) / DIM (вспомогательное).
// Раньше градации задавались альфой от белого на месте вызова — из-за этого
// «тише» означало разное в разных углах окна. Теперь это именованные цвета.
cg_r=0.394; cg_g=0.421; cg_b=0.423;   // GREY: подписи второго уровня (3.5:1)
cd_r=0.323; cd_g=0.346; cd_b=0.349;   // DIM: вспомогательное (2.6:1)
cl_r=0.292; cl_g=0.313; cl_b=0.317;   // LINE: рамки (2.3:1)

// Track colour is information, not styling: it stays. Drawn as the stripe and
// mixed into the fill so the instance is identifiable at a glance.
tc = trkcol|0;
tint >= 0.5 && tc > 0 ? (
  tr_r = ((((tc-1)/65536)|0) & 255)/255; tr_g = ((((tc-1)/256)|0) & 255)/255; tr_b = (((tc-1)|0) & 255)/255;
  tlum = max(max(tr_r, tr_g), tr_b);
  tlum > 0.01 ? (            // dark track colours are unreadable on black
    tsc = 0.9 / tlum;
    tr_r = min(tr_r*tsc,1); tr_g = min(tr_g*tsc,1); tr_b = min(tr_b*tsc,1);
  );
  // Цвет трека в ЗАЛИВКУ больше не подмешиваем: интерфейс монохромный, и
  // окрашенные слайдеры вернули бы ту самую пестроту. Полоска цвета трека
  // внизу окна остаётся — там он информация, а не украшение.
);
term = 0;   // terminal theme is gone; kept as 0 so old branches stay inert

// ---- UI scale ---------------------------------------------------------------
// Every widget size below is expressed in US units, so the whole interface
// rescales from one number. gfx_ext_flags bit 1 = embedded in the TCP/MCP.
//
// Embedded views pick their scale from the height they were given instead of
// using a fixed one: a track strip is short, and shrinking the widgets is what
// lets the pads and the fx panel fit at all. Drag the track taller and the rows
// appear in order -- waveform, pads, fx panel. The thresholds below are the
// heights each row set needs, measured at scale 1.0 and divided down.
embedded = (gfx_ext_flags & 1) ? 1 : 0;
embedded ? (
  // 0.75 is the floor: below that the labels stop being readable, and a strip
  // too short for the pads at 0.75 would not gain a usable row by shrinking.
  US = gfx_h >= 500 ? 1.1 : gfx_h >= 380 ? 0.9 : 0.75;
) : US = 1.5;
// One family across the whole ecosystem (jf_grid window, jf_phatfx, reel):
// the plugins must read as one thing with REAPER, not as separate toys.
// BigBlueTerm437 was a DOS terminal face -- it only has uppercase forms, which
// is why every label shouted. JetBrainsMono Mono has a real lowercase.
// gfx_setfont falls back silently when a family is missing, so the second call
// only lands if the first found nothing -- hence the gfx_texth guard.
// 25 окт: шрифт трекера — встроенный битмап REAPER (gfx_setfont(0)), как jf_tracker при :font 0:
// окно slixer выглядит частью сэмплера трекера. Плотно: масштаб раскладки от высоты битмапа
// (кнопка = строка текста + 3 px), а не от кегля TTF
gfx_setfont(0);
!embedded ? US = 1.4;   // ширины полей — как в прежней раскладке (подпись и значение помещаются)
BPAD = 8; BGAP = 2;      // 25 окт: кнопки плотно, как в трекере: 4 px внутри с каждой стороны, 2 px между
FSZ = gfx_texth;
u = US;  // short alias used by the layout math below

// drag-and-drop: file dropped onto the plugin window loads the loop
// ПЕРЕТАСКИВАНИЕ ФАЙЛА — один обработчик на всё окно, здесь и только здесь.
// Раньше слоты пытались ловить дроп сами, но этот блок выполняется РАНЬШЕ
// отрисовки и уже вычищал очередь gfx_getdropfile(-1): файл, бросенный из
// Media Explorer на слот, пропадал. Теперь запоминаем и путь, и КУДА бросили
// (drop_y), а слоты и буфер разбирают это при отрисовке.
!drop_req && gfx_getdropfile(0, #droppath) > 0 ? (
  drop_req = 1;
  drop_x = mouse_x; drop_y = mouse_y;
  gfx_getdropfile(-1);
);

lclick = (mouse_cap & 1) && !(last_cap & 1);
// Хоткей действует ОДИН КАДР. Клавиатура разбирается в конце @gfx и ставит
// hk_fire; кнопки читают его на следующем кадре и тут же гасят. Без сброса
// флаг держался бы вечно и повторял действие каждый кадр — ровно так уже
// ломались броски (повтор 34 раза за секунду).
hk_fire = hk_next; hk_next = 0;
rclick = (mouse_cap & 2) && !(last_cap & 2);
dbl = 0;
lclick ? (
  tnow = time_precise();
  (tnow - lc_time < 0.32 && abs(mouse_x - lc_x) < 5 && abs(mouse_y - lc_y) < 5) ? dbl = 1;
  lc_time = tnow; lc_x = mouse_x; lc_y = mouse_y;
);
// SETUP overlay geometry is needed here already: a click inside the open panel
// must be eaten before the main widgets see it, else it would also hit
// whatever pad or button sits underneath. The panel's own fields use lclick2.
setup_on && !embedded ? (
  spw = min(W - floor(40*u), floor(560*u));
  sph = min(H - floor(40*u), floor(160*u));   // три тоггла + заголовок + подпись (15 сен)
  spx = floor((W - spw)/2); spy = floor((H - sph)/2);
  in_setup = mouse_x >= spx && mouse_x < spx+spw && mouse_y >= spy && mouse_y < spy+sph;
  lclick2 = lclick; dbl2 = dbl;
  in_setup ? ( lclick = 0; rclick = 0; dbl = 0; );
) : ( in_setup = 0; lclick2 = 0; dbl2 = 0; );
tmap_on && !embedded ? (
  tpw2 = min(W - floor(40*u), floor(620*u));
  tph2 = min(H - floor(40*u), floor(360*u));
  tpx2 = floor((W - tpw2)/2); tpy2 = floor((H - tph2)/2);
  in_tmap = mouse_x >= tpx2 && mouse_x < tpx2+tpw2 && mouse_y >= tpy2 && mouse_y < tpy2+tph2;
  lclick3 = lclick;
  in_tmap ? ( lclick = 0; rclick = 0; dbl = 0; );
) : ( in_tmap = 0; lclick3 = 0; );


// ------- background chunked tasks (detect / classify / overview) -------
auto_det_req && task == 0 ? (
  auto_det_req = 0;
  task = 1; tsk_d = auto_det_d; det_new = 1;
);
task == 1 ? ( // transient detect on deck tsk_d
  det_new ? (
    det_new = 0;
    dk_nsl[tsk_d] = 0;
    tk_buf = dbuf(tsk_d);
    tk_sb = slb(tsk_d);
    det_i = 0; det_env = 0; det_slow = 0.001;
    det_hp = 0;
    det_last = -srate;
    det_gap = floor(0.05 * dk_srate[tsk_d]);
    det_fast = exp(-1/(0.003*dk_srate[tsk_d]));
    det_slowc = 1 - exp(-1/(0.08*dk_srate[tsk_d]));
    det_khp = 1 - exp(-2*$pi*3000/dk_srate[tsk_d]);
    det_thr = 1.2 + (1 - sens) * 6;
    det_bwin = floor(0.015 * dk_srate[tsk_d]);
    det_pre = floor(preroll_ms * 0.001 * dk_srate[tsk_d]);
    // PITCH mode tracks a coarse pitch through zero-crossing density over
    // 30 ms windows and cuts where it moves: on melodic material that lands on
    // note changes a transient detector walks straight past.
    det_pmode = slmode > 1.5;
    det_win = max(64, floor(0.03 * dk_srate[tsk_d]));
    det_zc = 0; det_prev = 0; det_wpos = 0; det_lastz = -1;
    // EQUAL PARTS needs no scan at all: lay the grid down and go to classify
    slmode > 0.5 && slmode < 1.5 ? (
      // SP-МОД ЖЁСТКО ОГРАНИЧИВАЕТ ВОСЕМЬЮ: у SP-1200 восемь голосов, и это
      // не настройка, а устройство аппарата. Ограничение здесь, а не только
      // в слайдере: нарезку зовут и с грида, и из демона.
      dp_n = max(2, min(MAXSL, floor(eqparts + 0.5)));
      dp_k = 0;
      while (dp_k < dp_n) (
        tk_sb[OF_START+dp_k] = floor(dk_frames[tsk_d] * dp_k / dp_n);
        slice_defaults(tsk_d, dp_k);
        dp_k += 1;
      );
      dk_nsl[tsk_d] = dp_n;
      calc_ends(tsk_d);
      msel_only(tsk_d, 0);
      det_i = dk_frames[tsk_d];      // nothing left to scan
      task = 2; cls_new = 1;
    );
  );
  det_pmode && task == 1 ? (
    det_n = min(det_i + 262144, dk_frames[tsk_d]);
    while (det_i < det_n) (
      dpv = (tk_buf[det_i*2] + tk_buf[det_i*2+1]) * 0.5;
      (dpv >= 0) != (det_prev >= 0) ? det_zc += 1;
      det_prev = dpv;
      det_wpos += 1;
      det_wpos >= det_win ? (
        det_lastz >= 0 ? (
          dpr = abs(det_zc - det_lastz) / max(1, max(det_zc, det_lastz));
          dpr > (1.05 - pitchsens) && det_i - det_last > det_gap && dk_nsl[tsk_d] < MAXSL ? (
            tk_sb[OF_START+dk_nsl[tsk_d]] = max(0, det_i - det_win - det_pre);
            slice_defaults(tsk_d, dk_nsl[tsk_d]);
            dk_nsl[tsk_d] += 1;
            det_last = det_i;
          );
        );
        det_lastz = det_zc; det_zc = 0; det_wpos = 0;
      );
      det_i += 1;
    );
    det_i >= dk_frames[tsk_d] ? (
      dk_nsl[tsk_d] == 0 ? ( tk_sb[OF_START] = 0; slice_defaults(tsk_d, 0); dk_nsl[tsk_d] = 1; );
      calc_ends(tsk_d);
      msel_only(tsk_d, 0);
      task = 2; cls_new = 1;
    );
  ) : task == 1 ? (
  det_n = min(det_i + 262144, dk_frames[tsk_d]);
  while (det_i < det_n) (
    dxm = (tk_buf[det_i*2] + tk_buf[det_i*2+1]) * 0.5;
    det_hp += (dxm - det_hp) * det_khp;
    // HF-weighted onset signal: broadband + emphasized high band (hats/snaps)
    dx = abs(tk_buf[det_i*2]) + abs(tk_buf[det_i*2+1]) + 3*abs(dxm - det_hp);
    det_env = max(dx, det_env * det_fast);
    det_slow += (det_env - det_slow) * det_slowc;
    (det_env > det_slow * det_thr && det_env > 0.01 &&
     det_i - det_last > det_gap && dk_nsl[tsk_d] < MAXSL) ? (
      // ОТКАТ К НАЧАЛУ АТАКИ. Раньше искали минимум МГНОВЕННОЙ амплитуды в
      // окне — но сигнал переходит через ноль десятки раз за 15 мс, и
      // минимум попадал в случайный ноль задолго до удара: срез начинался
      // раньше времени и «съедал до» (13 сен).
      //
      // Теперь идём по СГЛАЖЕННОЙ огибающей НАЗАД от точки срабатывания и
      // останавливаемся там, где она падает ниже доли пика атаки. Это и есть
      // момент, когда звук начал расти, а не случайный ноль волны.
      bt0 = max(0, det_i - det_bwin);
      det_last >= 0 ? bt0 = max(bt0, det_last + 64);
      // пик атаки в окне — им нормируем порог отката
      // 27 окт: пик ищется и на 5 мс ВПЕРЁД — срабатывание бывает на подъёме, до пика (порог от недопика уводил назад)
      btend = min(dk_frames[tsk_d] - 1, det_i + floor(0.005 * dk_srate[tsk_d]));
      btmax = 0; bti = bt0;
      while (bti <= btend) (
        btv = abs(tk_buf[bti*2]) + abs(tk_buf[bti*2+1]);
        btv > btmax ? btmax = btv;
        bti += 1;
      );
      // назад по огибающей (однополюсный сглаживатель по модулю), порог 12 %
      // от пика: ниже него звук ещё не начался, выше — уже атака
      // 27 окт: СТОП НА ПЕРВОМ ПРОВАЛЕ. Раньше бралась самая ранняя точка окна выше порога — в брейке хвост
      // прошлого удара почти всегда выше 12 %, и срез уезжал к началу окна (на 15 мс + pre-roll раньше удара)
      btthr = btmax * 0.2;
      btenv = 0; btpos = det_i;
      bti = det_i; bt_go = 1;
      while (bti >= bt0 && bt_go) (
        btv = abs(tk_buf[bti*2]) + abs(tk_buf[bti*2+1]);
        btenv = max(btv, btenv * 0.90);      // назад во времени — быстрый спад
        btenv > btthr ? btpos = bti : bt_go = 0;
        bti -= 1;
      );
      tk_sb[OF_START+dk_nsl[tsk_d]] = max(det_last >= 0 ? det_last + 64 : 0, btpos - det_pre);
      slice_defaults(tsk_d, dk_nsl[tsk_d]);
      dk_nsl[tsk_d] += 1;
      det_last = det_i;
      det_slow = det_env;
    );
    det_i += 1;
  );
  det_i >= dk_frames[tsk_d] ? (
    calc_ends(tsk_d);
    msel_only(tsk_d, dk_nsl[tsk_d] > 0 ? 0 : -1);
    // slicing flows straight into classification: the pads get their colours
    // and the sequencer its class pools without another button press
    dk_nsl[tsk_d] > 0 ? ( task = 2; cls_new = 1; ) : task = 0;
  );
  );
) : task == 2 ? ( // classify slices on deck tsk_d
  cls_new ? (
    cls_new = 0; cls_s = 0; cls_inslice = 0;
    tk_buf = dbuf(tsk_d);
    tk_sb = slb(tsk_d);
  );
  cls_s >= dk_nsl[tsk_d] ? task = 0 : (
    !cls_inslice ? (
      cls_inslice = 1;
      cls_i = tk_sb[OF_START+cls_s];
      cls_lp = 0; cls_lp2 = 0;
      cls_el = 0; cls_eh = 0; cls_et = 0.000000001;
      cls_peak = 0.000000001; cls_lastloud = cls_i;
      // extra features for the wider class set:
      //   zcr      -- zero crossings; low and steady on pitched material,
      //               high on noise, which is what separates a voice from a hat
      //   peakpos  -- where the loudest point sits. A hit peaks immediately,
      //               a swell/reverse/riser peaks late: that is the fx tell
      //   zcvar    -- how much the crossing rate wanders; a steady rate means a
      //               held pitch, a wandering one means noise or a sweep
      cls_zc = 0; cls_prev = 0; cls_peakpos = cls_i;
      cls_zseg = 0; cls_zsegn = 0; cls_zsum = 0; cls_zsq = 0;
      // high band split into attack (first 60 ms) and decay (60..250 ms)
      // windows: their ratio is what tells an open hat from a closed one
      // (QuantumCut's sustain-ratio idea)
      cls_ehe = 0.000000001; cls_ehl = 0.000000001; cls_ne = 1; cls_nl = 1;
      cls_we = floor(0.06 * dk_srate[tsk_d]);
      cls_wl = floor(0.25 * dk_srate[tsk_d]);
      cls_klo = 1 - exp(-2*$pi*180/dk_srate[tsk_d]);
      cls_khi = 1 - exp(-2*$pi*4500/dk_srate[tsk_d]);
    );
    cls_n = min(cls_i + 262144, tk_sb[OF_END+cls_s]);
    while (cls_i < cls_n) (
      cmm = (tk_buf[cls_i*2] + tk_buf[cls_i*2+1]) * 0.5;
      cls_lp += (cmm - cls_lp) * cls_klo;
      cls_lp2 += (cmm - cls_lp2) * cls_khi;
      chh = cmm - cls_lp2;
      cls_el += cls_lp*cls_lp;
      cls_eh += chh*chh;
      cls_et += cmm*cmm;
      cls_o = cls_i - tk_sb[OF_START+cls_s];
      cls_o < cls_we ? ( cls_ehe += chh*chh; cls_ne += 1; )
      : cls_o < cls_wl ? ( cls_ehl += chh*chh; cls_nl += 1; );
      caa = abs(cmm);
      caa > cls_peak ? ( cls_peak = caa; cls_peakpos = cls_i; );
      caa > cls_peak * 0.05 ? cls_lastloud = cls_i;
      // zero crossings, counted in 512-sample segments so their spread can be
      // measured as well as their rate
      (cmm >= 0) != (cls_prev >= 0) ? ( cls_zc += 1; cls_zseg += 1; );
      cls_prev = cmm;
      (cls_i & 511) == 511 ? (
        cls_zsum += cls_zseg; cls_zsq += cls_zseg*cls_zseg;
        cls_zsegn += 1; cls_zseg = 0;
      );
      cls_i += 1;
    );
    cls_i >= tk_sb[OF_END+cls_s] ? (
      rl = cls_el / cls_et;
      rh = cls_eh / cls_et;
      slen = max(1, tk_sb[OF_END+cls_s] - tk_sb[OF_START+cls_s]);
      dlen = (cls_lastloud - tk_sb[OF_START+cls_s]) / dk_srate[tsk_d];
      slsec = slen / dk_srate[tsk_d];
      // crossings per second, and how steady that rate is (0 = rock steady)
      zrate = cls_zc / max(0.001, slsec);
      zmean = cls_zsegn > 0 ? cls_zsum/cls_zsegn : 0;
      zvar  = cls_zsegn > 1 ? sqrt(max(0, cls_zsq/cls_zsegn - zmean*zmean)) / max(1, zmean) : 1;
      ppos  = (cls_peakpos - tk_sb[OF_START+cls_s]) / slen;   // 0 = attack, 1 = tail
      // >0.35 means the highs keep ringing after the attack: open, not closed
      sus = sqrt((cls_ehl/cls_nl) / (cls_ehe/cls_ne));

      // Ordered from the most specific test to the least. A late peak means the
      // sound swells rather than strikes, which no drum hit does -- that is
      // checked first so risers and reverses do not get read as percussion.
      cc = ppos > 0.35 && dlen > 0.25 ? 8 :                       // FX: swell/riser/reverse
           (zvar < 0.30 && zrate < 4000 && rl < 0.5 && dlen > 0.20) ? 7 :  // VOICE: steady pitch, sustained
           rl > 0.4 ? 1 :                                          // KICK
           (rh > 0.45 && dlen < 0.18 && sus <= 0.35) ? 3 :          // closed HAT: highs die with the attack
           (rh > 0.30 && dlen > 0.9) ? 5 :                          // CRASH: long wash
           (rh > 0.40 && sus > 0.35) ? 6 :                          // OPEN HAT / ride: highs sustain
           (rh > 0.30 && dlen > 0.35) ? 6 :                         // RIDE: shorter shimmer
           (rh < 0.45 && rl < 0.4 && dlen < 0.45) ? 2 : 4;          // SNARE else PERC
      tk_sb[OF_CLASS+cls_s] = cc;
      // class bus: kick=1 snare=2 hat=3 perc=4 crash=5, and the three new
      // classes share bus 6 -- there are only six stereo buses to route to
      tk_sb[OF_OUTCH+cls_s] = min(cc, 6);
      cc == 3 ? tk_sb[OF_CHOKE+cls_s] = 1;  // hats auto-choke
      cls_inslice = 0;
      cls_s += 1;
    );
  );
) : task == 3 ? ( // rebuild overviews after project load
  ov_rebuild_step(262144);   // 2 ноя: тело — функцией (её зовёт и @block при закрытом окне)
);

// Each toolbar row is a function so it can be run twice: a dry pass that only
// counts how many lines it wraps onto, then a real pass that draws. That is
// what keeps the measured height and the drawn height identical.
// ЗОНЫ (решение пользователя 13 сен: «зона эффектов и зона управления
// сэмплами, а то всё навалено»). Ряд начинается с подписи зоны — zlab —
// той же механикой потока, что btnw, но без рамки.
//   ряд 1  SAMPLE   rec / arm / load / item        — как звук попадает внутрь
//   ряд 2  SLICE    detect / mode / classify / … / MIDI / names — как режется
//   низ    PLAY     раскладка клавиш, квант, tsync, sync, out, keys + поля
//   низ    FX       all/sel, мастер, mix, фейдер A|B, восемь слотов
//   самый низ       восемь слотов быстрой загрузки с мини-волнами
// Убраны как ненужные: markers (импорт тейк-маркеров), save/favs (.jfkit —
// заменены нативным пресетом и слотами), FX A / FX B (сцены: пути теперь
// параллельные), A>B, LOOP/LOOP>MIDI в панели (дубли TSYNC и MIDI).
// ── ГРУППЫ В РАМКАХ (просьба пользователя 17 сен, переделано 18 сен) ─────
// «Схожие команды паковать в рамки с пометкой».
//
// ПЕРВАЯ ВЕРСИЯ БЫЛА НЕВЕРНА ПО ПОСТРОЕНИЮ (скриншот 18 сен): рамка
// выступала на 3u выше и ниже ряда, а шаг рядов — BTH+3u, то есть рамки
// соседних рядов ПЕРЕСЕКАЛИСЬ на 3u при любом размере окна; подпись сидела
// «верхом на линии» и залезала в строку выше (sync лёг на заголовок play).
// Арп при переносе рвался: кнопка в рамке справа, скорости строкой ниже.
//
// ТЕПЕРЬ:
//  * подпись ВНУТРИ рамки, в потоке, как обычный текст — вверх ничего не
//    торчит;
//  * рамка плотная: 1u сверху и снизу, между рядами остаётся 1u;
//  * зона, которая не влезает в остаток строки, переносится ЦЕЛИКОМ: её
//    ширина известна заранее из сухого прохода (ZWID), перенос внутри зоны
//    остаётся только у зон шире окна — тогда рамка рисуется по строкам.
// НЕ ВЫЗЫВАЕТСЯ с 21 сен (рамки зон сняты). Оставлена как готовый приём:
// прямоугольник, скруглённый самой линией, без гашения фона.
function zbox(x y w_ h_) (
  // скруглена САМОЙ ЛИНИЕЙ (рамка без заливки, гасить нечего): стороны
  // короче на 2 px с каждого конца + пиксель по диагонали в углу
  gfx_rect(x + 2, y, w_ - 4, 1); gfx_rect(x + 2, y + h_ - 1, w_ - 4, 1);
  gfx_rect(x, y + 2, 1, h_ - 4); gfx_rect(x + w_ - 1, y + 2, 1, h_ - 4);
  gfx_rect(x + 1, y + 1, 1, 1); gfx_rect(x + w_ - 2, y + 1, 1, 1);
  gfx_rect(x + 1, y + h_ - 2, 1, 1); gfx_rect(x + w_ - 2, y + h_ - 2, 1, 1);
);

function zlab(y lab) local(tw th zw) (
  // 26 окт: поток, как в DSP трекера — группа не переносится целиком (пустые хвосты рядов),
  // подпись уходит на новую строку только вместе со своей первой кнопкой; подложек групп нет
  gfx_measurestr(lab, tw, th);
  bx > WX && bx + tw + floor(60*u) > W - floor(8*u) ? ( bx = WX; bwrap += 1; );
  z_x0 = bx; z_w0 = bwrap; z_acc = 0; z_seg = bx;
  z_pre = 1;
  !tb_dry ? (
    mcol(z_idx, 1);
    gfx_x = bx; gfx_y = y + bwrap*ROWSTEP + (BTH-th)/2; gfx_drawstr(lab);
  );
  bx += tw + floor(4*u);
);

function zend(y) (
  ZWID[z_idx] = z_acc + (bx - z_seg);
  bx += floor(6*u);   // зазор до следующей группы
  z_idx += 1;
);

function tbrow1() (
zlab(TB1, "");   // 27 окт: подписи SAMPLE нет (просьба)
// Кнопок rec / arm здесь больше нет (25 окт): запись со входа выпилена, её
// место — jf_rec (кольцо + печать куска айтемом на таймлайн, оттуда item).
// LOAD/ITEM go through the daemon (daemon_slixer.lua)
gmem[8] != hb_last ? ( hb_last = gmem[8]; hb_t = time_precise(); );
helper_ok = time_precise() - hb_t < 2;
btnw(TB1, "load", 0) ? (
  helper_ok ? ( gmem[606] = mn_tok; gmem[7] = 1; ) : warn_t = time_precise();
);
btnh("open a file (Finder dialog) - needs the daemon");
btnw(TB1, "item", 0) ? (
  helper_ok ? ( gmem[606] = mn_tok; gmem[7] = 2; ) : warn_t = time_precise();
);
btnh("load the selected item as it sounds (playrate, stretch markers and all)");
row1_end = bx; row1_wrap = bwrap;
bx = WX; bwrap += 1;   // 31 окт: setup load item — своей строкой, остальное ниже

gfr > 0 ? (
  sprintf(#info, "%d Hz  %.2fs  %d slices",
          dk_srate[0], gfr/max(dk_srate[0],1), dk_nsl[0]);
) : (
  strcpy(#info, "empty - LOAD, ITEM, or drop a file");
);
// the info line has its own row (INFOY), so it can never be painted over a
// button that wrapped onto a second line
zend(TB1);

);

// 26 окт: CUT — инструменты слайсера трекера: snap, trim, равные части 2..64, sens − +, mono, follow
function slx_equal(n) local(i) (
  gfr > 0 ? (
    kill_deck(0); dk_nsl[0] = 0; i = 0;
    while (i < n) ( slb(0)[OF_START+i] = floor(i * gfr / n); slice_defaults(0, i); i += 1; );
    dk_nsl[0] = n; calc_ends(0); msel_only(0, 0); auto_det_req = 0;
    sprintf(#seq_msg, "%d equal slices", n); seq_msg_t = time_precise();
  );
);
// trim: тишина в начале и в конце (порог -48 дБ от пика; 5 мс до звука, 20 мс хвоста), как autotrim трекера
function slx_trim() local(bf i pk thr i0 i1 a) (
  gfr > 0 ? (
    bf = dbuf(0); pk = 0; i = 0;
    while (i < gfr) ( a = max(abs(bf[i*2]), abs(bf[i*2+1])); a > pk ? pk = a; i += 1; );
    pk > 0 ? (
      thr = max(0.001, pk * 0.00398);
      i0 = 0; while (i0 < gfr && max(abs(bf[i0*2]), abs(bf[i0*2+1])) < thr) ( i0 += 1; );
      i1 = gfr - 1; while (i1 > i0 && max(abs(bf[i1*2]), abs(bf[i1*2+1])) < thr) ( i1 -= 1; );
      i0 = max(0, i0 - floor(dk_srate[0] * 0.005)); i1 = min(gfr, i1 + floor(dk_srate[0] * 0.02));
      dk_frames[0] = i1; gfr = i1;
      dk_nsl[0] > 0 ? ( slb(0)[OF_START] = max(slb(0)[OF_START], i0); calc_ends(0); );
      sprintf(#seq_msg, "trim: %.3fs from the start, %.2fs long", i0 / max(1, dk_srate[0]), i1 / max(1, dk_srate[0])); seq_msg_t = time_precise();
    );
  );
);
function tbcut(y) local(k n) (
  zlab(y, "CUT");
  btnw(y, "snap", snap_on) ? snap_on = !snap_on;
  btnh("snap: a dragged slice edge sticks to the nearest 1/16 of the loop (the ruler under the wave)");
  btnw(y, "trim", 0) ? slx_trim();
  btnh("trim the silence at the start and the end (-48 dB from the peak, 5 ms before the sound, 20 ms of tail)");
  k = 0;
  while (k < 6) (
    n = k == 0 ? 2 : k == 1 ? 4 : k == 2 ? 8 : k == 3 ? 16 : k == 4 ? 32 : 64;
    btnw(y, sprintf(#cutl, "%d", n), dk_nsl[0] == n) ? slx_equal(n);
    btnh("cut the sample into equal slices");
    k += 1;
  );
  btnw(y, "-", 0) ? sens = max(0.05, sens - 0.05);
  btnh("transient sensitivity down: fewer slices (detect re-runs)");
  btnw(y, "+", 0) ? sens = min(1, sens + 0.05);
  btnh("transient sensitivity up: more slices (detect re-runs)");
  btnw(y, "mono", monomode > 0.5) ? ( monomode = monomode > 0.5 ? 0 : 1; sliderchange(monomode); );
  btnh("mono: one voice, retriggered; off - up to 15 voices");
  btnw(y, "follow", follow_on) ? follow_on = !follow_on;
  btnh("follow: the slice you play becomes the selected one");
btnw(y, "0x", zerox > 0.5) ? (   // 26 окт: Ø нет в битмап-шрифте — пустая кнопка
  zerox = zerox > 0.5 ? 0 : 1; sliderchange(zerox); calc_ends(0);
);
btnh("snap slice starts to the nearest zero crossing: no click on the attack");
  zend(y);
);

function tbrow2() (
zlab(TB2, "");   // 26 окт: подписи SLICE нет — и так ясно
(btnwi(TB2, "detect", task == 1, 'd') || hk_fire == 'd') && gfr > 0 && task == 0 ? ( task = 1; tsk_d = 0; det_new = 1; );
btnh("find transients and cut there. Moving SENS re-runs it immediately");
btnh("run the slicer in the mode chosen beside it");
btnwi(TB2, slmode < 0.5 ? "transient" : slmode < 1.5 ? "equal" : "pitch", 0, 't') || hk_fire == 't' ? (   // 26 окт: t (m — KEYS трекера)
  slmode = slmode + 1 > 2 ? 0 : slmode + 1;
);
btnh("slicing mode: transients (sensitivity), equal parts (how many), or pitch changes (sensitivity)");
// the mode's own parameter, right where the mode is chosen
bx + floor(64*u) > W - floor(8*u) ? zwrap();
!tb_dry ? (
  sprintf(#d, slmode < 0.5 ? "%.2f" : slmode < 1.5 ? "%d" : "%.2f",
          slmode < 0.5 ? sens : slmode < 1.5 ? eqparts : pitchsens);
  slmode < 1.5 && slmode > 0.5 ?
    eqparts = floor(vbtn(50, bx, TB2 + bwrap*ROWSTEP, floor(64*u), BTH, 2, 64, 16, 1, eqparts, "parts", #d)+0.5) :
  slmode < 0.5 ?
    sens = vbtn(51, bx, TB2 + bwrap*ROWSTEP, floor(64*u), BTH, 0.05, 1, 0.5, 0.01, sens, "sens", #d) :
    pitchsens = vbtn(52, bx, TB2 + bwrap*ROWSTEP, floor(64*u), BTH, 0.05, 1, 0.5, 0.01, pitchsens, "sens", #d);   // 27 окт: как поле трекера
  // РЕАКТИВНАЯ ЧУВСТВИТЕЛЬНОСТЬ (решение пользователя 13 сен): подвинул
  // ползунок — нарезка пересчитана сразу, жать detect не надо. Ждём, пока
  // ручку ОТПУСТЯТ (fld_active < 0): пересчёт на каждом пикселе съел бы
  // процессор и мигал бы нарезкой прямо под пальцем.
  det_sens_init ? (
    (sens != det_sens_last || eqparts != det_parts_last || pitchsens != det_psens_last) &&
    fld_active < 0 && task == 0 && gfr > 0 && dk_nsl[0] > 0 ? (
      det_sens_last = sens; det_parts_last = eqparts; det_psens_last = pitchsens;
      task = 1; tsk_d = 0; det_new = 1;
    );
  ) : (
    // первый кадр: запоминаем исходные значения, иначе пересчёт сработает сразу
    det_sens_init = 1;
    det_sens_last = sens; det_parts_last = eqparts; det_psens_last = pitchsens;
  );
);
bx += floor(70*u);
(btnwi(TB2, "classify", task == 2, 'c') || hk_fire == 'c') && dk_nsl[0] > 0 && task == 0 ? ( task = 2; tsk_d = 0; cls_new = 1; );
btnh("guess each slice: kick/snare/hat/perc/crash/ride/voice/fx, and route to class buses");
btnwi(TB2, "auto", auto_det, 'a') || hk_fire == 'a' ? auto_det = !auto_det;
btnh("slice automatically after loading or recording");
btnwi(TB2, "clear", 0, 'x') || hk_fire == 'x' ? ( dk_nsl[0] = 0; msel_only(0, -1); );
btnh("remove every slice marker (the audio stays)");
// btnw(TB2, "markers", 0) && gmem[0] == MAGIC ? import_markers(0);   // убрано: тейк-маркеры никто не шлёт
// GATE. Порог 30 дБ был ЖЁСТКИМ, и на ровном материале кнопка выглядела
// сломанной: в брейке все удары примерно одной громкости, тише порога нет
// ни одного, и нажатие МОЛЧА не делало ничего (жалоба 29 сен «gate не
// нажимается» — он нажимался, просто ноль попаданий).
// Теперь порог по кругу 30 -> 20 -> 12 -> 6 дБ: мелкий шаг доходит до
// материала, где разница между ударами невелика. И ответ ЧЕСТНЫЙ: когда
// ничего не подошло, так и сказано, а не «dropped 0».
(btnwi(TB2, sprintf(#gt_lab, "gate %d", gate_db > 0 ? gate_db : 30), 0, 'g') || hk_fire == 'g') && dk_nsl[0] > 0 ? (
  gate_db <= 0 ? gate_db = 30;
  gate_n = gate_slices(gate_db);
  gate_n > 0 ?
    sprintf(#seq_msg, "gate -%ddB: dropped %d quiet slice%s",
            gate_db, gate_n, gate_n == 1 ? "" : "s") :
    sprintf(#seq_msg, "gate -%ddB: nothing quieter than that - click again for a tighter threshold",
            gate_db);
  // Ничего не подошло — на следующем нажатии порог жёстче. Подошло —
  // возвращаемся к мягкому: иначе второе нажатие срезало бы живое.
  gate_n > 0 ? gate_db = 30 :
    (gate_db == 30 ? gate_db = 20 : gate_db == 20 ? gate_db = 12 :
     gate_db == 12 ? gate_db = 6  : gate_db = 30);
  seq_msg_t = time_precise();
);
btnh("cut slices quieter than N dB below the loudest, OUT OF THE AUDIO. Nothing dropped? click again - the threshold tightens 30/20/12/6. UNDO restores");
// Q ПО ТРАНЗИЕНТАМ: нажатие стартует с ближайшего транзиента, а не с сетки.
// Место здесь, в ряду нарезки: он отвечает на вопрос «по чему попадаем», и
// смотреть на него надо вместе с detect и gate.
btnwi(TB2, "q: trans", qtrans > 0.5, 'r') || hk_fire == 'r' ? ( qtrans = qtrans > 0.5 ? 0 : 1; sliderchange(qtrans); );
btnh("quantize to the material: the hit starts from the nearest transient, not a grid line");
(btnwi(TB2, "undo", 0, 'z') || hk_fire == 'z') && undo_have ? (
  undo_restore();
  strcpy(#seq_msg, "restored the audio and slicing from before the gate");
  seq_msg_t = time_precise();
);
btnh("one step back: restores the audio and slicing from before the last GATE");
// save (.jfkit) и favs убраны: нативный пресет REAPER хранит сэмплы и нарезку,
// слоты внизу — быстрая загрузка. Код kit_save/favs в демоне оставлен.
bx += floor(4*u);   // gap: slicing group | export group
(btnwi(TB2, "midi", 0, 'e') || hk_fire == 'e') && dk_nsl[0] > 0 ? (
  helper_ok ? ( midi_req = 1; midi_req_mode = 0; names_req = 1; gmem[7] = 3; ) : warn_t = time_precise();
);
btnh("write the slice timing as a MIDI item on this track at the edit cursor");
btnwi(TB2, "names", 0, 'n') || hk_fire == 'n' ? (
  helper_ok ? ( names_req = 1; gmem[7] = 4; ) : warn_t = time_precise();
);
btnh("write MIDI note names onto this track so the piano roll shows what each key does");
// 27 окт: sync — сразу за names, как в DSP трекера (было в CUT)
tbm = btnmk(TB2, dk_sync[0] == 0 ? "sync: off" : dk_sync[0] == 1 ? "sync: pitch" : "sync: str",
     dk_sync[0] > 0, "off|pitch (repitch)|str (granular stretch)", 's');
tbm > 0 ? dk_sync[0] = tbm - 1;
btnh("fit the loop to whole beats at project tempo: PITCH = repitch, STR = granular stretch");
zend(TB2);
);

// PLAY — кнопки зоны внизу окна (над полями голоса)
// 26 окт: группы SYNC нет — sync и 0x в CUT (сэмпл и темп), q в MIDI, thru в ARP

function tbrowM(y) (
zlab(y, "MIDI");
// 26 окт: q (из SYNC) — время входящих нот
strcpy(#qn, qgrid == 0 ? "q: off" : qgrid == 1 ? "q: 1/32" : qgrid == 2 ? "q: 1/16T" :
             qgrid == 3 ? "q: 1/16" : qgrid == 4 ? "q: 1/8T" : qgrid == 5 ? "q: 1/8" : "q: 1/4");
tbm = btnmk(y, #qn, qgrid > 0, "off|1/32|1/16 T|1/16|1/8 T|1/8|1/4", 'q');
tbm > 0 ? qgrid = tbm - 1;
btnh("input quantize: incoming notes wait for the next grid line");
tbm = btnmk(y, keysmode < 0.5 ? "chrom" : keysmode < 1.5 ? "piano" : "class",
     keysmode > 0.5, "chrom (one slice, whole keyboard)|piano (slice per key)|class (slices grouped by class)", 'p');
tbm > 0 ? keysmode = tbm - 1;
btnh("CLASS: white = kick C2, snare D2, hat E2...  black = the SAME slice reversed.  Octave up: white plays the loop from that hit, black sets the ARP rate (1/4 1/8 1/8T 1/16 1/32)");
btnw(y, "tala", talas_on > 0.5) ? talas_on = talas_on > 0.5 ? 0 : 1;
btnh("tala map: 31 rhythmic cycles, ready patterns and groove import");
btnwi(y, "keys", keys_on, 'k') || hk_fire == 'k' ? keys_on = !keys_on;
btnh("computer keyboard as MIDI: q-row plays slices. Needs window focus");
// VEL — полное игнорирование динамики, и рядом с ним значение, которым
// играть (решение пользователя 13 сен). Поле показывается только когда
// режим включён: выключенная настройка рядом с выключенной кнопкой — шум.
btnwi(y, velfix ? "vel: fix" : "vel", velfix, 'v') || hk_fire == 'v' ? velfix = !velfix;
btnh("ignore incoming velocity and play every hit at the fixed value beside it");
velfix ? (
  // ПЕРЕНОС СЧИТАЕТСЯ И В СУХОМ ПРОХОДЕ: поле рисуется только в реальном,
  // но курсор двигается всегда — иначе измеренная и нарисованная высота
  // строки разойдутся, и кнопки наедут друг на друга.
  bx + floor(54*u) > W - floor(8*u) ? zwrap();
  !tb_dry ? (
    sprintf(#d, "%d", floor(velval + 0.5));
    // ПЕРЕНОС СТРОКИ ПЕРЕД ПОЛЕМ. btnw проверяет край только для СЕБЯ, а
    // поля ufield в этом ряду рисовались по текущему bx без проверки —
    // на узком окне они вылезали за край и ложились на соседей
    // (скриншот 14 сен: «at 100» поверх кривой, «base» поверх «ch»).
    bx + floor(54*u) > W - floor(8*u) ? zwrap();
    velval = floor(ufield(53, bx, y + bwrap*ROWSTEP, floor(54*u), BTH, 1, 127, 100, 0, velval, "at", #d) + 0.5);
  );
  bx += floor(60*u);
);
// КРИВАЯ АФТЕРТАЧА — маленьким графиком рядом с VEL: обе настройки про
// то, КАК прибор отвечает на нажатие, и стоять должны вместе.
bx + floor(34*u) > W - floor(8*u) ? zwrap();
!tb_dry ? (
  atcurve = atgraph(bx, y + bwrap*ROWSTEP, floor(34*u), BTH, atcurve);
  // ЖИВОЕ ДАВЛЕНИЕ поверх кривой: вертикальная метка едет по графику.
  // Вопрос «почему стретч не работает» без неё не решается: не видно,
  // приходит ли афтертач вообще (его режут плагины перед слайсером и сами
  // клавиатуры, если он выключен в их настройках). Тусклая метка = давление
  // пришло, но заглушено ролью педали STR при отпущенной педали.
  at_in > 0.003 ? (
    pset(3);
    gfx_rect(bx + 1 + floor(at_in * (floor(34*u) - 4)), y + bwrap*ROWSTEP + 1, 2, BTH - 2);
  );
);
bx += floor(40*u);
// канал и базовая нота — сюда же, из полей внизу
bx + floor(58*u) > W - floor(8*u) ? zwrap();
!tb_dry ? (
  mcha < 0.5 ? strcpy(#d, "omni") : sprintf(#d, "%d", floor(mcha+0.5));
  mcha = floor(ufield(26, bx, y + bwrap*ROWSTEP, floor(58*u), BTH, 0, 16, 0, 1, mcha, "ch", #d)+0.5);
);
bx += floor(64*u);
bx + floor(58*u) > W - floor(8*u) ? zwrap();
!tb_dry ? (
  sprintf(#d, "%d", floor(basenote_a+0.5));
  basenote_a = floor(ufield(25, bx, y + bwrap*ROWSTEP, floor(58*u), BTH, 0, 127, 48, 0, basenote_a, "bas", #d)+0.5);
);
bx += floor(64*u);
zend(y);
// зазор групп — в zend (26 окт)
// ── ЗОНА ARP ──────────────────────────────────────────────────────────────
// Держишь несколько пэдов — они играют по очереди в темп. Включается
// педалью (роль выбирается тут же), скорость задаётся КНОПКАМИ и крутится
// модколесом: семь ступеней, по колесу снизу вверх.
zlab(y, "ARP");
btnwi(y, arp_on ? "arp: on" : "arp", arp_on, 'b') || hk_fire == 'b' ? (
  arp_on = !arp_on;
  !arp_on ? ( arp_note >= 0 ? release_note(arp_note); arp_note = -1; arp_clear(); );
);
// 26 окт: thru (из SYNC) — как и ARP, одна нота превращается в последовательность
btnwi(y, (playthru || ped_thru) ? "thru: on" : "thru", playthru || ped_thru, 'h') || hk_fire == 'h' ? playthru = !playthru;   // 26 окт: h (t — режим нарезки)
btnh("release a pad and the following slices keep playing in order - in tempo when SYNC is on. The sustain pedal (CC64) turns this on while held");
btnh("hold several pads and they play in turn, in tempo. The pedal turns this on; the mod wheel sets the rate");
// СКОРОСТЬ — ВЫПАДАШКА (21 сен). Семь кнопок в ряд занимали ~200 px ради
// одной величины, и шесть из них всегда были «не то». Значение читается с
// самой кнопки, список — по клику. Ряд арпа стал вчетверо короче.
arp_rate == 0 ? strcpy(#arl, "1/1") : arp_rate == 1 ? strcpy(#arl, "1/2") :
arp_rate == 2 ? strcpy(#arl, "1/4") : arp_rate == 3 ? strcpy(#arl, "1/8") :
arp_rate == 4 ? strcpy(#arl, "1/8T") : arp_rate == 5 ? strcpy(#arl, "1/16") :
                strcpy(#arl, "1/32");
tbm = btnm(y, #arl, arp_on, "1/1|1/2|1/4|1/8|1/8T|1/16|1/32");
tbm > 0 ? ( arp_rate = tbm - 1; sliderchange(slider34); );
btnh("arp rate. The mod wheel sets it too, while playing");
// порядок обхода
arp_mode < 0.5 ? strcpy(#arm, "up") : arp_mode < 1.5 ? strcpy(#arm, "down") :
arp_mode < 2.5 ? strcpy(#arm, "up-down") : arp_mode < 3.5 ? strcpy(#arm, "random") :
                 strcpy(#arm, "as played");
tbm = btnm(y, #arm, 0, "up|down|up-down|random|as played");
tbm > 0 ? ( arp_mode = tbm - 1; sliderchange(slider35); );
btnh("order the held pads are played in");
// роль педали
// роль STR убрана: в старых проектах она читается как thru
arp_pedal > 2.5 ? ( arp_pedal = 0; sliderchange(slider37); );
strcpy(#arp_, arp_pedal < 0.5 ? "ped: thru" : arp_pedal < 1.5 ? "ped: hold" : "ped: latch");
tbm = btnm(y, #arp_, arp_pedal > 0.5, "thru (as before)|hold (arp runs while pressed)|latch (pedal toggles the arp)");
tbm > 0 ? ( arp_pedal = tbm - 1; sliderchange(slider37); );
btnh("what the sustain pedal does: THRU as before, HOLD runs the arp while pressed, LATCH toggles it. Aftertouch stretch is always on, no pedal needed");
// длина ноты
!tb_dry ? (
  bx + floor(58*u) > W - floor(8*u) ? zwrap();
  sprintf(#d, "%d%%", floor(arp_gate*100+0.5));
  arp_gate = ufield(54, bx, y + bwrap*ROWSTEP, floor(58*u), BTH, 0.05, 1, 0.5, 0, arp_gate, "gate", #d);
);
bx += floor(64*u);
zend(y);
// зазор групп — в zend (26 окт)
tbm = btnmk(y, outmode < 0.5 ? "out: mix" : outmode < 1.5 ? "out: class" : "out: slice", outmode > 0.5,
     "mix on 1/2|class buses: mix on 1/2 plus each class on 3/4..13/14|slice per channel: slice N -> mono channel N (container does the rest)", 'o');
tbm > 0 ? outmode = tbm - 1;
// Канал выделенного среза — РЯДОМ с режимом, в видимом ряду. Раньше он жил
// в зоне на месте слотов, а та лежит глубоко в блоке матрицы модуляции и на
// обычной высоте окна просто не рисуется: поле было, но его никто не видел.
// Правило «одно место на инструмент»: решение про выход принимается здесь.
outmode > 1.5 && gsel >= 0 && gsel < dk_nsl[0] ? (
  sprintf(#oc_l, "ch %d", floor(gsb[OF_OUTCH+gsel] + 0.5));
  btnw(y, #oc_l, 0) ? (
    // клик по кругу внутри первых восьми: дальше — поле в зоне среза
    ov = gsb[OF_OUTCH+gsel];
    gsb[OF_OUTCH+gsel] = (floor(ov + 0.5) + 1) > 8 ? 0 : floor(ov + 0.5) + 1;
    apply_set(0, OF_OUTCH, ov, gsb[OF_OUTCH+gsel]);
  );
  btnh("output channel of the selected slice: 0 = its own number, 1-8 by clicking. The container picks it up from there");
);
// ── ЗОНА ARTIC: восемь артикуляторов (21 сен) ────────────────────────────
// Артикулятор — это СНИМОК ВСЕГО ИНСТРУМЕНТА, надетый на кнопку. Он живёт
// рядом с ARP, потому что это соседи по смыслу: и то, и другое — «как
// играется», а не «как звучит один удар».
//
// В окне он нужен для ЗАПИСИ и проверки; играют им с грида (ряд 7,
// клетки 9-16), где жест мгновенный. Поэтому здесь клик = надеть/снять
// защёлкой, а не «пока держишь»: мышь держать неудобно, и это не тот
// инструмент, которым играют.
// зазор групп — в zend (26 окт)
zlab(y, "ARTIC");
arti = 0;
while (arti < ART_N) (
  art_at(arti)[ART_W-1] > 0.5 ?
    (arti == 0 ? strcpy(#artl, "arp") : arti == 1 ? strcpy(#artl, "soft") :
     arti == 2 ? strcpy(#artl, "stac") : sprintf(#artl, "a%d", arti + 1)) :
    sprintf(#artl, "%d", arti + 1);
  btnwi(y, #artl, art_cur == arti, '1' + arti) || hk_fire == '1' + arti ? (
    // SHIFT+клик = записать сюда текущее состояние, ALT+клик = стереть.
    // Модификаторы, а не отдельные кнопки: восемь слотов уже занимают ряд,
    // а «save» и «clear» рядом с каждым дали бы двадцать четыре кнопки.
    (mouse_cap & 8)  ? art_save(arti) :
    (mouse_cap & 16) ? art_clear(arti) :
    art_cur == arti  ? ( art_off(); art_latch = 0; )
                     : ( art_on(arti); art_latch = 1; );
  );
  btnh("articulator: a snapshot of the whole instrument on one button. Click to wear it, click again to take it off. SHIFT+click saves what you hear into this slot, ALT+click clears it. On the grid (row 7, cells 9-16) it works under the finger: hold for an accent, hold past 400 ms to latch");
  arti += 1;
);
zend(y);
);

// ФЕЙДЕР A|B — баланс двух параллельных путей эффектов; своя строка в зоне FX.
// Справа кнопка wreck (случайная окраска пути B).
function xfader(y) local(xfx xfw xtrh xtry hx hkw wbw wbh) (
  gfx_measurestr("wreck", wbw, wbh); wbw = floor(wbw + 9*u);
  pseta(4, 0.65);
  gfx_x = WX; gfx_y = y + (BTH-xlh)/2; gfx_drawstr("A");
  xfx = WX + xlw + floor(8*u);
  xfw = W - WX - wbw - floor(10*u) - xlw - floor(6*u) - xfx;
  gfx_x = xfx + xfw + floor(6*u); gfx_y = y + (BTH-xlh)/2; gfx_drawstr("B");
  xtrh = max(4, floor(10*u));
  xtry = y + (BTH - xtrh)/2;
  pseta(1, 1);
  gfx_rect(xfx, xtry, xfw, xtrh);
  pseta(4, 0.40);
  gfx_rect(xfx,xtry,xfw,1); gfx_rect(xfx,xtry+xtrh-1,xfw,1);
  hx = xfx + xfade*xfw;
  hkw = max(4, floor(8*u));
  pset(2);
  gfx_rect(hx-hkw/2, y, hkw, BTH);
  (lclick && mouse_x >= xfx-hkw && mouse_x < xfx+xfw+hkw && mouse_y >= y && mouse_y < y+BTH) ? xf_drag = 1;
  xf_drag && (mouse_cap & 1) ? (
    xfade = min(1, max(0, (mouse_x - xfx)/xfw));
    dbl ? xfade = 0.5;
  );
  xf_drag && !(mouse_cap & 1) ? xf_drag = 0;
  mouse_x >= xfx && mouse_x < xfx+xfw && mouse_y >= y && mouse_y < y+BTH ?
    tip("balance between path A (filt sat crush comp) and path B (ring fold bite dust); double-click = centre");
  btn(W - WX - wbw, y, wbw, BTH, "wreck", 0) && task == 0 ? scene_wreck_b();
  mouse_x >= W - WX - wbw && mouse_y >= y && mouse_y < y+BTH ?
    tip("fill path B with random colour - the fader then sweeps clean to wrecked");
);

// Подпись зоны в панели: слово слева и тихая линия до правого края.
// Подпись зоны БЕЗ ЛИНИИ (21 сен): линия во всю ширину окна тянулась от
// каждой подписи и резала окно поперёк. Заголовок и так стоит один в своей
// строке — этого хватает, чтобы он читался как заголовок.
function zcap(y lab m) local(tw th) (
  gfx_measurestr(lab, tw, th);
  mcol(m, 1); gfx_x = WX; gfx_y = y + (ZH - th)/2; gfx_drawstr(lab);
);

// 8 СЛОТОВ БЫСТРОЙ ЗАГРУЗКИ — самый низ окна, плитки с мини-волной (как
// карточки в менеджере проектов). Слот = путь к сэмплу:
//   клик            загрузить (через демон)
//   shift+клик      положить ТЕКУЩИЙ сэмпл в слот
//   alt+клик        очистить
//   drag&drop       положить файл в слот и сразу загрузить
// Мини-волну считает демон (cmd 7) и кладёт в gmem[QSPK]; запрашиваем по
// одному слоту за кадр и только когда gmem[7] свободен.
function qslots(y) local(psw gpi ppx pflag phit pnw pnh wvy wvh ci cx_ cw_ pk qlw qlh) (
  // 27 окт: подпись ряда — quickload:
  gfx_measurestr("quickload:", qlw, qlh);
  pseta(4, 0.6); gfx_x = WX; gfx_y = y + (QSH - qlh)/2; gfx_drawstr("quickload:");
  qlw += floor(8*u);
  psw = floor((WW - qlw - 7*floor(3*u)) / 8);
  // запрос превью: один слот за кадр
  gpi = 0;
  while (gpi < 8) (
    qs_dirty[gpi] && helper_ok && gmem[7] == 0 ? (
      strlen(QS0 + gpi) > 0 ? (
        gmem[QSREQ] = gpi;
        path_send_cmd(QS0 + gpi, 7);   // 26 окт: сразу 7 — превью, не загрузка
      ) : ( ci = 0; while (ci < QSW) ( gmem[QSPK + gpi*QSW + ci] = 0; ci += 1; ); );
      qs_dirty[gpi] = 0;
    );
    gpi += 1;
  );
  gpi = 0;
  while (gpi < 8) (
    ppx = WX + qlw + gpi*(psw + floor(3*u));
    pflag = strlen(QS0 + gpi) > 0;
    phit = mouse_x >= ppx && mouse_x < ppx+psw && mouse_y >= y && mouse_y < y+QSH;
    pflag ? pseta(1, 0.85) : pseta(1, 0.5);
    phit ? pseta(1, 1);
    gfx_rect(ppx, y, psw, QSH);
    pseta(4, 0.30);
    gfx_rect(ppx,y,psw,1); gfx_rect(ppx,y+QSH-1,psw,1);
    gfx_rect(ppx,y,1,QSH); gfx_rect(ppx+psw-1,y,1,QSH);
    rcorn(ppx, y, psw, QSH, 0.30);
    // 27 окт: одна строка, как плитка в шапке модуля DSP трекера: мини-волна во всю высоту — тускло, имя поверх
    wvy = y + floor(2*u); wvh = QSH - floor(4*u);
    pflag && wvh > 3 ? (
      cw_ = (psw - floor(6*u)) / QSW;
      ci = 0;
      pseta(2, phit ? 0.55 : 0.35);
      while (ci < QSW) (
        pk = min(1, max(0, gmem[QSPK + gpi*QSW + ci]));
        cx_ = ppx + floor(3*u) + ci*cw_;
        gfx_rect(cx_, wvy + wvh/2 - pk*wvh/2, max(1, cw_ - 1), max(1, pk*wvh));
        ci += 1;
      );
    );
    // имя поверх, обрезанное до влезающих букв
    pflag ? pset(4) : pseta(4, 0.45);
    pflag ? path_base(QS0 + gpi, #pn) : sprintf(#pn, "%d", gpi+1);
    gfx_measurestr(#pn, pnw, pnh);
    while (pnw + floor(6*u) > psw && strlen(#pn) > 1) (
      strcpy_substr(#pn2, #pn, 0, strlen(#pn) - 1); strcpy(#pn, #pn2);
      gfx_measurestr(#pn, pnw, pnh);
    );
    gfx_x = ppx + floor(3*u); gfx_y = y + (QSH - pnh)/2;
    gfx_drawstr(#pn);
    // ДРОП НА СЛОТ (в том числе из Media Explorer): путь уже пойман общим
    // обработчиком наверху, здесь только смотрим, попала ли точка броска в
    // эту плитку. drop_req гасим, чтобы файл не ушёл заодно и в буфер.
    drop_req && drop_x >= ppx && drop_x < ppx+psw && drop_y >= y && drop_y < y+QSH ? (
      drop_req = 0;
      strcpy(QS0 + gpi, #droppath); qs_dirty[gpi] = 1; qs_ver += 1;
      helper_ok ? path_send(QS0 + gpi) : load_sample(0, QS0 + gpi);
    );
    phit && lclick ? (
      (mouse_cap & 8) ? ( path_recv(210); strcpy(QS0 + gpi, 210); qs_dirty[gpi] = 1; qs_ver += 1; ) :
      (mouse_cap & 16) ? ( strcpy(QS0 + gpi, ""); qs_dirty[gpi] = 1; qs_ver += 1; ) :
      pflag ? ( helper_ok ? path_send(QS0 + gpi) : load_sample(0, QS0 + gpi); ) : 0;
    );
    phit ? tip("quick slot: click = load, shift+click = store current sample, alt+click = clear, drop a file = store and load");
    gpi += 1;
  );
);


// ---------------- layout ----------------
// TB1/TB2 = toolbar row tops, BTH = standard button height. Embedded views keep
// only the toolbar and the waveform, so the pad/param rows are skipped below.
// КОМПАКТНЕЕ (25 окт, просьба пользователя «все кнопки компактно»): 20u -> 17u.
// При US = 1.5 это 30 -> 25 px: подпись и хоткей помещаются, а ряд перестаёт
// быть вдвое выше своего текста. Трекер плотный именно так — размер от
// содержимого, а не фиксированное число, умноженное на масштаб.
BTH = gfx_texth + 5;   // 25 окт: высота кнопки — от строки битмапа, как ряд трекера
WX = floor(8*u);
WW = W - WX*2;
// ОТСТУПЫ ПАНЕЛЕЙ: от рамки до органов MPY по вертикали и MPX по
// горизонтали. Шаг рядов считает панель целиком + 3u между панелями
// соседних рядов — пересечься они не могут по построению (утренняя версия
// рамок пересекалась на 3u при любом размере окна).
MPY = 2; MPX = floor(4*u);   // 25 окт: отступы панелей плотнее (битмап)
ROWSTEP = BTH + MPY*2 + floor(2*u);

// Toolbars wrap, so their height is not known until the labels are measured.
// Measuring here (same strings, same font as the draw below) lets the rows
// underneath start in the right place instead of being overlapped by a wrapped
// button. tbrows() returns how many rows a list of labels needs at this width.
// Three toolbar rows, grouped by what they do:
//   row 1  SOURCE   load/record/slice the audio, export it
//   row 2  PLAY     keyboard, quantize, transport lock, sync, routing, setup
//   row 3  SCENES   preset strip, FX A/B, A>B, WRECK B, and the morph fader
// Row 3's preset strip and fader have fixed widths, so they are reserved
// below. Each row is measured by RUNNING IT with tb_dry set -- drawing
// nothing, only advancing the cursor -- so the counted height and the drawn
// height cannot drift apart the way a parallel list of labels did.
gfx_measurestr("A", xlw, xlh);
QTOP = 0;   // 31 окт: слоты быстрой загрузки — снова в самом низу (просьба); сверху — setup load item строкой
TB1 = MPY + floor(2*u) + QTOP; TB2 = TB1;        // dry pass only needs the cursor
tb_dry = 1;
// Кнопка setup — ВНЕ потока кнопок: поток двигает bx и переносит строки,
// поэтому «угол» внутри него получить нельзя, соседи сдвинут. Явные
// координаты + сдвиг начала потока на её ширину.
gfx_measurestr("setup", scw_, sch_);
SETUPW = floor(scw_ + 9*u);
SETUPOFF = SETUPW + floor(6*u);

// ДВА СУХИХ ПРОХОДА: первый меряет ширины зон (ZWID), второй считает
// строки уже С УЧЁТОМ переноса зон целиком — теми же ширинами, что увидит
// рисующий проход. С одним проходом счёт строк отставал бы на кадр каждый
// раз, когда подпись кнопки меняет ширину («arp» -> «arp: on»).
dry_i = 0;
while (dry_i < 2) (
  z_idx = 0; bx = WX + SETUPOFF; bwrap = 0; TB2 = TB1; tbrow1(); tbrow2(); tbcut(TB1); TB1ROWS = bwrap + 1;   // 26 окт: один поток
  TB2ROWS = 0; PROWS = 0;
  bx = WX; bwrap = 0; tbrowM(0); MROWS = bwrap + 1;   // 26 окт: нижний поток (MIDI ARP ARTIC)
  dry_i += 1;
);
tb_dry = 0;

TB1 = MPY + floor(2*u) + QTOP;        // панель первого ряда не вылезает за верх окна; над ней — слоты
TB2 = TB1;   // 26 окт: все группы одним потоком от TB1
// ── PLAY НАВЕРХ, НАД СЛАЙСАМИ (просьба 21 сен) ───────────────────────────
// SYNC · MIDI · ARP стояли под панелью параметров, в трёхстах пикселях от
// кнопок SAMPLE и SLICE, с которыми они в одном ряду по смыслу: всё это
// НАСТРОЙКА инструмента, а не правка среза. Параметры среза (pitch, ADSR,
// стретч, слоты) внизу — они про «этот удар»; настройки вверху — про «весь
// инструмент». Разделение по смыслу, а не по истории файла.
TB3 = TB1;
// 27 окт: строки сведений над волной нет — «44100 Hz 8.46s 22 slices» в ряду select под волной (как в DSP трекера)
WY = TB1 + TB1ROWS*ROWSTEP + floor(3*u);
// pads are one strip under the waveform, each as wide as its own slice
// 26 окт: ПЭДОВ НЕТ — они повторяли срезы волны; всё, что умели пэды
// (послушать, shift-выделение, мьют, высота протяжкой), делает сама волна
padh = 0;
PH = 0;
// One formula for the parameter block, reused by the rows that draw it, so the
// reserved height and the actual row positions cannot drift apart.
FGAP = max(2, floor(4*u));
// ── ПОТОЛКИ ШИРИНЫ (просьба пользователя 18 сен, по Aalto/Kaivo) ─────────
// «Слайдеры плотнее рядом, менее горизонтально раскидывать».
// БЫЛО: ширина считалась как «сколько осталось» (ow = остаток/4), и при
// окне 1180 px поле раздувалось до 219 px, хотя содержимого в нём на 56 —
// 652 px пустой дорожки в одном ряду (посчитано, а не на глаз).
// СТАЛО: модуль занимает СВОЙ размер, лишнее остаётся полем между
// группами — ровно так устроены Aalto и Kaivo. Глаз ловит группу целиком,
// а не прочёсывает строку от края до края.
// Числа: подпись три буквы (~24 px) + значение до шести знаков (~44 px) +
// поля 16 px = 84; берём 96 как удобный потолок с запасом на «1/8T».
// ПОТОЛКИ ПО СОДЕРЖИМОМУ, А НЕ «НА ГЛАЗ» (19 сен). Виджет рисует подпись
// у левого края и значение у правого; лишняя ширина уходит в РАЗРЫВ МЕЖДУ
// ними — на скриншоте это 60-80 px пустоты внутри каждой полосы.
// Считаем, сколько нужно: моноширинный ≈ 0.6 кегля на символ, самые длинные
// пары — «atk 999 ms» и «siz 120 ms», это 10 символов + поля.
// xlw — ШИРИНА символа «A», замерена строкой выше (gfx_texth это ВЫСОТА
// строки, она в полтора раза больше ширины: на ней формула врала в плюс).
// Самая длинная пара «atk 999 ms» = 10 символов, плюс поля 10u.
FLDMAX = floor(xlw*10) + floor(10*u);   // поле ufield
KNMAX  = floor(xlw*9)  + floor(10*u);   // полоса knob
// Ручке нужно три яруса: подпись, дорожка, значение. Тридцати пикселей на
// это мало — подпись и значение наезжали бы друг на друга.
// РЯД РУЧЕК СТАЛ ВДВОЕ НИЖЕ (14 сен): подпись и значение переехали ВНУТРЬ
// дорожки, три этажа схлопнулись в один. Было 46, стало 26 — и зона
// перестала занимать место под воздух.
// ── КОМПАКТНО (просьба пользователя 19 сен: «меньше визуальной пустоты») ─
// Ряд был 26u при полосе 20u — шесть пикселей воздуха внутри ряда, поверх
// которых шли ещё отступы панели. Теперь ряд = полоса + 2u; воздух даёт
// ТОЛЬКО панель модуля, и он один, а не в три слоя.
PR_R1 = floor(22*u);     // ряд компактных ручек + график ADSR
// ВТОРАЯ СТРОКА — PRECALC (14 сен). Десять ручек уже занимают всю ширину;
// впихнуть ещё четыре значило бы сузить каждую на треть и сделать
// нечитаемыми. Отдельная строка честнее: группа отделена визуально, а
// зона вырастает — FX и PLAY считаются от неё и уедут вниз сами.
PR_RP = floor(22*u) + floor(2*u);
MSH   = floor(12*u);     // modulation shape chips under each fx slider
PR_R2 = floor(44*u) + MSH + floor(3*u);   // fx mini sliders + their chips
PR_R3 = floor(22*u);     // stretch buttons + routing
PR_F  = floor(26*u);     // PLAY: поля голоса
PR_RX = floor(26*u);     // FX: all/sel, мастер M1 M2, FX MIX, FX D/W
PR_XF = 0;               // фейдера A|B больше нет: путей нет

// ── ВЫСОТА ЗОНЫ FX СЧИТАЕТСЯ ОТ СОДЕРЖИМОГО (14 сен) ──────────────────────
// Раньше MXH было равно 40*u «на глаз», а панель параметров справа рисовала
// три поля по PR_RX (26*u) плюс строку D/W — до 104*u в зону высотой 40.
// Панель вылезала вниз и НАКЛАДЫВАЛАСЬ на зону PLAY (скриншот 14 сен:
// «mix» поверх «at / ch omni / base»).
//
// Лечим не сдвигом, а ПРИЧИНОЙ: зона обязана быть не ниже того, что в ней
// нарисовано. Тогда PLAY уезжает вниз сама, и наложение становится
// невозможным при любой ширине окна, а не исправленным на одном размере.
//
// Число колонок панели считаем ЗДЕСЬ и кладём в переменную: отрисовка берёт
// её же. Две копии формулы разошлись бы при первой правке — ровно так
// разъехался фильтр гранулятора, живший в трёх местах.
// ── FX: ЯЧЕЙКИ СТОЛБИКОМ слева, ПАРАМЕТРЫ выбранной — столбиком справа
// (15 сен, просьба пользователя). Ряд ячейки и ряд полосы — одна высота
// PR_R1: ячейка и её ручка стоят на одной горизонтали, глаз не прыгает.
// Четыре ряда с обеих сторон: 4 ячейки слева, amt · P2 · mix · c/w справа.
FXCW  = floor(110*u);                        // ширина ячейки цепи
FXRH  = PR_R1 + floor(3*u);                  // шаг ряда
PANX  = WX + FXCW + floor(16*u);             // полосы параметров справа
PANW  = WX + WW - PANX;
PCOLS = 1;
PCW   = min(PFMAX, PANW);                    // полоса не шире потолка: см. ниже
MXH   = 0;                                   // зоны FX больше нет
ZH    = gfx_texth + floor(4*u);   // строка-подпись зоны
// Три зоны под пэдами, сверху вниз: SLICE (выделенный срез) → FX → PLAY.
// Ряда рендера/запекания больше нет (18 сен): зона slice = ручки + rnd/sta + str.
// ВЕРТИКАЛИ ЗОНЫ SLICE — здесь и только здесь; отрисовка читает эти же
// числа (две копии формулы уже разъезжались: ряд str ложился под precalc).
SL_R1 = ZH + MPY + floor(4*u);                  // ряд 1: ручки среза + панель ADSR (над ней заголовок)
SL_R2 = SL_R1 + PR_R1 + MPY + floor(6*u);       // ряд 2: rnd · zoom · sta · rst
SL_SA = SL_R2 + PR_R1 + MPY*2 + floor(8*u);     // панель STRETCH, ряд алгоритмов
SL_SB = SL_SA + PR_R3 + FGAP;                   //                 ряд коэффициентов
FX_OFF = SL_SB + PR_R3 + MPY + floor(10*u);
// ЗОНА FX: подпись + ряд ИМЁН четырёх модулей + ряд их РУЧЕК
FXZH   = ZH + MPY + floor(2*u) + PR_R1 + floor(2*u) + PR_R1 + MPY + floor(10*u);
// Параметры ячейки переехали ВПРАВО от графа, поэтому отдельной строки под
// ним больше нет: зона FX = подпись + граф + фейдер A|B.
// ЗОНА MOD: два ряда по четыре кабеля + ряд LFO
// Зона MOD стала ТАБЛИЦЕЙ (21 сен): шапка + восемь строк по 16u + ряд LFO.
// Формула повторяет ту, по которой панель рисуется, — иначе зарезервированная
// высота разойдётся с нарисованной, как это уже случалось с рядами тулбара.
MODZH  = ZH + MPY + floor(2*u) + (gfx_texth + floor(2*u)) + 5*floor(16*u)
         + floor(3*u) + MPY + floor(10*u);
MOD_OFF = FX_OFF + FXZH;
// PLAY уехал в верхний тулбар, поэтому в панели его зоны больше нет:
// slice -> fx -> mod -> (превью слотов)
PL_OFF = MOD_OFF + MODZH;
PF_OFF = PL_OFF;
PRH = PF_OFF + PR_F + floor(6*u);
// 26 окт: панель — секции колонками, как модуль DSP трекера; высота — самая высокая колонка
PNRH = BTH;
PNG = floor(12*u);
pn_h0 = 10; pn_h1 = 9; pn_h2 = 6; pn_h3 = 6; pn_h4 = 6; pn_h5 = 13;   // mono — в CUT   // срез, adsr, stretch, out, voice, mod
pn_nmax = max(1, floor((WW + PNG) / (floor(170*u) + PNG)));
pn_lim = 13;
while (pn_cols(pn_lim) > pn_nmax && pn_lim < 51) ( pn_lim += 1; );
pn_nc = pn_cols(pn_lim);
pn_cw = floor((WW - (pn_nc - 1) * PNG) / pn_nc);
PRH = pn_lim * PNRH + floor(4*u);
// слоты-превью в самом низу, над строкой статуса (в TCP не рисуем)
QSH = embedded ? 0 : BTH + floor(2*u);   // 27 окт: одна строка (имя поверх мини-волны), наверху окна
QSRES = QSH;   // 31 окт: строка слотов внизу — место под неё
SELH = BTH + floor(4*u);
STATH = floor(20*u);            // status line at the bottom
WMIN = floor(60*u);
// How much vertical room the rows below the waveform need. If the view is too
// short for all of them, drop them from the bottom up rather than drawing past
// the edge -- show_pads/show_panel gate the drawing further down. This applies
// to the TCP the same as to the plugin window: a tall enough track strip gets
// the pads and the fx panel, a thin one keeps just the waveform.
// ── ПОЛОСЫ ПОД СРЕЗАМИ (просьба пользователя 14 сен) ────────────────────
// Под каждым срезом — свой ряд слайдеров: precalc и слот эффекта. Так
// видно СРАЗУ, что у какого среза настроено, и правка не может уехать в
// соседний: колонка принадлежит срезу физически.
//
// ПОРОГ ПО ЧИСЛУ СРЕЗОВ. Считано: при ширине окна ~1900 восемь срезов дают
// полосу 237 px (четыре слайдера и слот помещаются), шестнадцать — 118
// (тесно), тридцать два — 59 (нечитаемо). Поэтому полосы показываются до
// восьми срезов, дальше остаётся панель выделенного среза: 64 среза и так
// правят выборочно, а не все подряд.
strips_on = 0; STRIPH = 0;   // полосы убраны, константы оставлены нулями
RULH  = floor(18*u);     // линейка синхронности под волной (объявлена ДО формул, что её читают)
MBH = MROWS * ROWSTEP;   // 26 окт: ряды MIDI / ARP / ARTIC — в самом низу, над слотами
need_all = WMIN + RULH + floor(5*u) + MBH + SELH + PH + STRIPH + floor(8*u) + PRH + STATH + QSRES;
need_pads = WMIN + RULH + floor(5*u) + MBH + SELH + PH + STRIPH + STATH + QSRES;
avail = H - WY;
// ── ПОТОЛОК ВЫСОТЫ ВОЛНЫ (просьба пользователя 18 сен: «экран нарезки
// компактнее») ──────────────────────────────────────────────────────────
// Волна брала ВЕСЬ остаток высоты, и на высоком окне раздувалась до
// половины экрана, тогда как ниже жались модули. Это та же ошибка
// «сколько осталось» вместо «сколько нужно», что была у ширины полей.
// Волне хватает своей высоты: по ней ищут границы срезов и транзиенты, а
// не разглядывают форму семпла — для этого есть зум на срез (кнопка zoom).
// Лишняя высота отдаётся тому, ради чего окно и открыто: ручкам и пэдам.
WHMAX = floor(210*u);
avail >= need_all ? (
  show_pads = 1; show_panel = 1;
  WH = avail - (need_all - WMIN);   // 26 окт: свободная высота — волне (была пустой полосой между линейкой и select)
  // Цепочка SELY -> PY -> PRY идёт от низа волны, поэтому урезание волны
  // не отдаёт место модулям — оно сдвигает всю цепь вверх, а дыра
  // появляется у нижнего края. Поэтому блок ПРИЖИМАЕТСЯ К НИЗУ: пэды и
  // панель там, где их ищет рука, а освободившийся воздух ложится между
  // волной и пэдами — то есть работает разделителем групп.
  SELY = WY + WH + RULH + floor(5*u);
  PY = SELY + SELH;
  STRIPY = PY + PH;
  PRY = STRIPY + STRIPH + floor(8*u);
) : avail >= need_pads ? (
  // no room for the parameter panel: keep the pads, the panel is off
  show_pads = 1; show_panel = 0;
  WH = avail - (need_pads - WMIN);
  SELY = WY + WH + RULH + floor(5*u);
  PY = SELY + SELH;
  STRIPY = PY + PH;
  PRY = H;
) : (
  // only the waveform fits
  show_pads = 0; show_panel = 0;
  WH = max(24, avail - STATH - QSRES - floor(4*u));
  SELY = H; PY = H; PRY = H; STRIPY = H; strips_on = 0;
);
QSY = H - STATH - QSH;                  // 31 окт: слоты — самый низ, над строкой статуса
MBY = H - STATH - QSRES - MBH + MPY;            // 26 окт: верх рядов MIDI / ARP / ARTIC (27 окт: слоты ушли наверх)
gsel = dk_sel[0];
gsb = slb(0);
gmsel = msel_base(0);
gfr = dk_frames[0];
govw = OVW0;
// Сцен больше нет: слоты 0-3 редактируют банк A, 4-7 — банк B (gfxa и др.
// ставятся на каждый слот в цикле ниже). cur остаётся только в @serialize.

// In the TCP the ground takes the track colour so the plugin reads as part of
// the panel rather than an inserted box; dimmed so widgets stay legible.
embedded && tc > 0 ? (
  tr_r = ((((tc-1)/65536)|0) & 255)/255;
  tr_g = ((((tc-1)/256)|0) & 255)/255;
  tr_b = (((tc-1)|0) & 255)/255;
  gfx_set(tr_r*0.55, tr_g*0.55, tr_b*0.55, 1);
) : pset(0);
gfx_rect(0,0,W,H);

// ---------------- toolbar rows: draw ----------------
// setup — фиксированный ЛЕВЫЙ ВЕРХНИЙ УГОЛ, одно место во всех плагинах
// экосистемы. Вне потока рядов: поток двигает bx и переносит строки, угол
// внутри него не удержать. Поток начинается правее на ширину кнопки.
btn(WX, TB1, SETUPW, BTH, "setup", setup_on) ? ( setup_on = !setup_on; setup_on ? tmap_on = 0; );
mouse_x >= WX && mouse_x < WX+SETUPW && mouse_y >= TB1 && mouse_y < TB1+BTH ?
  tip("global settings: capture, output, font, track tint");
z_idx = 0; bx = WX + SETUPOFF; bwrap = 0; tbrow1(); tbrow2(); tbcut(TB1);   // 26 окт: один поток

hr(WY - floor(3*u));

// ---------------- waveform ----------------
// 25 окт: как слайсер трекера — сверху полоса-обзор всего сэмпла (рамка = видимое окно),
// под ней волна с зумом: колесо — к мыши, Shift+колесо — листать, щелчок / протяжка по обзору — туда
fr_show = gfr;
// 27 окт: ПРИЦЕЛ — снайперский зум у границы среза, как в пульте DSP трекера: ±aim_w2 кадров вокруг границы под
// мышью (на волне), иначе — начала выбранного среза. Протяжка — точный сдвиг, колесо — шире / ближе, spam — срез
// звучит сам, пока тянешь (roll раз в 0.12 с) и после
// 27 окт: порядок сверху вниз — обзор (скролл), прицел, волна
OVH = gfx_texth + 4;
OVY = WY;
WY += OVH + 2; WH -= OVH + 2;
AIMH = embedded ? 0 : 6*BTH;   // 27 окт: втрое выше (было 2 строки) — волна ниже
AIMH > 0 && WH > AIMH * 1.5 && fr_show > 0 ? (
  aim_y = WY; WY += AIMH + 2; WH -= AIMH + 2;
  aim_w2 <= 0 ? aim_w2 = floor(0.04 * max(1, dk_srate[0]));
  // какая граница: тянется > под мышью на волне > выбранный срез
  aim_hv = -1;
  mouse_y >= WY && mouse_y < WY + WH && mouse_x >= WX && mouse_x < WX + WW ? (
    aim_i = 0;
    while (aim_i < dk_nsl[0]) ( abs(WX + (gsb[OF_START+aim_i]-wv_f0)/max(1, wv_fn)*WW - mouse_x) <= 6 ? aim_hv = aim_i; aim_i += 1; );
  );
  aim_drag ? aim_e = aim_drag - 1 : drag_marker > 0 ? aim_e = drag_marker - 1 : aim_hv >= 0 ? aim_e = aim_hv : gsel >= 0 ? aim_e = gsel;
  aim_e >= dk_nsl[0] ? aim_e = -1;
  pset(0); gfx_rect(WX, aim_y, WW, AIMH);
  pseta(4, 0.3); gfx_rect(WX, aim_y, WW, 1); gfx_rect(WX, aim_y + AIMH - 1, WW, 1); gfx_rect(WX, aim_y, 1, AIMH); gfx_rect(WX + WW - 1, aim_y, 1, AIMH);
  aim_e >= 0 ? (
    aim_c = gsb[OF_START+aim_e];
    aim_t0 = aim_c - aim_w2; aim_sp = 2 * aim_w2;
    aim_bf = dbuf(0);
    // пики по пикселям, два прохода (размах, потом столбцы) — без своего массива: свободной памяти JSFX тут нет;
    // не больше 24 чтений на столбец
    aim_amp = 0.02; aim_pass = 0;
    aim_cy = aim_y + AIMH/2; aim_hh = AIMH/2 - 2;
    while (aim_pass < 2) (
      aim_pass == 1 ? pseta(4, 0.75);
      aim_px = 0;
      while (aim_px < WW) (
        aim_a = floor(aim_t0 + aim_px / WW * aim_sp); aim_b = floor(aim_t0 + (aim_px + 1) / WW * aim_sp);
        aim_st = max(1, floor((aim_b - aim_a) / 24));
        aim_mx = 0; aim_mn = 0; aim_k = max(0, aim_a);
        while (aim_k < min(gfr, max(aim_b, aim_a + 1))) (
          aim_v = 0.5 * (aim_bf[aim_k*2] + aim_bf[aim_k*2+1]);
          aim_v > aim_mx ? aim_mx = aim_v; aim_v < aim_mn ? aim_mn = aim_v;
          aim_k += aim_st;
        );
        aim_pass == 0 ? aim_amp = max(aim_amp, max(aim_mx, -aim_mn))
          : gfx_rect(WX + aim_px, aim_cy - aim_mx/aim_amp*aim_hh, 1, max(1, (aim_mx - aim_mn)/aim_amp*aim_hh));
        aim_px += 1;
      );
      aim_pass += 1;
    );
    pseta(4, 0.25); gfx_rect(WX, floor(aim_cy), WW, 1);
    aim_i = 0;
    while (aim_i < dk_nsl[0]) (
      aim_p = gsb[OF_START+aim_i];
      aim_p >= aim_t0 && aim_p <= aim_t0 + aim_sp ? (
        aim_x = floor(WX + (aim_p - aim_t0) / aim_sp * WW);
        aim_i == aim_e ? ( pset(3); gfx_rect(aim_x, aim_y, 2, AIMH); ) : ( gfx_set(0.42, 0.72, 0.78, 1); gfx_rect(aim_x, aim_y, 1, AIMH); );
      );
      aim_i += 1;
    );
    sprintf(#aiml, "slice %02X  %.4fs  +-%d ms", aim_e + 1, aim_c / max(1, dk_srate[0]), floor(aim_w2 / max(1, dk_srate[0]) * 1000 + 0.5));
    gfx_measurestr(#aiml, aim_lw, aim_lh);
    pset(0); gfx_rect(WX + 3, aim_y + 2, aim_lw + 4, aim_lh);
    pseta(4, 0.6); gfx_x = WX + 5; gfx_y = aim_y + 2; gfx_drawstr(#aiml);
  ) : (
    pseta(4, 0.5); gfx_x = WX + 5; gfx_y = aim_y + 2; gfx_drawstr("aim: point at a slice edge (or select a slice) - its edge up close here");
  );
  gfx_measurestr("spam", aim_lw, aim_lh); aim_bw = aim_lw + floor(10*u);
  btn(WX + WW - aim_bw - 3, aim_y + 2, aim_bw, BTH - 2, "spam", aim_spam) ? aim_spam = !aim_spam;
  aim_in = mouse_x >= WX && mouse_x < WX + WW - aim_bw - 6 && mouse_y >= aim_y && mouse_y < aim_y + AIMH;
  aim_in ? tip("aim: the slice edge up close - drag: fine move, wheel: wider / closer; spam: the slice plays while you drag and after");
  aim_in && mouse_wheel != 0 ? ( aim_w2 = max(32, min(max(64, gfr/2), floor(aim_w2 * (mouse_wheel > 0 ? 0.8 : 1.25)))); mouse_wheel = 0; );
  aim_in && lclick && aim_e >= 0 ? ( aim_drag = aim_e + 1; aim_base = gsb[OF_START+aim_e]; aim_mx0 = mouse_x; aim_spn = 2 * aim_w2; aim_rt = 0; );
  aim_drag > 0 && (mouse_cap & 1) ? (
    aim_i = aim_drag - 1;
    aim_lo = aim_i > 0 ? gsb[OF_START+aim_i-1] + 64 : 0;
    aim_hi = aim_i < dk_nsl[0]-1 ? gsb[OF_START+aim_i+1] - 64 : gfr - 64;
    aim_nf = max(aim_lo, min(aim_hi, floor(aim_base + (mouse_x - aim_mx0) / WW * aim_spn)));
    aim_nf != gsb[OF_START+aim_i] ? (
      gsb[OF_START+aim_i] = aim_nf; calc_ends(0);
      aim_spam && time_precise() - aim_rt >= 0.12 ? ( aim_rt = time_precise(); pv_deck = 0; pv_req = aim_i; );
    );
  );
  aim_drag > 0 && !(mouse_cap & 1) ? ( aim_spam ? ( pv_deck = 0; pv_req = aim_drag - 1; ); aim_drag = 0; );
);
gfx_set(0.16,0.165,0.175,1);
gfx_rect(WX, WY, WW, WH);
// ── ОКНО ПОКАЗА [wv_f0, wv_f0+wv_fn) ───────────────────────────────────
// Вся отрисовка волны, маркеров и кликов шла через одно выражение
// `кадр/fr_show*WW`. Ввести зум значит подменить ЭТУ систему координат, а
// не написать второй вид: второй вид — это вторая копия полутора сотен
// строк, которая разойдётся с первой на первой же правке.
// Zoom берёт выделенный срез с полями в четверть его длины по бокам:
// рендер видно, но и соседние удары остаются в кадре — иначе теряется
// ответ на вопрос «куда этот срез встал».
wv_f0 = 0; wv_fn = max(1, fr_show);
// свободный зум (колесо): wv_zf0 / wv_zfn — окно в кадрах; 0 — весь сэмпл
fr_show > 0 && mouse_wheel != 0 && mouse_y >= WY && mouse_y < WY + WH && mouse_x >= WX && mouse_x < WX + WW ? (
  wz_fn = wv_zfn > 0 ? wv_zfn : fr_show; wz_f0 = wv_zfn > 0 ? wv_zf0 : 0;
  (mouse_cap & 8) ? (
    wz_f0 += (mouse_wheel > 0 ? -1 : 1) * wz_fn * 0.15;
  ) : (
    wz_fa = wz_f0 + (mouse_x - WX) / WW * wz_fn;
    wz_fn = max(WW * BINSZ, min(fr_show, wz_fn * (mouse_wheel > 0 ? 0.8 : 1.25)));
    wz_f0 = wz_fa - (mouse_x - WX) / WW * wz_fn;
  );
  wz_f0 = max(0, min(fr_show - wz_fn, wz_f0));
  wz_fn >= fr_show ? ( wv_zfn = 0; wv_zf0 = 0; ) : ( wv_zfn = wz_fn; wv_zf0 = wz_f0; );
  wv_zoom = 0;
  mouse_wheel = 0;
);
// обзор: щелчок / протяжка — окно зума центром туда
fr_show > 0 && wv_zfn > 0 && (mouse_cap & 1) && mouse_y >= OVY && mouse_y < OVY + OVH && mouse_x >= WX && mouse_x < WX + WW ? (
  wv_zf0 = max(0, min(fr_show - wv_zfn, (mouse_x - WX) / WW * fr_show - wv_zfn / 2));
);
wv_zfn > 0 ? ( wv_f0 = wv_zf0; wv_fn = wv_zfn; );
wv_zoom && gsel >= 0 && gsel < dk_nsl[0] && fr_show > 0 ? (
  wv_s0 = gsb[OF_START+gsel]; wv_s1 = gsb[OF_END+gsel];
  wv_pad = max(floor((wv_s1 - wv_s0) * 0.25), floor(dk_srate[0] * 0.02));
  wv_f0 = max(0, wv_s0 - wv_pad);
  wv_fn = max(1, min(fr_show - wv_f0, (wv_s1 - wv_s0) + wv_pad*2));
);
// полоса-обзор (всегда весь сэмпл), серым, рамка — видимое окно
gfx_set(0.12,0.125,0.13,1); gfx_rect(WX, OVY, WW, OVH);
fr_show > 0 ? (
  ov_mid = OVY + OVH/2;
  cx = 0;
  while (cx < WW) (
    b0 = floor(cx / WW * fr_show / BINSZ); b1 = max(b0 + 1, floor((cx + 1) / WW * fr_show / BINSZ));
    pmn = 1; pmx = -1; bb = b0;
    while (bb < b1) ( gob = govw + bb*5; gob[0] < pmn ? pmn = gob[0]; gob[1] > pmx ? pmx = gob[1]; bb += 1; );
    pmx >= pmn ? ( pset(5); gfx_line(WX+cx, ov_mid - min(1,pmx)*(OVH/2-1), WX+cx, max(ov_mid - min(1,pmx)*(OVH/2-1) + 1, ov_mid - max(-1,pmn)*(OVH/2-1))); );
    cx += 1;
  );
  ov_x0 = WX + wv_f0 / fr_show * WW; ov_x1 = WX + (wv_f0 + wv_fn) / fr_show * WW;
  (wv_zfn > 0 || wv_zoom) ? (
    pset(3); gfx_rect(ov_x0, OVY, max(1, ov_x1 - ov_x0), 1); gfx_rect(ov_x0, OVY + OVH - 1, max(1, ov_x1 - ov_x0), 1);
    gfx_rect(ov_x0, OVY, 1, OVH); gfx_rect(max(ov_x0, ov_x1 - 1), OVY, 1, OVH);
  );
);
fr_show > 0 ? (
  wmid = WY + WH/2;
  gsel >= 0 && gsel < dk_nsl[0] ? (
    x0 = WX + (gsb[OF_START+gsel]-wv_f0)/wv_fn * WW;
    x1 = WX + (gsb[OF_END+gsel]-wv_f0)/wv_fn * WW;
    wavecol < 0.5 ? pseta(3, 0.14) : gfx_set(0.25,0.30,0.38,0.45);   // 25 окт: peaks — янтарём, как выделенный срез трекера
    gfx_rect(max(WX, x0), WY, max(1, min(x1, WX+WW)-max(WX, x0)), WH);
  );
  cx = 0;
  // Бины берутся от АБСОЛЮТНОГО кадра, а не от доли всей деки: при зуме на
  // колонку приходится меньше бинов, и правка одного среза наконец видна.
  while (cx < WW) (
    b0 = floor((wv_f0 + cx / WW * wv_fn) / BINSZ);
    b1 = max(b0+1, floor((wv_f0 + (cx+1) / WW * wv_fn) / BINSZ));
    pmn = 1; pmx = -1; sel_ = 0; sem_ = 0; seh_ = 0;
    bb = b0;
    while (bb < b1) (
      gob = govw + bb*5;
      gob[0] < pmn ? pmn = gob[0];
      gob[1] > pmx ? pmx = gob[1];
      sel_ += gob[2]; sem_ += gob[3]; seh_ += gob[4];
      bb += 1;
    );
    pmx >= pmn ? (
      // В ЛИНЕЙНОМ РЕЖИМЕ спектр не считаем вовсе: цвет всё равно белый, а
      // центроид на каждую из ~1900 колонок каждый кадр — работа впустую.
      wavecol > 1.5 && wavecol < 3.5 ? 0 : wavecol < 0.5 ? pset(5) : (   // 25 окт: peaks — серым, как волна слайсера трекера
      // media-explorer style spectral peaks: hue from spectral centroid
      set_ = sel_ + sem_ + seh_;
      set_ > 0 ? (
        ctr = (sem_*0.5 + seh_) / set_;
        wavecol > 0.5 && wavecol < 3.5 ? (
          // brightness carries the frequency: lows stay visible but dim,
          // highs come forward. One material instead of a rainbow.
          // Floor raised: on a #0d0f10 ground the old 0.16 sank into the
          // background and quiet low material disappeared entirely.
          tt = min(1, ctr*1.25);
          cr = 0.26 + 0.74*tt*tt; cg2 = 0.30 + 0.70*tt*tt; cb = 0.34 + 0.66*tt;
        ) : (
          // Spectral hues, saturated: on black the peaks have to carry the
          // contrast themselves. Low = amber, mid = green, high = cyan/blue —
          // the ecosystem accents, so the waveform belongs to the same palette.
          ctr < 0.35 ? ( tt = ctr/0.35;        cr = 1;            cg2 = 0.35+0.50*tt; cb = 0.12; )
          : ctr < 0.6 ? ( tt = (ctr-0.35)/0.25; cr = 1-0.65*tt;    cg2 = 0.90;         cb = 0.15+0.30*tt; )
          : ctr < 0.8 ? ( tt = (ctr-0.6)/0.2;   cr = 0.35-0.10*tt; cg2 = 0.90;         cb = 0.45+0.50*tt; )
          :             ( tt = (ctr-0.8)/0.2;   cr = 0.25+0.30*tt; cg2 = 0.90-0.35*tt; cb = 1.00; );
        );
        gfx_set(cr, cg2, cb, 1);
      ) : gfx_set(0.24, 0.46, 0.48, 1);   // тишина: приглушённый бирюзовый (3.9:1), не серый
      );
      // волна НЕ ВЫХОДИТ из своего окна: записанный или загруженный звук
      // громче единицы рисовался поверх кнопок выше и ниже
      // 26 окт: ПЛЕЙХЕД ЗАЛИВКОЙ — сыгранная часть звучащего среза ярко-жёлтая; стретч
      // давлением тянет её к концу в красный (чем сильнее нажим, тем краснее)
      pv_hit = 0; gvi = 0; pv_fc = wv_f0 + (cx + 0.5) / WW * wv_fn;
      while (gvi < NVOICE) (
        gv = V0 + gvi*VF;
        gv[fA] && gv[fST] < 3 ? (
          php = gv[fGRAN] > 0 ? gv[fVT] : gv[fPOS];
          pv_s0 = gsb[OF_START + (gv[fS]|0)];
          pv_fc >= min(pv_s0, php) && pv_fc <= max(pv_s0, php) ? (
            pv_hit = 1; pv_t = abs(pv_fc - pv_s0) / max(1, abs(php - pv_s0)) * gv[fATS];
          );
        );
        gvi += 1;
      );
      pv_hit ? gfx_set(1, 0.86 - 0.70*pv_t, 0.22 - 0.16*pv_t, 1);
      pmx = min(1, max(-1, pmx)); pmn = min(1, max(-1, pmn));
      y0 = wmid - pmx * (WH/2 - 2);
      y1 = wmid - pmn * (WH/2 - 2);
      wavecol > 2.5 && wavecol < 3.5 ? (
        // ── МАССИВ PURE DATA (15 сен) ──────────────────────────────────
        // Каждая колонка — ОДНА ТОЧКА на своей высоте, ничем не соединённая:
        // так Pd рисует array в режиме points. Пиковый размах — тусклой
        // вертикалью, как у линии: без него громкое неотличимо от тихого.
        wl_y = floor(wmid - (pmx + pmn) * 0.5 * (WH/2 - 2));
        pmx - pmn > 0.08 ? (
          gfx_set(1, 1, 1, 0.28);
          gfx_line(WX+cx, floor(y0), WX+cx, floor(max(y1, y0+1)));
        );
        gfx_set(1, 1, 1, 1);
        gfx_rect(WX+cx, wl_y, 1, 1);
      ) : wavecol > 1.5 && wavecol < 3.5 ? (
