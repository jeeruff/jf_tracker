        );
        // размах пиков — короткой вертикалью, тускло: без неё громкий
        // участок неотличим от тихого, а это главное, что несёт волна
        pmx - pmn > 0.08 ? (
          gfx_set(1, 1, 1, 0.28);
          gfx_line(WX+cx, floor(y0), WX+cx, floor(max(y1, y0+1)));
        );
        wl_prev = wl_y;
      ) : gfx_line(WX+cx, y0, WX+cx, max(y1, y0+1));
    ) : wavecol > 1.5 && wavecol < 3.5 ? wl_prev = wmid;   // тишина: линия держится середины
    cx += 1;
  );
  // alternating slice zone tint - makes the cut structure obvious
  gsi = 0;
  while (gsi < dk_nsl[0]) (
    (gsi & 1) ? (
      x0 = WX + (gsb[OF_START+gsi]-wv_f0)/wv_fn * WW;
      x1 = WX + (gsb[OF_END+gsi]-wv_f0)/wv_fn * WW;
      // зебра зон: в линейном режиме гасим — форма должна читаться линией,
      // а заливка возвращает ту самую «массу», от которой уходим
      // в линейном режиме зебры НЕТ: чёрный фон и белая линия, ничего между
      wavecol <= 1.5 && wavecol > 0.5 || wavecol > 3.5 ? ( gfx_set(1,1,1, 0.06); gfx_rect(x0, WY, max(1, x1-x0), WH); );
    );
    gsi += 1;
  );
  // ── ПЕРЕВЁРНУТЫЕ СРЕЗЫ — ИНВЕРСНЫМ ЦВЕТОМ (просьба пользователя 17 сен) ──
  // Реверс на волне не виден В ПРИНЦИПЕ: он переставляет min/max местами,
  // огибающая почти симметрична, спектр тот же. Никакой зум этого не
  // покажет — значит след должен быть НАРИСОВАН, а не вычислен из звука.
  // gfx_mode 1 = аддитивное наложение: белая полоса поверх волны выбивает
