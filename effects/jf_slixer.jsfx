    sprintf(#sn, "%d %s", gsi+1, #nn);
    gfx_measurestr(#sn, snw, snh);
    gzx2 = gsi < dk_nsl[0]-1 ? WX + (gsb[OF_START+gsi+1]-wv_f0)/wv_fn*WW : WX + WW;
    // labels ride at the top of the marker line, right of its triangle, where
    // the eye already is; they used to sit at the bottom, far from the cut
    snw + floor(12*u) < gzx2 - gmx ? (
      gfx_x = gmx + floor(10*u); gfx_y = WY + floor(1*u);
      pseta(4, 0.85);
      gfx_drawstr(#sn);
    ) : (
      sprintf(#sn, "%d", gsi+1);
      gfx_measurestr(#sn, snw, snh);
      snw + floor(10*u) < gzx2 - gmx ? (
        gfx_x = gmx + floor(9*u); gfx_y = WY + floor(1*u);
        pseta(4, 0.85);
        gfx_drawstr(#sn);
      );
    );
    );   // 25 окт: конец ветки не-peaks
    gsi += 1;
  );
  // voice playheads
  gvi = 0;
  while (gvi < NVOICE) (
    gv = V0 + gvi*VF;
    gv[fA] ? (
      // read the path the engine actually resolved (fGRAN), don't re-derive it:
      // aftertouch also forces granular, so a re-derived test freezes the playhead
      php = gv[fGRAN] > 0 ? gv[fVT] : gv[fPOS];
      gpx = WX + (php-wv_f0)/wv_fn * WW;
      gfx_set(1,1,1,0.35 + 0.5*gv[fENV]);
      gfx_line(gpx, WY, gpx, WY+WH);
    );
    gvi += 1;
  );
);

// waveform mouse interaction
m_inwave = mouse_x >= WX && mouse_x < WX+WW && mouse_y >= WY && mouse_y < WY+WH;
m_fr = wv_f0 + (mouse_x - WX) / WW * wv_fn;
m_inwave && lclick && fr_show > 0 ? (
  hitm = -1; gsi = 0;
  while (gsi < dk_nsl[0]) (
    abs(WX + (gsb[OF_START+gsi]-wv_f0)/wv_fn*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  (mouse_cap & 16) && hitm >= 0 ? (      // alt+click = delete
    del_slice(0, hitm);
  ) : dbl ? (
    add_slice(0, m_fr);
  ) : hitm >= 0 ? (
    drag_marker = hitm+1; msel_only(0, hitm);
  ) : (
    // click inside a slice zone selects it; shift adds it to the selection
    hitm = -1; gsi = 0;
    while (gsi < dk_nsl[0]) (
      gsb[OF_START+gsi] <= m_fr ? hitm = gsi;
      gsi += 1;
    );
    // 26 окт: как прежние пэды — клик слушает срез (при лупе — прыжок по кванту),
    // протяжка вверх / вниз — высота; shift — добавить к выделению без звука
    hitm >= 0 ? ( (mouse_cap & 8) ? msel_toggle(0, hitm) : (
      msel_only(0, hitm);
      tl_active ? (
        tl_jump = hitm;
        tl_jump_pos = qstep > 0 ? ceil(play_position*srate / qstep) * qstep : 0;
      ) : ( pv_deck = 0; pv_req = hitm; );
      paddrag = hitm+1; pad_y0 = mouse_y; pad_p0 = gsb[OF_PITCH+hitm]; pad_moved = 0;
    ));
  );
);
// зона под мышью — светлее; замьюченная — темнее и перечёркнута
m_inwave && fr_show > 0 && !drag_marker && !paddrag ? (
  hovz = -1; gsi = 0;
  while (gsi < dk_nsl[0]) ( gsb[OF_START+gsi] <= m_fr ? hovz = gsi; gsi += 1; );
  hovz >= 0 ? (
    x0 = max(WX, WX + (gsb[OF_START+hovz]-wv_f0)/wv_fn * WW);
    x1 = min(WX+WW, WX + (gsb[OF_END+hovz]-wv_f0)/wv_fn * WW);
    x1 > x0 ? ( gfx_set(1, 1, 1, 0.07); gfx_rect(x0, WY, x1-x0, WH); );
  );
);
gsi = 0;
while (gsi < dk_nsl[0]) (
  gsb[OF_MUTE+gsi] > 0.5 ? (
    x0 = max(WX, WX + (gsb[OF_START+gsi]-wv_f0)/wv_fn * WW);
    x1 = min(WX+WW, WX + (gsb[OF_END+gsi]-wv_f0)/wv_fn * WW);
    x1 > x0 ? ( gfx_set(0, 0, 0, 0.55); gfx_rect(x0, WY, x1-x0, WH); pseta(4, 0.5); gfx_line(x0, WY+WH-1, x1-1, WY); );
  );
  gsi += 1;
);
// протяжка по срезу: вверх / вниз — высота (Ctrl — мелко), на всё выделение
paddrag > 0 && (mouse_cap & 1) ? (
  pdi = paddrag - 1;
  pdi < dk_nsl[0] ? (
    pdy = pad_y0 - mouse_y;
    !pad_moved && abs(pdy) > floor(3*u) ? pad_moved = 1;
    pad_moved ? (
      pdov = gsb[OF_PITCH+pdi];
      gsb[OF_PITCH+pdi] = max(-24, min(24, pad_p0 + pdy / (4*u) * ((mouse_cap & 4) ? 0.1 : 1)));
      apply_delta(0, OF_PITCH, pdov, gsb[OF_PITCH+pdi], -24, 24);
      sprintf(#pn, "%+.1f", gsb[OF_PITCH+pdi]);
      gfx_measurestr(#pn, ptw, pth);
      pset(3); gfx_x = min(WX + WW - ptw - 2, max(WX, WX + (gsb[OF_START+pdi]-wv_f0)/wv_fn*WW + 3)); gfx_y = WY + pth + 4; gfx_drawstr(#pn);
    );
  );
);
paddrag > 0 && !(mouse_cap & 1) ? ( paddrag = 0; pad_moved = 0; );
rclick && m_inwave && fr_show > 0 ? (
  hitm = -1; gsi = 0;
  while (gsi < dk_nsl[0]) (
    abs(WX + (gsb[OF_START+gsi]-wv_f0)/wv_fn*WW - mouse_x) <= 6 ? hitm = gsi;
    gsi += 1;
  );
  hitm >= 0 ? del_slice(0, hitm) : (
    // 26 окт: правый клик внутри среза (не на границе) — мьют, как было на пэде
    gsi = 0;
    while (gsi < dk_nsl[0]) ( gsb[OF_START+gsi] <= m_fr ? hitm = gsi; gsi += 1; );
    hitm >= 0 ? gsb[OF_MUTE+hitm] = gsb[OF_MUTE+hitm] > 0.5 ? 0 : 1;
  );
);
drag_marker > 0 && (mouse_cap & 1) ? (
  di = drag_marker - 1;
  dlo = di > 0 ? gsb[OF_START+di-1] + 64 : 0;
  dhi = di < dk_nsl[0]-1 ? gsb[OF_START+di+1] - 64 : gfr - 64;
  sn_f = m_fr;
  snap_on && dk_frames[0] > 0 && dk_srate[0] > 0 && tempo > 0 ? (
    sn_q = dk_frames[0] / max(0.25, dk_sync[0] ? loop_beats : dk_frames[0] / dk_srate[0] * tempo / 60) / 4;   // кадров в 1/16 лупа
    sn_g = floor(m_fr / sn_q + 0.5) * sn_q;
    abs(sn_g - m_fr) / wv_fn * WW <= floor(8*u) ? sn_f = sn_g;
  );
  gsb[OF_START+di] = max(dlo, min(dhi, floor(sn_f)));
  calc_ends(0);
  aim_spam && time_precise() - aim_rt >= 0.12 ? ( aim_rt = time_precise(); pv_deck = 0; pv_req = di; );   // 27 окт: spam — roll
);
drag_marker > 0 && !(mouse_cap & 1) ? ( aim_spam ? ( pv_deck = 0; pv_req = drag_marker - 1; ); drag_marker = 0; );

// ---------------- selection strip + pads + panel (height permitting) --------
show_pads ? (
// ── ЛИНЕЙКА СИНХРОННОСТИ (просьба пользователя 18 сен) ───────────────────
// Вопрос, на который она отвечает: «попадёт ли начало каждого среза в темп,
// если играть луп насквозь?» Раньше это было неоткуда узнать.
//   * сетка: такты (высокий штрих + номер), доли, шестнадцатые;
//   * метка у КАЖДОГО среза: зелёная — старт стоит в шестнадцатой (± 4 мс),
//     оранжевая — мимо, и от неё тянется чёрточка до ближайшей шестнадцатой:
//     длина чёрточки = на сколько срез опоздает или поспешит;
//   * при sync луп подгоняется под ЦЕЛОЕ число долей — сетка кончается ровно
//     в конце волны. Без sync доли идут как есть (например 7.83), и видно,
//     что последний такт не закрывается: луп будет уплывать от проекта.
// Живёт в координатах ВОЛНЫ (wv_f0/wv_fn), поэтому зумится вместе с ней.
show_pads && fr_show > 0 && loop_beats > 0 ? (
  ruy = WY + WH + floor(2*u); ruh = RULH - floor(4*u);
  rub = dk_sync[0] ? loop_beats : max(0.25, smb);     // долей в лупе: целое при sync
  rufb = dk_frames[0] / rub;                          // кадров в доле
  rupx = rufb / 4 / wv_fn * WW;                       // пикселей на шестнадцатую
  rubar = max(1, ts_num|0);
  // основание
  pseta(4, 0.25); gfx_rect(WX, ruy + ruh - 1, WW, 1);
  ruq = 0; run_ = floor(rub * 4 + 0.0001);
  while (ruq <= run_) (
    rux = WX + (rufb * ruq / 4 - wv_f0) / wv_fn * WW;
    rux >= WX && rux < WX + WW ? (
      (ruq % (rubar*4)) == 0 ? (
        pseta(4, 0.9); gfx_rect(rux, ruy, 1, ruh);
        // номер такта — только если до следующего такта есть место под цифру
        rupx * rubar * 4 > floor(18*u) ? (
          sprintf(#ru, "%d", floor(ruq / (rubar*4)) + 1);
          pseta(4, 0.7); gfx_x = rux + floor(3*u); gfx_y = ruy - floor(1*u); gfx_drawstr(#ru);
        );
      ) : (ruq % 4) == 0 ? (
        pseta(4, 0.6); gfx_rect(rux, ruy + floor(ruh*0.4), 1, ruh - floor(ruh*0.4));
      ) : rupx >= 4 ? (
        pseta(4, 0.3); gfx_rect(rux, ruy + floor(ruh*0.72), 1, ruh - floor(ruh*0.72));
      );
    );
    ruq += 1;
  );
  // метки срезов
  rui = 0;
  while (rui < dk_nsl[0]) (
    rus = gsb[OF_START+rui];
    rug = floor(rus / (rufb/4) + 0.5) * (rufb/4);      // ближайшая шестнадцатая, в кадрах
    rux = WX + (rus - wv_f0) / wv_fn * WW;
    rugx = WX + (rug - wv_f0) / wv_fn * WW;
    rux >= WX && rux < WX + WW ? (
      abs(rus - rug) <= dk_srate[0] * 0.004 ? (
        mcol(9, 1); gfx_rect(rux - 1, ruy + ruh - floor(5*u), 3, floor(5*u));
      ) : (
        mcol(10, 1);
        gfx_rect(rux - 1, ruy + ruh - floor(5*u), 3, floor(5*u));
        gfx_rect(min(rux, rugx), ruy + ruh - floor(3*u), max(1, abs(rugx - rux)), 1);
      );
    );
    rui += 1;
  );
  // итог словами, справа в строке select: место там свободно, а на самой
  // линейке текст лёг бы на штрихи
  dk_sync[0] ? sprintf(#ru, "sync: %d beats, loop locked to tempo", loop_beats)
             : sprintf(#ru, "free: %.2f beats at %d bpm - will drift, turn sync on to lock", smb, floor(tempo + 0.5));
  gfx_measurestr(#ru, rutw, ruth);
  rutw < WW * 0.45 ? (
    dk_sync[0] ? mcol(9, 0.9) : mcol(10, 0.9);
    gfx_x = WX + WW - rutw; gfx_y = SELY + (BTH - ruth)/2; gfx_drawstr(#ru);
  );
);
// The SELECT button opens a dropdown; the menu itself is drawn at the very end
// of @gfx so it paints over the pads and the parameter panel below it.
nsel = msel_count(0);
bx = WX; bwrap = 0;
// 26 окт: MIDI · ARP · ARTIC — потоком в самом низу (над быстрыми слотами)
show_pads ? ( mz_i = z_idx; z_idx = 4; bx = WX; bwrap = 0; tbrowM(MBY); z_idx = mz_i; );   // 26 окт: в самом низу
bx = WX; bwrap = 0;
btnw(SELY, "select", selmenu) ? selmenu = !selmenu;
sel_mx = WX; sel_my = SELY + BTH + floor(2*u);
btnw(SELY, "all", 0) ? ( msel_action(0, 0); selmenu = 0; );
btnw(SELY, "none", 0) ? ( msel_action(0, 1); selmenu = 0; );
btnw(SELY, "invert", 0) ? ( msel_action(0, 2); selmenu = 0; );
// 27 окт: сведения о сэмпле — здесь, под волной (как в DSP трекера); точка — пришло MIDI
gfx_measurestr(#info, infw, infh);
pseta(4, 0.6);
gfx_x = bx + floor(6*u); gfx_y = SELY + (BTH - infh)/2;
gfx_drawstr(#info);
bx = gfx_x + floor(6*u);
midi_act ? (
  gfx_set(0.4,0.9,0.5,1);
  gfx_circle(bx, SELY + BTH/2, max(3,floor(4*u)), 1);
  midi_act = 0;
);
bx += floor(8*u);

nsel > 1 ? (
  gfx_set(0.95,0.65,0.25,1);
  sprintf(#seli, "%d slices selected - edits apply to all", nsel);
) : dk_nsl[0] > 0 ? (
  gfx_set(0.45,0.47,0.50,1);
  sprintf(#seli, "click: hear, shift: several, drag up/down: pitch, rclick: mute");
) : strcpy(#seli, "");
gfx_measurestr(#seli, selw, selth);
// 26 окт: подсказка не налезает на итог синхронности справа (он рисуется, когда уже W*0.45)
sel_r = W - WX - (show_pads && loop_beats > 0 && rutw > 0 && rutw < WW * 0.45 ? rutw + floor(10*u) : 0);
bx + floor(4*u) + selw < sel_r ? (
  gfx_x = bx + floor(4*u); gfx_y = SELY + (BTH-selth)/2;
  gfx_drawstr(#seli);
);

// ---------------- pads: убраны 26 окт (срезы на волне делают то же) ----------------
// плейхед лупа и прыжок по кванту — на волне
dk_frames[0] > 0 && loop_beats > 0 && fr_show > 0 && tl_active ? (
  pset(3); gfx_rect(WX + (tl_pos - wv_f0) / wv_fn * WW, WY, 2, WH);
  tl_jump >= 0 && (floor(time_precise()*4) & 1) ? gfx_rect(WX + (gsb[OF_START+tl_jump] - wv_f0) / wv_fn * WW, WY, 2, WH);
);

show_panel ? hr(PRY - floor(4*u));

// ---------------- панель: секции колонками (26 окт, вид модуля DSP трекера) ----------------
// срез · adsr · stretch · out · voice · mod — что с чем связано, рядом; без пустых полос
gsel = dk_sel[0];
pn_ok = gsel >= 0 && gsel < dk_nsl[0];
show_panel ? (
  pn_c = 0; pn_ch = 0; pn_k = 0;
  while (pn_k < 6) (
    pn_s = pn_ord(pn_k);   // 28 окт: секция на этом месте (out и stretch поменяны)
    pn_hh = pn_hk(pn_s);
    pn_ch > 0 && pn_ch + pn_hh > pn_lim ? ( pn_c += 1; pn_ch = 0; );
    px0 = WX + pn_c * (pn_cw + PNG); py0 = PRY + pn_ch * PNRH; pn_w = pn_cw;
    pn_ch += pn_hh;
    pn_s == 0 ? (
      // ── СРЕЗ: имя (номер, нота, класс), звук среза и его место
      pn_ok ? (
        notename(slice_note(gsel), #zc2); classname(gsb[OF_CLASS+gsel], #zc3);
        gsb[OF_CLASS+gsel] > 0.5 ? sprintf(#zc, "slice %d  %s  %s", gsel + 1, #zc2, #zc3) : sprintf(#zc, "slice %d  %s", gsel + 1, #zc2);
      ) : strcpy(#zc, "slice");
      psec(px0, py0, pn_w, #zc);
      pn_ok ? (
        pn_y = py0 + PNRH;
        sprintf(#d, "%.1f", gsb[OF_PITCH+gsel]); ov = gsb[OF_PITCH+gsel];
        gsb[OF_PITCH+gsel] = prow(301, px0, pn_y, pn_w, ov, -24, 24, 0, "pit", #d, 1, 1);
        apply_delta(0, OF_PITCH, ov, gsb[OF_PITCH+gsel], -24, 24); pn_y += PNRH;
        sprintf(#d, "%.1f dB", gsb[OF_GAIN+gsel]); ov = gsb[OF_GAIN+gsel];
        gsb[OF_GAIN+gsel] = prow(302, px0, pn_y, pn_w, ov, -24, 12, 0, "vol", #d, 1, 0.5);
        apply_delta(0, OF_GAIN, ov, gsb[OF_GAIN+gsel], -24, 12); pn_y += PNRH;
        sprintf(#d, "%d", floor(gsb[OF_PAN+gsel]*100+0.5)); ov = gsb[OF_PAN+gsel];
        gsb[OF_PAN+gsel] = prow(303, px0, pn_y, pn_w, ov, -1, 1, 0, "pan", #d, 1, 0.05);
        apply_delta(0, OF_PAN, ov, gsb[OF_PAN+gsel], -1, 1); pn_y += PNRH;
        sta_lo = gsel > 0 ? gsb[OF_END+gsel-1] : 0;
        sta_hi = max(sta_lo + 64, gsb[OF_END+gsel] - 64);
        sprintf(#d, "%d ms", floor(gsb[OF_START+gsel] / max(1, dk_srate[0]) * 1000 + 0.5)); ov = gsb[OF_START+gsel];
        nv_sta = prow(304, px0, pn_y, pn_w, ov, sta_lo, sta_hi, ov, "sta", #d, 0, max(1, floor(dk_srate[0] * 0.001)));
        nv_sta != ov ? ( gsb[OF_START+gsel] = floor(nv_sta); calc_ends(0); );
        mouse_x >= px0 && mouse_x < px0 + pn_w && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("slice start inside its own bounds (wheel: 1 ms, the aim on the wave is finer)");
        pn_y += PNRH;
        sprintf(#d, "%d%%", floor(gsb[OF_RND+gsel]*100+0.5)); ov = gsb[OF_RND+gsel];
        gsb[OF_RND+gsel] = prow(305, px0, pn_y, pn_w, ov, 0, 1, 0, "rnd", #d, 0, 0.05);
        apply_delta(0, OF_RND, ov, gsb[OF_RND+gsel], 0, 1);
        mouse_x >= px0 && mouse_x < px0 + pn_w && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("rnd: tiny per-hit pitch / attack / decay jitter against the machine-gun effect");
        pn_y += PNRH;
        modename(gsb[OF_MODE+gsel], #d); ov = gsb[OF_MODE+gsel];
        gsb[OF_MODE+gsel] = floor(prow(306, px0, pn_y, pn_w, ov, 0, 3, 0, "mode", #d, 2, 1) + 0.5);
        apply_set(0, OF_MODE, ov, gsb[OF_MODE+gsel]); pn_y += PNRH;
        classname(gsb[OF_CLASS+gsel], #d); ov = gsb[OF_CLASS+gsel];
        gsb[OF_CLASS+gsel] = floor(prow(307, px0, pn_y, pn_w, ov, 0, 8, 0, "cls", #d, 2, 1) + 0.5);
        apply_set(0, OF_CLASS, ov, gsb[OF_CLASS+gsel]);
        mouse_x >= px0 && mouse_x < px0 + pn_w && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("slice class: kk kick, sn snare, hh hat, pc perc, cr crash, rd ride, vo voice, fx");
        pn_y += PNRH;
        sprintf(#d, "%d", gsb[OF_CHOKE+gsel]); ov = gsb[OF_CHOKE+gsel];
        gsb[OF_CHOKE+gsel] = floor(prow(308, px0, pn_y, pn_w, ov, 0, 4, 0, "chk", #d, 2, 1) + 0.5);
        apply_set(0, OF_CHOKE, ov, gsb[OF_CHOKE+gsel]); pn_y += PNRH;
        strcpy(#d, wv_zoom ? "on" : "off");
        wv_zoom = prow(309, px0, pn_y, pn_w, wv_zoom, 0, 1, 0, "zoom", #d, 3, 0);
        mouse_x >= px0 && mouse_x < px0 + pn_w && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("zoom: fit the waveform to the selected slice");
      ) : (
        pseta(4, 0.5); gfx_x = px0; gfx_y = py0 + PNRH; gfx_drawstr("no slice selected");
      );
    ) : pn_s == 1 ? (
      // ── ADSR: график сверху (узлы тянуть), под ним четыре строки
      psec(px0, py0, pn_w, "adsr");
      pn_ok ? (
        gy = py0 + PNRH; gh = PNRH * 3 - floor(2*u);
        adsr_edit(px0, gy, pn_w, gh, gsb[OF_ATK+gsel], gsb[OF_DEC+gsel], gsb[OF_SUS+gsel], gsb[OF_REL+gsel]) ? (
          ov = gsb[OF_ATK+gsel]; gsb[OF_ATK+gsel] = adsr_a; apply_delta(0, OF_ATK, ov, adsr_a, 0, 1);
          ov = gsb[OF_DEC+gsel]; gsb[OF_DEC+gsel] = adsr_d; apply_delta(0, OF_DEC, ov, adsr_d, 0, 1);
          ov = gsb[OF_SUS+gsel]; gsb[OF_SUS+gsel] = adsr_s; apply_delta(0, OF_SUS, ov, adsr_s, 0, 1);
          ov = gsb[OF_REL+gsel]; gsb[OF_REL+gsel] = adsr_r; apply_delta(0, OF_REL, ov, adsr_r, 0, 1);
        );
        adsr_draw(px0, gy, pn_w, gh, gsb[OF_ATK+gsel], gsb[OF_DEC+gsel], gsb[OF_SUS+gsel], gsb[OF_REL+gsel]);
        pn_y = py0 + PNRH * 4;
        sprintf(#d, "%d ms", floor(max(0.0005, gsb[OF_ATK+gsel]*gsb[OF_ATK+gsel]*0.5)*1000+0.5)); ov = gsb[OF_ATK+gsel];
        gsb[OF_ATK+gsel] = prow(311, px0, pn_y, pn_w, ov, 0, 1, 0, "atk", #d, 0, 0.02);
        apply_delta(0, OF_ATK, ov, gsb[OF_ATK+gsel], 0, 1); pn_y += PNRH;
        sprintf(#d, "%d ms", floor(max(0.001, gsb[OF_DEC+gsel]*gsb[OF_DEC+gsel]*2)*1000+0.5)); ov = gsb[OF_DEC+gsel];
        gsb[OF_DEC+gsel] = prow(312, px0, pn_y, pn_w, ov, 0, 1, 0, "dcy", #d, 0, 0.02);
        apply_delta(0, OF_DEC, ov, gsb[OF_DEC+gsel], 0, 1); pn_y += PNRH;
        sprintf(#d, "%d%%", floor(gsb[OF_SUS+gsel]*100+0.5)); ov = gsb[OF_SUS+gsel];
        gsb[OF_SUS+gsel] = prow(313, px0, pn_y, pn_w, ov, 0, 1, 1, "sus", #d, 0, 0.05);
        apply_delta(0, OF_SUS, ov, gsb[OF_SUS+gsel], 0, 1); pn_y += PNRH;
        sprintf(#d, "%d ms", floor(max(0.001, gsb[OF_REL+gsel]*gsb[OF_REL+gsel]*3)*1000+0.5)); ov = gsb[OF_REL+gsel];
        gsb[OF_REL+gsel] = prow(314, px0, pn_y, pn_w, ov, 0, 1, 0.02, "rel", #d, 0, 0.02);
        apply_delta(0, OF_REL, ov, gsb[OF_REL+gsel], 0, 1); pn_y += PNRH;
        btn(px0, pn_y, floor(40*u), PNRH - 1, "rst", 0) ? (
          ov = gsb[OF_ATK+gsel]; gsb[OF_ATK+gsel] = 0; apply_delta(0, OF_ATK, ov, 0, 0, 1);
          ov = gsb[OF_DEC+gsel]; gsb[OF_DEC+gsel] = 0; apply_delta(0, OF_DEC, ov, 0, 0, 1);
          ov = gsb[OF_SUS+gsel]; gsb[OF_SUS+gsel] = 1; apply_delta(0, OF_SUS, ov, 1, 0, 1);
          ov = gsb[OF_REL+gsel]; gsb[OF_REL+gsel] = 0.02; apply_delta(0, OF_REL, ov, 0.02, 0, 1);
        );
        mouse_x >= px0 && mouse_x < px0 + floor(40*u) && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("rst: the envelope back to 0 / 0 / 100% / 20 ms");
      );
    ) : pn_s == 2 ? (
      // ── STRETCH: алгоритм (3 в ряд), размер зерна, коэффициент (4 в ряд)
      psec(px0, py0, pn_w, "stretch");
      pn_ok ? (
        pn_y = py0 + PNRH; pbw = floor((pn_w - 2 * 2) / 3);
        sak = 0;
        while (sak < 5) (
          pbx = px0 + (sak % 3) * (pbw + 2); pby = pn_y + floor(sak / 3) * PNRH;
          btn(pbx, pby, pbw, PNRH - 1, sak==0 ? "grain" : sak==1 ? "cycle" : sak==2 ? "tape" : sak==3 ? "cloud" : "sync", (gsb[OF_STALG+gsel]|0) == sak) ? (
            ov = gsb[OF_STALG+gsel]; gsb[OF_STALG+gsel] = sak; apply_set(0, OF_STALG, ov, sak);
          );
          mouse_x >= pbx && mouse_x < pbx + pbw && mouse_y >= pby && mouse_y < pby + PNRH ? tip(
            sak==0 ? "grain: two Hann-windowed heads - the smooth all-rounder" :
            sak==1 ? "cycle: hard-edged cyclic stretch, the metallic Akai / jungle sound" :
            sak==2 ? "tape: no grains - stretch slows the tape, pitch drops with it; pressure = tape stop" :
            sak==3 ? "cloud: grains jump with random spray - the sound smears into a cloud" :
                     "sync: each grain is phase-aligned to the one playing (WSOLA) - cleanest on tonal material");
          sak += 1;
        );
        pn_y += PNRH * 2;
        sprintf(#d, "%d ms", floor((0.02 + gsb[OF_FXP2+FX_STRETCH*64+gsel]*0.1)*1000 + 0.5)); ov = gsb[OF_FXP2+FX_STRETCH*64+gsel];
        gsb[OF_FXP2+FX_STRETCH*64+gsel] = prow(321, px0, pn_y, pn_w, ov, 0, 1, 0.5, "size", #d, 0, 0.05);
        apply_delta(0, OF_FXP2+FX_STRETCH*64, ov, gsb[OF_FXP2+FX_STRETCH*64+gsel], 0, 1);
        mouse_x >= px0 && mouse_x < px0 + pn_w && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("grain size 20..120 ms: short = buzzy and tight, long = smooth but smeared transients");
        pn_y += PNRH; pbw = floor((pn_w - 3 * 2) / 4);
        fxk = 0;
        while (fxk < 7) (
          sf = fxk==0?0.5 : fxk==1?0.75 : fxk==2?1 : fxk==3?1.5 : fxk==4?2 : fxk==5?4 : 8;
          strcpy(#fl, fxk==0?"1/2" : fxk==1?"3/4" : fxk==2?"1x" : fxk==3?"1.5" : fxk==4?"2x" : fxk==5?"4x" : "8x");
          stv = (1 + log(sf)/log(8)) / 2;
          btn(px0 + (fxk % 4) * (pbw + 2), pn_y + floor(fxk / 4) * PNRH, pbw, PNRH - 1, #fl, abs(gsb[OF_FXA2+FX_STRETCH*64+gsel] - stv) < 0.01) ? (
            ov = gsb[OF_FXA2+FX_STRETCH*64+gsel]; gsb[OF_FXA2+FX_STRETCH*64+gsel] = stv;
            apply_set(0, OF_FXA2+FX_STRETCH*64, ov, stv);
          );
          fxk += 1;
        );
      );
    ) : pn_s == 3 ? (
      // ── OUT: куда идёт срез — канал, MIDI-нота наружу; маршрут всего плагина
      psec(px0, py0, pn_w, "out");
      pn_y = py0 + PNRH;
      pn_ok ? (
        sprintf(#d, "%d", floor(gsb[OF_OUTCH+gsel]+0.5)); ov = gsb[OF_OUTCH+gsel];
        gsb[OF_OUTCH+gsel] = floor(prow(331, px0, pn_y, pn_w, ov, 0, 64, 0, "ch", #d, 0, 1) + 0.5);
        apply_set(0, OF_OUTCH, ov, gsb[OF_OUTCH+gsel]);
        mouse_x >= px0 && mouse_x < px0 + pn_w && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("channel of the slice: 0 = the common mix, 1-64 = its own mono output");
        pn_y += PNRH;
        moutname(gsb[OF_MOUT+gsel], #d); ov = gsb[OF_MOUT+gsel];
        gsb[OF_MOUT+gsel] = floor(prow(332, px0, pn_y, pn_w, ov, 0, 2, 0, "snd", #d, 2, 1) + 0.5);
        apply_set(0, OF_MOUT, ov, gsb[OF_MOUT+gsel]); pn_y += PNRH;
        sprintf(#d, "%d", floor(gsb[OF_MNUM+gsel]+0.5)); ov = gsb[OF_MNUM+gsel];
        gsb[OF_MNUM+gsel] = floor(prow(333, px0, pn_y, pn_w, ov, 0, 127, 36, "num", #d, 0, 1) + 0.5);
        apply_delta(0, OF_MNUM, ov, gsb[OF_MNUM+gsel], 0, 127); pn_y += PNRH;
        sprintf(#d, "%d", floor(gsb[OF_MCHAN+gsel]+0.5)+1); ov = gsb[OF_MCHAN+gsel];
        gsb[OF_MCHAN+gsel] = floor(prow(334, px0, pn_y, pn_w, ov, 0, 15, 0, "chan", #d, 0, 1) + 0.5);
        apply_set(0, OF_MCHAN, ov, gsb[OF_MCHAN+gsel]);
      );
      pn_y = py0 + PNRH * 5;
      strcpy(#d, outmode < 0.5 ? "mix" : outmode < 1.5 ? "class" : "slice");
      outmode = floor(prow(335, px0, pn_y, pn_w, outmode, 0, 2, 0, "rout", #d, 2, 1) + 0.5);
      mouse_x >= px0 && mouse_x < px0 + pn_w && mouse_y >= pn_y && mouse_y < pn_y + PNRH ? tip("output routing: mix (1/2) - class buses (3-14) - slice per channel");
    ) : pn_s == 4 ? (
      // ── VOICE: как играет голос — всё плагину целиком
      psec(px0, py0, pn_w, "voice");
      pn_y = py0 + PNRH;
      strcpy(#d, legato ? "on" : "off");
      legato = prow(342, px0, pn_y, pn_w, legato, 0, 1, 0, "leg", #d, 3, 0); pn_y += PNRH;
      sprintf(#d, "%d ms", floor(glide_ms+0.5));
      glide_ms = prow(343, px0, pn_y, pn_w, glide_ms, 0, 500, 0, "gld", #d, 0, 10); pn_y += PNRH;
      strcpy(#d, interp < 0.5 ? "none" : interp < 1.5 ? "lin" : "herm");
      interp = floor(prow(344, px0, pn_y, pn_w, interp, 0, 2, 2, "itp", #d, 2, 1) + 0.5); pn_y += PNRH;
      strcpy(#d, gatemode ? "gate" : "1-shot");
      gatemode = prow(345, px0, pn_y, pn_w, gatemode, 0, 1, 0, "gate", #d, 3, 0); pn_y += PNRH;
      sprintf(#d, "%d ms", floor(preroll_ms+0.5));
      preroll_ms = floor(prow(346, px0, pn_y, pn_w, preroll_ms, 0, 100, 5, "pre", #d, 0, 1) + 0.5);
      mouse_y >= py0 + PNRH && mouse_y < py0 + PNRH * 6 && mouse_x >= px0 && mouse_x < px0 + pn_w ? (
        pn_r = floor((mouse_y - py0) / PNRH) + 1;
        pn_r == 2 ? tip("in mono: a new note while one is held does not restart the envelope") :
        pn_r == 3 ? tip("in mono: pitch glides between notes over this time") :
        pn_r == 4 ? tip("sample interpolation: none is rough and cheap, herm is smooth") :
        pn_r == 5 ? tip("gate: stops on note-off; off - 1-shot, the slice plays to its end") :
                    tip("slice markers are placed this far before each transient");
      );
    ) : (
      // ── MOD: восемь связей «источник → цель · сколько», под ними два LFO
      psec(px0, py0, pn_w, "mod");
      pn_sw = floor(pn_w * 0.3); pn_tw = floor(pn_w * 0.3);
      mk_ = 0;
      while (mk_ < NCAB) (
        mcx = px0; mcy = py0 + PNRH * (1 + mk_);
        mcb = CAB + mk_*3; msrc = mcb[0]|0; mdst = mcb[1]|0;
        src_name(msrc, #mnm);
        pn_h = mouse_x >= mcx && mouse_x < mcx + pn_sw && mouse_y >= mcy && mouse_y < mcy + PNRH - 1;
        pn_h ? pset(3) : msrc > 0 ? pset(4) : pseta(4, 0.4);
        gfx_x = mcx; gfx_y = mcy + max(0, floor((PNRH - 1 - gfx_texth) / 2)); gfx_drawstr(#mnm);
        pn_h ? (
          tip("modulation source: click for the list (vel / press / wheel / env / phase / rnd / lfo / bend / arp step)");
          lclick ? ( gfx_x = mouse_x; gfx_y = mouse_y; mmn = gfx_showmenu("--|vel|press|wheel|env|phase|rnd|lfo 1|lfo 2|bend|arp step"); mmn > 0 ? mcb[0] = mmn - 1; lclick = 0; );
        );
        dst_name(mdst, #mnm);
        pn_h = mouse_x >= mcx + pn_sw && mouse_x < mcx + pn_sw + pn_tw && mouse_y >= mcy && mouse_y < mcy + PNRH - 1;
        pn_h ? pset(3) : mdst > 0 ? pset(4) : pseta(4, 0.4);
        gfx_x = mcx + pn_sw; gfx_drawstr(#mnm);
        pn_h ? (
          tip("modulation target: click for the list");
          lclick ? ( gfx_x = mouse_x; gfx_y = mouse_y; mmn = gfx_showmenu("--|pitch|vol|pan|stretch|start|glitch|stutter|fx 1|fx 2|fx 3|fx 4"); mmn > 0 ? mcb[1] = mmn - 1; lclick = 0; );
        );
        sprintf(#d, "%+d%%", floor(mcb[2]*100 + 0.5));
        mcb[2] = prow(350 + mk_, mcx + pn_sw + pn_tw, mcy, pn_w - pn_sw - pn_tw, mcb[2], -1, 1, 0, "", #d, 1, 0.05);
        mk_ += 1;
      );
      pn_y = py0 + PNRH * (1 + NCAB);
      sprintf(#d, "%.2f Hz", lfo1_hz);
      pn_v = prow(360, px0, pn_y, pn_w, lfo1_hz, 0.01, 20, 1, "lfo1", #d, 0, 0.1); pn_v != lfo1_hz ? ( lfo1_hz = pn_v; sliderchange(slider82); ); pn_y += PNRH;
      strcpy(#d, lfo1_sh < 0.5 ? "sine" : lfo1_sh < 1.5 ? "tri" : lfo1_sh < 2.5 ? "saw" : lfo1_sh < 3.5 ? "sqr" : "rnd");
      pn_v = floor(prow(361, px0, pn_y, pn_w, lfo1_sh, 0, 4, 0, "shp1", #d, 2, 1) + 0.5); pn_v != lfo1_sh ? ( lfo1_sh = pn_v; sliderchange(slider83); ); pn_y += PNRH;
      sprintf(#d, "%.2f Hz", lfo2_hz);
      pn_v = prow(362, px0, pn_y, pn_w, lfo2_hz, 0.01, 20, 0.25, "lfo2", #d, 0, 0.1); pn_v != lfo2_hz ? ( lfo2_hz = pn_v; sliderchange(slider84); ); pn_y += PNRH;
      strcpy(#d, lfo2_sh < 0.5 ? "sine" : lfo2_sh < 1.5 ? "tri" : lfo2_sh < 2.5 ? "saw" : lfo2_sh < 3.5 ? "sqr" : "rnd");
      pn_v = floor(prow(363, px0, pn_y, pn_w, lfo2_sh, 0, 4, 0, "shp2", #d, 2, 1) + 0.5); pn_v != lfo2_sh ? ( lfo2_sh = pn_v; sliderchange(slider85); );
    );
    pn_k += 1;
  );
);

);  // end show_pads

// ── ХОТКЕИ ДЕЙСТВИЙ (25 окт) ─────────────────────────────────────────────
// Подписаны прямо на кнопках тулбара тусклой буквой справа (btni), поэтому
// обязаны работать ВСЕГДА, а не только при включённой игре с клавиатуры:
// кнопка, обещающая клавишу, которая иногда не нажимается, хуже кнопки без
// подписи. Буквы выбраны мимо нотной раскладки q2w3er5t6y7ui9o0p — отсюда
// z для undo (u занята нотой), а не привычное Ctrl+Z.
// Ловим ДО нотного разбора и НЕ передаём дальше: иначе d сыграла бы ноту.
// Клавиша ставит ФЛАГ, а не делает работу: тела detect / gate / undo живут
// в кнопках выше и уже отрисованы к этому моменту. Флаг читается кнопкой на
// СЛЕДУЮЩЕМ кадре (hk_fire), поэтому клавиша и клик — буквально один путь,
// и логика не раздваивается. Кадр при 30 fps — 33 мс, на слух незаметно.
hk_ch = gfx_getchar();
while (hk_ch > 0) (
  // 25 окт: как в трекере — пока keys выкл, буквы — команды (строчные, подписаны на кнопках ярко):
  // d detect x clear g gate z undo c classify a auto e midi n names t thru v vel s sync q quantize
  // p раскладка нот o out; k (keys) — всегда, она не нота. Keys вкл — буквы играют ноты
  hk_ch == 'k' || (!keys_on && (hk_ch == 'd' || hk_ch == 'x' || hk_ch == 'g' || hk_ch == 'z' || hk_ch == 'c' || hk_ch == 'a' || hk_ch == 'e'
  || hk_ch == 'n' || hk_ch == 't' || hk_ch == 'v' || hk_ch == 's' || hk_ch == 'q' || hk_ch == 'p' || hk_ch == 'o'
  || hk_ch == 'h' || hk_ch == 'r' || hk_ch == 'b' || (hk_ch >= '1' && hk_ch <= '8'))) ? (   // t mode, h thru, r q: trans, b arp, 1..8 артикуляторы
    hk_next = hk_ch;
  ) : (
    hk_q = hk_ch;   // не наша — отдаём нотному разбору ниже
  );
  hk_ch = hk_q ? 0 : gfx_getchar();
);

// Ноты с клавиатуры — только при keys_on. ВАЖНО сбросить hk_q и когда он
// выключен: иначе чужая клавиша застревала бы в нём навсегда и цикл выше
// выходил бы сразу, то есть хоткеи переставали работать после первой же
// посторонней клавиши.
!keys_on ? hk_q = 0;
keys_on ? (
  (
    sq_ch = hk_q ? hk_q : gfx_getchar();
    hk_q = 0;
    while (sq_ch > 0) (
      kp_r = key_rel(sq_ch);
      kp_r >= 0 ? (
        kp_n = basenote_a + kp_r;
        // not held yet -> note on; held -> just extend (OS key repeat keeps it)
        kp_i = 0; kp_f = -1;
        while (kp_i < 32) ( KBH[kp_i*2] == kp_n+1 ? kp_f = kp_i; kp_i += 1; );
        kp_f < 0 ? (
          kp_i = 0; while (kp_i < 32 && KBH[kp_i*2] != 0) ( kp_i += 1; );
          kp_i < 32 ? ( KBH[kp_i*2] = kp_n+1; kb_req = kp_n; kb_vel = 100; kp_f = kp_i; );
        );
        kp_f >= 0 ? KBH[kp_f*2+1] = time_precise() + 0.35;
      );
      sq_ch = gfx_getchar();
    );
  );
  // gfx_getchar has no key-up: release a key once its repeat stops coming
  kp_i = 0;
  while (kp_i < 32) (
    KBH[kp_i*2] && time_precise() > KBH[kp_i*2+1] ? ( kb_off = KBH[kp_i*2]-1; KBH[kp_i*2] = 0; );
    kp_i += 1;
  );
);

// ---------------- слоты-превью: самый низ, над статусом ----------------
QSH > 0 && QSY + QSH <= H ? ( qslots(QSY); hr(QSY + QSH + floor(2*u)); );

// ---------------- status line ----------------
gfx_measurestr("Ag", stw2, sth2);
sty = H - sth2 - floor(3*u);
hr(sty - floor(3*u));
pseta(4, 0.45);
gfx_x = WX; gfx_y = sty;
warn_t > 0 && time_precise() - warn_t < 4 ? (
  gfx_set(0.95,0.6,0.3,1);
  strcpy(#st, "helper off: run jf_slixer_helper.lua once (Actions) or restart REAPER");
) : tipshow ? (
  // hover help lives here, in the reserved status row, never floating over
  // the widgets
  pset(4);
  strcpy(#st, #tiptext);
  tipshow = 0;
) : seq_msg_t > 0 && time_precise() - seq_msg_t < 5 ? (
  pset(3);
  sprintf(#st, "seq> %s", #seq_msg);
) : embedded ? (
  sprintf(#st, "%d slices", dk_nsl[0]);
) : (
  // Подсказка про клавиши z x c v … убрана (пользователь: лишнее). Осталось
  // только то, что не угадать: как править слот мышью, и текущий шаг
  // энкодера: режим меняется с грида, а видно его должно быть и в окне.
  jog_mode > 0 ? (
    jogf = JOGST[min(NJOGS - 1, jog_mode - 1)];
    jogms = dk_srate[0] > 0 ? jogf * 1000 / dk_srate[0] : 0;
    jogf < 2 ? strcpy(#jogs, "1 sample") :
      jogms < 1 ? sprintf(#jogs, "%d smp (%.2f ms)", jogf, jogms)
                : sprintf(#jogs, "%d smp (%.0f ms)", jogf, jogms);
    sprintf(#st, "v1.5 | jog step: %s | fx slot: drag level vertically, bar = 2nd parameter", #jogs);
  ) : strcpy(#st, "v1.5 | jog: adaptive (slow = per sample, fast = coarse) | fx slot: drag level vertically, bar = 2nd parameter");
);
// ПАМЯТЬ ПЕРЕСЕКЛАСЬ — важнее любой подсказки: без этого сообщения
// коллизия выглядит как десяток несвязанных глюков (14-15 сен).
memerr ? (
  gfx_set(1, 0.25, 0.2, 1);
  sprintf(#st, "MEMORY OVERLAP: slice table %d..%d vs voices %d - fix SL0/V0/TBL", SL0, SL0 + NSLF*64, V0);
);
gfx_measurestr(#st, stw3, sth3);
task ? tskres = floor(100*u) : tskres = 0;
// too long: drop characters from the end until it fits, then mark it
stw3 > W - tskres - WX*2 ? (
  st_k = strlen(#st);
  while (stw3 > W - tskres - WX*2 - floor(12*u) && st_k > 1) (
    st_k -= 1; strcpy_substr(#st2, #st, 0, st_k); gfx_measurestr(#st2, stw3, sth3);
  );
  strcat(#st2, "..."); strcpy(#st, #st2);
);
gfx_drawstr(#st);

task ? (
  strcpy(#tk, task == 1 ? "detecting..." : task == 2 ? "classifying..." : "rebuilding...");
  gfx_measurestr(#tk, tkw, tkh);
  gfx_set(0.9,0.8,0.3,1);
  gfx_x = W - tkw - WX; gfx_y = sty;
  gfx_drawstr(#tk);
);

// ---------------- track name (top right, over the toolbar gap) ----------------
tname_len > 0 && !embedded && helper_ok ? (
  gfx_measurestr(#trkname, tnw, tnh);
  tnx = W - tnw - floor(24*u);
  // only on row 1's last line, and only if it clears the last button there
  tny = TB1 + row1_wrap*ROWSTEP;
  tnx > row1_end + floor(8*u) ? (
    tc > 0 ? (
      gfx_set(((((tc-1)/65536)|0)&255)/255, ((((tc-1)/256)|0)&255)/255, (((tc-1)|0)&255)/255, 1);
      gfx_rect(tnx - floor(10*u), tny + floor(4*u), floor(5*u), BTH - floor(8*u));
    );
    pseta(4, 0.8);
    gfx_x = tnx; gfx_y = tny + (BTH-tnh)/2;
    gfx_drawstr(#trkname);
  );
);

// ---------------- FAVS dropdown: starred files with mini waveforms ----------
favs_on && !embedded ? (
  fvn = gmem[599]|0;
  fvw = min(floor(460*u), W - floor(20*u));
  fvrh = floor(38*u);                       // two lines per kit
  fvhdr = gfx_texth + floor(6*u);
  fvh = max(fvrh, fvn*fvrh) + fvhdr + floor(6*u);
  fvx = W - fvw - floor(10*u); fvy = TB1 + BTH + floor(4*u);
  pseta(0, 0.97); gfx_rect(fvx, fvy, fvw, fvh);
  pseta(4, 0.4);
  gfx_rect(fvx,fvy,fvw,1); gfx_rect(fvx,fvy+fvh-1,fvw,1); gfx_rect(fvx,fvy,1,fvh); gfx_rect(fvx+fvw-1,fvy,1,fvh);
  pseta(4, 0.45);
  gfx_x = fvx + floor(8*u); gfx_y = fvy + floor(3*u);
  sprintf(#sq_tmp, "KITS %d - click loads, shift+click removes", fvn);
  gfx_drawstr(#sq_tmp);
  fvn == 0 ? (
    pseta(4, 0.6);
    gfx_x = fvx + floor(8*u); gfx_y = fvy + fvhdr;
    gmem[9] < 4 ? (
      gfx_set(0.95,0.6,0.3,1);
      gfx_drawstr(helper_ok ? "helper is an old version - restart jf_slixer_helper.lua" : "helper is not running - run jf_slixer_helper.lua");
    ) : gfx_drawstr("no kits yet - slice a loop and press SAVE");
  );
  fb_i = 0;
  while (fb_i < fvn) (
    fv_b = 2000 + fb_i*96;
    fv_ry = fvy + fvhdr + fb_i*fvrh;
    fv_hov = mouse_x >= fvx && mouse_x < fvx+fvw && mouse_y >= fv_ry && mouse_y < fv_ry+fvrh;
    fv_hov ? ( pseta(3, 0.2); gfx_rect(fvx+1, fv_ry, fvw-2, fvrh); );
    // mini waveform, 48 columns, the pm_browser look
    fv_wx = fvx + floor(6*u); fv_ww = floor(120*u);
    gmem[fv_b+41] > 0.5 ? (
      pseta(2, 0.85);
      fb_k = 0;
      while (fb_k < 48) (
        fv_h2 = max(1, gmem[fv_b+42+fb_k] * (fvrh - floor(12*u)));
        gfx_rect(fv_wx + fb_k*(fv_ww/48), fv_ry + (fvrh - fv_h2)/2, max(1, fv_ww/48 - 1), fv_h2);
        fb_k += 1;
      );
    ) : (
      pseta(4, 0.3);
      gfx_x = fv_wx; gfx_y = fv_ry + floor(4*u); gfx_drawstr("...");
    );
    // name
    strcpy(#sq_tmp, "");
    fb_k = 0;
    while (fb_k < gmem[fv_b]) (
      sprintf(#sq_tmp2, "%c", max(32, min(126, gmem[fv_b+1+fb_k])));
      strcat(#sq_tmp, #sq_tmp2);
      fb_k += 1;
    );
    pseta(4, 0.92);
    gfx_x = fv_wx + fv_ww + floor(8*u); gfx_y = fv_ry + floor(3*u);
    gfx_drawstr(#sq_tmp);
    // second line: bpm / length, then the tags as coloured dots -- two with
    // their label and the rest bare, the jf_reaprolog card rule
    fv_ty = fv_ry + floor(3*u) + gfx_texth + floor(2*u);
    fv_tx = fv_wx + fv_ww + floor(8*u);
    (gmem[fv_b+94] > 0 || gmem[fv_b+95] > 0) ? (
      gmem[fv_b+94] > 0 ? sprintf(#sq_tmp, "%d bpm  %.1fs", gmem[fv_b+94], gmem[fv_b+95])
                        : sprintf(#sq_tmp, "%.1fs", gmem[fv_b+95]);
      pseta(4, 0.45);
      gfx_x = fv_tx; gfx_y = fv_ty; gfx_drawstr(#sq_tmp);
      gfx_measurestr(#sq_tmp, sq_tw, sq_th);
      fv_tx += sq_tw + floor(10*u);
    );
    gmem[fv_b+90] > 0 ? (
      strcpy(#sq_tmp, ""); fv_nt = 0;
      fb_k = 0;
      while (fb_k <= gmem[fv_b+90]) (
        fv_c = fb_k < gmem[fv_b+90] ? max(32, min(126, gmem[fv_b+91+fb_k])) : 32;
        fv_c == 32 ? (
          strlen(#sq_tmp) > 1 ? (
            fv_dr = max(2, floor(3*u));
            tagcol(fnv1a(#sq_tmp) % 7);
            gfx_circle(fv_tx + fv_dr, fv_ty + gfx_texth/2, fv_dr, 1);
            fv_tx += fv_dr*2 + floor(3*u);
            fv_nt < 2 ? (
              gfx_measurestr(#sq_tmp, sq_tw, sq_th);
              fv_tx + sq_tw < fvx + fvw - floor(24*u) ? (
                pseta(4, 0.7);
                gfx_x = fv_tx; gfx_y = fv_ty; gfx_drawstr(#sq_tmp);
                fv_tx += sq_tw + floor(6*u);
              );
            );
            fv_nt += 1;
          );
          strcpy(#sq_tmp, "");
        ) : ( sprintf(#sq_tmp2, "%c", fv_c); strcat(#sq_tmp, #sq_tmp2); );
        fb_k += 1;
      );
    );
    lclick && fv_hov ? (
      gmem[301] = fb_i;
      gmem[300] = (mouse_cap & 8) ? 12 : 11;   // shift removes the kit
      (mouse_cap & 8) ? 0 : favs_on = 0;
    );
    fb_i += 1;
  );
  lclick && !favs_just && !(mouse_x >= fvx && mouse_x < fvx+fvw && mouse_y >= fvy && mouse_y < fvy+fvh) ? favs_on = 0;
  favs_just = 0;
);

// ---------------- SETUP overlay ----------------
// Every slider that has no place on the main screen lives here, so nothing is
// reachable only through REAPER's generic UI (those sliders are hidden now).
// Drawn after everything else so it covers the panel; clicks inside it are
// consumed by the fields, clicks outside close it.
setup_on && !embedded ? (
  lclick = lclick2; dbl = dbl2;   // hand the click back to the panel's fields
  pseta(0, 0.96); gfx_rect(spx, spy, spw, sph);
  pseta(4, 0.5);
  gfx_rect(spx,spy,spw,1); gfx_rect(spx,spy+sph-1,spw,1); gfx_rect(spx,spy,1,sph); gfx_rect(spx+spw-1,spy,1,sph);
  pset(4); gfx_x = spx + floor(10*u); gfx_y = spy + floor(8*u); gfx_drawstr("setup");
  // ── ТОЛЬКО НАСТРОЙКИ ВИДА (15 сен, просьба пользователя: «в сетапе слова
  // полные и не слайдеры, а тогглы; убрать дубли; только настройки вида»).
  // Ушли: sens (дубль поля в ряду slice), thr (дубль кнопки thru в play),
  // master gain / capture / save audio — теперь ОБЫЧНЫЕ слайдеры REAPER
  // (с них снят минус): их место в списке параметров, а не в окне вида.
  // Тоггл = кнопка во всю ширину, клик листает; слово целиком, без сокращений.
  sfh = floor(30*u); sfw = spw - floor(20*u); sgp = floor(6*u);
  sx0 = spx + floor(10*u); sy0 = spy + floor(8*u) + BTH;
  strcpy(#d, font_sc<0.5?"font size: 0.8x" : font_sc<1.5?"font size: 1x" : font_sc<2.5?"font size: 1.25x" : "font size: 1.5x");
  btn(sx0, sy0, sfw, sfh, #d, 0) ? ( font_sc = font_sc >= 2.5 ? 0 : font_sc + 1; sliderchange(font_sc); );
  sy1 = sy0 + sfh + sgp;
  btn(sx0, sy1, sfw, sfh, tint > 0.5 ? "track colour stripe: on" : "track colour stripe: off", tint > 0.5) ? (
    tint = tint > 0.5 ? 0 : 1; sliderchange(tint);
  );
  sy2 = sy1 + sfh + sgp;
  strcpy(#d, wavecol > 2.5 ? "waveform: array (pure data)" : wavecol > 1.5 ? "waveform: line (pure data)"
           : wavecol > 0.5 ? "waveform: brightness by frequency" : "waveform: spectral colours");
  btn(sx0, sy2, sfw, sfh, #d, 0) ? ( wavecol = wavecol >= 2.5 ? 0 : wavecol + 1; sliderchange(wavecol); );
  mouse_y >= sy2 && mouse_y < sy2+sfh && mouse_x >= sx0 && mouse_x < sx0+sfw ?
    tip("spectral = colour by spectrum; brightness = dark low, bright high; line = one white line; array = dots like a Pure Data array");
  gfx_x = sx0; gfx_y = spy + sph - floor(8*u) - gfx_texth;
  pseta(4, 0.6); gfx_drawstr("click outside to close");
  lclick && !in_setup ? setup_on = 0;
);

// ---------------- tala map overlay ----------------
tmap_on && !embedded ? (
  pseta(0, 0.96); gfx_rect(tpx2, tpy2, tpw2, tph2);
  pseta(4, 0.5);
  gfx_rect(tpx2,tpy2,tpw2,1); gfx_rect(tpx2,tpy2+tph2-1,tpw2,1); gfx_rect(tpx2,tpy2,1,tph2); gfx_rect(tpx2+tpw2-1,tpy2,1,tph2);
  pset(4); gfx_x = tpx2 + floor(8*u); gfx_y = tpy2 + floor(6*u); gfx_drawstr("TALA MAP - drag to morph, click outside to close");
  tmx0 = tpx2 + floor(10*u); tmy0 = tpy2 + floor(8*u) + gfx_texth + floor(6*u);
  tmw = tpw2 - floor(20*u); tmh = tph2 - (tmy0 - tpy2) - floor(10*u);
  // names, brightness by proximity to the cursor
  tm_i = 0;
  while (tm_i < SQ_NTALA) (
    tala_name(tm_i, #sq_nm);
    // first alias only: up to the /
    tm_v = 0;
    while (tm_v < strlen(#sq_nm) && str_getchar(#sq_nm, tm_v) != 47) ( tm_v += 1; );
    strcpy_substr(#sq_tmp, #sq_nm, 0, tm_v);
    gfx_measurestr(#sq_tmp, sq_tw, sq_th);
    tnx2 = tmx0 + SQ_TPOS[tm_i*2]*tmw - sq_tw/2;
    tny2 = tmy0 + SQ_TPOS[tm_i*2+1]*tmh - sq_th/2;
    tm_d = sqr(tmap_x - SQ_TPOS[tm_i*2]) + sqr(tmap_y - SQ_TPOS[tm_i*2+1]);
    tm_i == seq_tala ? pset(3) : pseta(4, min(0.95, max(0.30, 0.30 + 0.5/(tm_d*40 + 1))));
    gfx_x = max(tmx0, min(tmx0+tmw-sq_tw, tnx2)); gfx_y = max(tmy0, min(tmy0+tmh-sq_th, tny2));
    gfx_drawstr(#sq_tmp);
    tm_i += 1;
  );
  // cursor crosshair
  pset(3);
  cxp = tmx0 + tmap_x*tmw; cyp = tmy0 + tmap_y*tmh;
  gfx_line(cxp - floor(6*u), cyp, cxp + floor(6*u), cyp);
  gfx_line(cxp, cyp - floor(6*u), cxp, cyp + floor(6*u));
  // drag: begin inside the field, keep morphing while the button is down
  lclick3 && in_tmap && mouse_y >= tmy0 ? tmap_drag = 1;
  tmap_drag && (mouse_cap & 1) ? (
    tmap_x = min(1, max(0, (mouse_x - tmx0)/tmw));
    tmap_y = min(1, max(0, (mouse_y - tmy0)/tmh));
    (abs(tmap_x - tmap_ax) > 0.003 || abs(tmap_y - tmap_ay) > 0.003) ? (
      seq_map_apply(tmap_x, tmap_y);
      tmap_ax = tmap_x; tmap_ay = tmap_y;
      tala_name(seq_tala, #sq_nm);
      sprintf(#seq_msg, "map: %s (%d steps)", #sq_nm, seq_len);
      seq_msg_t = time_precise();
    );
  );
  tmap_drag && !(mouse_cap & 1) ? tmap_drag = 0;
  lclick3 && !in_tmap ? tmap_on = 0;
);

// ── ПЛОТНАЯ РАМКА У ОКНА В ФОКУСЕ (просьба пользователя 17 сен) ──────────
// Когда в проекте несколько слайсеров, видно, какой из них держит грид и
// кольца: поверхность отдаётся тому, чьё окно трогали последним. Рисуем
// САМОЙ ПОСЛЕДНЕЙ строкой @gfx — иначе содержимое окна её перекроет.
// Три пикселя: заметно с расстояния и не съедает место под виджеты.
winfocus > 0.5 && !embedded ? (
  pset(3);
  fr_w = max(1, floor(u));   // 26 окт: тонкая, как рамка модуля трекера (3*u при u 1.4 давало 4 px — «зачем такая толстая»)
  gfx_rect(0, 0, W, fr_w); gfx_rect(0, H - fr_w, W, fr_w);
  gfx_rect(0, 0, fr_w, H); gfx_rect(W - fr_w, 0, fr_w, H);
);

last_cap = mouse_cap;
