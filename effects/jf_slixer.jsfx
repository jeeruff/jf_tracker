  gsi = 0;
  while (gsi < dk_nsl[0]) (
    gmx = WX + (gsb[OF_START+gsi]-wv_f0)/wv_fn * WW;
    gzx2 = gsi < dk_nsl[0]-1 ? WX + (gsb[OF_START+gsi+1]-wv_f0)/wv_fn*WW : WX + WW;
    wavecol < 0.5 ? (
      // 25 окт: как слайсер трекера — янтарная линия, сверху номер (hex), снизу нота (клавиш нет, 26 окт)
      gmx >= WX - 1 && gmx <= WX + WW ? (
        pset(3); gfx_rect(gmx, WY, gsi == gsel ? 2 : 1, WH);
        gsi == gsel ? ( pset(3); gfx_rect(gmx, WY, max(1, min(gzx2, WX+WW) - gmx), 1); gfx_rect(gmx, WY+WH-1, max(1, min(gzx2, WX+WW) - gmx), 1); );
        sprintf(#sn, "%02X", gsi+1); gfx_measurestr(#sn, snw, snh);
        snw + 4 < gzx2 - gmx ? ( pset(3); gfx_x = gmx + 3; gfx_y = WY + 2; gfx_drawstr(#sn); );
        notename(slice_note(gsi), #nn);
        strlen(#nn) == 2 ? ( strcpy_substr(#nn2, #nn, 0, 1); strcat(#nn2, "-"); strcpy_substr(#nn3, #nn, 1, 1); strcat(#nn2, #nn3); strcpy(#nn, #nn2); );   // C2 -> C-2, как в трекере
        gfx_measurestr(#nn, snw, snh);
