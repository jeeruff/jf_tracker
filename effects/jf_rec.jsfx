desc:jf_rec
noindex:true
tags:utility
version:1.0
author:jeeruff
about:Ретроспективный буфер для ретро-сэмплера jf_grid. Пишет последние N
  секунд входа в кольцо и отдаёт наружу пики для отрисовки. Свой код и своё
  gmem-пространство: экосистема jf не зависит от платного nvk_CREATE.

// ─────────────────────────────────────────────────────────────────────────
// ЗАЧЕМ. Раньше ретро-сэмплер брал звук из nvk_RECORD (платный nvk_CREATE) —
// читал его gmem и писал в его почтовый ящик вставки. Это связывало две
// разные вещи: 28 сен подмена плагина своей копией разорвала связь
// nvk_CREATE с его собственным окном, и он перестал работать у пользователя.
// Решение: СВОЙ буфер со СВОИМ gmem. nvk живёт отдельно и целиком не тронут.
//
// ПАМЯТЬ. JSFX держит звук в 8-байтовых double, а не в 16-битных сэмплах,
// поэтому 40 секунд стерео на 48 кГц = 3.84 млн слов = 29 МБ (вчетверо
// больше, чем тот же материал на диске в 24 битах). Слои пиков при этом
// копейки: 0.74 МБ. Дорого именно сырое аудио — отсюда выбор длины буфера
// в config, а не константой «на всякий случай».
// Приём с вычисляемым maxmem подсмотрен в стоковом Cockos super8: там
// память считается препроцессором из настройки, а не забивается числом.
//
// КАРТА gmem (пространство jf_rec, всё своё):
//    0  srate         частота, чтобы читатель знал масштаб
//    1  len_sec       длина кольца в секундах
//    2  head_pct      где голова записи, доля кольца 0..1
//    3  writing       1 = пишем, 0 = стоим (bypass или выключен)
//    4  width         ширина слоя экрана, её задаёт ЧИТАТЕЛЬ
//   10  put_go        почтовый ящик вставки: 1 = напечатать кусок
//   11  put_track     номер трека (0-based)
//   12  put_pos       позиция на таймлайне, секунды
//   13  put_start     начало куска в сэмплах от начала кольца
//   14  put_len       длина куска в сэмплах
//   15  put_rev       1 = вставить реверсом
//   16  pb_go         превью: 1 = играть, 2 = стоп
//   17  pb_start      откуда играть, сэмплы от начала кольца
//   18  pb_len        сколько играть, сэмплов (0 = до конца кольца)
//   19  pb_pos        где сейчас играет (наружу, для курсора)
//   20  sel_on        подсветка: 1 = есть выделение
//   21  sel_a         начало выделения, доля кольца
//   22  sel_b         конец
//   23  sel_rev       1 = кусок пойдёт реверсом
//   30  alive         плагин пишет сюда 1 каждый блок — тест живости
//  1000000  экранный слой: max, следом min (width столбцов каждый)
//  2000000  зум-слой:     max, следом min (ZPS пиков в секунду)
// ─────────────────────────────────────────────────────────────────────────

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

// ВИД ВОЛНЫ — слайдер, а не переменная: слайдер REAPER сохраняет с проектом
// сам, без @serialize. Скрыт («-»): крутят его из меню под ключом.
slider1:view=0<0,2,1{peaks,tone,spectrogram}>-view
// СЛОТ ЭКЗЕМПЛЯРА (29 сен): у каждого канала свой jf_rec, и в общей gmem
// они говорят по очереди — через владельца. Слот раздаёт ДЕМОН (пишет этот
// слайдер), он же хранится с проектом. Скрыт: руками его не трогают.
slider2:slot=0<0,63,1>-slot

config: buflen "Длина буфера" 40 10="10 секунд" 20="20 секунд" 40="40 секунд (по умолчанию)" 80="80 секунд" 160="160 секунд"

// Память: кольцо (buflen * 192000 * 2 канала, с запасом под 192 кГц) плюс
// слои пиков. Считается препроцессором, поэтому 40-секундный буфер не
// резервирует память как 160-секундный.
options:gmem=jf_rec, gfx_idle, no_meter, gfx_hz=30, maxmem=<? printf("%d", buflen*192000*2 + 4200000) ?>

@init
ext_noinit = 1;              // не стирать память при перезапуске звука

// ── карта gmem ──────────────────────────────────────────────────────────
G_SRATE = 0;  G_LEN = 1;  G_HEAD = 2;  G_WRITING = 3;  G_WIDTH = 4;
G_PUTGO = 10; G_PUTTR = 11; G_PUTPOS = 12; G_PUTST = 13; G_PUTLEN = 14;
// G_PUTREV убран: реверс делает ВЫЗЫВАЮЩИЙ, у него уже есть рабочий путь
// через D_PLAYRATE айтема. Держать здесь поле, которое никто не читает,
// значит обещать несделанное.
G_PBGO = 16; G_PBST = 17; G_PBLEN = 18; G_PBPOS = 19;
G_SELON = 20; G_SELA = 21; G_SELB = 22; G_SELREV = 23;
// Заморозка СНАРУЖИ (демон: кусок выбирают энкодерами арка). Читаем в
// @block, а не в @sample — gmem_read на каждом сэмпле был бы тратой.
G_FRZ = 25;
// Команда ДЕМОНУ: 0 нет, 1 replace selected, 2 save to vault. Плагин только
// поднимает флаг — обе операции про проект и файлы, а туда ему хода нет.
G_ACT = 24;
G_ALIVE = 30;
G_PMAX = 1000000; G_PMIN = 1050000;     // слой под ширину окна
G_ZMAX = 2000000; G_ZMIN = 2050000;     // зум-слой

ZPS = 500;                   // пиков в секунду в зум-слое
// ЗНАЧЕНИЕ config ПОДСТАВЛЯЕТСЯ ПРЕПРОЦЕССОРОМ, а не читается как
// переменная. Проба 28 сен: `len_sec = buflen` дало НОЛЬ — кольцо нулевой
// длины, буфер не работал вовсе, хотя плагин был «жив». В options тот же
// buflen сработал только потому, что там он стоял внутри <? ?>.
// Так же устроен стоковый super8: свой maxmem он читает исключительно
// внутри <? ?>, в обычном коде эта переменная не существует.
len_sec = <? printf("%d", buflen) ?>;
len_sec < 1 ? len_sec = 40;   // страховка, если config пуст
ring_n = floor(len_sec * srate);         // отсчётов на канал
bufL = 0;
bufR = ring_n;                           // правый канал сразу за левым

// ── ПАМЯТЬ ПОД СПЕКТР (29 сен) ──────────────────────────────────────────
// fft() EEL2 требует, чтобы буфер НЕ ПЕРЕСЕКАЛ границу 65536 слов —
// поэтому выравниваем начало на ближайшую такую границу за кольцом.
// Запас maxmem (+4.2 млн слов) это покрывает при любой частоте до 192 кГц.
FFTN  = 4096;                                  // комплексных точек
FFTB  = ceil((bufR + ring_n + 16) / 65536) * 65536;
SPACC = FFTB + FFTN*2;                         // накопитель модулей, FFTN/2

// ── ЛОКАЛЬНОЕ ЗЕРКАЛО gmem (29 сен) ──────────────────────────────────────
// Каналов с jf_rec может быть много, а gmem-пространство `jf_rec` одно.
// Если все пишут туда напрямую, пики, головы и почтовые ящики смешиваются:
// панель в TCP одного канала рисовала бы звук другого.
// Поэтому ВСЁ состояние экземпляр держит у себя, по той же карте адресов
// (mr[G_X] вместо gmem[G_X]), а с общей gmem синхронизируется ТОЛЬКО
// ВЛАДЕЛЕЦ — экземпляр выделенного канала (назначает демон) или тот, по
// чьей панели только что кликнули. Своё рисует каждый — из своего зеркала.
// Размер: до зум-слоя max+min, 2 050 000 + 160 с x 500 = 2.13 млн слов;
// запас maxmem (+4.2 млн) покрывает с FFT вместе.
mr = FFTB + 16384;
G_OWNER = 26;          // gmem: слот текущего владельца
G_TRK   = 3000;        // gmem: G_TRK + слот = номер трека экземпляра (пишет демон)
was_owner = 0;

// ── СПЕКТРОГРАММА (29 сен, вместо спектра) ─────────────────────────────
// Время по горизонтали (весь буфер), частоты по вертикали (лог, 30 Гц …
// Найквист), цвет — громкость, палитра как у спектрограммы айтема REAPER.
// КОПИТСЯ, а не считается заново: SGC столбцов x SGB полос в закадровом
// изображении 1; за кадр пересчитываются только столбцы, по которым прошла
// голова записи, плюс первое заполнение порциями. Экран — один gfx_blit.
SGC = 512; SGB = 96; SGN = 1024;              // столбцы, полосы, точек FFT
SGBE = mr + 2200000;                          // края полос в бинах, SGB+1
b = 0;
while (b <= SGB) (
  f = 30 * pow((srate * 0.5) / 30, b / SGB);
  SGBE[b] = max(1, floor(f / srate * SGN));
  b += 1;
);
sg_init = 0; sg_fill = 0; sg_hc = -1;
ls_on = -1; ls_a = -1; ls_b = -1;   // последнее опубликованное выделение
wpos = 0;                                // голова записи

// Накопители пиков: копим модуль, сбрасываем по границе пика.
zn = floor(len_sec * ZPS);               // сколько пиков в зум-слое
z_step = srate / ZPS;                    // сэмплов на один зум-пик
z_i = 0; z_acc = 0; z_max = 0; z_min = 0;

pw = 0;                                  // ширина экранного слоя, её даёт читатель
p_i = 0; p_acc = 0; p_max = 0; p_min = 0;

// ── ПРЕВЬЮ ──────────────────────────────────────────────────────────────
// pb_pos = -1 означает «молчим». Ноль не годится: это валидная позиция
// начала кольца, и неинициализированная переменная сыграла бы с неё.
pb_pos = -1;
pb_left = 0;                 // сколько сэмплов осталось играть
pb_dying = 0;                // идёт затухание (объявлено явно: в EEL2
                             // неинициализированная переменная и так ноль,
                             // но читателю кода это знать неоткуда)
fade_n = floor(srate * 0.005);   // 5 мс — чтобы не щёлкало на краях
fade_n < 1 ? fade_n = 1;
fade_in = 0; fade_out = 0;

// ЖИВОСТЬ СТАВИМ ЗДЕСЬ, в @init, а не в @block. Проба 28 сен показала
// почему: на треке без входного сигнала и без воспроизведения @block может
// не вызываться вовсе, и читатель решал бы, что плагина нет, — хотя он
// стоит и готов писать. У nvk этой беды не было только потому, что он жил
// в цепи мониторинга мастера, где блоки идут всегда.
mr[G_ALIVE] = 1;
mr[G_SRATE] = srate;
mr[G_LEN]   = len_sec;
mr[G_HEAD]  = 0;
mr[G_WRITING] = 0;
mr[G_SELON] = 0;
mr[G_PUTGO] = 0;
mr[G_PBGO]  = 0;
mr[G_PBPOS] = -1;
mr[G_FRZ]   = 0;          // перезагрузка плагина = запись идёт
ext_frz = 0;
mr[G_ACT]   = 0;
mr[G_PUTTR] = -1;           // -1 = печатать на СВОЙ трек (таблица демона)
// Тумблеры панели. В EEL2 неинициализированная переменная и так ноль, но
// читателю кода это знать неоткуда — объявляем явно.
snap_on = 0;      // притягивать границы к звуку
trim_on = 0;      // срезать тишину в конце
pnl_was = 0;
t_press = 0;      // время последнего нажатия ЛКМ — для двойного клика

// ВСТАВКА — ОДНА ФУНКЦИЯ на кнопку insert и двойной клик: два пути вставки
// разошлись бы при первой же правке. Превью гасим тут же (просьба 29 сен):
// после вставки слушать уже нечего, кусок в проекте.
// ── ЦВЕТА ТЕМЫ REAPER (1 окт) ─────────────────────────────────────────────
// «Очень близко к нативной теме и реагировать на theme tweaker». JSFX не
// может спросить цвет темы сам (в EEL2 нет GetThemeColor), поэтому демон раз
// в секунду кладёт палитру в общую gmem: [39] = 1 (есть), [40+роль] =
// 0xRRGGBB. Палитра одна на все экземпляры — читается без проверки владельца.
// Нет демона — значения стандартной темы, снятые 1 окт.
//   0 фон панели  col_tr1_bg        5 текст       col_toolbar_text
//   1 фон волны   col_mi_bg         6 активное    col_toolbar_text_on
//   2 пики        col_tr1_peaks     7 рамка       col_toolbar_frame
//   3 выделение   col_tl_bgsel2     8 фон кнопки  col_main_bg2
//   4 голова      col_cursor        9 сетка       col_tl_fg
TCD = mr + 2200400;
TCD[0] = $x404040; TCD[1] = $x687068; TCD[2] = $x1a1a1a; TCD[3] = $x696f69;
TCD[4] = $x318721; TCD[5] = $x767676; TCD[6] = $x24a300; TCD[7] = $x434a43;
TCD[8] = $x323232; TCD[9] = $x6d6d6d;
function tcv(i) ( gmem[39] > 0.5 ? gmem[40 + i] : TCD[i] );
function tc(i a) local(c) (
  c = tcv(i);
  gfx_set(((c >> 16) & 255) / 255, ((c >> 8) & 255) / 255, (c & 255) / 255, a);
);
// смесь двух ролей — для вида tone (плавно -> резко)
function tcmix(i j t a) local(c d) (
  c = tcv(i); d = tcv(j);
  gfx_set((((c >> 16) & 255) * (1-t) + ((d >> 16) & 255) * t) / 255,
          (((c >> 8) & 255) * (1-t) + ((d >> 8) & 255) * t) / 255,
          ((c & 255) * (1-t) + (d & 255) * t) / 255, a);
);

// ── ЗНАЧКИ ЛИНИЯМИ (1 окт) — ЗАПАСНОЙ ПУТЬ, если Nerd Font не нашёлся ────
// Растровый шрифт REAPER глифов не содержит, поэтому значки рисуются
// примитивами на целых координатах — чётко, как пиктограммы темы. Толщина
// растёт с размером ячейки.
function ln(x1 y1 x2 y2) local(w o) (
  w = max(1, floor(icsz / 10)); o = 0;
  while (o < w) ( gfx_line(x1 + o, y1, x2 + o, y2); gfx_line(x1, y1 + o, x2, y2 + o); o += 1; );
);
function draw_ico(k x y s) local(c r) (
  icsz = s;
  k == 0 ? (                                   // настройки: гаечный ключ
    ln(x + s*0.15, y + s*0.85, x + s*0.62, y + s*0.38);
    gfx_circle(x + s*0.70, y + s*0.30, s*0.20, 0, 0);
    gfx_circle(x + s*0.70, y + s*0.30, s*0.20 - 1, 0, 0);
  ) : k == 1 ? (                               // snap: подкова-магнит
    ln(x + s*0.20, y + s*0.15, x + s*0.20, y + s*0.60);
    ln(x + s*0.80, y + s*0.15, x + s*0.80, y + s*0.60);
    ln(x + s*0.20, y + s*0.60, x + s*0.40, y + s*0.85);
    ln(x + s*0.80, y + s*0.60, x + s*0.60, y + s*0.85);
    ln(x + s*0.40, y + s*0.85, x + s*0.60, y + s*0.85);
    gfx_rect(x + s*0.13, y + s*0.10, s*0.17, s*0.12);
    gfx_rect(x + s*0.70, y + s*0.10, s*0.17, s*0.12);
  ) : k == 2 ? (                               // trim: ножницы
    gfx_circle(x + s*0.25, y + s*0.75, s*0.14, 0, 0);
    gfx_circle(x + s*0.75, y + s*0.75, s*0.14, 0, 0);
    ln(x + s*0.33, y + s*0.65, x + s*0.80, y + s*0.12);
    ln(x + s*0.67, y + s*0.65, x + s*0.20, y + s*0.12);
  ) : k == 3 ? (                               // на выделенный трек: стрелка вниз в лоток
    ln(x + s*0.50, y + s*0.10, x + s*0.50, y + s*0.62);
    ln(x + s*0.28, y + s*0.42, x + s*0.50, y + s*0.64);
    ln(x + s*0.72, y + s*0.42, x + s*0.50, y + s*0.64);
    ln(x + s*0.15, y + s*0.85, x + s*0.85, y + s*0.85);
  ) : k == 4 ? (                               // replace: встречные стрелки
    ln(x + s*0.15, y + s*0.32, x + s*0.85, y + s*0.32);
    ln(x + s*0.65, y + s*0.15, x + s*0.85, y + s*0.32);
    ln(x + s*0.15, y + s*0.68, x + s*0.85, y + s*0.68);
    ln(x + s*0.35, y + s*0.85, x + s*0.15, y + s*0.68);
  ) : k == 5 ? (                               // vault: дискета
    gfx_rect(x + s*0.15, y + s*0.15, s*0.70, 1); gfx_rect(x + s*0.15, y + s*0.85, s*0.70, 1);
    gfx_rect(x + s*0.15, y + s*0.15, 1, s*0.70); gfx_rect(x + s*0.85, y + s*0.15, 1, s*0.71);
    gfx_rect(x + s*0.30, y + s*0.15, s*0.40, s*0.25);
    gfx_rect(x + s*0.28, y + s*0.58, s*0.44, 1);
  ) : k == 6 ? (                               // slixer: брусок, нарезанный на срезы
    gfx_rect(x + s*0.12, y + s*0.25, s*0.76, 1); gfx_rect(x + s*0.12, y + s*0.75, s*0.76, 1);
    c = 0; while (c <= 4) ( gfx_rect(x + s*(0.12 + c*0.19), y + s*0.25, max(1, floor(s/12)), s*0.51); c += 1; );
  ) : (                                        // grain: облако зёрен
    r = max(1, s*0.06);
    gfx_circle(x + s*0.30, y + s*0.35, r, 1, 0); gfx_circle(x + s*0.55, y + s*0.25, r, 1, 0);
    gfx_circle(x + s*0.72, y + s*0.50, r, 1, 0); gfx_circle(x + s*0.40, y + s*0.62, r, 1, 0);
    gfx_circle(x + s*0.62, y + s*0.78, r, 1, 0); gfx_circle(x + s*0.22, y + s*0.80, r, 1, 0);
  );
);

// Палитра «магма»: тёмно-фиолетовый -> пурпур -> оранж -> жёлтый.
// Спектрограмма остаётся в своей палитре: в REAPER её цвета задаются в
// настройках, а не в теме — «как в теме» тут не бывает.
function sg_color(v) (
  v < 0.33 ? gfx_set(0.04 + v*0.9, 0.01 + v*0.15, 0.10 + v*1.0, 1) :
  v < 0.66 ? gfx_set(0.34 + (v-0.33)*1.7, 0.06 + (v-0.33)*0.9, 0.43 - (v-0.33)*1.0, 1) :
             gfx_set(0.90 + (v-0.66)*0.3, 0.36 + (v-0.66)*1.7, 0.10 + (v-0.66)*0.8, 1);
);
// Один столбец c: FFT окна Ханна от позиции кольца c/SGC, максимум по
// бинам каждой полосы, дБ -90..0 -> 0..1, сразу рисуется в изображение 1.
function sg_col(c) local(p i k re im m bb ba v nrm) (
  p = floor(c / SGC * ring_n);
  i = 0;
  while (i < SGN) (
    k = p + i; k >= ring_n ? k -= ring_n;
    FFTB[i*2]   = (bufL[k] + bufR[k]) * 0.5 * (0.5 - 0.5*cos(2*$pi*i/(SGN-1)));
    FFTB[i*2+1] = 0;
    i += 1;
  );
  fft(FFTB, SGN);
  fft_permute(FFTB, SGN);
  nrm = 16 / (SGN * SGN);                     // (2 / (SGN*0.5))^2: Ханн, одна сторона
  gfx_dest = 1;
  i = 0;
  while (i < SGB) (
    ba = SGBE[i]; bb = max(ba + 1, SGBE[i+1]);
    m = 0; k = ba;
    while (k < bb && k < SGN/2) ( re = FFTB[k*2]; im = FFTB[k*2+1]; m = max(m, re*re + im*im); k += 1; );
    v = (10 * log10(max(m * nrm, 0.000000001)) + 90) / 90;
    sg_color(min(1, max(0, v)));
    gfx_rect(c, SGB - 1 - i, 1, 1);           // низкие частоты внизу
    i += 1;
  );
  gfx_dest = -1;
);

function do_insert() (
  mr[G_PUTST]  = floor(mr[G_SELA] * ring_n);
  mr[G_PUTLEN] = max(1, floor((mr[G_SELB] - mr[G_SELA]) * ring_n));
  mr[G_PUTGO]  = 1;
  mr[G_PBGO]   = 2;
  pb_frozen = 0;
  mr[G_FRZ] = 0;             // вставили — внешняя заморозка тоже снята
);
cfg_open = 0;     // меню под ключом открыто
prev_amp = 0;     // для окраски по тону


@block
// ── ВЛАДЕЛЕЦ: синхронизация зеркала с общей gmem ──────────────────────────
is_owner = gmem[G_OWNER] == slot;
is_owner ? (
  // стал владельцем — выложить всю свою картину разом (один раз)
  !was_owner ? (
    i = 0; while (i < zn) ( gmem[G_ZMAX+i] = mr[G_ZMAX+i]; gmem[G_ZMIN+i] = mr[G_ZMIN+i]; i += 1; );
    ls_on = -1;                      // выделение тоже переопубликовать
  );
  gmem[G_ALIVE] = 1; gmem[G_SRATE] = srate; gmem[G_LEN] = len_sec;
  gmem[G_HEAD] = mr[G_HEAD]; gmem[G_WRITING] = mr[G_WRITING];
  gmem[G_PBPOS] = mr[G_PBPOS];
  mr[G_WIDTH] = gmem[G_WIDTH];
  // КОМАНДЫ ОТ ДЕМОНА — принять и погасить в общей памяти
  gmem[G_PUTGO] >= 0.5 ? (
    mr[G_PUTST] = gmem[G_PUTST]; mr[G_PUTLEN] = gmem[G_PUTLEN];
    mr[G_PUTTR] = gmem[G_PUTTR]; mr[G_PUTGO] = 1; gmem[G_PUTGO] = 0;
  );
  gmem[G_PBGO] >= 0.5 ? (
    mr[G_PBST] = gmem[G_PBST]; mr[G_PBLEN] = gmem[G_PBLEN];
    mr[G_PBGO] = gmem[G_PBGO]; gmem[G_PBGO] = 0;
  );
  mr[G_FRZ] = gmem[G_FRZ];
  // ВЫДЕЛЕНИЕ в обе стороны: изменил демон (энкодеры) — взять; изменили
  // мы (мышь) — выложить. Сравнение с последним опубликованным различает.
  gmem[G_SELON] != ls_on || gmem[G_SELA] != ls_a || gmem[G_SELB] != ls_b ? (
    ls_on >= 0 ? ( mr[G_SELON] = gmem[G_SELON]; mr[G_SELA] = gmem[G_SELA]; mr[G_SELB] = gmem[G_SELB]; );
  );
  gmem[G_SELON] = mr[G_SELON]; gmem[G_SELA] = mr[G_SELA];
  gmem[G_SELB] = mr[G_SELB]; gmem[G_SELREV] = mr[G_SELREV];
  ls_on = mr[G_SELON]; ls_a = mr[G_SELA]; ls_b = mr[G_SELB];
  // кнопки панели (replace/vault/slixer/grain/-> sel) — демону
  mr[G_ACT] > 0.5 ? (
    gmem[G_PUTST] = mr[G_PUTST]; gmem[G_PUTLEN] = mr[G_PUTLEN];
    gmem[G_ACT] = mr[G_ACT]; mr[G_ACT] = 0;
  );
) : (
  mr[G_FRZ] = 0;                     // чужая заморозка нас не касается
  mr[G_ACT] = 0;                     // не владелец — демон нас не слышит
);
was_owner = is_owner;
mr[G_ALIVE] = 1;
ext_frz = mr[G_FRZ] > 0.5;
mr[G_SRATE] = srate;
mr[G_LEN]   = len_sec;

// ── ПОЧТОВЫЙ ЯЩИК ВСТАВКИ ───────────────────────────────────────────────
// Читатель (ретро-мод) кладёт сюда адрес куска и поднимает флаг; мы печатаем
// айтем и флаг гасим. Печать делается ЗДЕСЬ, а не в @gfx: окно плагина может
// быть закрыто, а вставка обязана работать всегда.
// Ширину экранного слоя задаёт читатель; пересчитываем шаг при её смене.
mr[G_WIDTH] >= 16 && mr[G_WIDTH] <= 4096 && floor(mr[G_WIDTH]) != pw ? (
  pw = floor(mr[G_WIDTH]);
  p_i = 0; p_acc = 0; p_max = 0; p_min = 0;
);

// ── КОМАНДЫ ПРЕВЬЮ ──────────────────────────────────────────────────────
// 1 = играть кусок, 2 = остановить. Разбираем в @block, а не в @sample:
// блок приходит раз в ~128 сэмплов, и читать gmem на каждом сэмпле ради
// команды, которая меняется раз в секунду, — чистая трата.
mr[G_PBGO] >= 0.5 ? (
  mr[G_PBGO] == 1 ? (
    pb_pos  = max(0, min(ring_n - 1, floor(mr[G_PBST])));
    pb_left = floor(mr[G_PBLEN]);
    // Длина 0 означает «до конца кольца», но БЕСКОНЕЧНО играть нельзя:
    // ровно так 24 сен получался «призрак» — плагин крутил кольцо вечно,
    // пока не придёт стоп, и переживал закрытие мода.
    pb_left <= 0 ? pb_left = ring_n;
    pb_left = min(pb_left, ring_n);
    fade_in = fade_n;
    fade_out = 0;
  ) : (
    // стоп — не обрыв, а фейд: обрыв на полуволне даёт щелчок
    pb_pos >= 0 && fade_out <= 0 ? fade_out = fade_n;
  );
  mr[G_PBGO] = 0;
);

@sample
// ── КОЛЬЦЕВАЯ ЗАПИСЬ ────────────────────────────────────────────────────
// Пишем всегда, пока плагин включён: в этом и смысл ретроспективы — решение
// «оставить» принимается ПОСЛЕ игры, а не до.
// ── ЗАМОРОЗКА НА ВРЕМЯ ВЫБОРА (29 сен) ────────────────────────────────
// Пока человек тянет выделение мышью, кольцо стоять ДОЛЖНО: иначе голова
// уезжает, материал под выделением затирается новым, и к моменту вставки
// берётся уже не то, что выбирали. Та же болезнь была в окне демона —
// «скобки едут с плейхедом», и лечится она так же: остановить запись, а не
// пересчитывать координаты.
// Размораживает ОТПУСКАНИЕ мыши (см. @gfx): решение возобновить — за рукой.
// Пустой ветки быть не должно — в EEL2 она валит компиляцию, а ошибка
// видна только при открытии плагина. Пишем через отрицание.
!pb_frozen && !ext_frz ? (
bufL[wpos] = spl0;
bufR[wpos] = spl1;

// Пики считаем ЗДЕСЬ, а не потом из аудио: проход по трём миллионам отсчётов
// ради отрисовки стоил бы дороже самой записи. Берём модуль по громкому из
// каналов — удар, которого нет в одном канале, но есть в другом, не пропадёт.
smax = max(spl0, spl1);
smin = min(spl0, spl1);

// зум-слой
smax > z_max ? z_max = smax;
smin < z_min ? z_min = smin;
z_acc += 1;
z_acc >= z_step ? (
  zi = floor(wpos / z_step);
  zi >= 0 && zi < zn ? (
    mr[G_ZMAX + zi] = z_max;
    mr[G_ZMIN + zi] = z_min;
    is_owner ? ( gmem[G_ZMAX + zi] = z_max; gmem[G_ZMIN + zi] = z_min; );
  );
  z_acc = 0; z_max = 0; z_min = 0;
);

// экранный слой (ширину задал читатель)
pw > 0 ? (
  smax > p_max ? p_max = smax;
  smin < p_min ? p_min = smin;
  p_acc += 1;
  p_acc >= ring_n / pw ? (
    pi = floor(wpos / ring_n * pw);
    pi >= 0 && pi < pw ? (
      mr[G_PMAX + pi] = p_max;
      mr[G_PMIN + pi] = p_min;
      is_owner ? ( gmem[G_PMAX + pi] = p_max; gmem[G_PMIN + pi] = p_min; );
    );
    p_acc = 0; p_max = 0; p_min = 0;
  );
);

wpos += 1;
wpos >= ring_n ? wpos = 0;

// Голову отдаём наружу долей кольца: читателю не нужно знать ни частоту,
// ни длину, чтобы понять, где «сейчас».
mr[G_HEAD] = wpos / ring_n;
mr[G_WRITING] = 1;
);   // конец ветки «не заморожены»

// ── ПРЕВЬЮ: ЧТЕНИЕ КУСКА В ВЫХОД ────────────────────────────────────────
// Подмешиваем к сигналу, а не заменяем его: слышно и то, что играет сейчас,
// и то, что выбрано. Идёт ПОСЛЕ записи в кольцо, иначе превью писалось бы
// само в себя и получилась бы обратная связь.
pb_pos >= 0 ? (
  // Громкость: нарастание в начале, затухание в конце. Одна величина g,
  // потому что оба фейда никогда не действуют одновременно.
  g = 1;
  fade_in > 0 ? (
    g = (fade_n - fade_in) / fade_n;
    fade_in -= 1;
  );
  pb_dying ? (
    g = fade_out / fade_n;
    fade_out -= 1;
  );

  spl0 += bufL[pb_pos] * g;
  spl1 += bufR[pb_pos] * g;

  pb_pos += 1;
  pb_pos >= ring_n ? pb_pos = 0;       // кольцо: кусок может идти через край
  pb_left -= 1;

  // ── ГАСНЕМ САМИ, а не ждём стопа снаружи ─────────────────────────────
  // Именно этого не хватало у nvk: там чтение шло по кольцу бесконечно и
  // переживало закрытие мода — отсюда «призрак» 24 сен.
  //
  // ОТДЕЛЬНЫЙ ФЛАГ pb_dying, а не «fade_out > 0», делает состояние
  // однозначным. Проверено симуляцией: вариант без флага обрывал звук на
  // громкости 0.4 (щелчок), а попытка починить его сравнением с нулём —
  // ЗАЛИПАЛА, звук не гас вовсе. В @sample такая ошибка стоит дорого:
  // не «не сработало», а залипший тон посреди игры.
  //   кусок доиграл -> pb_dying, затухание от fade_n до 0 ВКЛЮЧИТЕЛЬНО;
  //   fade_out ушёл ниже нуля -> замолчали.
  pb_left <= 0 && !pb_dying ? ( pb_dying = 1; fade_out = fade_n );
  pb_dying && fade_out < 0 ? (
    pb_pos = -1; pb_dying = 0; fade_in = 0; fade_out = 0;
  );

  mr[G_PBPOS] = pb_pos;
) : (
  mr[G_PBPOS] = -1;
);

@gfx 600 140
// ── ПОЧТОВЫЙ ЯЩИК ВСТАВКИ — ЗДЕСЬ, А НЕ В @block (29 сен) ──────────────
// Проба: из @block заказ СЪЕДАЛСЯ (флаг сбрасывался), а айтем не появлялся.
// export_buffer_to_project трогает проект, то есть это работа главного
// потока; в аудиопотоке она молча не выполняется.
// Так же поступает и nvk_RECORD — его вызов стоит в @gfx, и теперь понятно
// почему, а не «так у автора написано».
//
// Цена: при закрытом окне вставка не сработает. Для нас терпимо — панель
// встроена в TCP и открыта почти всегда; а жест вставки и так делается
// мышью по этой самой панели.
mr[G_PUTGO] >= 0.5 ? (
  mr[G_PUTGO] = 0;
  put_st  = mr[G_PUTST];
  put_len = mr[G_PUTLEN];
  put_len > 0 ? (
    // ТРЕК ПРИХОДИТ СНАРУЖИ, и иначе никак: JSFX живёт в аудиопотоке и про
    // структуру проекта не знает ничего — ни своего номера трека, ни
    // позиции курсора. Проверено 28 сен: переменной `trackidx` не
    // существует (я её выдумал), а стоковые плагины вроде jf_looper тоже
    // получают номер извне.
    // Поэтому демон кладёт номер В ЯЧЕЙКУ ЗАРАНЕЕ, при постановке плагина
    // на трек. Тогда ПКМ в панели печатает САМ, не дёргая демона в момент
    // жеста — а если демона нет вовсе, стоит 0 (первый трек), и это видно
    // по результату, а не молча промахивается.
    // Свой трек: демон ведёт таблицу слот -> трек в общей gmem. Заказ
    // демона (PUTTR >= 0) главнее — он печатает на выделенный.
    put_tr = mr[G_PUTTR];
    put_tr < 0 ? put_tr = gmem[G_TRK + slot];
    put_tr < 0 ? put_tr = 0;
    mr[G_PUTTR] = -1;
    // export_buffer_to_project — встроенная функция REAPER: печатает кусок
    // памяти как аудио-айтем. Каналы идут подряд, поэтому шаг между ними —
    // расстояние от левого канала до правого.
    export_buffer_to_project(bufL + put_st, put_len, 2, srate,
                             put_tr, 0, 0, bufR - bufL);
  );
);


// ── САМОДОСТАТОЧНАЯ ПАНЕЛЬ В TCP (просьба 28 сен) ───────────────────────
// «Кидаю на канал и прямо вижу, что на канале игралось, и могу за эти
//  40 секунд скопировать кусок».
//
// Поэтому плагин работает БЕЗ демона и без ретро-мода: волна, выделение
// мышью, прослушивание и вставка — всё здесь. Демон, когда он есть, просто
// пишет в те же ячейки gmem; конфликта нет, потому что источник истины один
// (gmem), а не две копии состояния.
// фон панели — цвет трека темы; gfx_clear ждёт B*65536 + G*256 + R
tcb = tcv(0);
gfx_clear = ((tcb >> 16) & 255) + ((tcb >> 8) & 255) * 256 + (tcb & 255) * 65536;

// Место снизу под ДВА РЯДА КНОПОК и строку статуса. Без резерва они легли
// бы на волну — а на неё и смотрят.
// ВСТРОЕННЫЙ В TCP ВИД — ВДВОЕ МЕЛЬЧЕ (просьба 29 сен): шрифт и кнопки
// считаются от одного кегля, поэтому шрифт ставим ДО высоты кнопок.
// gfx_ext_flags & 1 — окно встроено в TCP/MCP.
embedded = gfx_ext_flags & 1;
// NERD FONT НА ВСЮ ЭКОСИСТЕМУ GRID (1 окт, вечер): текст и значки одним
// семейством, как в окне демона. Растровый шрифт REAPER (утро 1 окт)
// глифов не содержит и не масштабируется. Цвета по-прежнему из темы.
// gfx_setfont молча подставляет что попало, если семейства нет: проверяем
// высоту и откатываемся на растровый — значки тогда рисуются линиями.
gfx_setfont(1, "JetBrainsMono Nerd Font Mono", embedded ? 13 : 14);
nerd_ok = gfx_texth >= 4;
!nerd_ok ? gfx_setfont(0);
BTNH = max(14, floor(gfx_texth * 1.25));
// Диагностика: реальная ширина встроенной панели — по ней подбирается
// параметр темы, который её сужает (замер, а не догадка).
embedded ? gmem[27] = gfx_w;
LABH = gfx_texth + 4;
// СТОЛБЕЦ ЗНАЧКОВ СПРАВА (29 сен: «кнопки нечитаемые — ярче, больше,
// справа значками nerd icons»). 8 ячеек на всю высоту; волна получает всю
// ширину слева от столбца (WW), внизу остаётся одна строка статуса.
ICN = 8;
// В TCP значки ВТРОЕ крупнее (30 сен): 8 штук в один столбец в панель
// высотой ~130 px не лезут, поэтому СЕТКА справа — 3 ряда, столбцов сколько
// нужно. В окне плагина — как было, один столбец.
CELL = embedded ? max(24, min(48, floor((gfx_h - 4) / 3) - 2))
                : max(12, min(30, floor((gfx_h - 4) / ICN) - 2));
IROWS = max(1, floor((gfx_h - 2) / (CELL + 2)));
ICOLS = ceil(ICN / IROWS);
COLW = ICOLS * (CELL + 2) + 2;
WW = max(40, gfx_w - COLW);
PANH = LABH;
wave_h = max(20, gfx_h - PANH);
hh = wave_h / 2;


// Геометрия ключа и меню считается ЗДЕСЬ, до мыши: обработчик выделения
// обязан знать, что клик пришёлся на кнопку, а не на волну.
gsz = CELL; gx0 = WW + 2; gy0 = 2;
MENUW = floor(BTNH * 5); MENUN = 4;
mx0 = WW - MENUW - 2; my0 = 2;
over_ui = (mouse_x >= gx0 && mouse_x < gx0 + gsz && mouse_y >= gy0 && mouse_y < gy0 + gsz)
       || (cfg_open && mouse_x >= mx0 && mouse_x < mx0 + MENUW
                    && mouse_y >= my0 && mouse_y < my0 + MENUN * (BTNH + 1));

// ── ВОЛНА: ТРИ ВИДА (29 сен) ───────────────────────────────────────────
// peaks — столбцы min/max из зум-слоя (500 пиков/с: на 600 точках ширины
//   это 33 пика на столбец при 40 с, берём максимум по ним — иначе удар
//   между отсчётами исчезнет);
// tone  — то же, но цвет столбца от СКОРОСТИ изменения огибающей: плавно —
//   бирюзовый, резко — к жёлтому. Это НЕ спектр (звука у нас нет, только
//   пики), а честная оценка «бас/хэт» по форме; та же эвристика, что в окне
//   демона, нормирована на громкость — иначе громкое всегда «резкое»;
// spectrogram — время x частота, цвет = громкость; копится по мере записи.
view < 1.5 ? (
  // фон волны — фон айтема темы: панель читается как айтем на треке
  tc(1, 1); gfx_rect(0, 0, WW, wave_h);
  prev_amp = 0;
  i = 0;
  while (i < WW) (
    za = floor(i / WW * zn);
    zb = max(za + 1, floor((i + 1) / WW * zn));
    y1 = 0; y2 = 0;
    k = za;
    while (k < zb && k < zn) (
      mr[G_ZMAX + k] > y1 ? y1 = mr[G_ZMAX + k];
      mr[G_ZMIN + k] < y2 ? y2 = mr[G_ZMIN + k];
      k += 1;
    );
    view >= 0.5 ? (
      amp = max(y1, -y2);
      d = abs(amp - prev_amp);
      t = amp > 0.01 ? min(1, d / amp * 3) : 0;
      prev_amp = amp;
      tcmix(2, 6, t, 1);
    ) : tc(2, 1);
    y1 = y1 >= 0 ? sqrt(y1) : -sqrt(-y1);
    y2 = y2 >= 0 ? sqrt(y2) : -sqrt(-y2);
    gfx_line(i, hh + hh*y1, i, hh + hh*y2);
    i += 1;
  );
) : (
  // ── СПЕКТРОГРАММА ────────────────────────────────────────────────────
  !sg_init ? (
    gfx_setimgdim(1, SGC, SGB);
    gfx_dest = 1; gfx_set(0.04, 0.01, 0.10, 1); gfx_rect(0, 0, SGC, SGB); gfx_dest = -1;
    sg_init = 1; sg_fill = 0; sg_hc = -1;
  );
  // столбцы, по которым прошла голова с прошлого кадра (обычно 0-1)
  hc = floor(mr[G_HEAD] * SGC) % SGC;
  sg_hc < 0 ? sg_hc = hc;
  n = 0;
  while (sg_hc != hc && n < 6) ( sg_col(sg_hc); sg_hc = (sg_hc + 1) % SGC; n += 1; );
  // первое заполнение — порциями, чтобы кадр не вставал
  n = 0;
  while (sg_fill < SGC && n < 8) ( sg_col(sg_fill); sg_fill += 1; n += 1; );
  gfx_dest = -1;
  gfx_blit(1, 1, 0, 0, 0, SGC, SGB, 0, 0, WW, wave_h);
  // сетка частот тонко поверх — чтобы было видно, где 100 Гц и 1 кГц
  tc(9, 0.5);
  fmin = 30; lgr = log((srate*0.5) / fmin);
  f = 100; while (f < srate*0.5) (
    gy = wave_h - log(f / fmin) / lgr * wave_h;
    gfx_line(0, gy, WW, gy);
    gfx_x = 2; gfx_y = gy - gfx_texth;
    tc(5, 1);
    gfx_drawstr(f >= 1000 ? sprintf(#flab, "%dk", f/1000) : sprintf(#flab, "%d", f));
    tc(9, 0.5);
    f *= 10;
  );
);

// ── ВЫДЕЛЕНИЕ ───────────────────────────────────────────────────────────
// Доли кольца приходят от читателя. Здесь система координат ПРОСТАЯ: волна
// рисуется от начала кольца, значит доля умножается прямо на ширину.
// (У nvk было иначе — там рисовался только хвост, и подсветка требовала
// пересчёта; на этом 26 сен уехали скобки в окне демона.)
mr[G_SELON] >= 0.5 ? (
  sa = mr[G_SELA] * WW;
  sb = mr[G_SELB] * WW;
  sb < sa ? (t = sa; sa = sb; sb = t);
  sw = max(2, sb - sa);
  // Реверс отличается ЦВЕТОМ, а не штриховкой: штриховку на узкой полоске
  // не разглядеть.
  mr[G_SELREV] >= 0.5 ?
    tc(6, 0.25) :
    tc(3, 0.45);
  gfx_rect(sa, 0, sw, gfx_h);
  mr[G_SELREV] >= 0.5 ?
    tc(6, 1) :
    tc(3, 1);
  gfx_rect(sa, 0, 1, gfx_h);
  gfx_rect(sa + sw - 1, 0, 1, gfx_h);
);

// Голова записи — цвет курсора темы.
tc(4, 1);
hx = mr[G_HEAD] * WW;
gfx_rect(hx, 0, 2, wave_h);

// ── МЫШЬ: ВЫДЕЛИТЬ, ПОСЛУШАТЬ, ВСТАВИТЬ ─────────────────────────────────
// Жест читается по КОНЦУ, а не по началу — пока кнопка нажата, неизвестно,
// будет это клик или протягивание:
//   клик            -> плейхед сюда, кусок до конца буфера
//   протянул        -> выделен ровно этот отрезок
//   отпустил        -> кусок звучит (слышишь, что взял)
//   ПКМ по выделению -> кусок печатается айтемом под курсор проекта
//
// ПРО ДРАГ В АРАНЖИРОВКУ, честно: системного drag-n-drop у JSFX нет —
// @gfx знает только координаты внутри себя и отдать «файл» наружу не может.
// Поэтому вставка сделана вторым щелчком (ПКМ), а не перетаскиванием.
// Результат тот же — кусок оказывается на таймлайне, — но тени под
// курсором не будет.
mdown = mouse_cap & 1;
rdown = mouse_cap & 2;
inside = mouse_y >= 0 && mouse_y < wave_h && mouse_x >= 0 && mouse_x < WW && !over_ui;
mf = max(0, min(1, mouse_x / WW));

// НАЖАЛ — ЗАПИСЬ ВСТАЛА. Пока тянешь выделение, кольцо не проворачивается:
// иначе материал под выделением затрётся новым, и вставится не то, что
// выбирали (просьба 29 сен: «когда начинаю нажимать, он перестал
// записывать входящий сигнал»).
// ── МЫШЬ (окончательная раскладка 29 сен, вечер) ───────────────────────
//   ЛКМ тянуть   — выделить; запись замирает
//   отпустить    — превью
//   ДВОЙНОЙ ЛКМ  — остановить превью
//   ПКМ          — вставить на ТРЕК САМОГО ПЛАГИНА, под edit-курсор
// Кнопка «→ sel» в панели — то же, но на ВЫДЕЛЕННЫЙ трек (через демон).
//
// Свой трек плагин не знает (JSFX в аудиопотоке, проверено 28 сен), поэтому
// демон кладёт его номер в G_PUTTR при установке и обновляет раз в 2 с.
// Клик по панели ЗАБИРАЕТ ВЛАДЕНИЕ: грид, арк и окно демона переключаются
// на этот канал — работаешь там, где кликнул.
(mdown && !m_was || rdown && !r_was) && mouse_y >= 0 && mouse_y < gfx_h ? gmem[G_OWNER] = slot;
mdown && !m_was && inside ? (
  now_t = time_precise();
  dbl = (now_t - t_press) < 0.35;
  t_press = now_t;
  dbl ? (
    mr[G_PBGO] = 2;                  // двойной — тишина
    m_drag = 0;
  ) : (
    m_drag = 1; m_a = mf; pb_frozen = 1;
  );
);
mdown && m_drag && abs(mf - m_a) * WW >= 3 ? (
  mr[G_SELON] = 1;
  mr[G_SELA] = min(m_a, mf);
  mr[G_SELB] = max(m_a, mf);
);
!mdown && m_was && m_drag ? (
  m_drag = 0;
  abs(mf - m_a) * WW < 3 ? (
    // Клик без протягивания: от точки, не длиннее четверти кольца —
    // иначе «послушать» превращается в «играть всё».
    mr[G_SELA] = mf;
    mr[G_SELB] = min(1, mf + 0.25);
  );
  mr[G_SELON] = 1;
  mr[G_PBST]  = floor(mr[G_SELA] * ring_n);
  mr[G_PBLEN] = max(1, floor((mr[G_SELB] - mr[G_SELA]) * ring_n));
  mr[G_PBGO]  = 1;
);
m_was = mdown;

// ПКМ — вставить на свой трек (G_PUTTR уже заполнен демоном).
rdown && !r_was && inside && mr[G_SELON] >= 0.5 ? do_insert();
r_was = rdown;

// Клик по волне БЕЗ выделения размораживает: выход из режима выбора, если
// передумал. Без него плагин замирал бы навсегда после первого касания.
!mdown && !rdown && pb_frozen && mr[G_SELON] < 0.5 ? pb_frozen = 0;

// ── ПАНЕЛЬ КНОПОК (просьба 29 сен) ──────────────────────────────────────
// Шесть действий в два ряда по три. Мышью по кнопке надёжнее, чем помнить,
// что ПКМ вставляет: жест без подписи приходится заучивать.
//
// ЧЕТЫРЕ ДЕЛАЕТ ПЛАГИН САМ (snap, trim, insert, и они же на гриде), а
// ДВЕ — «replace» и «vault» — требуют знания о ПРОЕКТЕ (выделенный айтем) и
// о файловой системе. JSFX в аудиопотоке про это не знает ничего, поэтому
// он лишь поднимает флаг, а делает демон. Та же граница, что с номером
// трека: проверено 28 сен, своего трека плагин тоже не знает.
function rbtn(x y w h lab on) local(hit r tw th) (
  hit = mouse_x >= x && mouse_x < x+w && mouse_y >= y && mouse_y < y+h;
  on ? tc(3, 1) : tc(8, 1);
  gfx_rect(x, y, w, h);
  tc(7, hit ? 1 : 0.8);
  gfx_rect(x, y, w, 1); gfx_rect(x, y+h-1, w, 1);
  gfx_rect(x, y, 1, h); gfx_rect(x+w-1, y, 1, h);
  on ? tc(6, 1) : tc(5, 1);
  gfx_measurestr(lab, tw, th);
  gfx_x = x + (w - tw)/2; gfx_y = y + (h - th)/2;
  gfx_drawstr(lab);
  r = hit && lclick_r;
  r;
);

// Клик по кнопке ловим ФРОНТОМ: mouse_cap держится, пока кнопка нажата, и
// без фронта одно нажатие срабатывало бы десятки раз подряд.
lclick_r = (mouse_cap & 1) && !pnl_was;
pnl_was = mouse_cap & 1;

// Кнопка-значок: крупный глиф Nerd Font, ЯРКИЙ (0.95 на тёмном), активное —
// бирюзовой подложкой. Нет шрифта — короткая буква. Под курсором название
// уходит в строку статуса: значки не надо заучивать.
function ibtn(k glyph alt name on) local(x y hit tw th) (
  x = WW + 2 + floor(k / IROWS) * (CELL + 2);
  y = 2 + (k % IROWS) * (CELL + 2);
  hit = mouse_x >= x && mouse_x < x + CELL && mouse_y >= y && mouse_y < y + CELL;
  on ? tc(3, 1) : tc(8, 1);
  gfx_rect(x, y, CELL, CELL);
  tc(7, hit ? 1 : 0.8);
  gfx_rect(x, y, CELL, 1); gfx_rect(x, y + CELL - 1, CELL, 1);
  gfx_rect(x, y, 1, CELL); gfx_rect(x + CELL - 1, y, 1, CELL);
  // значок глифом Nerd Font (шрифт 2, кегль от ячейки); нет шрифта —
  // линиями. Активное — цветом «включено» темы, под курсором ярче.
  on ? tc(6, 1) : tc(5, hit ? 1 : 0.9);
  nerd_ok ? (
    gfx_setfont(2, "JetBrainsMono Nerd Font Mono", floor(CELL * 0.62));
    gfx_measurestr(glyph, tw, th);
    gfx_x = x + floor((CELL - tw) / 2); gfx_y = y + floor((CELL - th) / 2);
    gfx_drawstr(glyph);
    gfx_setfont(1);
  ) : draw_ico(k, x + floor(CELL * 0.18), y + floor(CELL * 0.18), floor(CELL * 0.64));
  hit ? strcpy(#hover, name);
  hit && lclick_r;
);

strcpy(#hover, "");
have_sel = mr[G_SELON] >= 0.5;
ibtn(0, "", "cfg", "settings: view / clear", cfg_open) ? cfg_open = !cfg_open;
ibtn(1, "", "S", "snap: edges to the sound", snap_on) ? snap_on = !snap_on;
ibtn(2, "", "T", "trim silence at the end", trim_on) ? trim_on = !trim_on;
// на ВЫДЕЛЕННЫЙ трек — через демона, он знает выделение
ibtn(3, "", ">", "insert to selected track", 0) && have_sel ? (
  mr[G_PUTST]  = floor(mr[G_SELA] * ring_n);
  mr[G_PUTLEN] = max(1, floor((mr[G_SELB] - mr[G_SELA]) * ring_n));
  mr[G_ACT]    = 5;
);
ibtn(4, "", "R", "replace selected item", 0) && have_sel ? (
  mr[G_PUTST]  = floor(mr[G_SELA] * ring_n);
  mr[G_PUTLEN] = max(1, floor((mr[G_SELB] - mr[G_SELA]) * ring_n));
  mr[G_ACT]    = 1;
);
ibtn(5, "", "V", "save to vault (jf_pm tags)", 0) && have_sel ? (
  mr[G_PUTST]  = floor(mr[G_SELA] * ring_n);
  mr[G_PUTLEN] = max(1, floor((mr[G_SELB] - mr[G_SELA]) * ring_n));
  mr[G_ACT]    = 2;
);
ibtn(6, "", "sl", "to slixer on a new track", 0) && have_sel ? (
  mr[G_PUTST]  = floor(mr[G_SELA] * ring_n);
  mr[G_PUTLEN] = max(1, floor((mr[G_SELB] - mr[G_SELA]) * ring_n));
  mr[G_ACT]    = 3;
);
ibtn(7, "", "gr", "to grain on a new track", 0) && have_sel ? (
  mr[G_PUTST]  = floor(mr[G_SELA] * ring_n);
  mr[G_PUTLEN] = max(1, floor((mr[G_SELB] - mr[G_SELA]) * ring_n));
  mr[G_ACT]    = 4;
);

// ── МЕНЮ НАСТРОЕК (под ключом) — слева от столбца, поверх волны ─────────
mx0 = WW - MENUW - 2; my0 = 2;
cfg_open ? (
  tc(8, 1);
  gfx_rect(mx0 - 2, my0 - 2, MENUW + 4, MENUN * (BTNH + 1) + 4);
  rbtn(mx0, my0,                 MENUW, BTNH, "peaks", view < 0.5) ? ( view = 0; sliderchange(view); cfg_open = 0; );
  rbtn(mx0, my0 + (BTNH+1),      MENUW, BTNH, "tone",  view >= 0.5 && view < 1.5) ? ( view = 1; sliderchange(view); cfg_open = 0; );
  rbtn(mx0, my0 + (BTNH+1)*2,    MENUW, BTNH, "spectrogram", view >= 1.5) ? ( view = 2; sliderchange(view); cfg_open = 0; );
  rbtn(mx0, my0 + (BTNH+1)*3,    MENUW, BTNH, "clear sel", 0) ? ( mr[G_SELON] = 0; pb_frozen = 0; cfg_open = 0; );
);

// ── ПОДПИСЬ ─────────────────────────────────────────────────────────────
// Одной строкой внизу: что за плагин, длина буфера и как им пользоваться.
// Без неё панель молчит о том, что вообще умеет.
tc(5, 1);
gfx_x = 4; gfx_y = wave_h + 2;
strlen(#hover) > 0 ? ( gfx_drawstr(#hover); ) :
mr[G_SELON] >= 0.5 ? (
  sl = (mr[G_SELB] - mr[G_SELA]) * len_sec;
  gfx_printf("jf_rec  %d s   sel %.2f s   rmb insert  2x lmb stop", len_sec, sl);
) : (
  gfx_printf("jf_rec  %d s   drag on the wave: select and listen", len_sec);
);
